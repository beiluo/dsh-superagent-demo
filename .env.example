# Server-side configuration for the ontology agent.
#
# Copy to .env (git-ignored) for local development, or set these variables in
# your hosting provider. NEVER commit a real key and NEVER put it in
# assets/js/agent-config.js.
#
# Without LLM_API_KEY the agent still works in deterministic "rules mode".

# Required only for LLM mode. Use your own provider key.
LLM_API_KEY=

# OpenAI-compatible endpoint. DeepSeek is the default example.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_ENABLED=true

# Public origins allowed to call this backend from a browser.
ALLOWED_ORIGINS=https://beiluo.github.io,http://localhost:8000,http://127.0.0.1:8000

# Public-demo guardrails. Raise only if you understand the abuse risk.
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_HOUR=40
DAILY_REQUEST_BUDGET=300
MAX_QUESTION_CHARS=500
AGENT_MAX_STEPS=6
LLM_MAX_OUTPUT_TOKENS=1800
LLM_TIMEOUT_SECONDS=60

# Set true when the hosting platform terminates TLS and sets X-Forwarded-For.
TRUST_PROXY=false

# Serve index.html/assets/ontology/docs from this process for local dev.
SERVE_STATIC=true

# Real A-share lookup (public market/filing data, no API key).
# Set MARKET_DATA_ENABLED=false to keep the agent on the 4 synthetic examples.
MARKET_DATA_ENABLED=true
MARKET_DATA_TIMEOUT_SECONDS=8
MARKET_DATA_QUOTE_TTL_SECONDS=60
MARKET_DATA_FINANCIAL_TTL_SECONDS=21600


# Short-term K-line cache (MA20/MA60, limit-up streak, board breaks).
MARKET_DATA_SHORT_TERM_TTL_SECONDS=300

# Agent-driven acquisition of missing public facts (dragon-tiger list, seats,
# limit-up pool). Only public HTTPS finance hosts are accepted; the target must
# also resolve to a globally routable address.
ACQUISITION_ENABLED=true
ACQUISITION_TIMEOUT_SECONDS=8
ACQUISITION_MAX_BYTES=2000000
# Comma-separated domain suffixes. Leave unset for the built-in finance list.
# ACQUISITION_ALLOWED_HOSTS=eastmoney.com,sina.com.cn,qq.com,cninfo.com.cn,sse.com.cn,szse.cn
