ashd:voice-youzi-236 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "\"分析交易不要只看图形，要看背后的市场环境与其他投资者的情绪与资金去向——\"这才是真正的顺势而为\"。" ;
    ash:statementSpeaker "著名刺客" ;
