ashd:skill-youzi-11 ash:hasStatement ashd:voice-youzi-678 .

ashd:voice-youzi-679 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "箱体思维：A股以500-600点箱体运行（3370跌破后3400-4000箱体终结，看2800-3400），越靠近箱体下沿越可加重抄底仓位。" ;
    ash:statementSpeaker "万法归宗" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 12 ;
    ash:hasSkillTopic ashs:topic-position ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "万法归宗 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-13 ash:hasStatement ashd:voice-youzi-679 .

ashd:voice-youzi-680 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 心态修炼：\"心态一定要放平，这样反而每年有很好的收获\"\"多念经，免贪欲，管住手，勤学习\"\"人不可贪婪，在市场面前始终要谦卑，要跟随。" ;
    ash:statementSpeaker "万法归宗" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 13 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "万法归宗 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-13 ash:hasStatement ashd:voice-youzi-680 .

ashd:voice-youzi-681 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 知错即改：\"虽然也经常出错，但都能下意识的第一时间认错，所以一波行情下来胜利果实基本都在，运气好的话大盘调整时资金还能不断创新高。" ;
    ash:statementSpeaker "职业炒手" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 7 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "职业炒手 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-15 ash:hasStatement ashd:voice-youzi-681 .

ashd:voice-youzi-682 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "回撤源于心态与判断失误，而非模式：\"所有的回撤幅度过大都是判断出现重大失误造成的，没有什么模式存在固有缺陷，也没有什么模式会让人畅通无阻。" ;
    ash:statementSpeaker "孤独牛背" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 21 ;
    ash:hasSkillTopic ashs:topic-account ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "孤独牛背 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-19 ash:hasStatement ashd:voice-youzi-682 .

ashd:voice-youzi-683 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "体系第一义：悟道=大道无形，不限于某种手法：\"真正的悟道，绝对不是仅仅限制于某种手法的操作……如果要晋级，做到大道无形，买入即是赚钱的点。" ;
    ash:statementSpeaker "92科比" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 19 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "92科比 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-20 ash:hasStatement ashd:voice-youzi-683 .

ashd:voice-youzi-684 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "资金曲线： 1996年5万元入市（1996-1998年A股可透支交易，正是这个机制成就了章建平），先滚到20万，至2000年达3000万；" ;
    ash:statementSpeaker "章建平" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 1 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "章建平 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-42 ash:hasStatement ashd:voice-youzi-684 .

ashd:voice-youzi-685 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "②\"稳定盈利的前提是心态稳定……最好每天自己账户内的股票没有绿盘的，全部红盘收盘，买点必须精心选择，买的时候要确信自己买了当天就能浮盈。" ;
    ash:statementSpeaker "瑞鹤仙" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 15 ;
    ash:hasSkillTopic ashs:topic-account ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "瑞鹤仙 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-04 ash:hasStatement ashd:voice-youzi-685 .

ashd:voice-youzi-686 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "与本档案集《独谷一箭》可对照：两者同属\"客观、少主观、控制亏损\"一脉——独股一箭\"超短必须客观多主观少\"，艾琳\"开仓后只问对错怎么办\"；" ;
    ash:statementSpeaker "艾琳" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 11 ;
    ash:hasSkillTopic ashs:topic-account ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "艾琳 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-25 ash:hasStatement ashd:voice-youzi-686 .

ashd:voice-youzi-687 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "90年代后期与几位短线高手被市场冠名\"宁波涨停板敢死队\"，以银河证券宁波解放南路营业部为核心，成员约20人，核心为徐翔、徐晓、张建斌；" ;
    ash:statementSpeaker "徐翔" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "徐翔 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-17 ash:hasStatement ashd:voice-youzi-687 .

ashd:voice-youzi-688 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "危险信号：板块高位盘整时，龙2/龙3（尤其小盘）突兀拉起、原龙一转为跟随——多为协助板块内资金出局，次日基本低开活埋，追高危险性极大。" ;
    ash:statementSpeaker "龙飞虎" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 9 ;
    ash:hasSkillTopic ashs:topic-one-day ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "龙飞虎 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-24 ash:hasStatement ashd:voice-youzi-688 .

ashd:voice-youzi-689 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "国泰君安成都北一环路——成都帮\"南北环\"之一（与华泰成都南一环并称），\"校长\"领衔的成都帮主阵地：铁索连舟抱团联动、超短首板快进快出。" ;
    ash:statementSpeaker "北一环" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 5 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "北一环 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-41 ash:hasStatement ashd:voice-youzi-689 .

ashd:voice-youzi-690 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "\"敢死队之王\"章建平——96年5万入市、2007年做到近20亿的超级个人大户：调动数亿资金逐步拉升封板的趋势型善庄，游资界大哥级人物。" ;
    ash:statementSpeaker "章建平" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-trend ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "章建平 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-42 ash:hasStatement ashd:voice-youzi-690 .

ashd:voice-youzi-691 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "平仓规则：下午3时至收盘的15分钟内，以所能选择的最佳1分K线平仓（即\"持有到收盘\"，理由：没找到更好的止盈策略，目前最适合自己）。" ;
    ash:statementSpeaker "艾琳" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 12 ;
    ash:hasSkillTopic ashs:topic-technical ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "艾琳 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-25 ash:hasStatement ashd:voice-youzi-691 .

ashd:voice-youzi-692 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "与本档案集《丁一熊》同属\"趋势/空仓休整\"价值观（跌势离场、等强势股出现再进场），但落升有量化触发（乖离率阈值），丁一熊偏经验哲学。" ;
    ash:statementSpeaker "落升" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 12 ;
    ash:hasSkillTopic ashs:topic-trend ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "落升 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-28 ash:hasStatement ashd:voice-youzi-692 .

ashd:voice-youzi-693 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "语料《21、敢死队游资操盘手法大揭秘》将\"敢死队\"名号延续到无锡清扬路一线游资，说明该词已从宁波地域概念演化为超短打板游资的统称。" ;
    ash:statementSpeaker "宁波敢死队" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 11 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "宁波敢死队 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-02 ash:hasStatement ashd:voice-youzi-693 .

ashd:voice-youzi-694 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "对称规律：\"绝大多数股票一轮行情结束，哪里来哪里去\"，因为多数股票只是操纵的工具和符号——所以不要太认真，圆滑、跟随才是生存法宝。" ;
    ash:statementSpeaker "万法归宗" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 14 ;
    ash:hasSkillTopic ashs:topic-regulatory ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "万法归宗 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-13 ash:hasStatement ashd:voice-youzi-694 .

ashd:voice-youzi-695 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "团队属性：依靠大资金优势和超短线操作策略快速套利，绝大部分情况下单兵作战、极少协同作战（另一处记载称其有战队属性、讲究团队作战）。" ;
    ash:statementSpeaker "佛山系" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 13 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "佛山系 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-21 ash:hasStatement ashd:voice-youzi-695 .

ashd:voice-youzi-696 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "先锋入场：10:06兴源环境再封跌停后卖盘仍有22万手（价值1.5亿），佛山先锋2个席位合计买入1亿吃掉绝大部分筹码，跌停板打开；" ;
    ash:statementSpeaker "佛山系" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 14 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-chip ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "佛山系 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-21 ash:hasStatement ashd:voice-youzi-696 .

ashd:voice-youzi-697 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "一切技术信息都体现在价格上，只看六要素：\"我没有什么技术，也从来不看技术，我看的主要看几点：人气，合力，换手，量能，强度，股性。" ;
    ash:statementSpeaker "孤独牛背" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 22 ;
    ash:hasSkillTopic ashs:topic-relay ; ash:hasSkillTopic ashs:topic-technical ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "孤独牛背 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-19 ash:hasStatement ashd:voice-youzi-697 .

ashd:voice-youzi-698 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "语料称其名为\"艾琳歆\"（女性），2010年6月开帖，同年8月开始用一个\"一致化的简单系统\"操作，至2011年6月盈利约200%。" ;
    ash:statementSpeaker "艾琳" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 13 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "艾琳 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-25 ash:hasStatement ashd:voice-youzi-698 .

ashd:voice-youzi-699 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "自述曾在熊市中练打板两年多，\"打过无数烂板，爆亏的次数数不胜数，在无数烂板中学会了打好板\"，熊市打板成功率也能稳定在七成以上。" ;
    ash:statementSpeaker "令胡冲" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 10 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "令胡冲 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-06 ash:hasStatement ashd:voice-youzi-699 .

ashd:voice-youzi-700 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "自选股四层进阶：10-30个按图索骥→放大到500个临盘决策→放大到3000个临盘决策→不滞于物，以盘中感受资金态度决定买卖。" ;
    ash:statementSpeaker "凡倍无名" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 32 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "凡倍无名 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-09 ash:hasStatement ashd:voice-youzi-700 .

ashd:voice-youzi-701 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "悟道=大道无形，不限于某种手法：\"真正的悟道，绝对不是仅仅限制于某种手法的操作……如果要晋级，做到大道无形，买入即是赚钱的点。" ;
    ash:statementSpeaker "92科比" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 20 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "92科比 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-20 ash:hasStatement ashd:voice-youzi-701 .

ashd:voice-youzi-702 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "复利靠稳定模式而非运气：\"小资金做大需要稳定的成功率……靠稳定的模式，靠复利做出来，没有自己的方法，一个亿的资金去做也是韭菜。" ;
    ash:statementSpeaker "92科比" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 21 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "92科比 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-20 ash:hasStatement ashd:voice-youzi-702 .

ashd:voice-youzi-703 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "追涨实战细节：确认逻辑——\"就算你在-2%看好保利地产，你也必须等到+3%买，牺牲5个点作为成本去追求它今天能涨的确定性\"；" ;
    ash:statementSpeaker "乔帮主" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 25 ;
    ash:hasSkillTopic ashs:topic-chip ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "乔帮主 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-07 ash:hasStatement ashd:voice-youzi-703 .

ashd:voice-youzi-704 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "方向对了才谈坚持：\"在努力之前，我们必须保证自己的方向是对的，正确的道路上坚持下去就是胜利，可是错误的道路上停下来就是胜利。" ;
    ash:statementSpeaker "小鳄鱼" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 26 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "小鳄鱼 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-23 ash:hasStatement ashd:voice-youzi-704 .

ashd:voice-youzi-705 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "好机会永远不缺，不抢一时：\"交易的时候，不要急在一时，想好了再下手，匆忙做的决定，往往都是错的，匆忙的交易，也往往都是亏的。" ;
    ash:statementSpeaker "成都帮" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 8 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "成都帮 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-27 ash:hasStatement ashd:voice-youzi-705 .

ashd:voice-youzi-706 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "文中引用了职业炒手的话（短线理念：在强势股里找机会，先理解再印证，小资金短期翻倍是印证，剩下不断复制），可见其身处超短圈子。" ;
    ash:statementSpeaker "榜中榜" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 7 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "榜中榜 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-33 ash:hasStatement ashd:voice-youzi-706 .

ashd:voice-youzi-707 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "擅长排板：这是该席位最大特点——频频出现在新股上市首日秒停的榜单，也经常出现在连续一字板的重组股龙虎榜中（用排单抢一字板）。" ;
    ash:statementSpeaker "割肉荣" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "割肉荣 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-43 ash:hasStatement ashd:voice-youzi-707 .

ashd:voice-youzi-708 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "与佛山系\"一日游超短、次日快速获利出局\"、成都帮\"一日游超短\"同为超短流派，但敢死队更强调主动狙击涨停、借势共振而非潜伏。" ;
    ash:statementSpeaker "宁波敢死队" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 12 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-one-day ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "宁波敢死队 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-02 ash:hasStatement ashd:voice-youzi-708 .

ashd:voice-youzi-709 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 大资金动手前的三重确认：试盘（先锋）→环境（大盘+高低位跷跷板+热点）→发酵（20分钟观察），万无一失才雷霆一击。" ;
    ash:statementSpeaker "佛山系" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 15 ;
    ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "佛山系 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-21 ash:hasStatement ashd:voice-youzi-709 .

ashd:voice-youzi-710 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "\"有时候交易事实就是在赌博，用确定代价赌不确定的利润，谁也不知道明天会怎么走，只不过当致命的风险远离的时候，未来值得一赌。" ;
    ash:statementSpeaker "艾琳" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 14 ;
    ash:hasSkillTopic ashs:topic-risk ; ash:hasSkillTopic ashs:topic-fundamental ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "艾琳 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-25 ash:hasStatement ashd:voice-youzi-710 .

ashd:voice-youzi-711 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "自述历史：2001年上证2245点后连续下跌的弱市中，\"我们创新出适应市场的'涨停敢死队'，能够生存到现在已经是幸运\"；" ;
    ash:statementSpeaker "宁波敢死队" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 13 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "宁波敢死队 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-02 ash:hasStatement ashd:voice-youzi-711 .

ashd:voice-youzi-712 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "对约2000只股票\"看名字就知道代码和基本面情况\"（此处基本面指板块题材、股性、市值区间、亮点是否正宗等，非财务报表）；" ;
    ash:statementSpeaker "令胡冲" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 11 ;
    ash:hasSkillTopic ashs:topic-range ; ash:hasSkillTopic ashs:topic-theme ; ash:hasSkillTopic ashs:topic-fundamental ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "令胡冲 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-06 ash:hasStatement ashd:voice-youzi-712 .

ashd:voice-youzi-713 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "\"后期干脆分两个账户操作，\"全仓还是分仓在于买入标的的确定性有多大，高成功率的标的是很少出现的，每天满仓必然是错误的\"。" ;
    ash:statementSpeaker "退学炒股" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 15 ;
    ash:hasSkillTopic ashs:topic-account ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "退学炒股 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-08 ash:hasStatement ashd:voice-youzi-713 .

ashd:voice-youzi-714 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "辨识度优先，赚记忆的钱：\"看到市场异动，哪有时间看基本面慢慢选股，他们首先想到的，一定是辨识度最高、有赚钱记忆的人气股。" ;
    ash:statementSpeaker "成都帮" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 9 ;
    ash:hasSkillTopic ashs:topic-fundamental ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "成都帮 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-27 ash:hasStatement ashd:voice-youzi-714 .

ashd:voice-youzi-715 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "客观多于主观，临场随机应变：\"超短线必须客观多，主观少，要根据盘面随机应变，临场判断，如果脑子里主观判断太多，必然失败。" ;
    ash:statementSpeaker "独谷一箭" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 6 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "独谷一箭 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-30 ash:hasStatement ashd:voice-youzi-715 .

ashd:voice-youzi-716 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "语料为《榜中榜心法：理解力才是王道》，是其本人（或其圈子）的语录/复盘札记汇编，无履历、席位等事实性信息，语料中未提及。" ;
    ash:statementSpeaker "榜中榜" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 8 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-review ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "榜中榜 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-33 ash:hasStatement ashd:voice-youzi-716 .

ashd:voice-youzi-717 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "市场标签：善良、义庄、格局游资——次日直接砸盘少见，爱加仓、锁仓，\"和气生财，有钱大家赚\"，是次新股连板炒作的风向标；" ;
    ash:statementSpeaker "欢乐海岸" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 39 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-position ; ash:hasSkillTopic ashs:topic-lockup ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "欢乐海岸 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-11 ash:hasStatement ashd:voice-youzi-717 .

ashd:voice-youzi-718 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "风险提示（其本人亲述）：网络开户时代席位可随意更换，曾有小游资专程到欢乐海岸开户冒充，故\"欢乐海岸上榜\"未必都是本尊。" ;
    ash:statementSpeaker "欢乐海岸" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 40 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-risk ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "欢乐海岸 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-11 ash:hasStatement ashd:voice-youzi-718 .

ashd:voice-youzi-719 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 高手三特征（其归纳）：①追确定无疑的涨势、杀明白无误的跌势，行情不确定和跌势时绝对空仓观望，趋势明朗快速进场；" ;
    ash:statementSpeaker "职业炒手" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 8 ;
    ash:hasSkillTopic ashs:topic-trend ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "职业炒手 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-15 ash:hasStatement ashd:voice-youzi-719 .

ashd:voice-youzi-720 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "做大概率的事，趋势是最大的概率：\"如果不能坚持做大概率的事件，失败1万次，那个韭菜还是那个韭菜……趋势就是最大的概率。" ;
    ash:statementSpeaker "万狮虎" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 19 ;
    ash:hasSkillTopic ashs:topic-trend ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "万狮虎 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-16 ash:hasStatement ashd:voice-youzi-720 .

ashd:voice-youzi-721 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "\"题材的力度不是YY出来的：大力的题材必定匹配大力的赚钱效应，当你认为题材很大但赚钱效应马马虎虎的时候，你就要谨慎了。" ;
    ash:statementSpeaker "万狮虎" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 20 ;
    ash:hasSkillTopic ashs:topic-emotion ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "万狮虎 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-16 ash:hasStatement ashd:voice-youzi-721 .

ashd:voice-youzi-722 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "一切为确定性服务，打板与做核心是两大确定性工具：\"确定性(效率)：好行情不打板太容易错失机会，烂行情不打板太容易犯错。" ;
    ash:statementSpeaker "涅盘重升" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 24 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "涅盘重升 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-26 ash:hasStatement ashd:voice-youzi-722 .

ashd:voice-youzi-723 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "\"游资追求的是短期暴利，其操作风格往往较为凶狠、彪悍，从吸筹、拉升到出货整个过程干脆利落、周期短……简称'暴力拉升'。" ;
    ash:statementSpeaker "一花残忆" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;
    ash:hasSkillTopic ashs:topic-emotion ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "一花残忆 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-37 ash:hasStatement ashd:voice-youzi-723 .

ashd:voice-youzi-724 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "出击时机必须把握\"大盘否极泰来的临界点\"，借大盘的势：\"睁大眼睛，等待最强的那只股票出现，然后闭着眼睛进入就可以了。" ;
    ash:statementSpeaker "Asking" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 18 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "Asking · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-10 ash:hasStatement ashd:voice-youzi-724 .

ashd:voice-youzi-725 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "新仓买进条件升高一个档次，同时降低买进仓位（其后1.2/1.3同上：新仓走弱加速了结老仓、不良信号无条件了结老仓）。" ;
    ash:statementSpeaker "龙飞虎" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 10 ;
    ash:hasSkillTopic ashs:topic-position ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "龙飞虎 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-24 ash:hasStatement ashd:voice-youzi-725 .

ashd:voice-youzi-726 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "杭州中信建投庆春路系营业部游资，人称\"善庄庆春路\"——不似凶悍一日游资，操作相对温柔，擅长争夺一板并深度炒作题材股。" ;
    ash:statementSpeaker "庆春路" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 4 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-one-day ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "庆春路 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-35 ash:hasStatement ashd:voice-youzi-726 .

ashd:voice-youzi-727 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "随后利空再出、股价跌至20元（市场一致认为只值10-15元），股价从20元起一个多月翻倍，泽熙35元上方获利了结；" ;
    ash:statementSpeaker "徐翔" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 4 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "徐翔 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-17 ash:hasStatement ashd:voice-youzi-727 .

ashd:voice-youzi-728 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 总方针：\"经常空（轻）仓，节奏不对空仓，大亏空仓，大赚空仓，拿不准空仓，有事空仓，睡过头空仓，思淫欲空仓。" ;
    ash:statementSpeaker "孤独牛背" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 23 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "孤独牛背 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-19 ash:hasStatement ashd:voice-youzi-728 .

ashd:voice-youzi-729 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 职业门槛：\"亏钱不影响生活就可以职业，10万资金不适合职业，容易养活不了自己，50万职业也是很有挑战性的。" ;
    ash:statementSpeaker "92科比" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 22 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "92科比 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-20 ash:hasStatement ashd:voice-youzi-729 .

ashd:voice-youzi-730 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "靠别人赚的钱终要还回市场：\"做股票想真正赚到钱要靠自己，如果靠别人推荐跟风赚的钱其实并不属于你，最终还要还回市场！" ;
    ash:statementSpeaker "独谷一箭" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 7 ;
    ash:hasSkillTopic ashs:topic-leader ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "独谷一箭 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-30 ash:hasStatement ashd:voice-youzi-730 .

ashd:voice-youzi-731 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "资金战绩：2012年9月28日-11月5日约一个月零一周从86.5万做到155万（盈利79.1%，百万级账户）；" ;
    ash:statementSpeaker "瑞鹤仙" ;
    ash:statementType "observation" ;
