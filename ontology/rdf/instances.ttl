@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ashd:bond-demo a owl:NamedIndividual,
        ash:GovernmentBond ;
    rdfs:label "示例 30 年国债"@zh ;
    ash:bondCode "019000" ;
    ash:couponRate 2.45 ;
    ash:hasBondRating ashd:bond-rating-demo ;
    ash:isExample true ;
    ash:listedOn ashd:exchange-sse ;
    ash:maturityDate "2052-06-30"^^xsd:date ;
    ash:securityCode "019000" ;
    ash:securityName "示例 30 年国债" ;
    ash:tradesOn ashd:segment-main ;
    ash:tradingStatus "normal" ;
    ash:yieldToMaturity 2.62 .

ashd:cb-demo a owl:NamedIndividual,
        ash:ConvertibleBond ;
    rdfs:label "华辰转债（示例）"@zh ;
    ash:bondCode "110000" ;
    ash:conversionPremium 34.0 ;
    ash:couponRate 0.50 ;
    ash:hasBondRating ashd:bond-rating-demo ;
    ash:isExample true ;
    ash:listedOn ashd:exchange-sse ;
    ash:maturityDate "2031-06-30"^^xsd:date ;
    ash:securityCode "110000" ;
    ash:securityName "华辰转债" ;
    ash:tradesOn ashd:segment-main ;
    ash:tradingStatus "normal" ;
    ash:underlyingAsset ashd:sec-huachen-a .

ashd:event-huachen-buyback a owl:NamedIndividual,
        ash:ShareRepurchase ;
    rdfs:label "华辰智造股份回购（示例）"@zh ;
    ash:dataAsOf "2026-09-30"^^xsd:date ;
    ash:eventOf ashd:company-huachen ;
    ash:isExample true ;
    ash:repurchaseAmount 200000000 .

ashd:exchange-bse a owl:NamedIndividual,
        ash:Exchange ;
    rdfs:label "Beijing Stock Exchange"@en,
        "北京证券交易所"@zh ;
    rdfs:comment "示例中的北交所市场结构实例。"@zh ;
    ash:exampleNote "合成示例，不代表真实交易所数据。"@zh ;
    ash:exchangeCode "BSE" ;
    ash:isExample true .

ashd:fund-csi300etf-flow a owl:NamedIndividual,
        ash:FundFlow ;
    rdfs:label "华辰沪深 300ETF 2026-10 资金流"@zh ;
    ash:flowAmount -210000000 ;
    ash:flowPeriod "2026-10"^^xsd:gYearMonth ;
    ash:isExample true ;
    ash:netFlowPct -1.7 .

ashd:fund-demo a owl:NamedIndividual,
        ash:Fund ;
    rdfs:label "华辰沪深 300ETF 联接（示例）"@zh ;
    ash:fundCode "F0001" ;
    ash:fundType "ETF" ;
    ash:hasFundFee ashd:fund-fee-demo ;
    ash:hasFundFlow ashd:fund-flow-demo ;
    ash:hasFundManager ashd:fund-manager-demo ;
    ash:hasFundShare ashd:fund-csi300etf ;
    ash:isExample true ;
    ash:managedBy ashd:fund-company-demo ;
    ash:netFlowPct -6.2 .

ashd:future-csi300 a owl:NamedIndividual,
        ash:IndexFuture ;
    rdfs:label "沪深 300 股指期货 IF2612"@zh ;
    ash:contractCode "IF2612" ;
    ash:expiryDate "2026-12-18"^^xsd:date ;
    ash:hasContractSpec ashd:spec-if ;
    ash:hasMarginRequirement ashd:margin-if ;
    ash:isExample true ;
    ash:multiplier 300 ;
    ash:underlyingAsset ashd:index-csi300 .

ashd:macro-cpi-2026-09 a owl:NamedIndividual,
        ash:MacroIndicator ;
    rdfs:label "CPI year-on-year"@en,
        "居民消费价格指数同比"@zh ;
