    ash:isExample true .
ashd:skill-youzi-04 ash:hasStatement ashd:voice-youzi-346 .

ashd:voice-youzi-347 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "Asking（邱宝裕）：两人对龙头的理解\"如出一辙\"，都背过只铁《短线英雄》而方法自成体系，\"这种龙头捕捉方法必然是经过次数极多的实盘并提炼才最后形成相对固定的操作模式\"；" ;
    ash:statementSpeaker "职业炒手" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;
    ash:hasSkillTopic ashs:topic-leader ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "职业炒手 · 原话摘录"@zh ;
