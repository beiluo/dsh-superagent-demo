ashd:voice-youzi-147 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "影响因素：总龙头/板块龙头/涨停时间/卡位/主流板块/情绪周期/启动正溢价退潮负溢价/指数/尾盘跳水反转/消息面利空利好/股性/流通盘/图形筹码/封板时间次数封单/分时/买入席位；" ;
