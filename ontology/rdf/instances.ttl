ashd:voice-youzi-046 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "A. 向\"左\"看齐卖出：大盘来到前期重要高点附近时，应该空仓（为避免踏空，等跌到颈线附近重新入场）。" ;
    ash:statementSpeaker "落升" ;
