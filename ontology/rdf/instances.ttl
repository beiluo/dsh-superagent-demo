    ash:isExample true .
ashd:skill-youzi-26 ash:hasStatement ashd:voice-youzi-352 .

ashd:voice-youzi-353 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "③午后偷袭板——下午盘拉升，尤其叠加次新、接近创历史新高的次新股（\"下午盘拉升的次新，十有八九都有乔帮主的身影\"，华森制药、泰禾集团均为主升第一天买入）；" ;
    ash:statementSpeaker "乔帮主" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 11 ;
    ash:hasSkillTopic ashs:topic-trend ;
