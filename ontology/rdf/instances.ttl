ashd:voice-youzi-414 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "\"7月股灾回撤100万后，8月\"有意放弃了尾端行情……主动回避，放弃小利润，躲过了大风险\"。" ;
    ash:statementSpeaker "令胡冲" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;
    ash:hasSkillTopic ashs:topic-account ; ash:hasSkillTopic ashs:topic-risk ; ash:hasSkillTopic ashs:topic-fundamental ;
