    rdfs:label "乔帮主 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-07 ash:hasStatement ashd:voice-youzi-353 .

ashd:voice-youzi-354 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "孤独牛背演讲提及：\"市场上做首板的资金很多，比如佛山，校长，还有成都一大批的资金，都是爱做首板……他们绝对不会去扫的，大资金的谨慎程度肯定比我们小资金高。" ;
    ash:statementSpeaker "佛山系" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 6 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "佛山系 · 原话摘录"@zh ;
    ash:isExample true .
