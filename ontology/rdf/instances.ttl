    ash:dataAsOf "2026-10-15"^^xsd:date ;
    ash:indicatorCode "CPI" ;
    ash:indicatorPeriod "2026-09"^^xsd:gYearMonth ;
    ash:indicatorUnit "%" ;
    ash:indicatorValue 0.40 ;
    ash:isExample true .

ashd:margin-demo a owl:NamedIndividual,
        ash:MarginBalance ;
    rdfs:label "两融余额（示例）"@zh ;
    ash:dataAsOf "2026-11-02"^^xsd:date ;
    ash:isExample true ;
    ash:marginBalance 1620000000000 ;
    ash:marginChangePct 2.4 .

ashd:northbound-demo a owl:NamedIndividual,
        ash:NorthboundFlow ;
    rdfs:label "北向资金净流入（示例）"@zh ;
    ash:capitalFlowNet 1260000000 ;
    ash:dataAsOf "2026-11-02"^^xsd:date ;
    ash:isExample true ;
    ash:northboundNetBuy 1260000000 .

ashd:principle-auction a owl:NamedIndividual,
        ash:PlaybookPrinciple ;
    rdfs:label "竞价预期差原则"@zh ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    ash:isExample true ;
    ash:principleCategory "竞价" ;
    ash:principleText "竞价先形成预期，再用实际开盘与量能验证；预期差决定是跟随、放弃还是反向。" .

ashd:principle-buy1 a owl:NamedIndividual,
        ash:PlaybookPrinciple ;
    rdfs:label "买一卖一原则"@zh ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    ash:isExample true ;
    ash:principleCategory "龙虎榜" ;
    ash:principleText "龙虎榜买一资金应显著大于卖一；买一独大、买二买三差距过大时要防抛压。" .

ashd:principle-drawdown a owl:NamedIndividual,
        ash:PlaybookPrinciple ;
    rdfs:label "回撤控制原则"@zh ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    ash:isExample true ;
    ash:principleCategory "风控" ;
    ash:principleText "账户回撤超过 10% 时先降仓和复盘，不用加仓或换手法来掩盖交易系统问题。" .

ashd:principle-emotion a owl:NamedIndividual,
        ash:PlaybookPrinciple ;
    rdfs:label "情绪周期优先原则"@zh ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    ash:isExample true ;
    ash:principleCategory "情绪周期" ;
    ash:principleText "先判断情绪周期阶段，再决定仓位和手法；高潮后期与冰点期的风险收益完全不同。" .

ashd:principle-volume a owl:NamedIndividual,
        ash:PlaybookPrinciple ;
    rdfs:label "放量换手原则"@zh ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    ash:isExample true ;
    ash:principleCategory "打板" ;
    ash:principleText "放量换手板让短线筹码充分交换，成本更接近涨停价；缩量板浮盈集中，次日砸盘风险更高。" .

ashd:segment-bse a owl:NamedIndividual,
        ash:MarketSegment ;
    rdfs:label "Beijing Stock Exchange Board"@en,
        "北交所"@zh ;
    rdfs:comment "北京证券交易所板块。"@zh ;
    ash:isExample true .

ashd:strategy-value ash:hasExitRule ashd:exit-rule-demo ;
    ash:hasPositionSizing ashd:position-sizing-demo .

<https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdf> a owl:Ontology ;
    dcterms:conformsTo <https://www.w3.org/TR/rdf11-concepts/>,
        <https://www.w3.org/TR/turtle/> ;
    dcterms:description "Synthetic RDF individuals for companies, securities, reports, quotes, valuations, decisions and portfolios."@en,
        "用于公司、证券、财报、行情、估值、决策与组合的合成 RDF 实例。"@zh ;
    dcterms:source "Synthetic example data generated for this ontology design."@en ;
    dcterms:title "A-Share Investment Decision Ontology — RDF instance graph"@en,
        "A 股投资决策本体 — RDF 实例层"@zh ;
    owl:versionInfo "1.11.0" .

ashd:approval-demo a owl:NamedIndividual,
        ash:Approval ;
    rdfs:label "华辰智造决策人工审批"@zh ;
    ash:approvalStatus "PENDING" ;
    ash:approvedBy ashd:party-compliance ;
    ash:approves ashd:decision-huachen-2026q4 ;
    ash:isExample true .

