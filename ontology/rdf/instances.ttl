ashd:voice-youzi-415 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 仓位管理=认清市场资金容量：一只股容纳约200万级短线资金、一个模式约1000万级；" ;
    ash:statementSpeaker "凡倍无名" ;
    ash:statementType "tactic" ;
