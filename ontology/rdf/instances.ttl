    ash:statementText "语料主体为2003-2005年前后流传的《宁波高手》系列\"内部资料\"（曙光工作室编，共三册：《盘中选股雷达狙击手》《敢死队选股秘诀》《十八般武艺》），记录的正是宁波涨停敢死队鼎盛期的打法。" ;
    ash:statementSpeaker "宁波敢死队" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 9 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "宁波敢死队 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-02 ash:hasStatement ashd:voice-youzi-652 .

ashd:voice-youzi-653 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "参与方式二（打反抽板确认，作者本人更爱）：打龙回头正式启动的反抽板，收益有限但确定性高，\"妖股涨停很少坑人，第二天即便低开也多数会有冲高\"（九鼎新材9.17尾盘烂板，次日照样冲高8个点）。" ;
    ash:statementSpeaker "欢乐海岸" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 37 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-account ; ash:hasSkillTopic ashs:topic-one-day ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "欢乐海岸 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-11 ash:hasStatement ashd:voice-youzi-653 .

ashd:voice-youzi-654 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "股池个股均标注两要素：多题材叠加 + \"攀升上扬式\"技术形态（OCR原文各异：\"举升上扬式\"\"率升上拓式\"\"升上张式\"\"攀升上损式\"，应为同一形态名\"攀升上扬式\"）+ \"三仙归一\"标记。" ;
    ash:statementSpeaker "章盟主" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-theme ; ash:hasSkillTopic ashs:topic-technical ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "章盟主 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-12 ash:hasStatement ashd:voice-youzi-654 .

ashd:voice-youzi-655 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "自由模式论：\"我不认为我的操作就是打板模式，只是打板在我的操作中占比偏高……我的操作更偏向于自由模式，我个性上不喜欢被束缚\"，自比\"游走江湖的混混，没有门派，出招混乱，无招胜有招\"；" ;
    ash:statementSpeaker "令胡冲" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 7 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "令胡冲 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-06 ash:hasStatement ashd:voice-youzi-655 .

ashd:voice-youzi-656 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "上榜记录均为\"日涨幅偏离值达7%\"\"连续三个交易日内涨幅偏离值累计达20%\"类（阳光电源、九有股份等），单笔买入常在数百万至七千万级（2018-11-06阳光电源买入7371万）。" ;
    ash:statementSpeaker "打板祖师爷" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "打板祖师爷 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-45 ash:hasStatement ashd:voice-youzi-656 .

ashd:voice-youzi-657 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "盘中识别标志（独家）：喜欢利用资金优势形成连排固定交易型筹码数字，如N个215、N个156等数字建仓锁筹——今后盘口若发现连续固定交易型筹码数字，大概率就是上海超短帮。" ;
    ash:statementSpeaker "上海超帮" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 1 ;
    ash:hasSkillTopic ashs:topic-chip ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "上海超帮 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-46 ash:hasStatement ashd:voice-youzi-657 .

ashd:voice-youzi-658 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "打板三要素（按重要程度排序）：第一，市场氛围——\"如果跌幅榜上躺着众多跌停或大跌5%以上的个股，大环境不好，不轻易出手，尽量等尾盘，且要对明日的炒作方向有初步预期\"；" ;
    ash:statementSpeaker "令胡冲" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 8 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-auction ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "令胡冲 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-06 ash:hasStatement ashd:voice-youzi-658 .

ashd:voice-youzi-659 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "用仓位和策略保持主动性：2014年自述心得十词——\"大局观、看指数、看热点、看主流、看个股、看盘口、节奏感、心态、买点的舒适感、通过仓位和交易策略来保持交易的主动性。" ;
    ash:statementSpeaker "小鳄鱼" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 25 ;
    ash:hasSkillTopic ashs:topic-position ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "小鳄鱼 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-23 ash:hasStatement ashd:voice-youzi-659 .

ashd:voice-youzi-660 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "你涨一倍，我涨60%，他涨30%，呈现级差递减规律\"\"十个灶头，5把柴，只能烧开1、2个，烧热3、4个，烧温5、6个\"——熊市钱不足，别指望低位补涨股跟上前排涨幅。" ;
    ash:statementSpeaker "明王" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 14 ;
    ash:hasSkillTopic ashs:topic-leader ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "明王 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-22 ash:hasStatement ashd:voice-youzi-660 .

ashd:voice-youzi-661 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "2009年6月2日起以50万资金实盘，交割单全部公开，用2年时间做到800万： 2009/06/11—2009/11/03（5个月）：50万第一次翻倍至200万；" ;
    ash:statementSpeaker "龙飞虎" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 8 ;
    ash:hasSkillTopic ashs:topic-review ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "龙飞虎 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-24 ash:hasStatement ashd:voice-youzi-661 .

ashd:voice-youzi-662 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "国信证券深圳泰然九路——号称全国规模最大证券营业部（深圳40万客户、管理资产超600亿），客户众多资金分散、团队各自为战的\"散户集散式\"游资席位，操作以稳健为主。" ;
    ash:statementSpeaker "泰然九路" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "泰然九路 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-34 ash:hasStatement ashd:voice-youzi-662 .

ashd:voice-youzi-663 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "第三方观察：看龙虎榜应学\"最强游资的买卖思路\"，而非用上榜席位预测次日涨跌——\"次日走势大多跟前一日的席位关联性不大，超短强势股是由市场合力形成，并非独庄股\"。" ;
    ash:statementSpeaker "赵老哥" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 21 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-one-day ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "赵老哥 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-05 ash:hasStatement ashd:voice-youzi-663 .

ashd:voice-youzi-664 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "【理念检索】 判断用户处境（亏损焦虑 / 回撤失控 / 频繁交易 / 追涨杀跌 / 方向迷茫），从下方\"心法体系\"\"经典语录库\"中找出最相关的 1-3 条原文。" ;
    ash:statementSpeaker "凡倍无名" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 31 ;
    ash:hasSkillTopic ashs:topic-account ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "凡倍无名 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-09 ash:hasStatement ashd:voice-youzi-664 .

ashd:voice-youzi-665 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "语料合集中并列的杨永兴（持股不超2小时）、炒股养家、龙飞虎（换手决定高度）、落升（势/热点/波段）等为同一时代被后人整理的短线高手，常与Asking互相印证。" ;
    ash:statementSpeaker "Asking" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 15 ;
    ash:hasSkillTopic ashs:topic-relay ; ash:hasSkillTopic ashs:topic-trend ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "Asking · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-10 ash:hasStatement ashd:voice-youzi-665 .

ashd:voice-youzi-666 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "合力论与反庄股思维：\"现在不是庄股市场，今天的多头或许就是明天的空头\"\"涨停封不封死于我来说都是无所谓的……在我眼中，只有市场与我，市场的价格包含所有信息。" ;
    ash:statementSpeaker "令胡冲" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 9 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "令胡冲 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-06 ash:hasStatement ashd:voice-youzi-666 .

ashd:voice-youzi-667 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "核心战绩逻辑：\"涨停板敢死队通过短线不断兑现利润，将每次的'小利'叠成'厚利'，将无数匹小黑马'组装'成一匹大黑马\"，在盘整市和弱市中创造了新的盈利模式。" ;
    ash:statementSpeaker "宁波敢死队" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 10 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-one-day ; ash:hasSkillTopic ashs:topic-fundamental ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "宁波敢死队 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-02 ash:hasStatement ashd:voice-youzi-667 .

ashd:voice-youzi-668 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "唯一可靠的是一致性规则，它让你站上概率的大数一侧：\"未来的行情谁也无法预测，你唯一用到的东西就是规则，一致性的交易规则，它让你站在这场概率游戏的大数一侧。" ;
    ash:statementSpeaker "艾琳" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 10 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "艾琳 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-25 ash:hasStatement ashd:voice-youzi-668 .

ashd:voice-youzi-669 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "入场前的预期设定：介入前必须有合理预期（靠回溯过往类似情况形成期望值），以此为锚，对走势做超预期/符合预期/低于预期三档评价，再决定加仓/持股/离场；" ;
    ash:statementSpeaker "万狮虎" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 18 ;
    ash:hasSkillTopic ashs:topic-auction ; ash:hasSkillTopic ashs:topic-position ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "万狮虎 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-16 ash:hasStatement ashd:voice-youzi-669 .

ashd:voice-youzi-670 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "不轻言底部，只做超跌抢反弹：\"在贪婪者的眼里，下跌途中的每一根大阳线都是底部的信号，而在高手眼中，下跌途中的每一根大阳线都仅是下跌途中的普通反弹而已。" ;
    ash:statementSpeaker "落升" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 11 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "落升 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-28 ash:hasStatement ashd:voice-youzi-670 .

ashd:voice-youzi-671 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "5.19行情（1999）后专职超短，自述\"5.19到2006.7.23，资金从10几万到几千万，成交量从两三百万到七八个亿\"，豪宅名车尽从股市中来。" ;
    ash:statementSpeaker "Asking" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 16 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "Asking · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-10 ash:hasStatement ashd:voice-youzi-671 .

ashd:voice-youzi-672 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "与超短游资的分流：自认\"不适应市场的超短，只做大波段\"，并明确区分两种概念——\"短线高手每天都有机会，跟随属于趋势型，没有大的机会是不会进场的\"；" ;
    ash:statementSpeaker "万法归宗" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 11 ;
    ash:hasSkillTopic ashs:topic-trend ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "万法归宗 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-13 ash:hasStatement ashd:voice-youzi-672 .

ashd:voice-youzi-673 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "2019年发表《A股题材炒作的本质》，自述\"我们并不是主力，只是市场的一个跟随者\"，并点破当年最热的大牛股东方通信本质是庄股，自己只是跟庄吃肉。" ;
    ash:statementSpeaker "赵老哥" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 22 ;
    ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "赵老哥 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-05 ash:hasStatement ashd:voice-youzi-673 .

ashd:voice-youzi-674 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "中国第一代超短传奇、\"游资超短旗手\"，以\"等待、发现、跟随\"三字诀和\"只做超强势股的追涨与守株待兔\"开宗立派，从高利贷10万做到个人资本十亿级。" ;
    ash:statementSpeaker "Asking" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 17 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "Asking · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-10 ash:hasStatement ashd:voice-youzi-674 .

ashd:voice-youzi-675 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "中信证券上海古北路——身披孙氏父子、赵老哥分身等诸多传说的上海滩游资新贵：次新+热点题材强势股双线作战，一板到四板都做，高位大砸即题材见顶信号。" ;
    ash:statementSpeaker "古北路" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 6 ;
    ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "古北路 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-38 ash:hasStatement ashd:voice-youzi-675 .

ashd:voice-youzi-676 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "兴源环境是超跌反弹第一股，第二个被资金选中的必然是10个跌停的盛运环保（跌停板卖盘8个亿，只有广州甘化的筹码量能与之匹敌）——故主攻盛运环保；" ;
    ash:statementSpeaker "佛山系" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 12 ;
    ash:hasSkillTopic ashs:topic-chip ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "佛山系 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-21 ash:hasStatement ashd:voice-youzi-676 .

ashd:voice-youzi-677 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "路径：找到有价值的股票的短线机会，参与价值股的主升浪——\"这才是投资和投机技术的完美结合\"，且无论T+0还是国际化都有效、利润/时间最大化。" ;
    ash:statementSpeaker "瑞鹤仙" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 14 ;
    ash:hasSkillTopic ashs:topic-trend ; ash:hasSkillTopic ashs:topic-fundamental ; ash:hasSkillTopic ashs:topic-technical ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "瑞鹤仙 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-04 ash:hasStatement ashd:voice-youzi-677 .

ashd:voice-youzi-678 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "上榜记录（语料所附历史数据）：2018年10月12日至18日连续上榜深天地A、新疆浩源、盈方微、高争民爆等多只涨停股（当日涨幅均约10%）。" ;
    ash:statementSpeaker "欢乐海岸" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 38 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-board ;
