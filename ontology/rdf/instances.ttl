    ash:isExample true .
ashd:skill-youzi-16 ash:hasStatement ashd:voice-youzi-216 .

ashd:voice-youzi-217 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "耐心等待试盘确认：\"即使是佛山，坐拥上亿的资金，对市场依然保持十分的敬畏，先锋出击之后，足足等了20分钟，当市场情绪充分发酵以后，才将中军压上。" ;
    ash:statementSpeaker "佛山系" ;
    ash:statementType "observation" ;
