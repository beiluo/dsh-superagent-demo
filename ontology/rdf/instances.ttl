    ash:isExample true .
ashd:skill-youzi-30 ash:hasStatement ashd:voice-youzi-027 .

ashd:voice-youzi-028 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "做无人竞争的冷门低吸洼地：\"选股标的，一般是目标个股往往当天没有重大题材利好，也就是我们复盘时候无法正常归类的个股行情，这点在弱势或者消息匮乏的市场上优势明显。" ;
    ash:statementSpeaker "佛山系" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-low-buy ; ash:hasSkillTopic ashs:topic-review ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "佛山系 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-21 ash:hasStatement ashd:voice-youzi-028 .

ashd:voice-youzi-029 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "价值股主升浪滚动操作（其2012年word文档核心，自称\"滚动操作的升级版，主升浪非加速通道专用\"）：低吸重仓（60万以上）、高抛轻仓（30万），滚动推进；" ;
    ash:statementSpeaker "瑞鹤仙" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-low-buy ; ash:hasSkillTopic ashs:topic-trend ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "瑞鹤仙 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-04 ash:hasStatement ashd:voice-youzi-029 .

ashd:voice-youzi-030 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "吞吴破秦的对手盘理论（庄股、国家队、一字换手买一独大、龙头加速独食、弱势缩量板、情绪转折后反向加速为六类对手盘强大情形，规避之可避免80%以上大幅回撤）。" ;
    ash:statementSpeaker "孤独牛背" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-relay ; ash:hasSkillTopic ashs:topic-leader ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "孤独牛背 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-19 ash:hasStatement ashd:voice-youzi-030 .

ashd:voice-youzi-031 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "大题材（创投式：次日10多个一字、多股封单超自身流通盘）→\"能买到哪个直接买就好\"，竞价开得最高、板块内流通盘最小价格最低、稍有特色的直接干，不要犹豫。" ;
    ash:statementSpeaker "欢乐海岸" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 1 ;
    ash:hasSkillTopic ashs:topic-auction ; ash:hasSkillTopic ashs:topic-one-day ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "欢乐海岸 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-11 ash:hasStatement ashd:voice-youzi-031 .

ashd:voice-youzi-032 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "控制回撤篇同篇其他高手观点可作对照（非孤独牛背本人观点）：打板赚盒饭的仓位三等分法与\"大赚10个点以上强制降到3成以下\"、\"28（二八）分化仓位表\"；" ;
    ash:statementSpeaker "孤独牛背" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 4 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-account ; ash:hasSkillTopic ashs:topic-position ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "孤独牛背 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-19 ash:hasStatement ashd:voice-youzi-032 .

ashd:voice-youzi-033 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "广发证券辽阳民主路——传说中东北猛男（赵庚禹）的席位，\"不要怂就是干\"的敢死队猎人：激进接力、重仓打加速临界点、锁仓拿到最后，今天吃大面明天照样干。" ;
    ash:statementSpeaker "东北猛男" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 1 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-relay ; ash:hasSkillTopic ashs:topic-lockup ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "东北猛男 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-50 ash:hasStatement ashd:voice-youzi-033 .

ashd:voice-youzi-034 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "超短体系化教学者、《超短百科全书》作者，用\"低吸、追涨、打板三类筹码接力轮回\"统一解释股价运行的全能型超短作手，自述以半路（追涨）为主模式。" ;
    ash:statementSpeaker "凡倍无名" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-low-buy ; ash:hasSkillTopic ashs:topic-relay ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "凡倍无名 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-09 ash:hasStatement ashd:voice-youzi-034 .

ashd:voice-youzi-035 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "龙虎榜应用提示（语料转述）：与其同席共存的打板资金次日有底仓利润跑得快，\"打板如果遇上了这个低吸的席位，考虑如何脱身比考虑赚多少更重要\"。" ;
    ash:statementSpeaker "乔帮主" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 5 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-low-buy ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "乔帮主 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-07 ash:hasStatement ashd:voice-youzi-035 .

ashd:voice-youzi-036 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "由于该营业部客户众多，资金较为分散，经常出现在新股的卖出席位上，而一般买入席位也很少超过千万手笔，该营业部团队应该都是各自为战。" ;
    ash:statementSpeaker "泰然九路" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 1 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-risk ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "泰然九路 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-34 ash:hasStatement ashd:voice-youzi-036 .

ashd:voice-youzi-037 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "个股必须结合大盘：\"重个股、轻指数这个观念是绝对错误的——如果你不能正确预测大盘，你就不能提前于别人买入，最终被大盘牵着鼻子走。" ;
    ash:statementSpeaker "瑞鹤仙" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "瑞鹤仙 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-04 ash:hasStatement ashd:voice-youzi-037 .

ashd:voice-youzi-038 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "以\"理解力才是王道\"为标签的一线游资心法辑录——不打固定模式，围绕\"热点中的热点\"做题材接力，把市场情绪与题材真伪置于技术之前。" ;
    ash:statementSpeaker "榜中榜" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-relay ; ash:hasSkillTopic ashs:topic-emotion ; ash:hasSkillTopic ashs:topic-lockup ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "榜中榜 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-33 ash:hasStatement ashd:voice-youzi-038 .

ashd:voice-youzi-039 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "与本档案集《歌神》对照：温州帮是坐庄控盘流（对倒拉板、砸盘收割），歌神是打板接力流（首板买入、凌厉锁仓），两者资金性格相反。" ;
    ash:statementSpeaker "温州帮" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-relay ; ash:hasSkillTopic ashs:topic-lockup ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "温州帮 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-31 ash:hasStatement ashd:voice-youzi-039 .

ashd:voice-youzi-040 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "妖股必须10点前在板上换手）→妖股见顶（人气崩溃分时：一致看多转一致看空、心电图式巨幅波动、从涨停板直线掉落10%+）。" ;
    ash:statementSpeaker "凡倍无名" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-relay ; ash:hasSkillTopic ashs:topic-technical ;
