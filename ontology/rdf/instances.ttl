ashd:voice-youzi-113 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "龙头的涨停从来是大阳线而非小气的涨停开盘式，\"有足够的心胸让所有跟它的人赚钱\"。" ;
    ash:statementSpeaker "Asking" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
