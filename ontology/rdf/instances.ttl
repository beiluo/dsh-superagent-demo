ashd:voice-youzi-413 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "邱宝格(Asking)：兴业陕西湖东路，网名Aking/\"A神\"，龙头起家资产十亿转型一级。" ;
    ash:statementSpeaker "游资通用方法论" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
