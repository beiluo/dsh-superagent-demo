ashd:voice-youzi-048 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "打板的目的论：\"打板也好，低吸也好，追涨也好，目的就是要做到龙头个股，而不是简单的打板套利。" ;
    ash:statementSpeaker "赵老哥" ;
