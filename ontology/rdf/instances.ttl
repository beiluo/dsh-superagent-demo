ashd:voice-youzi-055 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "打板3种方法：扫板(快涨停直接买)、排板(已涨停排队)、回封板(炸板后回封时买)。" ;
    ash:statementSpeaker "游资通用方法论" ;
