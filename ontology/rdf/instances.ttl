ashd:report-huachen-2025 a owl:NamedIndividual, ash:AnnualReport ;
    ash:reportsOn ashd:company-huachen ;
    ash:reportPeriod "2025"^^xsd:gYear ;
    ash:fiscalYearEnd "2025-12-31"^^xsd:date ;
    ash:revenue 18600000000 ;
    ash:netProfit 2340000000 ;
    ash:roe 18.2 ;
    ash:roa 9.4 ;
    ash:debtRatio 46.8 ;
    ash:interestCoverage 8.4 ;
    ash:operatingCashFlow 2900000000 ;
    ash:revenueGrowth 21.5 ;
    ash:profitGrowth 24.8 ;
    ash:eps 1.82 ;
    ash:dataAsOf "2025-12-31"^^xsd:date ;
    ash:dataSource "合成年度报告（示例）" ;
    ash:dataQualityFlag "illustrative" ;
    rdfs:label "华辰智造 2025 年年报"@zh, "Huachen 2025 Annual Report"@en ;
