ashd:voice-youzi-172 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "超短的核心是连板、主线、人气与顺势：\"超短的核心：连板、主线、超人气龙头主线，及重磅消息个股，顺势而为。" ;
    ash:statementSpeaker "小鳄鱼" ;
