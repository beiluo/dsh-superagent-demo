ashd:voice-youzi-356 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "自述深入研究的对象只有两人：A神（启发在选股与控制力）与炒股养家（启发在对情绪与周期的理解，称\"如果说A神给了一个方向，那养家大师就是给了一条路\"）。" ;
    ash:statementSpeaker "万狮虎" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 10 ;
    ash:hasSkillTopic ashs:topic-emotion ;
