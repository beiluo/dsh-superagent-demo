ashd:voice-youzi-344 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "交易明细示例：2018-04-18科蓝软件、2018-05-03安洁科技卖出906.90万、2018-07-11盛运环保买入358万、2018-07-17 *ST百特等——进出兼有，卖方动作也不少。" ;
    ash:statementSpeaker "北大街" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
