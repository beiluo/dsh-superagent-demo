    ash:isExample true .
ashd:skill-youzi-01 ash:hasStatement ashd:voice-youzi-013 .

ashd:voice-youzi-014 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "融资铁律：\"融资资金是不能补仓买入的\"\"当你决定要融资买入一个股票的时候，必须有100%的把握，99%都不行，否则宁可等待。" ;
    ash:statementSpeaker "瑞鹤仙" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 1 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "瑞鹤仙 · 原话摘录"@zh ;
    ash:isExample true .
