ashd:voice-youzi-112 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "逆向思维、独立思考：市场观点高度一致时拐点将至，最热门时警惕、涨停满屏时心生寒意。" ;
    ash:statementSpeaker "徐翔" ;
    ash:statementType "observation" ;
