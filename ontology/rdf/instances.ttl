ashd:voice-youzi-168 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "阴线反包（首阴战法）：做中期题材妖股龙头的首阴（多为假阴，即收盘高于昨日收盘价的阴线），统计胜率可达85%以上；" ;
