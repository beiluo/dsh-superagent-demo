ashd:voice-youzi-418 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "\"打得赢就打，打不赢就跑，严格执行纪律，错了要坚决止损，千万不要短线做成中线，中线做成长线。" ;
    ash:statementSpeaker "落升" ;
