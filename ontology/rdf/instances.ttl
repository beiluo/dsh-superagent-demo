ashd:voice-youzi-417 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "仓位纪律：除\"千年大计\"雄安新区消息刺激下单买超1亿外，其余情况都用4000万以下资金操作；" ;
    ash:statementSpeaker "佛山系" ;
