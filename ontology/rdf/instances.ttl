    ash:validUntil "2026-12-31"^^xsd:date ;
    ash:confidence 0.78 ;
    ash:targetPrice 45.00 ;
    ash:stopLoss 30.50 ;
    rdfs:label "华辰智造 2026 年四季度增持决策"@zh, "Huachen Q4 2026 Buy Decision"@en ;
    rdfs:comment "示例投资决策，不构成投资建议。"@zh ;
    ash:isExample true ;
    ash:exampleNote "示例决策，用于展示 RDF—OWL—SWRL—OWL-S—ODRL 的贯通链路。"@zh .

ashd:rationale-huachen a owl:NamedIndividual, ash:DecisionRationale ;
    ash:rationaleText "公司在工业自动化与智能装备领域具备稳定的客户基础和高于行业的 ROE；当前 PE 低于过去三年中枢，估值与盈利质量匹配。目标价对应 2027 年约 22 倍 PE，止损价对应 2026 年约 17 倍 PE。" ;
    ash:assumption "制造业资本开支温和复苏；公司核心产品毛利率维持在 35% 以上。" ;
    ash:counterArgument "若大客户资本开支延后或供应链成本上升，盈利增速可能低于预期；12% 的组合权重已超过单票 10% 的约束，需先降仓再执行增持。" ;
    ash:hasEvidence ashd:evidence-huachen-report, ashd:evidence-huachen-quote, ashd:evidence-huachen-industry ;
    rdfs:label "华辰智造增持理由"@zh ;
    ash:isExample true .

ashd:check-huachen a owl:NamedIndividual, ash:ComplianceCheck ;
    ash:checksDecision ashd:decision-huachen-2026q4 ;
    ash:passed true ;
    ash:checkNote "通过：证券不在限制名单，投资者画像匹配，但组合已有持仓权重超过单票上限，执行前须降至 10% 以下。" ;
    rdfs:label "华辰智造决策合规检查"@zh ;
    ash:isExample true .

ashd:decision-ningyuan-2026q4 a owl:NamedIndividual, ash:InvestmentDecision ;
    ash:decisionId "DEC-2026-NY-002" ;
    ash:aboutSecurity ashd:sec-ningyuan-a ;
