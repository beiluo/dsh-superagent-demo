ashd:voice-youzi-151 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "股性与龙头：\"大凡大牛板块或大牛连板股，一定都是换手上去的板\"\"换手决定高度\"，量能15%-30%区间且不缩量趋势继续；" ;
