# ===== Trader voice excerpts 1.5 (short public excerpts; not full text) =====

ashd:voice-youzi-001 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "25/27. 永不止盈永不止损：买入按逻辑体系买入不考虑止盈，上涨只看姿势和买卖者情绪，继续看好则持股、不看好则卖出；" ;
    ash:statementSpeaker "炒股养家" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 1 ;
    ash:hasSkillTopic ashs:topic-emotion ; ash:hasSkillTopic ashs:topic-risk ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "炒股养家 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-03 ash:hasStatement ashd:voice-youzi-001 .

ashd:voice-youzi-002 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "三要素：主线（当下最强题材）+人气核心（龙头已打出空间）+情绪逆转（分歧转一致，从水下/大跌直线拉板，\"暴力美学\"）。" ;
    ash:statementSpeaker "著名刺客" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 1 ;
    ash:hasSkillTopic ashs:topic-leader ; ash:hasSkillTopic ashs:topic-emotion ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "著名刺客 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-14 ash:hasStatement ashd:voice-youzi-002 .

ashd:voice-youzi-003 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "主升期：题材故事还能讲，就敢于在分歧时大胆介入龙头，\"看好，分歧，买入\"，打板低吸皆可；" ;
    ash:statementSpeaker "92科比" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 1 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-low-buy ; ash:hasSkillTopic ashs:topic-leader ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "92科比 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-20 ash:hasStatement ashd:voice-youzi-003 .

ashd:voice-youzi-004 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "不设止损止盈，买入机会卖出风险；" ;
    ash:statementSpeaker "炒股养家" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-risk ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "炒股养家 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-03 ash:hasStatement ashd:voice-youzi-004 .

ashd:voice-youzi-005 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "封板手法：急速暴量扫货封板，利用资金优势万手大单排板，单笔买入通常5000万以上，参与风口龙头接力板，\"激发市场情绪，引导资金关注打造主线机会\"。" ;
    ash:statementSpeaker "赵老哥" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 1 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-relay ; ash:hasSkillTopic ashs:topic-leader ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "赵老哥 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-05 ash:hasStatement ashd:voice-youzi-005 .

ashd:voice-youzi-006 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "只做主升：\"一定不能参与调整段，一定要做主升，主升才是王道，而主升是低吸不来的，主升只能靠打板和追涨。" ;
    ash:statementSpeaker "乔帮主" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 1 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-low-buy ; ash:hasSkillTopic ashs:topic-trend ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
