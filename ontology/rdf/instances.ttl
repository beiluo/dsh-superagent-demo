ashd:voice-youzi-355 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "宁波解放南路（涨停板敢死队）：被其奉为\"最正宗、最大气、最合理的名门正派\"——\"一般的资金只是发现和跟随，宁波解放南路是发掘和引导，技术含量要高得多\"；" ;
    ash:statementSpeaker "Asking" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 4 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-technical ;
