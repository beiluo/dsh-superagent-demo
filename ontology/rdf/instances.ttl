ashd:voice-youzi-209 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "语料所示为一套以\"大资金视角\"自居的狙击式趋势战法课程：用\"高射炮/加农炮/迫击炮\"三类狙击点刻画\"买入即爆发/转势/轮动\"三种出手时机，配套\"三仙归一\"题材选股与\"强力试盘洗盘\"识别技术。" ;
    ash:statementSpeaker "章盟主" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 1 ;
    ash:hasSkillTopic ashs:topic-trend ; ash:hasSkillTopic ashs:topic-theme ; ash:hasSkillTopic ashs:topic-technical ;
