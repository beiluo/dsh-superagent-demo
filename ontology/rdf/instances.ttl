# ===== Youzi methodology examples =====

ashd:source-youzi-mdpt a owl:NamedIndividual, ash:KnowledgeSource ;
    ash:sourceUrl "https://youzi.mdpt.cn/"^^xsd:anyURI ;
    ash:sourceTitle "游资心法秘籍阁" ;
    ash:retrievedAt "2026-11-03"^^xsd:date ;
    ash:usageNote "公开站点；仅提炼概念、分类与判断原则，不复制原文、不转载语料。" ;
    rdfs:label "游资心法秘籍阁（公开方法论来源）"@zh ;
    ash:isExample true .

ashd:principle-buy1 a owl:NamedIndividual, ash:PlaybookPrinciple ;
    ash:principleText "龙虎榜买一资金应显著大于卖一；买一独大、买二买三差距过大时要防抛压。" ;
    ash:principleCategory "龙虎榜" ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "买一卖一原则"@zh ;
    ash:isExample true .

ashd:principle-volume a owl:NamedIndividual, ash:PlaybookPrinciple ;
    ash:principleText "放量换手板让短线筹码充分交换，成本更接近涨停价；缩量板浮盈集中，次日砸盘风险更高。" ;
    ash:principleCategory "打板" ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "放量换手原则"@zh ;
    ash:isExample true .

ashd:principle-auction a owl:NamedIndividual, ash:PlaybookPrinciple ;
    ash:principleText "竞价先形成预期，再用实际开盘与量能验证；预期差决定是跟随、放弃还是反向。" ;
    ash:principleCategory "竞价" ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "竞价预期差原则"@zh ;
    ash:isExample true .

ashd:principle-emotion a owl:NamedIndividual, ash:PlaybookPrinciple ;
    ash:principleText "先判断情绪周期阶段，再决定仓位和手法；高潮后期与冰点期的风险收益完全不同。" ;
    ash:principleCategory "情绪周期" ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "情绪周期优先原则"@zh ;
    ash:isExample true .

ashd:principle-drawdown a owl:NamedIndividual, ash:PlaybookPrinciple ;
    ash:principleText "账户回撤超过 10% 时先降仓和复盘，不用加仓或换手法来掩盖交易系统问题。" ;
    ash:principleCategory "风控" ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "回撤控制原则"@zh ;
    ash:isExample true .

ashd:auction-phase-920 a owl:NamedIndividual, ash:AuctionPhase ;
    rdfs:label "9:20–9:25 不可撤单阶段"@zh ;
    ash:isExample true .

ashd:auction-expectation-youzi a owl:NamedIndividual, ash:AuctionExpectation ;
    ash:expectedPremium -2.0 ;
    ash:actualPremium 3.2 ;
    rdfs:label "游资科技竞价预期"@zh ;
