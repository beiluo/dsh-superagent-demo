ashd:voice-youzi-016 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "常见逻辑缺陷：选股无标准(如仅集合竞价高开≠好股票)、买入无时机概念(扫排不分)、卖出依据是上次结果(刻舟求剑)。" ;
    ash:statementSpeaker "游资通用方法论" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
