ashd:voice-youzi-013 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "选股三方向：①连板龙头纳入自选(主升看分歧转一致，见顶后观察一月轮炒)②刚开板新股(观察一周)③板块中军股(观察热点风险，中军大跌=热点结束)。" ;
    ash:statementSpeaker "游资通用方法论" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-leader ; ash:hasSkillTopic ashs:topic-emotion ;
