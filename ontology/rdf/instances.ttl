ashd:voice-youzi-420 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "2015年动用全部账户将乐视网运作成\"一条直线上涨\"并引来大佬封涨停，未在龙虎榜留下痕迹。" ;
