ashd:skill-youzi-21 ash:hasStatement ashd:voice-youzi-737 .

ashd:voice-youzi-738 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "预判而非盲从：\"不预测、只跟随\"是极大错误——\"最高明的预测或预判是买在转折处，买入后就开始涨【最聪明的人】；" ;
    ash:statementSpeaker "瑞鹤仙" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 17 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "瑞鹤仙 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-04 ash:hasStatement ashd:voice-youzi-738 .

ashd:voice-youzi-739 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "系统化的买卖点：\"系统是根据经验对买卖点设定的要求，它的作用就是让你去做自己最拿手的事，不再临时起意情绪用事。" ;
    ash:statementSpeaker "退学炒股" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 18 ;
    ash:hasSkillTopic ashs:topic-emotion ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "退学炒股 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-08 ash:hasStatement ashd:voice-youzi-739 .

ashd:voice-youzi-740 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "体系第一义：等待、发现、跟随三字诀：\"等待，需要绝对的耐心，发现，需要经验来确认，跟随则是最次要的买入动作了。" ;
    ash:statementSpeaker "Asking" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 19 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "Asking · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-10 ash:hasStatement ashd:voice-youzi-740 .

ashd:voice-youzi-741 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "真正的投机是利用已知信息推导事件或市场情绪的发展来操作股票\"——just999在国恒铁路的一战是教科书式范例。" ;
    ash:statementSpeaker "职业炒手" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 10 ;
    ash:hasSkillTopic ashs:topic-emotion ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "职业炒手 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-15 ash:hasStatement ashd:voice-youzi-741 .

ashd:voice-youzi-742 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "主跌期：第一天杀跌很恐怖，第二天若持续杀跌，尾盘就可以找买点，第三天肯定会有情绪修复——随后回到低位试错阶段。" ;
    ash:statementSpeaker "92科比" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 23 ;
    ash:hasSkillTopic ashs:topic-emotion ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "92科比 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-20 ash:hasStatement ashd:voice-youzi-742 .

ashd:voice-youzi-743 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "首仓于上午10:00–10:30开仓，方向为当日有较大可能发生单边行情的方向，仓位50%（从1手发展至4手）。" ;
    ash:statementSpeaker "艾琳" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 15 ;
    ash:hasSkillTopic ashs:topic-position ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "艾琳 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-25 ash:hasStatement ashd:voice-youzi-743 .

ashd:voice-youzi-744 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "客观卖出依据：跌破技术形态/跌穿分时均线/10点前无拉升等，不因交易结果改变(否则会把所有卖飞场景试一遍)。" ;
    ash:statementSpeaker "游资通用方法论" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 33 ;
    ash:hasSkillTopic ashs:topic-risk ; ash:hasSkillTopic ashs:topic-trend ; ash:hasSkillTopic ashs:topic-technical ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "游资通用方法论 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-01 ash:hasStatement ashd:voice-youzi-744 .

ashd:voice-youzi-745 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "上榜条件：①日价格涨幅偏离值+7% ②当日换手率20% ③当日振幅15% ④连续3日涨幅偏离值累计20%。" ;
    ash:statementSpeaker "游资通用方法论" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 34 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-relay ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "游资通用方法论 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-01 ash:hasStatement ashd:voice-youzi-745 .

ashd:voice-youzi-746 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "期指资金严格限仓——\"50万期指资金严格限定开仓在2手以内，每次只开1手\"把杠杆从6.7倍降到2.68倍。" ;
    ash:statementSpeaker "瑞鹤仙" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 18 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "瑞鹤仙 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-04 ash:hasStatement ashd:voice-youzi-746 .

ashd:voice-youzi-747 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "极致隔日纪律：\"我说了无数遍，我是超短线，买完第二天除非涨停，必卖，我不看年报，不业绩，不看公司是干嘛的。" ;
    ash:statementSpeaker "乔帮主" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 27 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-fundamental ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "乔帮主 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-07 ash:hasStatement ashd:voice-youzi-747 .

ashd:voice-youzi-748 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "尊重合力，无视龙虎榜：\"股票的涨跌，跟龙虎榜关系不大……无视龙虎榜，该怎么做怎么做，这是股票层面的无神论。" ;
    ash:statementSpeaker "乔帮主" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 28 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "乔帮主 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-07 ash:hasStatement ashd:voice-youzi-748 .

ashd:voice-youzi-749 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "方法一横向对比：对比个股前后数日竞价总量与预期（修复日竞价量约为前日2倍左右属正常，过高=逐级抬价透支）。" ;
    ash:statementSpeaker "凡倍无名" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 33 ;
    ash:hasSkillTopic ashs:topic-auction ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "凡倍无名 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-09 ash:hasStatement ashd:voice-youzi-749 .

ashd:voice-youzi-750 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "做错要快速处理，不能拖：\"中一枪算是倒霉的，不快速处理，一般多搞成残废，也有拖成半身不遂的，那基本叫废啦。" ;
    ash:statementSpeaker "丁一熊" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "丁一熊 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-29 ash:hasStatement ashd:voice-youzi-750 .

ashd:voice-youzi-751 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "附加两则：涨起来一定买强势股（\"能够进退有度的人算是厉害了，如果还知道涨起来一定买强势股，就算入门了\"）；" ;
    ash:statementSpeaker "丁一熊" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "丁一熊 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-29 ash:hasStatement ashd:voice-youzi-751 .

ashd:voice-youzi-752 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "理论底色：书中称上涨的核心推动力是\"老鼠仓\"（用公家的钱往涨停价推），主张\"跟随主力老鼠仓全力做差价\"；" ;
    ash:statementSpeaker "宁波敢死队" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 14 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "宁波敢死队 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-02 ash:hasStatement ashd:voice-youzi-752 .

ashd:voice-youzi-753 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "均线与指标体系：均线参数5天、24天（生命线）、72天、203天，持仓个股60分钟K线必须在生命线之上；" ;
    ash:statementSpeaker "宁波敢死队" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 15 ;
    ash:hasSkillTopic ashs:topic-trend ; ash:hasSkillTopic ashs:topic-lockup ; ash:hasSkillTopic ashs:topic-technical ;
