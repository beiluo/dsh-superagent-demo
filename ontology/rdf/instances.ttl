ashd:voice-youzi-073 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "先预测先下手：\"在股市里，买入传言，卖出消息。" ;
    ash:statementSpeaker "落升" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
