ashd:voice-youzi-737 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "超早板和竞价板（通常是平台突破板）：形态是长长一条平K线拉出一根大阳（也有直接一字或短阳），量能放量但不放巨量；" ;
    ash:statementSpeaker "佛山系" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 16 ;
    ash:hasSkillTopic ashs:topic-auction ; ash:hasSkillTopic ashs:topic-technical ;
