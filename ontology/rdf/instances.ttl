    rdfs:label "炒股养家 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-03 ash:hasStatement ashd:voice-youzi-212 .

ashd:voice-youzi-213 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "素养标准=能说清板块逻辑+板块10%目标个股+典型个股(最积极/低PE/叠加题材/次新/大小盘)+每波领涨是谁+今日谁发动谁跟风+技术形态换手率最好的几个。" ;
    ash:statementSpeaker "炒股养家" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
