ashd:skill-youzi-11 ash:hasStatement ashd:voice-youzi-350 .

ashd:voice-youzi-351 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "万变不离其宗：焦点核心、情绪：\"别的像转折，高潮，反抽，补涨等乱七八糟的都是技巧而已，就像打游戏，他们只是Q,W,E,R，而'焦点核心，情绪'就像操作和大局观。" ;
    ash:statementSpeaker "涅盘重升" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 9 ;
    ash:hasSkillTopic ashs:topic-leader ; ash:hasSkillTopic ashs:topic-emotion ;
