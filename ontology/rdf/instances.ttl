ashd:voice-youzi-735 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "大资金思维/全局思维：设\"大资金的核心思维\"\"全局思维的研究\"专章，主张站在大资金角度思考狙击点，而非散户视角。" ;
    ash:statementSpeaker "章盟主" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "章盟主 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-12 ash:hasStatement ashd:voice-youzi-735 .

ashd:voice-youzi-736 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "just999：被其推崇为\"利用已知信息推导事件与市场情绪\"的教科书式高手（国恒铁路、0594、0522战役）；" ;
    ash:statementSpeaker "职业炒手" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 9 ;
    ash:hasSkillTopic ashs:topic-emotion ;
