ashd:voice-youzi-416 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "语料提及：成名后仓位、持股易被泄露，跟风者众多，其本人希望阳光私募争取机构席位以摆脱跟风者。" ;
