    rdfs:label "章盟主 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-12 ash:hasStatement ashd:voice-youzi-209 .

ashd:voice-youzi-210 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "复盘方法论：每天复盘翻一遍个股，把走势符合主升浪雏形的找出来，再研究公告、题材、预期、F10并不断跟踪——\"都是很累很烦的苦力活，但你不刻苦奋斗努力，怎么可能坐享其成\"；" ;
    ash:statementSpeaker "瑞鹤仙" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;
    ash:hasSkillTopic ashs:topic-auction ; ash:hasSkillTopic ashs:topic-review ; ash:hasSkillTopic ashs:topic-trend ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "瑞鹤仙 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-04 ash:hasStatement ashd:voice-youzi-210 .

ashd:voice-youzi-211 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "实盘总结：\"貌似自己的票低吸都有大肉\"——恒信移动3天25%+、汇金股份反复冲高、赛摩电气/赛福天/昊志机电\"次日绿盘至涨停、后日继续涨停\"、金亚科技次日低开冲击涨停；" ;
    ash:statementSpeaker "著名刺客" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 7 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-low-buy ; ash:hasSkillTopic ashs:topic-review ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "著名刺客 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-14 ash:hasStatement ashd:voice-youzi-211 .

ashd:voice-youzi-212 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "控制回撤三条：(1)能赚一块只赚七毛留三毛计时(2)绝不能把盈利做成亏损(铁律)(3)仓位提前计划知行合一(计划要细致：仓位配比+情况一策略一+情况二策略二)；" ;
    ash:statementSpeaker "炒股养家" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 15 ;
    ash:hasSkillTopic ashs:topic-account ; ash:hasSkillTopic ashs:topic-position ;
