ashd:voice-youzi-018 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "卖出习惯：向上止盈止损（左侧挂单卖出）——上班时无法盯盘养成的习惯，资金做大后左侧也更合适；" ;
    ash:statementSpeaker "乔帮主" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-risk ;
