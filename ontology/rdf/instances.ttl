ashd:voice-youzi-027 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "天涯时代被誉为\"超短线之神\"、半年翻十倍的低吸流派开山鼻祖——满仓一只、隔日必走的极致超短：只做热点强势股，用\"题材+热点+好形态、5日线附近低吸\"吃强势股的上升惯性。" ;
    ash:statementSpeaker "独谷一箭" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;
