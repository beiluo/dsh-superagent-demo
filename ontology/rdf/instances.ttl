    ash:isExample true .
ashd:skill-youzi-26 ash:hasStatement ashd:voice-youzi-351 .

ashd:voice-youzi-352 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "从100万实盘四年做到87倍、以\"六大情绪变量\"给市场定级定仓的情绪流超短游资——核心信仰是\"投机做的是赚钱效应（情绪）的延续\"，打板做核心，只为确定性出手。" ;
    ash:statementSpeaker "涅盘重升" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 10 ;
