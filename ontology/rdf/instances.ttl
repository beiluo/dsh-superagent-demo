ashd:voice-youzi-043 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "体系第一义：打板是为了龙头，不是套利：\"打板是为了在最后确定的一瞬间买入市场上最强的个股，持有获取最大的利润。" ;
    ash:statementSpeaker "著名刺客" ;
    ash:statementType "tactic" ;
