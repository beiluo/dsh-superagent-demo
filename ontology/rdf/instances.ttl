ashd:voice-youzi-130 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "交易做不好（与市场阶段不符、跟不上节奏）时：\"唯一摆脱这个尴尬局面的办法，就是逃出来在床上躺着不动\"——即彻底空仓，看市场跌下去，等新一轮上升确认后重新进场。" ;
    ash:statementSpeaker "丁一熊" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 6 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "丁一熊 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-29 ash:hasStatement ashd:voice-youzi-130 .

ashd:voice-youzi-131 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "与本档案集《落升》可对照：同持\"跌势离场、空仓等待、跌完买新强势股\"的生存逻辑，落升给出乖离率等量化触发，丁一熊给出\"放量上涨确认\"等定性触发，一量化一哲学。" ;
    ash:statementSpeaker "丁一熊" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 7 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "丁一熊 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-29 ash:hasStatement ashd:voice-youzi-131 .

ashd:voice-youzi-132 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "学习之后靠\"思\"和\"悟\"，用自己的道进入市场：\"以为搞懂了历史，就一定知道未来，那是一种美好的自我安慰……今天的你回到十年之前是高手，但在今天你什么都不是。" ;
    ash:statementSpeaker "浓汤野人" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 6 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "浓汤野人 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-18 ash:hasStatement ashd:voice-youzi-132 .

ashd:voice-youzi-133 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "协同席位遍布山东（兼及闽赣等地）、以国海证券两兄弟营业部为首的庄游资团伙——继温州帮之后崛起的\"造妖\"帮派：入驻次新做T高抛低吸、温和洗盘、与游资合力共处。" ;
    ash:statementSpeaker "山东帮" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 8 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-low-buy ; ash:hasSkillTopic ashs:topic-range ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "山东帮 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-44 ash:hasStatement ashd:voice-youzi-133 .

ashd:voice-youzi-134 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "搞超短最核心的技术就是你的选股系统——必须有一种动态的快速选股系统，能迅速找到市场的热点标的一小撮（不是一个两个），而后跟踪进行综合确认选择动手的目标。" ;
    ash:statementSpeaker "职业炒手" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 7 ;
    ash:hasSkillTopic ashs:topic-theme ; ash:hasSkillTopic ashs:topic-technical ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "职业炒手 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-15 ash:hasStatement ashd:voice-youzi-134 .

ashd:voice-youzi-135 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "技术面与基本面背离的反向重仓：形式（技术图形）再好，若与基本面背离，即是最反向操作时机，可逆市开重仓——这是其棉花重仓的逻辑基础。" ;
    ash:statementSpeaker "浓汤野人" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 7 ;
    ash:hasSkillTopic ashs:topic-fundamental ; ash:hasSkillTopic ashs:topic-technical ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "浓汤野人 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-18 ash:hasStatement ashd:voice-youzi-135 .

ashd:voice-youzi-136 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "④一旦轻仓被套，不可贸然补仓——每轮高点下行通常是20%-30%一个波段，拉开空间之后再补，不可跌一点补一点把子弹早早打完；" ;
    ash:statementSpeaker "明王" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 7 ;
    ash:hasSkillTopic ashs:topic-trend ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "明王 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-22 ash:hasStatement ashd:voice-youzi-136 .

ashd:voice-youzi-137 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "下跌周期十一条经验（原文要点）：①不同板块下跌周期不一样，前期先表现先下跌，后面的会补跌（先入老元气，再入新元气板块）；" ;
    ash:statementSpeaker "明王" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 8 ;
    ash:hasSkillTopic ashs:topic-emotion ; ash:hasSkillTopic ashs:topic-theme ;
