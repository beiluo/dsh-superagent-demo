ashd:voice-youzi-149 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "介入形态包括平台突破（北新路桥：头一日涨停、平台突破开盘买）、一字板开板抢筹（白银有色T字板低吸、天能重工/纵横通讯一字开板抢入）、超预期加速板、新龙头卡位、巨量烂板次日开盘走强。" ;
    ash:statementSpeaker "退学炒股" ;
    ash:statementType "tactic" ;
