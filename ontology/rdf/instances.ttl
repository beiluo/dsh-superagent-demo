ashd:voice-youzi-019 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "卖出习惯：\"我一般不习惯在涨停板卖，喜欢涨停低一点就出，比较保险，剩下那点不要了！" ;
    ash:statementSpeaker "独谷一箭" ;
    ash:statementType "warning" ;
