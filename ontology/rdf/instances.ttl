ashd:voice-youzi-235 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "外盘反向操作法：外围通常只影响开盘——情绪向上周期中，外围大跌导致指数低开恐慌，是大胆推进仓位的机会；" ;
    ash:statementSpeaker "万狮虎" ;
    ash:statementType "tactic" ;
