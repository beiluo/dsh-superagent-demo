ashd:company-st-demo a owl:NamedIndividual, ash:ListedCompany ;
    ash:companyName "示例风险警示股份有限公司" ;
    ash:companyCode "ST004" ;
    ash:isST true ;
    ash:delistingRisk true ;
    ash:primaryIndustry ashs:industry-materials ;
    ash:hasSecurity ashd:sec-st-demo ;
    ash:hasFinancialReport ashd:report-st-demo-2025 ;
    rdfs:label "示例 ST 公司"@zh, "Sample ST Company"@en ;
    rdfs:comment "用于演示 ST 与退市风险排除规则的合成示例公司。"@zh ;
    ash:isExample true ;
    ash:exampleNote "仅用于规则测试，不代表任何真实上市公司。"@zh .

ashd:sec-huachen-a a owl:NamedIndividual, ash:AShare ;
    ash:securityName "华辰智造" ;
    ash:securityCode "600000" ;
    ash:isin "CN0000000001" ;
    ash:listingDate "2010-06-18"^^xsd:date ;
    ash:listedOn ashd:exchange-sse ;
    ash:tradesOn ashd:segment-main ;
    ash:issuedBy ashd:company-huachen ;
    ash:isSuspended false ;
    ash:isRestricted false ;
    ash:hasMarketQuote ashd:quote-huachen-20261030 ;
    ash:hasValuation ashd:val-huachen-20261030 ;
    rdfs:label "华辰智造 A"@zh, "Huachen A"@en ;
    rdfs:comment "合成 A 股证券实例，代码仅用于演示。"@zh ;
