    ash:isExample true .
ashd:skill-youzi-04 ash:hasStatement ashd:voice-youzi-731 .

ashd:voice-youzi-732 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "\"好的交易呈现的交割单是：大涨小回，20%的交易贡献80%的利润，80%都是卖飞＋止损的废操，其意义是保持盘感。" ;
    ash:statementSpeaker "乔帮主" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 26 ;
    ash:hasSkillTopic ashs:topic-review ; ash:hasSkillTopic ashs:topic-risk ; ash:hasSkillTopic ashs:topic-fundamental ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
