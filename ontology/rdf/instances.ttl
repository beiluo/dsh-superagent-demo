    rdfs:label "明王 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-22 ash:hasStatement ashd:voice-youzi-137 .

ashd:voice-youzi-138 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "技术面与基本面背离时反向重仓：\"技术面的形式再好，如果与基本面相背离，则反而是最好的反向操作时机，可以逆市开重仓。" ;
    ash:statementSpeaker "浓汤野人" ;
