    ash:isExample true .
ashd:skill-youzi-02 ash:hasStatement ashd:voice-youzi-104 .

ashd:voice-youzi-105 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "很喜欢去重仓介入加速临界点的板，对于模式内的个股，不看换手不看标的就是上，喜欢做加速四板的接力。" ;
    ash:statementSpeaker "东北猛男" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 5 ;
    ash:hasSkillTopic ashs:topic-relay ; ash:hasSkillTopic ashs:topic-lockup ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "东北猛男 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-50 ash:hasStatement ashd:voice-youzi-105 .

ashd:voice-youzi-106 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "我唯一确信的是，当你老了，你能记住的一定不是他们，而是那些孤独投机生涯里，那一剑剑的豪情与傲骨。" ;
    ash:statementSpeaker "龙飞虎" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "龙飞虎 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-24 ash:hasStatement ashd:voice-youzi-106 .

ashd:voice-youzi-107 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "参与后的最佳跟进方式：该席位参与之后，低吸的获利概率要比打板更大——即不追高，等回踩低吸。" ;
    ash:statementSpeaker "北大街" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 7 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-low-buy ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "北大街 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-40 ash:hasStatement ashd:voice-youzi-107 .

ashd:voice-youzi-108 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "以超短板和热门题材的首板为主，盘中都是直线拉升涨停，引导资金合力封板，第二天有可能离场。" ;
    ash:statementSpeaker "北一环" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 6 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "北一环 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-41 ash:hasStatement ashd:voice-youzi-108 .

ashd:voice-youzi-109 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "自认改进方向是\"集中火力攻击目标股，同时用仓位控制风险\"，但这需要更强的判断力与控制力。" ;
    ash:statementSpeaker "龙飞虎" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 4 ;
    ash:hasSkillTopic ashs:topic-risk ; ash:hasSkillTopic ashs:topic-position ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "龙飞虎 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-24 ash:hasStatement ashd:voice-youzi-109 .

ashd:voice-youzi-110 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "讲纪律——\"长线不做成短线，短线不做成中长线，到了事先确定的止损位就一定要执行\"；" ;
    ash:statementSpeaker "宁波敢死队" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 8 ;
    ash:hasSkillTopic ashs:topic-risk ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "宁波敢死队 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-02 ash:hasStatement ashd:voice-youzi-110 .

ashd:voice-youzi-111 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "不可能每天复盘全部股票，用板块功能每天只复盘100来只，自选股必须从板块股中筛选。" ;
    ash:statementSpeaker "Asking" ;
