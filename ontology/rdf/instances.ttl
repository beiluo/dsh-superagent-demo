ashd:voice-youzi-218 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "情绪量化参考：参考\"昨日涨停今日表现\"类统计（如柏拉爱空指标：前日涨幅前20名次日表现），加入领跌品种与各周期领涨领跌板块，保持观点客观。" ;
    ash:statementSpeaker "炒股养家" ;
