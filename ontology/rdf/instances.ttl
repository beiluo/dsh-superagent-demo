ashd:voice-youzi-412 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "\"遇到亏损坚决割肉，\"不会去抱有任何幻想，因为这些都只是故事罢了，如果不止损后面会亏得更多\"。" ;
    ash:statementSpeaker "赵老哥" ;
    ash:statementType "warning" ;
