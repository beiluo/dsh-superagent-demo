# ===========================================================================
# Risk factors and assessments
# ===========================================================================

ashd:factor-huachen-supply a owl:NamedIndividual, ash:RiskFactor ;
    rdfs:label "供应链集中"@zh ;
    rdfs:comment "核心控制器与精密减速器供应商集中度较高。"@zh ;
    ash:isExample true .

ashd:factor-huachen-customer a owl:NamedIndividual, ash:RiskFactor ;
    rdfs:label "大客户依赖"@zh ;
    rdfs:comment "前五大客户收入占比超过 40%，需求波动会放大业绩波动。"@zh ;
    ash:isExample true .

ashd:factor-ningyuan-tech a owl:NamedIndividual, ash:RiskFactor ;
    rdfs:label "技术路线迭代"@zh ;
    rdfs:comment "固态电池等新技术路线可能改变现有竞争格局。"@zh ;
    ash:isExample true .

ashd:factor-ningyuan-price a owl:NamedIndividual, ash:RiskFactor ;
    rdfs:label "价格竞争"@zh ;
    rdfs:comment "动力电池行业产能扩张导致价格与毛利率承压。"@zh ;
    ash:isExample true .

ashd:factor-jingkang-clinical a owl:NamedIndividual, ash:RiskFactor ;
    rdfs:label "临床与注册失败"@zh ;
    rdfs:comment "核心管线处于关键临床阶段，存在读数与注册不确定性。"@zh ;
    ash:isExample true .

ashd:risk-huachen a owl:NamedIndividual, ash:RiskAssessment ;
    ash:assessesSecurity ashd:sec-huachen-a ;
    ash:assessesDecision ashd:decision-huachen-2026q4 ;
