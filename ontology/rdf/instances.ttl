ashd:voice-youzi-345 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "等待时机：不等大盘大涨（7月9日贸易战落地大涨时不动手），等的是\"有人先动了\"——7月12日集合竞价兴源环境巨量成交、开盘跌停被打开，确认有资金开始撬板（等于免费试盘，测出买盘强度与卖压）；" ;
    ash:statementSpeaker "佛山系" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 5 ;
    ash:hasSkillTopic ashs:topic-auction ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "佛山系 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-21 ash:hasStatement ashd:voice-youzi-345 .

ashd:voice-youzi-346 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 稳定盈利三条（其最广为流传的总结）：①外在表现很少一个月翻倍，\"而是一个月30%左右、3个月翻倍，平时资产小碎步缓慢爬升，积累一定利润后再加速爆发，如此循环，大幅回撤几乎为0\"；" ;
    ash:statementSpeaker "瑞鹤仙" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 6 ;
    ash:hasSkillTopic ashs:topic-review ; ash:hasSkillTopic ashs:topic-account ; ash:hasSkillTopic ashs:topic-fundamental ;
