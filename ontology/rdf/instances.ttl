ashd:voice-youzi-007 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "风险信号：高位时一定不要做古北路的对手盘——高位他砸完了，基本上题材龙头离结束就不远了。" ;
    ash:statementSpeaker "古北路" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 1 ;
    ash:hasSkillTopic ashs:topic-leader ; ash:hasSkillTopic ashs:topic-risk ; ash:hasSkillTopic ashs:topic-theme ;
