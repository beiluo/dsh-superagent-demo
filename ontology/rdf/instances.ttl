ashd:voice-youzi-017 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "主模式为超短打板（辅以低吸、半路），典型的隔日模式：当日打板/开盘买入，次日集合竞价或开盘5分钟内兑现；" ;
    ash:statementSpeaker "退学炒股" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 1 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-low-buy ; ash:hasSkillTopic ashs:topic-auction ;
