    rdfs:label "凡倍无名 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-09 ash:hasStatement ashd:voice-youzi-040 .

ashd:voice-youzi-041 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "长期资金曲线不断上升的秘密就是回撤少\"：系统风险来临时，要么降低仓位，要么换入能逆市的品种，哪个概率大选哪个。" ;
    ash:statementSpeaker "万法归宗" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
