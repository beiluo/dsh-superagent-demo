    ash:isExample true .
ashd:skill-youzi-07 ash:hasStatement ashd:voice-youzi-732 .

ashd:voice-youzi-733 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "体系第一义：确定性高于模式标签：\"对于我而言，要的是一个确定性，如果能确定它当天会涨停那我绝对不会在涨停去买了。" ;
    ash:statementSpeaker "退学炒股" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 16 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "退学炒股 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-08 ash:hasStatement ashd:voice-youzi-733 .

ashd:voice-youzi-734 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "空仓，不是靠回避股市，也不是靠限制交易来达成，真正意义上的空仓是处在看着盘打开交易软件随时准备下单的状态中完成。" ;
    ash:statementSpeaker "退学炒股" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 17 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "退学炒股 · 原话摘录"@zh ;
    ash:isExample true .
