ashd:voice-youzi-214 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "\"江南神鹰\"落升——隐居三年狂赚112倍的波段热点龙头猎手：以\"势\"为纲、以热点为提款机、以龙头为印钞机，熊市靠一套乖离率抢反弹纪律把风险放在第一位。" ;
    ash:statementSpeaker "落升" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 1 ;
    ash:hasSkillTopic ashs:topic-leader ; ash:hasSkillTopic ashs:topic-risk ; ash:hasSkillTopic ashs:topic-trend ;
