ashd:voice-youzi-759 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "上榜频率：语料龙虎榜片段显示其营业部上榜114次（胜率42.11%字样伴随该席位出现，为榜单统计口径）。" ;
    ash:statementSpeaker "歌神" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 5 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "歌神 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-32 ash:hasStatement ashd:voice-youzi-759 .

ashd:voice-youzi-760 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "\"所谓一致性就是你在任何时候都按照自己的规则做，行情和外界对你毫无干扰，除非出现了规则内大幅度的亏损。" ;
    ash:statementSpeaker "艾琳" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 16 ;
    ash:hasSkillTopic ashs:topic-account ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "艾琳 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-25 ash:hasStatement ashd:voice-youzi-760 .

ashd:voice-youzi-761 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "跌完一波平静、开始恢复时就是机会：\"往往跌完一波，就会有新的强势好股出现，空仓的人很容易抓住新的机会。" ;
    ash:statementSpeaker "丁一熊" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 4 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "丁一熊 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-29 ash:hasStatement ashd:voice-youzi-761 .

ashd:voice-youzi-762 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "成名之战——浪潮软件（步骤还原）：3板买入 → 5板加仓 → 后面一路锁仓 → 第一根阴线砸盘时离场；" ;
    ash:statementSpeaker "东北猛男" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;
    ash:hasSkillTopic ashs:topic-position ; ash:hasSkillTopic ashs:topic-lockup ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "东北猛男 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-50 ash:hasStatement ashd:voice-youzi-762 .

ashd:voice-youzi-763 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "\"不是连续7个涨停，而是7个股票，每个股票一个涨停，7个股票轮流来做，2002年做了165个涨停\"。" ;
    ash:statementSpeaker "宁波敢死队" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 16 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "宁波敢死队 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-02 ash:hasStatement ashd:voice-youzi-763 .

ashd:voice-youzi-764 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "龙虎榜观察方法（语料明示）：看龙虎榜是学习最强游资的买卖思路与热点引导，而非用上榜席位预测次日涨跌。" ;
    ash:statementSpeaker "宁波敢死队" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 17 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-one-day ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "宁波敢死队 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-02 ash:hasStatement ashd:voice-youzi-764 .

ashd:voice-youzi-765 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "赢面90%以上满仓——满仓出击必须胜率90%以上、上涨空间看30%-50%、下跌空间3%-5%以内。" ;
    ash:statementSpeaker "乔帮主" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 29 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "乔帮主 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-07 ash:hasStatement ashd:voice-youzi-765 .

ashd:voice-youzi-766 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "确定性高于模式标签：\"对于我而言，要的是一个确定性，如果能确定它当天会涨停那我绝对不会在涨停去买了。" ;
    ash:statementSpeaker "退学炒股" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 20 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "退学炒股 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-08 ash:hasStatement ashd:voice-youzi-766 .

ashd:voice-youzi-767 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "与单一模式派对比：认为打板、专做次新、专做尾盘等\"一招鲜\"进攻力不足，职业者最终应殊途同归做多面手；" ;
    ash:statementSpeaker "凡倍无名" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 34 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "凡倍无名 · 原话摘录"@zh ;
    ash:isExample true .
