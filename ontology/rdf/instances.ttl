    ash:attributionEffect "SELECTION" ;
    ash:attributionOfReview ashd:post-trade-review-huachen-2026-11 ;
    ash:attributionPct 62.0 ;
    ash:isExample true .

ashd:auction-behavior-huachen-20261103 a owl:NamedIndividual,
        ash:AuctionBehavior ;
    rdfs:label "华辰智造竞价强转弱"@zh ;
    ash:auctionBehaviorCode "strong_to_weak" ;
    ash:auctionBehaviorNote "高开 +1.2%、竞价量比 1.1，开盘后未能延续，竞价强转弱。" ;
    ash:auctionBehaviorOfSecurity ashd:sec-huachen-a ;
    ash:auctionBehaviorType "强转弱" ;
    ash:dataAsOf "2026-11-03"^^xsd:date ;
    ash:isExample true ;
    ash:producedByEngine ashd:engine-stock-cognition .

ashd:auction-behavior-youzi-20261103 a owl:NamedIndividual,
        ash:AuctionBehavior ;
    rdfs:label "游资科技竞价弱转强"@zh ;
    ash:auctionBehaviorCode "weak_to_strong" ;
    ash:auctionBehaviorNote "竞价预期 -2%，实际高开 +3.2%，竞价量比 2.6，开盘承接增强；但不能据此直接认定全天走强。" ;
    ash:auctionBehaviorOfSecurity ashd:sec-youzi-a ;
    ash:auctionBehaviorType "弱转强" ;
    ash:behaviorFromAuction ashd:auction-youzi-20261103 ;
    ash:dataAsOf "2026-11-03"^^xsd:date ;
    ash:isExample true ;
    ash:producedByEngine ashd:engine-stock-cognition .

