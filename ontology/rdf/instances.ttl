    ash:isExample true .
ashd:skill-youzi-02 ash:hasStatement ashd:voice-youzi-753 .

ashd:voice-youzi-754 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "时间选择：弱势行情尽量等下午——\"本周的行情都是在下午才开始……弱势行情当然等下午，是过滤风险的过程\"；" ;
    ash:statementSpeaker "令胡冲" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 12 ;
    ash:hasSkillTopic ashs:topic-risk ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "令胡冲 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-06 ash:hasStatement ashd:voice-youzi-754 .

ashd:voice-youzi-755 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "买点步骤化：前一日复盘做好计划→次日按计划出击（\"没有自己的标的就不买，瞎买一个就会使自己陷入被动\"）；" ;
    ash:statementSpeaker "退学炒股" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 19 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-review ; ash:hasSkillTopic ashs:topic-one-day ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "退学炒股 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-08 ash:hasStatement ashd:voice-youzi-755 .

ashd:voice-youzi-756 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "绝对收益为基础、相对收益为目标、严格止损为纪律：\"以绝对收益为基础，以相对收益为目标，以严格止损为纪律。" ;
    ash:statementSpeaker "徐翔" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 5 ;
    ash:hasSkillTopic ashs:topic-account ; ash:hasSkillTopic ashs:topic-risk ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "徐翔 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-17 ash:hasStatement ashd:voice-youzi-756 .

ashd:voice-youzi-757 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "本质：股价此时与基本面无关，只与群众心理相关——利用情绪赚钱是可复制的模式（昌九生化、獐子岛屡屡重演）。" ;
    ash:statementSpeaker "徐翔" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 6 ;
    ash:hasSkillTopic ashs:topic-emotion ; ash:hasSkillTopic ashs:topic-fundamental ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "徐翔 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-17 ash:hasStatement ashd:voice-youzi-757 .

ashd:voice-youzi-758 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 承认以攻代守型选手回撤较大（自述13年职业以来最大回撤约20个点），只能靠不断优化模式减少回撤。" ;
    ash:statementSpeaker "孤独牛背" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 24 ;
    ash:hasSkillTopic ashs:topic-account ;
