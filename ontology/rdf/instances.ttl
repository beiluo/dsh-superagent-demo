ashd:skill-youzi-15 ash:hasStatement ashd:voice-youzi-347 .

ashd:voice-youzi-348 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "技能内含该席位的档案画像、标志手法（特征/判断标志/操作）、龙虎榜与盘中识别要点、跟随方法与风险裁决，并给出「席位档案→手法要点→跟随建议→风险提示」的标准输出格式。" ;
    ash:statementSpeaker "宁波敢死队" ;
