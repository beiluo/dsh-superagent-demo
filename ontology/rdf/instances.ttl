    rdfs:label "落升 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-28 ash:hasStatement ashd:voice-youzi-214 .

ashd:voice-youzi-215 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "追涨与低吸的本质区分：\"买入瞬间是越来越贵的时候买入（追涨），还是越来越便宜的时候买入（低吸），才是最核心的因素\"，跟绝对的点位-3还是+3无关。" ;
    ash:statementSpeaker "乔帮主" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;
    ash:hasSkillTopic ashs:topic-low-buy ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "乔帮主 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-07 ash:hasStatement ashd:voice-youzi-215 .

ashd:voice-youzi-216 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "指数×情绪套利模式（自创）：指数大涨（无论高位低位区域）必然向上带动情绪，空间板自带辨识度光环、最先吃到情绪溢价→指数大涨当天直接半路介入空间板；" ;
    ash:statementSpeaker "万狮虎" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 5 ;
    ash:hasSkillTopic ashs:topic-low-buy ; ash:hasSkillTopic ashs:topic-emotion ; ash:hasSkillTopic ashs:topic-one-day ;
