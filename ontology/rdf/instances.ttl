ashd:voice-youzi-076 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "不要在竞价阶段赌开盘承接力之外的东西。" ;
    ash:statementSpeaker "榜中榜" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;
    ash:hasSkillTopic ashs:topic-relay ; ash:hasSkillTopic ashs:topic-auction ; ash:hasSkillTopic ashs:topic-lockup ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "榜中榜 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-33 ash:hasStatement ashd:voice-youzi-076 .

ashd:voice-youzi-077 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "杀伐果断：对已淘汰的题材做反弹赶紧走，\"一旦不及预期的走势就赶紧割肉……超短就是做隔日，一旦不达预期就是走人，在里面干等不是合理的，更不应该套里面三四天\"。" ;
    ash:statementSpeaker "92科比" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 5 ;
    ash:hasSkillTopic ashs:topic-auction ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "92科比 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-20 ash:hasStatement ashd:voice-youzi-077 .

ashd:voice-youzi-078 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "预判与跟随的辩证：买入基于\"对明天市场的预判，这才是重中之重\"，但出手必须等市场确认——\"等市场确认起来强势时再出手，哪怕是追高，也永远比猜底中出手要明智得多。" ;
    ash:statementSpeaker "令胡冲" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "令胡冲 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-06 ash:hasStatement ashd:voice-youzi-078 .

ashd:voice-youzi-079 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "行情分级应对，而非一套打法打天下：\"我的交易框架里，对不同的行情有不同的手法，主要分为追板、分时点火、低吸潜伏、强势超跌反弹、波段搏主升、空仓。" ;
    ash:statementSpeaker "小鳄鱼" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 6 ;
    ash:hasSkillTopic ashs:topic-low-buy ; ash:hasSkillTopic ashs:topic-trend ; ash:hasSkillTopic ashs:topic-technical ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "小鳄鱼 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-23 ash:hasStatement ashd:voice-youzi-079 .

ashd:voice-youzi-080 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "交易明细显示单笔多为几十万至一千余万的小额分散进出（海得控制482万、上海新阳572万、中国人保卖出1510万等），印证\"各自为战、资金分散\"。" ;
    ash:statementSpeaker "泰然九路" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 6 ;
    ash:hasSkillTopic ashs:topic-risk ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "泰然九路 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-34 ash:hasStatement ashd:voice-youzi-080 .

ashd:voice-youzi-081 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "光大证券宁波解放南路——打板界\"开天辟地的祖师爷\"、宁波敢死队栖息之地（徐翔、马信琪、舒晨芳等大佬出身），手法八字诀：\"追求强势，追逐涨停\"。" ;
    ash:statementSpeaker "打板祖师爷" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "打板祖师爷 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-45 ash:hasStatement ashd:voice-youzi-081 .

ashd:voice-youzi-082 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "人称\"佛山无影脚\"的老牌打板游资，以大资金无征兆直线拉板、\"独食\"封死涨停、次日砸盘出局的一日游超短套利闻名，绝技是\"声东击西\"导演地天板。" ;
    ash:statementSpeaker "佛山系" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 5 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-one-day ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "佛山系 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-21 ash:hasStatement ashd:voice-youzi-082 .

ashd:voice-youzi-083 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "仓位管理——回撤线法（其自创核心）：\"资金在回撤线之上则全仓，资金到了回撤线则分仓，回撤线根据资金最高点变动，大概10个点左右的幅度。" ;
    ash:statementSpeaker "退学炒股" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 8 ;
    ash:hasSkillTopic ashs:topic-account ; ash:hasSkillTopic ashs:topic-position ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "退学炒股 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-08 ash:hasStatement ashd:voice-youzi-083 .

ashd:voice-youzi-084 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "体系第一义：牛熊周期是自然规律，调整一定会来：\"市场总会是牛熊交替，周期循环，这是自然规律……所以调整一定会来，再大的人物也挡不住。" ;
    ash:statementSpeaker "丁一熊" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-emotion ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "丁一熊 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-29 ash:hasStatement ashd:voice-youzi-084 .

ashd:voice-youzi-085 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "打板执行细节：不是看到封死再排队——\"确定封死的基本排不到，冲板的那一刻直接往涨停买，大多数情况下单时上面还有好多卖单没有被吃\"；" ;
    ash:statementSpeaker "令胡冲" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 5 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "令胡冲 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-06 ash:hasStatement ashd:voice-youzi-085 .

ashd:voice-youzi-086 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "【跟踪方案】 给出可执行的跟随方法：盘后看龙虎榜哪些字段、盘中盯什么信号（结合\"游资通用方法论\"技能的放量换手/接力原则）。" ;
    ash:statementSpeaker "宁波敢死队" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 4 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-relay ; ash:hasSkillTopic ashs:topic-lockup ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "宁波敢死队 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-02 ash:hasStatement ashd:voice-youzi-086 .

ashd:voice-youzi-087 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "买点确认制：\"买点慢，是因为我要确认它能涨停，至少要确定当天不能被套\"——一个多月的多笔交易只有一笔出现过当日被套。" ;
    ash:statementSpeaker "职业炒手" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 1 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "职业炒手 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-15 ash:hasStatement ashd:voice-youzi-087 .

ashd:voice-youzi-088 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "复盘与盘感训练：复盘不是看帖子——\"我复盘主要是看昨天的涨停板今天的赚钱效应，哪一类涨停股次日有肉，哪一类股持续有肉\"；" ;
    ash:statementSpeaker "令胡冲" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 6 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-emotion ; ash:hasSkillTopic ashs:topic-review ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "令胡冲 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-06 ash:hasStatement ashd:voice-youzi-088 .

ashd:voice-youzi-089 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "任何交易系统只在某段时间或某种市场环境下有效，无人能保证长期稳定盈利——故须保持开放、随时归零，防系统失效风险。" ;
    ash:statementSpeaker "浓汤野人" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;
    ash:hasSkillTopic ashs:topic-risk ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "浓汤野人 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-18 ash:hasStatement ashd:voice-youzi-089 .

ashd:voice-youzi-090 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "牛熊周期是自然规律，调整一定会来：\"市场总会是牛熊交替，周期循环，这是自然规律……所以调整一定会来，再大的人物也挡不住。" ;
    ash:statementSpeaker "丁一熊" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;
    ash:hasSkillTopic ashs:topic-emotion ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "丁一熊 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-29 ash:hasStatement ashd:voice-youzi-090 .

ashd:voice-youzi-091 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "凡是没有题材、市值较小的冷门股突破出现快速拉升，伴随天量、巨大换手，千万不要追——\"一不小心就成了温州帮的刀下亡魂\"。" ;
    ash:statementSpeaker "温州帮" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 5 ;
    ash:hasSkillTopic ashs:topic-relay ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "温州帮 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-31 ash:hasStatement ashd:voice-youzi-091 .

ashd:voice-youzi-092 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "体系第一义：超短的核心是连板、主线、人气与顺势：\"超短的核心：连板、主线、超人气龙头主线，及重磅消息个股，顺势而为。" ;
    ash:statementSpeaker "小鳄鱼" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 7 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-leader ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "小鳄鱼 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-23 ash:hasStatement ashd:voice-youzi-092 .

ashd:voice-youzi-093 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "在任何时候只要不让资金走势出现大幅回撤，同时在自己的周期内敞开盈利，市场迟早会奖励你的，可能并不是在这一次。" ;
    ash:statementSpeaker "艾琳" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-emotion ; ash:hasSkillTopic ashs:topic-account ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "艾琳 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-25 ash:hasStatement ashd:voice-youzi-093 .

ashd:voice-youzi-094 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "知道的人越多溢价越低，打板溢价肯定变低（例：盘龙药业涨停后，成都帮没有参与九典制药和华森制药，因为规律已明）；" ;
    ash:statementSpeaker "成都帮" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 4 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-one-day ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "成都帮 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-27 ash:hasStatement ashd:voice-youzi-094 .

ashd:voice-youzi-095 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "跟单口诀：\"如果盘中缩量下跌，跌破上一日均价，则是逢低吸纳的机会，买入次日如果盘中开始拉升，则应该先获利了结。" ;
    ash:statementSpeaker "山东帮" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;
    ash:hasSkillTopic ashs:topic-low-buy ; ash:hasSkillTopic ashs:topic-one-day ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "山东帮 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-44 ash:hasStatement ashd:voice-youzi-095 .

ashd:voice-youzi-096 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "确认追涨先进半仓→当天涨停，次日加仓到全仓，让利润最大化→当天不能涨停，次日择高点先出，等回调做守株待兔；" ;
    ash:statementSpeaker "Asking" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 4 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-low-buy ; ash:hasSkillTopic ashs:topic-position ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "Asking · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-10 ash:hasStatement ashd:voice-youzi-096 .

ashd:voice-youzi-097 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "在中国，成长为一路游资最快最有用的方法是牢牢搞定全新题材和超级题材，啥也别说，哪怕是错了，只要止损就行；" ;
    ash:statementSpeaker "榜中榜" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 4 ;
    ash:hasSkillTopic ashs:topic-risk ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "榜中榜 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-33 ash:hasStatement ashd:voice-youzi-097 .

ashd:voice-youzi-098 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "系统风险判断不靠均线死叉（\"几根均线全部死叉向下时，个股已跌30%了\"），靠资金是否愿意追高的市场情绪；" ;
    ash:statementSpeaker "万法归宗" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 4 ;
    ash:hasSkillTopic ashs:topic-emotion ; ash:hasSkillTopic ashs:topic-risk ; ash:hasSkillTopic ashs:topic-trend ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "万法归宗 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-13 ash:hasStatement ashd:voice-youzi-098 .

ashd:voice-youzi-099 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "龙头和领涨我们不一定能把握，但板块行情应该不会错过\"——不做盘中跟风追强势股，而是打提前量，稳健选股。" ;
    ash:statementSpeaker "职业炒手" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-leader ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "职业炒手 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-15 ash:hasStatement ashd:voice-youzi-099 .

ashd:voice-youzi-100 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "凡是没有题材、市值较小的冷门股突破出现快速拉升，伴随着天量，巨大的换手，这样的股票我们千万不要去追。" ;
    ash:statementSpeaker "温州帮" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 7 ;
    ash:hasSkillTopic ashs:topic-relay ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "温州帮 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-31 ash:hasStatement ashd:voice-youzi-100 .

ashd:voice-youzi-101 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "散户称之为'割肉荣'，只要在龙虎榜上见到该营业部，小散们都不禁打一个寒颤……'奶奶的，今天又割肉了！" ;
    ash:statementSpeaker "割肉荣" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 5 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "割肉荣 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-43 ash:hasStatement ashd:voice-youzi-101 .

ashd:voice-youzi-102 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "反弹未确认（三信号未齐）坚决不重仓，宁可接受与最低点的N%差价，把N%当作购买确定性的代价。" ;
    ash:statementSpeaker "明王" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "明王 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-22 ash:hasStatement ashd:voice-youzi-102 .

ashd:voice-youzi-103 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "语料对其定义：嗅觉敏锐、发掘题材、发动行情，资金量常在数亿，能主导一只或多只股票涨停的超级短线资金。" ;
    ash:statementSpeaker "金田路" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 6 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "金田路 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-47 ash:hasStatement ashd:voice-youzi-103 .

ashd:voice-youzi-104 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "【风险裁决】 明确指出该风格的主要风险点（一日游、出货手法、接力失败形态），并给出一句话风险提示。" ;
    ash:statementSpeaker "宁波敢死队" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 6 ;
    ash:hasSkillTopic ashs:topic-relay ; ash:hasSkillTopic ashs:topic-risk ; ash:hasSkillTopic ashs:topic-lockup ;
