    ash:indicatorValue 2.90 ;
    ash:indicatorPeriod "2026-10"^^xsd:gYearMonth ;
    ash:indicatorUnit "%" ;
    ash:dataAsOf "2026-10-20"^^xsd:date ;
    rdfs:label "1 年期 LPR"@zh, "1-year LPR"@en ;
    rdfs:comment "示例宏观数据，非真实值。"@zh ;
    ash:isExample true .

