# ---------------------------------------------------------------------------
# A-Share Investment Decision Ontology — RDF instance layer
# ---------------------------------------------------------------------------
# All individuals below are synthetic examples created for ontology design,
# rule testing and page rendering. They are not real securities, prices,
# financial statements or investment advice.
# ---------------------------------------------------------------------------
@prefix ash:     <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#> .
@prefix ashs:    <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/skos#> .
@prefix ashd:    <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/data#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdf>
    a owl:Ontology ;
    dcterms:title "A-Share Investment Decision Ontology — RDF instance graph"@en ;
    dcterms:title "A 股投资决策本体 — RDF 实例层"@zh ;
    dcterms:description "Synthetic RDF individuals for companies, securities, reports, quotes, valuations, decisions and portfolios."@en ;
    dcterms:description "用于公司、证券、财报、行情、估值、决策与组合的合成 RDF 实例。"@zh ;
    dcterms:conformsTo <https://www.w3.org/TR/rdf11-concepts/> ;
    dcterms:conformsTo <https://www.w3.org/TR/turtle/> ;
    dcterms:source "Synthetic example data generated for this ontology design."@en ;
    owl:versionInfo "1.2.0" .

# ===========================================================================
# Market structure
# ===========================================================================

ashd:exchange-sse a owl:NamedIndividual, ash:Exchange ;
    ash:exchangeCode "SSE" ;
    rdfs:label "上海证券交易所"@zh, "Shanghai Stock Exchange"@en ;
    rdfs:comment "示例中的上交所市场结构实例。"@zh ;
    ash:isExample true ;
    ash:exampleNote "合成示例，不代表真实交易所数据。"@zh .

ashd:exchange-szse a owl:NamedIndividual, ash:Exchange ;
    ash:exchangeCode "SZSE" ;
    rdfs:label "深圳证券交易所"@zh, "Shenzhen Stock Exchange"@en ;
    rdfs:comment "示例中的深交所市场结构实例。"@zh ;
    ash:isExample true ;
    ash:exampleNote "合成示例，不代表真实交易所数据。"@zh .

ashd:exchange-bse a owl:NamedIndividual, ash:Exchange ;
    ash:exchangeCode "BSE" ;
    rdfs:label "北京证券交易所"@zh, "Beijing Stock Exchange"@en ;
    rdfs:comment "示例中的北交所市场结构实例。"@zh ;
    ash:isExample true ;
    ash:exampleNote "合成示例，不代表真实交易所数据。"@zh .

ashd:segment-main a owl:NamedIndividual, ash:MarketSegment ;
    rdfs:label "主板"@zh, "Main Board"@en ;
    rdfs:comment "上交所与深交所的主板板块。"@zh ;
    ash:isExample true .

ashd:segment-chinext a owl:NamedIndividual, ash:MarketSegment ;
    rdfs:label "创业板"@zh, "ChiNext"@en ;
    rdfs:comment "深交所创业板板块。"@zh ;
    ash:isExample true .

ashd:segment-star a owl:NamedIndividual, ash:MarketSegment ;
    rdfs:label "科创板"@zh, "STAR Market"@en ;
    rdfs:comment "上交所科创板板块。"@zh ;
    ash:isExample true .

ashd:segment-bse a owl:NamedIndividual, ash:MarketSegment ;
    rdfs:label "北交所"@zh, "Beijing Stock Exchange Board"@en ;
    rdfs:comment "北京证券交易所板块。"@zh ;
    ash:isExample true .

ashd:index-csi300 a owl:NamedIndividual, ash:Index ;
    rdfs:label "沪深 300"@zh, "CSI 300"@en ;
    rdfs:comment "示例组合的业绩比较基准。"@zh ;
    ash:isExample true .

ashd:source-sse a owl:NamedIndividual, ash:DataSource ;
    rdfs:label "交易所公开行情"@zh, "Exchange public market data"@en ;
    rdfs:comment "交易所披露的公开行情与证券基本信息。"@zh ;
    ash:isExample true .

ashd:source-annual-report a owl:NamedIndividual, ash:DataSource ;
    rdfs:label "公司年度报告"@zh, "Company annual report"@en ;
    rdfs:comment "上市公司依法披露的年度报告。"@zh ;
    ash:isExample true .

ashd:source-industry-research a owl:NamedIndividual, ash:DataSource ;
    rdfs:label "行业研究笔记"@zh, "Industry research note"@en ;
    rdfs:comment "示例中的行业研究材料，不代表任何机构观点。"@zh ;
    ash:isExample true .

# ===========================================================================
# Companies and securities
# ===========================================================================

ashd:company-huachen a owl:NamedIndividual, ash:ListedCompany ;
    ash:companyName "华辰智造股份有限公司" ;
    ash:companyCode "HC001" ;
    ash:isST false ;
    ash:delistingRisk false ;
    ash:primaryIndustry ashs:industry-advanced-manufacturing ;
    ash:hasThemeExposure ashs:theme-ai, ashs:theme-low-altitude-economy, ashs:theme-semiconductor-localization ;
    ash:hasSecurity ashd:sec-huachen-a ;
    ash:hasFinancialReport ashd:report-huachen-2025 ;
    ash:hasCorporateEvent ashd:event-huachen-dividend ;
    ash:hasDisclosure ashd:disclosure-huachen-annual ;
    rdfs:label "华辰智造"@zh, "Huachen Intelligent Manufacturing"@en ;
    rdfs:comment "工业自动化与智能装备领域的合成示例公司。"@zh ;
    ash:isExample true ;
    ash:exampleNote "公司名称、代码和全部财务数据均为本体演示用合成数据。"@zh .

