ashd:voice-youzi-069 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "与本档案集《温州帮》对照：歌神打板接力、做情绪与人气；" ;
    ash:statementSpeaker "歌神" ;
    ash:statementType "tactic" ;
