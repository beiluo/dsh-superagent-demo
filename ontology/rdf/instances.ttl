    ash:isExample true ;
    ash:exampleNote "示例决策，用于展示高风险证券的观察与复核逻辑。"@zh .

ashd:rationale-ningyuan a owl:NamedIndividual, ash:DecisionRationale ;
    ash:rationaleText "收入与利润增速较快，储能业务提供第二增长曲线；但资产负债率 64.2%、利息保障倍数 4.1 倍，且行业价格竞争激烈，当前估值缺乏足够安全边际，因此给予观察而非增持。" ;
    ash:assumption "储能装机需求维持高增长；动力电池价格战在 2027 年缓和。" ;
    ash:counterArgument "若固态电池技术路线快速商业化，现有产线可能面临减值；若价格战延续，毛利率可能继续下行。" ;
    ash:hasEvidence ashd:evidence-ningyuan-report, ashd:evidence-ningyuan-quote ;
    rdfs:label "宁源新能源观察理由"@zh ;
    ash:isExample true .

ashd:check-ningyuan a owl:NamedIndividual, ash:ComplianceCheck ;
    ash:checksDecision ashd:decision-ningyuan-2026q4 ;
    ash:passed true ;
    ash:checkNote "通过：观察建议不涉及新增交易；若升级为买入，需触发高风险二次复核。" ;
    rdfs:label "宁源新能源决策合规检查"@zh ;
    ash:isExample true .

