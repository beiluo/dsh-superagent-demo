ashd:voice-youzi-349 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "交易明细（2018年8-10月）：富满电子867万、辽宁成大1120万、北方导航1761万、全通教育3085万、北新路桥1613万等——单笔千万级、分散于题材股首板。" ;
