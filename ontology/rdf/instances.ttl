ashd:voice-youzi-350 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "佛山无影脚（佛山系首板模式）：2018年3月1日5000万主封万兴科技首板、次日赚10%即出局，随后万兴连拉8板——用以论证首板阶段不可能看出妖股、重仓首板拿不住。" ;
    ash:statementSpeaker "欢乐海岸" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 8 ;
