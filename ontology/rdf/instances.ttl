ashd:case-huachen-held a owl:NamedIndividual,
        ash:AnalysisCase ;
    rdfs:label "华辰智造已持仓分析案例"@zh ;
    ash:caseAsOf "2026-11-03"^^xsd:date ;
    ash:caseId "AC-HC-20261103" ;
    ash:caseOfCompany ashd:company-huachen ;
    ash:caseOfSecurity ashd:sec-huachen-a ;
    ash:caseScenario ashs:scenario-held ;
    ash:caseScenarioCode "held" ;
    ash:caseSummary "已持仓场景：原始增持逻辑部分成立，但下午放量跌破 MA20 后收回、单票权重 12% 超过 10% 硬限额，判断由持有改为减仓至 10%。" ;
    ash:caseUsesEngine ashd:engine-decision,
        ashd:engine-event-cognition,
        ashd:engine-market-cognition,
        ashd:engine-opportunity,
        ashd:engine-stock-cognition ;
    ash:caseVersion 2 ;
    ash:hasEventCognition ashd:event-cognition-huachen-20261103 ;
    ash:hasMarketCognition ashd:market-cognition-20261103 ;
    ash:hasOpportunityAssessment ashd:opportunity-huachen-20261103 ;
    ash:hasOutcomeVerification ashd:verification-huachen-20261103 ;
    ash:hasSectorCognition ashd:sector-cognition-huachen-20261103 ;
    ash:hasStockCognition ashd:stock-cognition-huachen-20261103 ;
    ash:hasTradingJudgment ashd:judgment-huachen-20261103 ;
    ash:isExample true .

