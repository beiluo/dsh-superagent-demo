ashd:voice-youzi-357 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "题材炒作完整流程（自述）：时事热点/重大政策出现→影响上市公司→游资拉涨停推动股价→击鼓传花→炒作结束前获利撤退，\"股价都是从哪里来跌回哪里去\"。" ;
    ash:statementSpeaker "赵老哥" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 4 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "赵老哥 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-05 ash:hasStatement ashd:voice-youzi-357 .

ashd:voice-youzi-358 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "经典战役：万兴科技——开板首日买入一次次日小赚出局，\"二进宫\"于2018年3月2日打第二个板进入并锁仓，吃到主升，市值由55W拉至117W以上；" ;
    ash:statementSpeaker "退学炒股" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 4 ;
    ash:hasSkillTopic ashs:topic-trend ; ash:hasSkillTopic ashs:topic-lockup ; ash:hasSkillTopic ashs:topic-one-day ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "退学炒股 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-08 ash:hasStatement ashd:voice-youzi-358 .

ashd:voice-youzi-359 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "激活人气（出现任一必涨形态引人注目）→确立龙头（平淡开盘单边上涨，分时无阻力，出现\"挡刀\"股）→人气激发（先锋、龙头、助攻、后援齐备的板块发酵；" ;
    ash:statementSpeaker "凡倍无名" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 14 ;
    ash:hasSkillTopic ashs:topic-leader ; ash:hasSkillTopic ashs:topic-auction ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "凡倍无名 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-09 ash:hasStatement ashd:voice-youzi-359 .

ashd:voice-youzi-360 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "参与方式一（试错性低吸，左侧预判）：确认会龙回头后，大阴线见顶第二天尾盘低吸3成仓，第三天早盘若继续杀跌3%左右再加3成仓后停手，等龙回头出现；" ;
    ash:statementSpeaker "欢乐海岸" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 9 ;
    ash:hasSkillTopic ashs:topic-low-buy ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "欢乐海岸 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-11 ash:hasStatement ashd:voice-youzi-360 .

ashd:voice-youzi-361 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "浮盈不是利润，承受不了回撤就做不大：\"很多人之所以在整体上无法实现资金的增加，其中一个关键就在于他无法承受浮盈的回撤，其实浮盈根本不是你的利润。" ;
    ash:statementSpeaker "艾琳" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-account ; ash:hasSkillTopic ashs:topic-fundamental ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "艾琳 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-25 ash:hasStatement ashd:voice-youzi-361 .

ashd:voice-youzi-362 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 时间纪律：\"不要在弱势个股中耽误时间，不参与调整，被套后不要死拿——选错股不会妨碍我们做大，打板大面也不会妨碍我们做大，但是时间会！" ;
    ash:statementSpeaker "著名刺客" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 12 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "著名刺客 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-14 ash:hasStatement ashd:voice-youzi-362 .

ashd:voice-youzi-363 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "合理的预期来自复盘积累：\"基本上每个月都有2-3只牛股出来，三年就是100只左右，消息面+日线+分时结构+场内情绪情况我反正都是能背下来的。" ;
    ash:statementSpeaker "万狮虎" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 11 ;
    ash:hasSkillTopic ashs:topic-emotion ; ash:hasSkillTopic ashs:topic-auction ; ash:hasSkillTopic ashs:topic-review ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "万狮虎 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-16 ash:hasStatement ashd:voice-youzi-363 .

ashd:voice-youzi-364 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "妖股战法：选股性好、见板不坑人的票（\"只要是见板，你去打板，从不坑人\"），本质是筹码博弈——里面筹码有较高预期，涨停后次日仍有赚钱概率；" ;
    ash:statementSpeaker "孤独牛背" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 11 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-auction ; ash:hasSkillTopic ashs:topic-one-day ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "孤独牛背 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-19 ash:hasStatement ashd:voice-youzi-364 .

ashd:voice-youzi-365 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "确认后做三件事：判断至少上升高度与失误止损的比例是否合算（值不值做）、切入点在什么地方、资金进场的安排——\"最多一个晚上就能够想清楚\"。" ;
    ash:statementSpeaker "丁一熊" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 1 ;
    ash:hasSkillTopic ashs:topic-risk ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "丁一熊 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-29 ash:hasStatement ashd:voice-youzi-365 .

ashd:voice-youzi-366 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "追涨（半路）两类买点：机构买点=具备主升逻辑（研报发掘）、盘子稍大、相对独立非板块性行为，1.5%以下介入宜早不宜迟，错了损失也不大；" ;
    ash:statementSpeaker "凡倍无名" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 15 ;
    ash:hasSkillTopic ashs:topic-low-buy ; ash:hasSkillTopic ashs:topic-trend ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "凡倍无名 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-09 ash:hasStatement ashd:voice-youzi-366 .

ashd:voice-youzi-367 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "次日大幅低开后继续拉板、临近午盘换手够了封死涨停——证明昨日冲高回落只是上升中继，\"超预期就是买\"，且当时指数向上，可确认再起一波。" ;
    ash:statementSpeaker "欢乐海岸" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 10 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-relay ; ash:hasSkillTopic ashs:topic-auction ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "欢乐海岸 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-11 ash:hasStatement ashd:voice-youzi-367 .

ashd:voice-youzi-368 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "只看明天，不预测未来：\"做短线就看明天能做什么就行了，不要想着看到未来，看到三五天，赵老哥他们也不是能看到未来的，也是看明天来打板。" ;
    ash:statementSpeaker "92科比" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 7 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "92科比 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-20 ash:hasStatement ashd:voice-youzi-368 .

ashd:voice-youzi-369 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "\"割肉逻辑：按计划买卖的前提下若割完上涨，\"必然出现了一些你不可预知的因素……如果你不割肉赌会有大资金来拉抬股价，万一没有呢\"。" ;
    ash:statementSpeaker "退学炒股" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 5 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "退学炒股 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-08 ash:hasStatement ashd:voice-youzi-369 .

ashd:voice-youzi-370 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 空仓六义：避免亏损后的报复性买入、避免盈利后的得意性买入、看清市场踏准节奏、反省上笔亏损、等待大胜算机会、提高成功率。" ;
    ash:statementSpeaker "乔帮主" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 12 ;
    ash:hasSkillTopic ashs:topic-account ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "乔帮主 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-07 ash:hasStatement ashd:voice-youzi-370 .

ashd:voice-youzi-371 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "复盘方法：\"水平提升只能通过更多的交易次数达到是一种误解……一是盘中眼观八方不能只盯着自己已买的股票，二是进行更加仔细的复盘。" ;
    ash:statementSpeaker "退学炒股" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 6 ;
    ash:hasSkillTopic ashs:topic-review ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "退学炒股 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-08 ash:hasStatement ashd:voice-youzi-371 .

ashd:voice-youzi-372 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "作手新一（国泰君安南京太平南）、华鑫杭州飞云江、财富杭州西湖国贸：均有数路资金共用席位，上榜未必是本人——提醒不可迷信龙虎榜。" ;
    ash:statementSpeaker "欢乐海岸" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 11 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "欢乐海岸 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-11 ash:hasStatement ashd:voice-youzi-372 .

ashd:voice-youzi-373 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "交易明细显示其亦有\"买后次日/隔日卖出\"的动作（如新华传媒11-22买入2003万、11-27买入1816万并卖出1616万；" ;
    ash:statementSpeaker "庆春路" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-risk ; ash:hasSkillTopic ashs:topic-one-day ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "庆春路 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-35 ash:hasStatement ashd:voice-youzi-373 .

ashd:voice-youzi-374 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 控制买入位置：相对首板，其操作整体偏低位置（二板附近），牺牲少量空间换确定性，\"即使买错了一般不会出现较大的亏损\"。" ;
    ash:statementSpeaker "小鳄鱼" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 16 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-account ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "小鳄鱼 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-23 ash:hasStatement ashd:voice-youzi-374 .

ashd:voice-youzi-375 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "与清扬路（无锡清扬路）在1.27妖股战役中\"板上抬轿\"配合（瑞仙集合竞价引导涨停、银河绍兴7000手扫板、清扬路排板）。" ;
    ash:statementSpeaker "瑞鹤仙" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 7 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-auction ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "瑞鹤仙 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-04 ash:hasStatement ashd:voice-youzi-375 .

ashd:voice-youzi-376 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "题材炒作本质是击鼓传花：上涨中\"无脑相信这个故事\"，炒作结束\"一定要清醒地意识到，这仅仅是讲故事，都是假的\"，及时撤退。" ;
    ash:statementSpeaker "赵老哥" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 5 ;
    ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "赵老哥 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-05 ash:hasStatement ashd:voice-youzi-376 .

ashd:voice-youzi-377 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "竞价找异动：跳空高开(越大越好)+越临近9:25竞价越往上+成交额500万以上=主力资金关注+抢筹+人气足，顺势介入。" ;
    ash:statementSpeaker "游资通用方法论" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 14 ;
    ash:hasSkillTopic ashs:topic-auction ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "游资通用方法论 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-01 ash:hasStatement ashd:voice-youzi-377 .

ashd:voice-youzi-378 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "谁能够在股市大成，那一定是因为他在熊市中收获最多\"\"不能在熊市稳定盈利的，都是不可靠的盈利，时间长了最终都会还给市场。" ;
    ash:statementSpeaker "瑞鹤仙" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 8 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "瑞鹤仙 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-04 ash:hasStatement ashd:voice-youzi-378 .

ashd:voice-youzi-379 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "语料称其属于标准龙头战法，\"正是神车（中国中车行情）让赵老哥身价正式跨入了十亿级别\"（语料中转述者称其为\"赵亿万\"）。" ;
    ash:statementSpeaker "赵老哥" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 6 ;
    ash:hasSkillTopic ashs:topic-leader ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "赵老哥 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-05 ash:hasStatement ashd:voice-youzi-379 .

ashd:voice-youzi-380 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 仓位分层：小白轻仓体验，熟练后在确定性位置满仓干——\"妖股涨了40%，对你账户来说只盈利10%，意义并不大\"；" ;
    ash:statementSpeaker "欢乐海岸" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 12 ;
    ash:hasSkillTopic ashs:topic-account ; ash:hasSkillTopic ashs:topic-position ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "欢乐海岸 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-11 ash:hasStatement ashd:voice-youzi-380 .

ashd:voice-youzi-381 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "介入：交投犹豫时，利用资金优势直线拉升、不给喘息机会直接涨停，大笔9999手资金封死涨停，通常不撤单（\"独食侠\"）；" ;
    ash:statementSpeaker "佛山系" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 7 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "佛山系 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-21 ash:hasStatement ashd:voice-youzi-381 .

ashd:voice-youzi-382 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 抢反弹快进快出：\"打得赢就打，打不赢就跑，严格执行纪律，错了要坚决止损，千万不要短线做成中线，中线做成长线。" ;
    ash:statementSpeaker "落升" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 5 ;
    ash:hasSkillTopic ashs:topic-risk ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "落升 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-28 ash:hasStatement ashd:voice-youzi-382 .

ashd:voice-youzi-383 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "④高位横盘换手板——很少打早盘急拉板，偏爱午后高位充分换手后上板，\"炸板率更低，该抛的都抛了\"，追求稳定而非暴利。" ;
    ash:statementSpeaker "乔帮主" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 13 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-relay ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "乔帮主 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-07 ash:hasStatement ashd:voice-youzi-383 .

ashd:voice-youzi-384 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "与徐翔、万狮虎等相比，明王体系偏指数/均线/量能的技术流+反弹打法，而非纯情绪题材流（此为编者对照，非语料原文）。" ;
    ash:statementSpeaker "明王" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;
    ash:hasSkillTopic ashs:topic-emotion ; ash:hasSkillTopic ashs:topic-trend ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "明王 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-22 ash:hasStatement ashd:voice-youzi-384 .

ashd:voice-youzi-385 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "分析主流热点是谁/演变过程(领头羊/跟风/中军/赚钱效应/亏钱效应)/所处阶段(启动/发酵/高潮/反复)定策略。" ;
    ash:statementSpeaker "游资通用方法论" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 15 ;
    ash:hasSkillTopic ashs:topic-leader ; ash:hasSkillTopic ashs:topic-emotion ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "游资通用方法论 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-01 ash:hasStatement ashd:voice-youzi-385 .

ashd:voice-youzi-386 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "孙哥(孙国华)：中信上海溧阳路/上海溧海中路，以知获客以度作引导热点龙头，光大庆春路起家，2015因涉操纵被罚。" ;
    ash:statementSpeaker "游资通用方法论" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 16 ;
    ash:hasSkillTopic ashs:topic-leader ; ash:hasSkillTopic ashs:topic-theme ; ash:hasSkillTopic ashs:topic-regulatory ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "游资通用方法论 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-01 ash:hasStatement ashd:voice-youzi-386 .

ashd:voice-youzi-387 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "情绪是交易的核心变量：\"交易背后核心是人气情绪——主线行情中人气股第一次极端情绪表达，从极端恐慌逆转到极端贪婪。" ;
    ash:statementSpeaker "著名刺客" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 13 ;
    ash:hasSkillTopic ashs:topic-emotion ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "著名刺客 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-14 ash:hasStatement ashd:voice-youzi-387 .

ashd:voice-youzi-388 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "比价亏钱效应预判退潮法：把每天跌幅榜前50构建弱势组合，统计其当日平均跌幅、隔日开盘平均溢价、隔日收盘平均跌幅；" ;
    ash:statementSpeaker "万狮虎" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 12 ;
    ash:hasSkillTopic ashs:topic-emotion ; ash:hasSkillTopic ashs:topic-auction ; ash:hasSkillTopic ashs:topic-one-day ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "万狮虎 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-16 ash:hasStatement ashd:voice-youzi-388 .

ashd:voice-youzi-389 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 明确警示他人：\"超短线操作对技巧，经验，时间等因素要求很高，并不适合大多数人，希望大家不要盲目跟风效仿！" ;
    ash:statementSpeaker "独谷一箭" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-leader ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "独谷一箭 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-30 ash:hasStatement ashd:voice-youzi-389 .

ashd:voice-youzi-390 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "龙头战法核心步骤：\"第一时间发现市场的精神领袖，第一时间上了她，一直持有，直到发现市场新的精神领袖果断切换\"；" ;
    ash:statementSpeaker "赵老哥" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 7 ;
    ash:hasSkillTopic ashs:topic-leader ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "赵老哥 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-05 ash:hasStatement ashd:voice-youzi-390 .

ashd:voice-youzi-391 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "盘中破5日线卖出即使被洗也无条件执行，\"尾盘收回来再买回去就可以，相对于主升浪的大肉，卖飞这几个点又算什么呢。" ;
    ash:statementSpeaker "乔帮主" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 14 ;
    ash:hasSkillTopic ashs:topic-risk ; ash:hasSkillTopic ashs:topic-trend ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "乔帮主 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-07 ash:hasStatement ashd:voice-youzi-391 .

ashd:voice-youzi-392 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "盘中识别线索：近10个交易日有2个以上连续涨停、最好近5日有连续3板的个股，盘后以官方龙虎榜验证（有滞后性）。" ;
    ash:statementSpeaker "欢乐海岸" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 13 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "欢乐海岸 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-11 ash:hasStatement ashd:voice-youzi-392 .

ashd:voice-youzi-393 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "警惕一字板：板块上攻中出现大批一字板品种 → 成本断层、接力盘缺失，极易衰竭（叠加跟风品种不跟、交易所特停）；" ;
    ash:statementSpeaker "龙飞虎" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-relay ; ash:hasSkillTopic ashs:topic-leader ; ash:hasSkillTopic ashs:topic-lockup ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "龙飞虎 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-24 ash:hasStatement ashd:voice-youzi-393 .

ashd:voice-youzi-394 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "③回调空间——顶部最好回落20个点以上，否则反抽板距前高太近容易被砸（恒立实业回调不足，龙回头涨停无溢价）；" ;
    ash:statementSpeaker "欢乐海岸" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 14 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-low-buy ; ash:hasSkillTopic ashs:topic-one-day ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "欢乐海岸 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-11 ash:hasStatement ashd:voice-youzi-394 .

ashd:voice-youzi-395 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "排一字板：经常排一字板（在连续一字板的次新/重组股中排队买入），对 IPO 开板、连板节奏的把握是核心能力。" ;
    ash:statementSpeaker "一花残忆" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "一花残忆 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-37 ash:hasStatement ashd:voice-youzi-395 .

ashd:voice-youzi-396 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "只做业绩快速释放阶段：\"利润释放最快阶段给予估值最高，买就买这阶段——看似目光短浅，资金效率却最高、最快。" ;
    ash:statementSpeaker "万法归宗" ;
    ash:statementType "principle" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-fundamental ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "万法归宗 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-13 ash:hasStatement ashd:voice-youzi-396 .

ashd:voice-youzi-397 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "围绕当下主线做首板，尤爱\"主线+次新\"双属性（嘉城国际=上海自贸港+次新、爱乐达=毛衣战军工受益+次新）。" ;
    ash:statementSpeaker "著名刺客" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 14 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "著名刺客 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-14 ash:hasStatement ashd:voice-youzi-397 .

ashd:voice-youzi-398 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "为何读龙虎榜：①了解市场活跃度 ②跟踪主力资金进出 ③掌握游资/机构青睐的板块热点 ④判断涨跌由谁推动。" ;
    ash:statementSpeaker "游资通用方法论" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 17 ;
    ash:hasSkillTopic ashs:topic-dragon-tiger ; ash:hasSkillTopic ashs:topic-theme ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "游资通用方法论 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-01 ash:hasStatement ashd:voice-youzi-398 .

ashd:voice-youzi-399 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "短线以天为单位：\"超短是以天为单位计算收益的……一天赚1%，一年200个交易日是7倍多，前提是不能回撤。" ;
    ash:statementSpeaker "乔帮主" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 15 ;
    ash:hasSkillTopic ashs:topic-account ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "乔帮主 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-07 ash:hasStatement ashd:voice-youzi-399 .

ashd:voice-youzi-400 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 情绪隔离：\"不要让这次的操作影响你下次的情绪\"\"忘掉每一次交易的盈亏\"\"不可吃着碗里看着锅里\"。" ;
    ash:statementSpeaker "退学炒股" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 7 ;
    ash:hasSkillTopic ashs:topic-emotion ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "退学炒股 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-08 ash:hasStatement ashd:voice-youzi-400 .

ashd:voice-youzi-401 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 不抄无赚钱效应的底：\"抄底的核心赚钱原理是抄有上涨动力的底，而不是低吸盘无赚钱效应连续杀跌的底。" ;
    ash:statementSpeaker "凡倍无名" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 16 ;
    ash:hasSkillTopic ashs:topic-low-buy ; ash:hasSkillTopic ashs:topic-emotion ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "凡倍无名 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-09 ash:hasStatement ashd:voice-youzi-401 .

ashd:voice-youzi-402 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "反包二板：大资金都喜欢反包后第二个板去买——反包第一个板次日走势不确定可能被闷杀，再来一个板安全度很高；" ;
    ash:statementSpeaker "92科比" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 8 ;
    ash:hasSkillTopic ashs:topic-low-buy ; ash:hasSkillTopic ashs:topic-one-day ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "92科比 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-20 ash:hasStatement ashd:voice-youzi-402 .

ashd:voice-youzi-403 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 绝不做模式外的事：低吸股反身向上不追——\"看着低吸的模式做着追涨的事情\"是散户亏钱的真实根源；" ;
    ash:statementSpeaker "凡倍无名" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 17 ;
    ash:hasSkillTopic ashs:topic-low-buy ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "凡倍无名 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-09 ash:hasStatement ashd:voice-youzi-403 .

ashd:voice-youzi-404 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 不做加速板：分歧转一致（加速）那天可做可不做——做加速能赚钱，但买到假妖容易吃天地板，不划算。" ;
    ash:statementSpeaker "欢乐海岸" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 15 ;
    ash:hasSkillTopic ashs:topic-emotion ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "欢乐海岸 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-11 ash:hasStatement ashd:voice-youzi-404 .

ashd:voice-youzi-405 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "承接力判断（新股开板）：看流通盘与价格（例：2700万流通盘、22元）、新股开闸节奏、有无带头作用；" ;
    ash:statementSpeaker "榜中榜" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-relay ; ash:hasSkillTopic ashs:topic-lockup ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "榜中榜 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-33 ash:hasStatement ashd:voice-youzi-405 .

ashd:voice-youzi-406 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "体系第一义：只做最强，宁缺毋滥：\"多空仓，多看少做，做最强那几只，错过就等，不敢下手就等敢下手的。" ;
    ash:statementSpeaker "孤独牛背" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 12 ;

    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "孤独牛背 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-19 ash:hasStatement ashd:voice-youzi-406 .

ashd:voice-youzi-407 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "[ ] 回撤机理认知：连续成功后自信爆棚→把小概率当大概率→连续失败→回撤到\"上轮资金的起点\"；" ;
    ash:statementSpeaker "退学炒股" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 8 ;
    ash:hasSkillTopic ashs:topic-account ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "退学炒股 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-08 ash:hasStatement ashd:voice-youzi-407 .

ashd:voice-youzi-408 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "正常仓位阶段每股占总仓1/3，炸板亏10%对账户仅损3%，其余两只赚钱还能对冲——\"慢就是快\"。" ;
    ash:statementSpeaker "欢乐海岸" ;
    ash:statementType "warning" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 16 ;
    ash:hasSkillTopic ashs:topic-board ; ash:hasSkillTopic ashs:topic-account ; ash:hasSkillTopic ashs:topic-position ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "欢乐海岸 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-11 ash:hasStatement ashd:voice-youzi-408 .

ashd:voice-youzi-409 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "孤独牛背演讲提及：\"市场上做首板的资金很多，比如佛山，校长，还有成都一大批的资金，都是爱做首板。" ;
    ash:statementSpeaker "成都帮" ;
    ash:statementType "observation" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 2 ;
    ash:hasSkillTopic ashs:topic-board ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "成都帮 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-27 ash:hasStatement ashd:voice-youzi-409 .

ashd:voice-youzi-410 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "与本档案集《小鳄鱼》对照：同为超短，独股一箭是\"满仓单票、隔日必走、5日线低吸\"的低吸鼻祖打法；" ;
    ash:statementSpeaker "独谷一箭" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 3 ;
    ash:hasSkillTopic ashs:topic-low-buy ;
    ash:derivedFromSource ashd:source-youzi-mdpt ;
    rdfs:label "独谷一箭 · 原话摘录"@zh ;
    ash:isExample true .
ashd:skill-youzi-30 ash:hasStatement ashd:voice-youzi-410 .

ashd:voice-youzi-411 a owl:NamedIndividual, ash:TraderStatement ;
    ash:statementText "一旦到三四板就不适合接力——一般三四板时开始出货，最后剩一点仓位\"给你来个核按钮，可就凉凉了\"。" ;
    ash:statementSpeaker "温州帮" ;
    ash:statementType "tactic" ;
    ash:statementStatus "public-corpus-excerpt-unverified" ;
    ash:statementOrder 1 ;
    ash:hasSkillTopic ashs:topic-relay ; ash:hasSkillTopic ashs:topic-position ; ash:hasSkillTopic ashs:topic-lockup ;
