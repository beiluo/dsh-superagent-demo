ashs:playbook-first-board a skos:Concept ;
    skos:inScheme ashs:scheme-trading-playbook ;
    skos:topConceptOf ashs:scheme-trading-playbook ;
    skos:prefLabel "首板"@zh, "First Board"@en ;
    skos:notation "PB-FIRST" ;
    skos:definition "个股首次涨停，代表新题材或资金首次聚焦。"@zh .

ashs:playbook-second-board a skos:Concept ;
    skos:inScheme ashs:scheme-trading-playbook ;
    skos:topConceptOf ashs:scheme-trading-playbook ;
    skos:prefLabel "二板"@zh, "Second Board"@en ;
    skos:notation "PB-SECOND" ;
    skos:definition "首板后次日继续涨停，验证承接与题材延续。"@zh .

ashs:playbook-third-board a skos:Concept ;
    skos:inScheme ashs:scheme-trading-playbook ;
    skos:topConceptOf ashs:scheme-trading-playbook ;
    skos:prefLabel "三板以上"@zh, "Third Board Plus"@en ;
    skos:notation "PB-THIRD" ;
    skos:definition "连续三板及以上，进入高标与情绪核心区域。"@zh .

ashs:playbook-leader a skos:Concept ;
    skos:inScheme ashs:scheme-trading-playbook ;
    skos:topConceptOf ashs:scheme-trading-playbook ;
    skos:prefLabel "龙头"@zh, "Sector Leader"@en ;
    skos:notation "PB-LEADER" ;
    skos:definition "题材中涨幅、连板高度或成交额领先的核心标的。"@zh .

ashs:playbook-reversal a skos:Concept ;
    skos:inScheme ashs:scheme-trading-playbook ;
    skos:topConceptOf ashs:scheme-trading-playbook ;
    skos:prefLabel "反包"@zh, "Reversal"@en ;
    skos:notation "PB-REVERSAL" ;
    skos:definition "断板或调整后重新走强、收复失地的形态。"@zh .

ashs:playbook-low-buy a skos:Concept ;
    skos:inScheme ashs:scheme-trading-playbook ;
    skos:topConceptOf ashs:scheme-trading-playbook ;
    skos:prefLabel "低吸"@zh, "Buy the Dip"@en ;
    skos:notation "PB-LOWBUY" ;
    skos:definition "在分歧或回调时低吸，等待资金回流。"@zh .

ashs:playbook-half-way a skos:Concept ;
    skos:inScheme ashs:scheme-trading-playbook ;
    skos:topConceptOf ashs:scheme-trading-playbook ;
    skos:prefLabel "半路"@zh, "Half-Way Entry"@en ;
    skos:notation "PB-HALFWAY" ;
    skos:definition "在分时或盘中确认承接后介入，不追求最低点。"@zh .

ashs:playbook-seal a skos:Concept ;
    skos:inScheme ashs:scheme-trading-playbook ;
    skos:topConceptOf ashs:scheme-trading-playbook ;
    skos:prefLabel "打板"@zh, "Seal the Board"@en ;
    skos:notation "PB-SEAL" ;
    skos:definition "在涨停封板前买入，博弈次日溢价。"@zh .

ashs:playbook-relay a skos:Concept ;
    skos:inScheme ashs:scheme-trading-playbook ;
    skos:topConceptOf ashs:scheme-trading-playbook ;
    skos:prefLabel "接力"@zh, "Relay"@en ;
    skos:notation "PB-RELAY" ;
    skos:definition "在连板过程中接力，承担更高位的分歧风险。"@zh .

ashs:playbook-divergence a skos:Concept ;
    skos:inScheme ashs:scheme-trading-playbook ;
    skos:topConceptOf ashs:scheme-trading-playbook ;
    skos:prefLabel "分歧"@zh, "Divergence"@en ;
    skos:notation "PB-DIVERGENCE" ;
    skos:definition "市场对题材或个股产生分歧、换手放大的阶段。"@zh .

ashs:playbook-ebb a skos:Concept ;
    skos:inScheme ashs:scheme-trading-playbook ;
    skos:topConceptOf ashs:scheme-trading-playbook ;
    skos:prefLabel "退潮"@zh, "Ebb"@en ;
    skos:notation "PB-EBB" ;
    skos:definition "涨停减少、炸板率上升、赚钱效应下降的阶段。"@zh .

ashs:playbook-freeze a skos:Concept ;
    skos:inScheme ashs:scheme-trading-playbook ;
    skos:topConceptOf ashs:scheme-trading-playbook ;
    skos:prefLabel "冰点"@zh, "Freeze"@en ;
    skos:notation "PB-FREEZE" ;
    skos:definition "情绪与成交降至低位、亏钱效应显著的阶段。"@zh .

ashs:playbook-repair a skos:Concept ;
