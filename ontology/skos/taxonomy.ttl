    skos:prefLabel "修复"@zh, "Repair"@en ;
    skos:notation "PB-REPAIR" ;
    skos:definition "冰点后出现首板或反包、情绪开始修复的阶段。"@zh .

ashs:playbook-main-wave a skos:Concept ;
