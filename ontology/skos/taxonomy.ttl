# ===== Short-term trading playbook scheme =====
ashs:scheme-trading-playbook a skos:ConceptScheme ;
    skos:prefLabel "A 股短线剧本与催化（示例）"@zh, "A-Share Short-Term Playbooks (illustrative)"@en ;
    skos:definition "用于标注首板、连板、反包、低吸、退潮等短线剧本与政策/业绩/并购催化的概念方案。"@zh ;
