    skos:inScheme ashs:scheme-trading-playbook ;
    skos:topConceptOf ashs:scheme-trading-playbook ;
    skos:prefLabel "二板"@zh, "Second Board"@en ;
    skos:notation "PB-SECOND" ;
    skos:definition "首板后次日继续涨停，验证承接与题材延续。"@zh .

ashs:playbook-third-board a skos:Concept ;
    skos:inScheme ashs:scheme-trading-playbook ;
    skos:topConceptOf ashs:scheme-trading-playbook ;
