    ash:transitionOfMachine ashd:state-machine-unified ;
    ash:transitionFrom ashd:state-watching ;
    ash:transitionTo ashd:state-expired ;
    ash:transitionKind "expire" ;
    ash:transitionCondition "超过观察窗口仍无足够证据。" .

ashd:state-transition-expire-candidate
    a owl:NamedIndividual, ash:RuleStateTransition ;
    rdfs:label "CANDIDATE → EXPIRED"@zh, "CANDIDATE to EXPIRED"@en ;
    rdfs:comment "超过有效期仍未确认。"@zh ;
    ash:transitionOfMachine ashd:state-machine-unified ;
    ash:transitionFrom ashd:state-candidate ;
    ash:transitionTo ashd:state-expired ;
    ash:transitionKind "expire" ;
    ash:transitionCondition "超过有效期仍未确认。" .

ashd:state-transition-expire-triggered
    a owl:NamedIndividual, ash:RuleStateTransition ;
    rdfs:label "TRIGGERED → EXPIRED"@zh, "TRIGGERED to EXPIRED"@en ;
    rdfs:comment "触发后超过有效期未获确认。"@zh ;
    ash:transitionOfMachine ashd:state-machine-unified ;
