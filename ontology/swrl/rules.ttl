    ash:ruleVersion "1.8.0" ;
    ash:ruleOwner "游资规则组" ;
    ash:ruleCategory "执行" ;
    ash:ruleBasis "公开游资方法论/原话摘要；阈值为示例"@zh ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:TradingJournal ;
    ash:ruleUses ash:profitFactor ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:TradingJournal ; swrl:argument1 ashd:var-r151 ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:profitFactor ; swrl:argument1 ashd:var-r151 ; swrl:argument2 ashd:var-r151-v ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThan ; swrl:arguments ( ashd:var-r151-v "1"^^xsd:decimal ) ]
    ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ash:ExecutionViolation ; swrl:argument1 ashd:var-r151 ] ) .
ashd:var-r151 a swrl:Variable ; rdfs:label "?var-r151" .
ashd:var-r151-v a swrl:Variable ; rdfs:label "?var-r151-v" .


# ===========================================================================
# Domain expansion 1.3 — account, risk budget, trade point and review rules
# ===========================================================================

ashd:var-lc-plan a swrl:Variable ; rdfs:label "?plan" .
ashd:var-lc-sizing a swrl:Variable ; rdfs:label "?sizing" .
ashd:var-lc-portfolio a swrl:Variable ; rdfs:label "?portfolio" .
ashd:var-lc-budget a swrl:Variable ; rdfs:label "?riskBudget" .
ashd:var-lc-risk a swrl:Variable ; rdfs:label "?riskAmount" .
ashd:var-lc-risklimit a swrl:Variable ; rdfs:label "?riskPerTrade" .
ashd:var-lc-projected a swrl:Variable ; rdfs:label "?projectedWeight" .
ashd:var-lc-maxweight a swrl:Variable ; rdfs:label "?maxSingleNameWeight" .
ashd:var-lc-notional a swrl:Variable ; rdfs:label "?plannedNotional" .
ashd:var-lc-account a swrl:Variable ; rdfs:label "?account" .
ashd:var-lc-buying a swrl:Variable ; rdfs:label "?buyingPower" .
ashd:var-lc-position a swrl:Variable ; rdfs:label "?position" .
ashd:var-lc-state a swrl:Variable ; rdfs:label "?positionState" .
ashd:var-lc-stopnode a swrl:Variable ; rdfs:label "?stopPriceNode" .
ashd:var-lc-stop a swrl:Variable ; rdfs:label "?stopPrice" .
ashd:var-lc-targetnode a swrl:Variable ; rdfs:label "?targetPriceNode" .
ashd:var-lc-target a swrl:Variable ; rdfs:label "?targetPrice" .
ashd:var-lc-last a swrl:Variable ; rdfs:label "?lastPrice" .
ashd:var-lc-quality a swrl:Variable ; rdfs:label "?executionQuality" .
ashd:var-lc-slippage a swrl:Variable ; rdfs:label "?slippageBps" .
ashd:var-lc-review a swrl:Variable ; rdfs:label "?review" .
ashd:var-lc-overdue a swrl:Variable ; rdfs:label "?overdueDays" .
ashd:var-lc-finding a swrl:Variable ; rdfs:label "?finding" .
ashd:var-lc-severity a swrl:Variable ; rdfs:label "?findingSeverity" .
ashd:var-lc-occurrence a swrl:Variable ; rdfs:label "?occurrenceCount" .
ashd:var-lc-utilization a swrl:Variable ; rdfs:label "?riskUtilization" .
ashd:var-lc-limit a swrl:Variable ; rdfs:label "?riskLimit" .
ashd:var-lc-hard a swrl:Variable ; rdfs:label "?hardLimit" .
ashd:var-lc-utilpct a swrl:Variable ; rdfs:label "?utilizationPct" .

ashd:rule-risk-budget-exceeded
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R152" ;
    rdfs:label "风险预算超限"@zh, "Risk budget exceeded"@en ;
    rdfs:comment "组合风险预算使用率达到 100% 时，推断风险预算超限。"@zh ;
    ash:ruleIf "riskBudgetUtilization ≥ 100"@zh ;
    ash:ruleThen "风险预算被推断为 ash:RiskBudgetExceeded"@zh ;
    ash:severity "high" ;
    ash:rulePriority 5 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.3.0" ;
    ash:ruleOwner "风险管理部" ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:RiskBudget ;
    ash:ruleUses ash:riskBudgetUtilization ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:RiskBudget ; swrl:argument1 ashd:var-lc-budget ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:riskBudgetUtilization ; swrl:argument1 ashd:var-lc-budget ; swrl:argument2 ashd:var-lc-utilpct ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( ashd:var-lc-utilpct "100.0"^^xsd:decimal ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:RiskBudgetExceeded ; swrl:argument1 ashd:var-lc-budget ]
    ) .

ashd:rule-trade-risk-breach
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R153" ;
    rdfs:label "单笔风险超限"@zh, "Per-trade risk breach"@en ;
    rdfs:comment "交易计划的计划风险金额超过组合单笔风险预算时，推断仓位测算超限。"@zh ;
    ash:ruleIf "riskAmount > riskPerTrade"@zh ;
    ash:ruleThen "仓位测算被推断为 ash:PositionSizingBreach"@zh ;
    ash:severity "high" ;
    ash:rulePriority 6 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.3.0" ;
    ash:ruleOwner "风险管理部" ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:PositionSizing ;
    ash:ruleUses ash:hasTradeSizing, ash:riskAmount, ash:planForPortfolio, ash:hasRiskBudget, ash:riskPerTradeLimit ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:TradePlan ; swrl:argument1 ashd:var-lc-plan ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasTradeSizing ; swrl:argument1 ashd:var-lc-plan ; swrl:argument2 ashd:var-lc-sizing ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:riskAmount ; swrl:argument1 ashd:var-lc-sizing ; swrl:argument2 ashd:var-lc-risk ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:planForPortfolio ; swrl:argument1 ashd:var-lc-plan ; swrl:argument2 ashd:var-lc-portfolio ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasRiskBudget ; swrl:argument1 ashd:var-lc-portfolio ; swrl:argument2 ashd:var-lc-budget ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:riskPerTradeLimit ; swrl:argument1 ashd:var-lc-budget ; swrl:argument2 ashd:var-lc-risklimit ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-lc-risk ashd:var-lc-risklimit ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:PositionSizingBreach ; swrl:argument1 ashd:var-lc-sizing ]
    ) .

ashd:rule-projected-weight-breach
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R154" ;
    rdfs:label "预计权重超限"@zh, "Projected weight breach"@en ;
    rdfs:comment "买入计划执行后的预计单票权重超过风险预算的单票上限时，推断买入受阻。"@zh ;
    ash:ruleIf "projectedWeight > maxSingleNameWeight"@zh ;
    ash:ruleThen "买入计划被推断为 ash:EntryBlocked"@zh ;
    ash:severity "high" ;
    ash:rulePriority 7 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.3.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:EntryPlan ;
    ash:ruleUses ash:hasTradeSizing, ash:projectedWeight, ash:planForPortfolio, ash:hasRiskBudget, ash:maxSingleNameWeight ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:EntryPlan ; swrl:argument1 ashd:var-lc-plan ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasTradeSizing ; swrl:argument1 ashd:var-lc-plan ; swrl:argument2 ashd:var-lc-sizing ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:projectedWeight ; swrl:argument1 ashd:var-lc-sizing ; swrl:argument2 ashd:var-lc-projected ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:planForPortfolio ; swrl:argument1 ashd:var-lc-plan ; swrl:argument2 ashd:var-lc-portfolio ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasRiskBudget ; swrl:argument1 ashd:var-lc-portfolio ; swrl:argument2 ashd:var-lc-budget ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:maxSingleNameWeight ; swrl:argument1 ashd:var-lc-budget ; swrl:argument2 ashd:var-lc-maxweight ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-lc-projected ashd:var-lc-maxweight ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:EntryBlocked ; swrl:argument1 ashd:var-lc-plan ]
    ) .

ashd:rule-buying-power-breach
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R155" ;
    rdfs:label "购买力不足"@zh, "Insufficient buying power"@en ;
    rdfs:comment "买入计划金额超过账户购买力时，推断购买力不足。"@zh ;
    ash:ruleIf "plannedNotional > buyingPower"@zh ;
    ash:ruleThen "买入计划被推断为 ash:BuyingPowerInsufficient"@zh ;
    ash:severity "high" ;
    ash:rulePriority 8 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.3.0" ;
    ash:ruleOwner "交易运营组" ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:EntryPlan ;
    ash:ruleUses ash:plannedNotional, ash:planForAccount, ash:buyingPower ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:EntryPlan ; swrl:argument1 ashd:var-lc-plan ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:plannedNotional ; swrl:argument1 ashd:var-lc-plan ; swrl:argument2 ashd:var-lc-notional ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:planForAccount ; swrl:argument1 ashd:var-lc-plan ; swrl:argument2 ashd:var-lc-account ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:buyingPower ; swrl:argument1 ashd:var-lc-account ; swrl:argument2 ashd:var-lc-buying ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-lc-notional ashd:var-lc-buying ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:BuyingPowerInsufficient ; swrl:argument1 ashd:var-lc-plan ]
    ) .

ashd:rule-stop-price-breached
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R156" ;
    rdfs:label "止损价触发"@zh, "Stop price breached"@en ;
    rdfs:comment "持仓最新价低于或等于退出计划的止损价时，推断止损价触发。"@zh ;
    ash:ruleIf "stateLastPrice ≤ stopPrice"@zh ;
    ash:ruleThen "持仓被推断为 ash:StopPriceBreached"@zh ;
    ash:severity "high" ;
    ash:rulePriority 4 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.3.0" ;
    ash:ruleOwner "风险管理部" ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:Position ;
    ash:ruleUses ash:exitPlanForPosition, ash:hasStopPrice, ash:priceLevelValue, ash:hasPositionState, ash:stateLastPrice ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:ExitPlan ; swrl:argument1 ashd:var-lc-plan ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:exitPlanForPosition ; swrl:argument1 ashd:var-lc-plan ; swrl:argument2 ashd:var-lc-position ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasStopPrice ; swrl:argument1 ashd:var-lc-plan ; swrl:argument2 ashd:var-lc-stopnode ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:priceLevelValue ; swrl:argument1 ashd:var-lc-stopnode ; swrl:argument2 ashd:var-lc-stop ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasPositionState ; swrl:argument1 ashd:var-lc-position ; swrl:argument2 ashd:var-lc-state ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:stateLastPrice ; swrl:argument1 ashd:var-lc-state ; swrl:argument2 ashd:var-lc-last ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThanOrEqual ; swrl:arguments ( ashd:var-lc-last ashd:var-lc-stop ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:StopPriceBreached ; swrl:argument1 ashd:var-lc-position ]
    ) .

ashd:rule-target-reached
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R157" ;
    rdfs:label "目标价到达"@zh, "Target price reached"@en ;
    rdfs:comment "持仓最新价达到或超过退出计划的目标价时，推断目标价到达。"@zh ;
    ash:ruleIf "stateLastPrice ≥ targetPrice"@zh ;
    ash:ruleThen "持仓被推断为 ash:TakeProfitReached"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 12 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.3.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:Position ;
    ash:ruleUses ash:exitPlanForPosition, ash:hasTargetPrice, ash:priceLevelValue, ash:hasPositionState, ash:stateLastPrice ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:ExitPlan ; swrl:argument1 ashd:var-lc-plan ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:exitPlanForPosition ; swrl:argument1 ashd:var-lc-plan ; swrl:argument2 ashd:var-lc-position ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasTargetPrice ; swrl:argument1 ashd:var-lc-plan ; swrl:argument2 ashd:var-lc-targetnode ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:priceLevelValue ; swrl:argument1 ashd:var-lc-targetnode ; swrl:argument2 ashd:var-lc-target ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasPositionState ; swrl:argument1 ashd:var-lc-position ; swrl:argument2 ashd:var-lc-state ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:stateLastPrice ; swrl:argument1 ashd:var-lc-state ; swrl:argument2 ashd:var-lc-last ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( ashd:var-lc-last ashd:var-lc-target ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:TakeProfitReached ; swrl:argument1 ashd:var-lc-position ]
    ) .

ashd:rule-execution-slippage
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R158" ;
    rdfs:label "执行滑点超限"@zh, "Execution slippage breach"@en ;
    rdfs:comment "成交滑点超过 50 个基点时，推断执行滑点超限。"@zh ;
    ash:ruleIf "slippageBps > 50"@zh ;
    ash:ruleThen "执行质量被推断为 ash:ExecutionSlippageBreach"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 15 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.3.0" ;
    ash:ruleOwner "交易运营组" ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:ExecutionQuality ;
    ash:ruleUses ash:slippageBps ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:ExecutionQuality ; swrl:argument1 ashd:var-lc-quality ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:slippageBps ; swrl:argument1 ashd:var-lc-quality ; swrl:argument2 ashd:var-lc-slippage ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-lc-slippage "50.0"^^xsd:decimal ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:ExecutionSlippageBreach ; swrl:argument1 ashd:var-lc-quality ]
    ) .

ashd:rule-review-overdue
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R159" ;
    rdfs:label "复盘逾期"@zh, "Review overdue"@en ;
    rdfs:comment "交易后复盘逾期 5 天及以上时，推断复盘逾期。"@zh ;
    ash:ruleIf "reviewOverdueDays ≥ 5"@zh ;
    ash:ruleThen "复盘被推断为 ash:ReviewOverdue"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 18 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.3.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:PostTradeReview ;
    ash:ruleUses ash:reviewOverdueDays ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:PostTradeReview ; swrl:argument1 ashd:var-lc-review ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:reviewOverdueDays ; swrl:argument1 ashd:var-lc-review ; swrl:argument2 ashd:var-lc-overdue ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( ashd:var-lc-overdue "5"^^xsd:integer ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:ReviewOverdue ; swrl:argument1 ashd:var-lc-review ]
    ) .

ashd:rule-recurring-finding
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R160" ;
    rdfs:label "重复高严重度发现"@zh, "Recurring high-severity finding"@en ;
    rdfs:comment "高严重度复盘发现重复出现 2 次及以上时，推断需要规则修订。"@zh ;
    ash:ruleIf "findingSeverity = high 且 findingOccurrenceCount ≥ 2"@zh ;
    ash:ruleThen "复盘发现被推断为 ash:RuleRevisionRequired"@zh ;
    ash:severity "high" ;
    ash:rulePriority 14 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.3.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:ReviewFinding ;
    ash:ruleUses ash:findingSeverity, ash:findingOccurrenceCount ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:ReviewFinding ; swrl:argument1 ashd:var-lc-finding ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:findingSeverity ; swrl:argument1 ashd:var-lc-finding ; swrl:argument2 ashd:var-lc-severity ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( ashd:var-lc-severity "high"^^xsd:string ) ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:findingOccurrenceCount ; swrl:argument1 ashd:var-lc-finding ; swrl:argument2 ashd:var-lc-occurrence ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( ashd:var-lc-occurrence "2"^^xsd:integer ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:RuleRevisionRequired ; swrl:argument1 ashd:var-lc-finding ]
    ) .

ashd:rule-hard-limit-halt
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R161" ;
    rdfs:label "硬性限额暂停交易"@zh, "Hard limit trading halt"@en ;
    rdfs:comment "硬性风险限额使用率达到 100% 时，推断暂停新增风险敞口。"@zh ;
    ash:ruleIf "riskLimitHard = true 且 riskUtilizationPct ≥ 100"@zh ;
    ash:ruleThen "风险使用率被推断为 ash:TradingHalted"@zh ;
    ash:severity "high" ;
    ash:rulePriority 3 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.3.0" ;
    ash:ruleOwner "风险管理部" ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:RiskUtilization ;
    ash:ruleUses ash:utilizationOfLimit, ash:riskLimitHard, ash:riskUtilizationPct ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:RiskUtilization ; swrl:argument1 ashd:var-lc-utilization ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:utilizationOfLimit ; swrl:argument1 ashd:var-lc-utilization ; swrl:argument2 ashd:var-lc-limit ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:riskLimitHard ; swrl:argument1 ashd:var-lc-limit ; swrl:argument2 ashd:var-lc-hard ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( ashd:var-lc-hard "true"^^xsd:boolean ) ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:riskUtilizationPct ; swrl:argument1 ashd:var-lc-utilization ; swrl:argument2 ashd:var-lc-utilpct ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( ashd:var-lc-utilpct "100.0"^^xsd:decimal ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:TradingHalted ; swrl:argument1 ashd:var-lc-utilization ]
    ) .

# ===========================================================================
# Domain expansion 1.10 — trading cognition rules
# ===========================================================================
# These rules encode only monotone gates from the cognition pipeline:
# market veto, risk-reward threshold, counter-evidence completeness, stage
# consistency, judgment versioning and outcome verification. Scenario-specific
# position sizing and human approval remain outside SWRL.

ashd:rule-cognition-market-veto
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R162" ;
    rdfs:label "市场风险偏好否决"@zh, "Market risk-appetite veto"@en ;
    rdfs:comment "市场认知的风险偏好分数低于 30 时，推断市场否决，新增风险敞口应暂停。"@zh ;
    ash:ruleIf "marketRiskAppetiteScore < 30"@zh ;
    ash:ruleThen "市场认知被推断为 ash:MarketVeto"@zh ;
    ash:severity "high" ;
    ash:rulePriority 2 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.11.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:ruleCategory "认知" ;
    ash:ruleBasis "Issue #22 的市场环境否决原则；阈值为示例"@zh ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:MarketCognition ;
    ash:ruleUses ash:marketRiskAppetiteScore ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:MarketCognition ; swrl:argument1 ashd:var-cog-market ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:marketRiskAppetiteScore ; swrl:argument1 ashd:var-cog-market ; swrl:argument2 ashd:var-cog-appetite ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThan ; swrl:arguments ( ashd:var-cog-appetite "30.0"^^xsd:decimal ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:MarketVeto ; swrl:argument1 ashd:var-cog-market ]
    ) .
ashd:var-cog-market a swrl:Variable ; rdfs:label "?marketCognition" .
ashd:var-cog-appetite a swrl:Variable ; rdfs:label "?riskAppetiteScore" .

ashd:rule-cognition-risk-reward
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R163" ;
    rdfs:label "风险收益不足"@zh, "Risk-reward insufficient"@en ;
    rdfs:comment "预期盈亏比低于 2.0 时，推断风险收益不足，机会即使成立也不值得重仓。"@zh ;
    ash:ruleIf "expectedRewardRiskRatio < 2.0"@zh ;
    ash:ruleThen "风险收益评估被推断为 ash:RiskRewardInsufficient"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 9 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.11.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:ruleCategory "认知" ;
    ash:ruleBasis "Issue #22 的风险收益门槛；阈值为示例"@zh ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:RiskRewardAssessment ;
    ash:ruleUses ash:expectedRewardRiskRatio ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:RiskRewardAssessment ; swrl:argument1 ashd:var-cog-rr ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:expectedRewardRiskRatio ; swrl:argument1 ashd:var-cog-rr ; swrl:argument2 ashd:var-cog-rrvalue ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThan ; swrl:arguments ( ashd:var-cog-rrvalue "2.0"^^xsd:decimal ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:RiskRewardInsufficient ; swrl:argument1 ashd:var-cog-rr ]
    ) .
ashd:var-cog-rr a swrl:Variable ; rdfs:label "?riskReward" .
ashd:var-cog-rrvalue a swrl:Variable ; rdfs:label "?rewardRiskRatio" .

ashd:rule-cognition-counter-evidence
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R164" ;
    rdfs:label "反向证据未审查"@zh, "Counter-evidence not reviewed"@en ;
    rdfs:comment "存在反向证据但没有完成审查时，推断判断证据不完整。"@zh ;
    ash:ruleIf "counterEvidenceCount ≥ 1 且 counterEvidenceReviewed = false"@zh ;
    ash:ruleThen "机会评估被推断为 ash:JudgmentIncomplete"@zh ;
    ash:severity "high" ;
    ash:rulePriority 8 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.11.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:ruleCategory "认知" ;
    ash:ruleBasis "Issue #22 的反向证据审查原则；阈值为示例"@zh ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:OpportunityAssessment ;
    ash:ruleUses ash:counterEvidenceCount, ash:counterEvidenceReviewed ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:OpportunityAssessment ; swrl:argument1 ashd:var-cog-opp ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:counterEvidenceCount ; swrl:argument1 ashd:var-cog-opp ; swrl:argument2 ashd:var-cog-count ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( ashd:var-cog-count "1"^^xsd:integer ) ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:counterEvidenceReviewed ; swrl:argument1 ashd:var-cog-opp ; swrl:argument2 ashd:var-cog-reviewed ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( ashd:var-cog-reviewed "false"^^xsd:boolean ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:JudgmentIncomplete ; swrl:argument1 ashd:var-cog-opp ]
    ) .
ashd:var-cog-opp a swrl:Variable ; rdfs:label "?opportunity" .
ashd:var-cog-count a swrl:Variable ; rdfs:label "?counterEvidenceCount" .
ashd:var-cog-reviewed a swrl:Variable ; rdfs:label "?counterEvidenceReviewed" .

ashd:rule-cognition-decline-buy
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R165" ;
    rdfs:label "衰退期买入阻断"@zh, "Entry blocked in declining opportunity"@en ;
    rdfs:comment "机会阶段已进入衰退而判断仍为买入时，推断买入受阻。"@zh ;
    ash:ruleIf "opportunityStageCode = decline 且 judgmentDecisionCode = buy"@zh ;
    ash:ruleThen "交易判断被推断为 ash:EntryBlocked"@zh ;
    ash:severity "high" ;
    ash:rulePriority 6 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.11.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:ruleCategory "认知" ;
    ash:ruleBasis "Issue #22 的机会阶段与决策一致性原则；阈值为示例"@zh ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:TradingJudgment ;
    ash:ruleUses ash:judgmentFromAssessment, ash:opportunityStageCode, ash:judgmentDecisionCode ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:TradingJudgment ; swrl:argument1 ashd:var-cog-judgment ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:judgmentDecisionCode ; swrl:argument1 ashd:var-cog-judgment ; swrl:argument2 ashd:var-cog-decision ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( ashd:var-cog-decision "buy"^^xsd:string ) ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:judgmentFromAssessment ; swrl:argument1 ashd:var-cog-judgment ; swrl:argument2 ashd:var-cog-assessment ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:opportunityStageCode ; swrl:argument1 ashd:var-cog-assessment ; swrl:argument2 ashd:var-cog-stage ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( ashd:var-cog-stage "decline"^^xsd:string ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:EntryBlocked ; swrl:argument1 ashd:var-cog-judgment ]
    ) .
ashd:var-cog-judgment a swrl:Variable ; rdfs:label "?tradingJudgment" .
ashd:var-cog-decision a swrl:Variable ; rdfs:label "?judgmentDecisionCode" .
ashd:var-cog-assessment a swrl:Variable ; rdfs:label "?opportunityAssessment" .
ashd:var-cog-stage a swrl:Variable ; rdfs:label "?opportunityStageCode" .

ashd:rule-cognition-judgment-revised
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R166" ;
    rdfs:label "判断版本已更新"@zh, "Judgment version updated"@en ;
    rdfs:comment "判断修订后的版本号高于修订前版本号时，推断判断已更新。"@zh ;
    ash:ruleIf "revisionToVersion > revisionFromVersion"@zh ;
    ash:ruleThen "判断修订被推断为 ash:JudgmentUpdated"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 20 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.11.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:ruleCategory "认知" ;
    ash:ruleBasis "Issue #22 的判断版本化要求；阈值为示例"@zh ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:JudgmentRevision ;
    ash:ruleUses ash:revisionFromVersion, ash:revisionToVersion ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:JudgmentRevision ; swrl:argument1 ashd:var-cog-revision ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:revisionFromVersion ; swrl:argument1 ashd:var-cog-revision ; swrl:argument2 ashd:var-cog-from ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:revisionToVersion ; swrl:argument1 ashd:var-cog-revision ; swrl:argument2 ashd:var-cog-to ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-cog-to ashd:var-cog-from ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:JudgmentUpdated ; swrl:argument1 ashd:var-cog-revision ]
    ) .
ashd:var-cog-revision a swrl:Variable ; rdfs:label "?judgmentRevision" .
ashd:var-cog-from a swrl:Variable ; rdfs:label "?fromVersion" .
ashd:var-cog-to a swrl:Variable ; rdfs:label "?toVersion" .

ashd:rule-cognition-logic-invalidated
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R167" ;
    rdfs:label "结果证伪逻辑"@zh, "Outcome invalidated logic"@en ;
    ash:ruleIf "verificationLogicStillValid = false"@zh ;
    ash:ruleThen "结果验证被推断为 ash:LogicInvalidated"@zh ;
    ash:severity "high" ;
    ash:rulePriority 4 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.11.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:ruleCategory "验证" ;
    ash:ruleBasis "Issue #22 的结果验证原则；阈值为示例"@zh ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:OutcomeVerification ;
    ash:ruleUses ash:verificationLogicStillValid ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:OutcomeVerification ; swrl:argument1 ashd:var-cog-verification ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:verificationLogicStillValid ; swrl:argument1 ashd:var-cog-verification ; swrl:argument2 ashd:var-cog-valid ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( ashd:var-cog-valid "false"^^xsd:boolean ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:LogicInvalidated ; swrl:argument1 ashd:var-cog-verification ]
    ) .
ashd:var-cog-verification a swrl:Variable ; rdfs:label "?outcomeVerification" .
ashd:var-cog-valid a swrl:Variable ; rdfs:label "?logicStillValid" .

ashd:rule-cognition-held-invalid
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R168" ;
    rdfs:label "持仓逻辑失效"@zh, "Held logic invalidated"@en ;
    rdfs:comment "已持仓判断的原始逻辑不再成立时，推断需要减仓或退出。"@zh ;
    ash:ruleIf "judgmentScenarioCode = held 且 judgmentLogicStillValid = false"@zh ;
    ash:ruleThen "交易判断被推断为 ash:ExitRequired"@zh ;
    ash:severity "high" ;
    ash:rulePriority 3 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.11.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:ruleCategory "认知" ;
    ash:ruleBasis "Issue #22 的持仓管理原则；阈值为示例"@zh ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:TradingJudgment ;
    ash:ruleUses ash:judgmentScenarioCode, ash:judgmentLogicStillValid ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:TradingJudgment ; swrl:argument1 ashd:var-cog-held ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:judgmentScenarioCode ; swrl:argument1 ashd:var-cog-held ; swrl:argument2 ashd:var-cog-scenario ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( ashd:var-cog-scenario "held"^^xsd:string ) ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:judgmentLogicStillValid ; swrl:argument1 ashd:var-cog-held ; swrl:argument2 ashd:var-cog-held-valid ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( ashd:var-cog-held-valid "false"^^xsd:boolean ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:ExitRequired ; swrl:argument1 ashd:var-cog-held ]
    ) .
ashd:var-cog-held a swrl:Variable ; rdfs:label "?heldJudgment" .
ashd:var-cog-scenario a swrl:Variable ; rdfs:label "?judgmentScenarioCode" .
ashd:var-cog-held-valid a swrl:Variable ; rdfs:label "?judgmentLogicStillValid" .

ashd:rule-cognition-opportunity-invalidated
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R169" ;
    rdfs:label "机会阶段衰退"@zh, "Opportunity stage declined"@en ;
    ash:ruleIf "opportunityStageCode = decline"@zh ;
    ash:ruleThen "机会评估被推断为 ash:OpportunityInvalidated"@zh ;
    ash:severity "high" ;
    ash:rulePriority 7 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.11.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:ruleCategory "认知" ;
    ash:ruleBasis "Issue #22 的机会阶段原则；阈值为示例"@zh ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:OpportunityAssessment ;
    ash:ruleUses ash:opportunityStageCode ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:OpportunityAssessment ; swrl:argument1 ashd:var-cog-decline ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:opportunityStageCode ; swrl:argument1 ashd:var-cog-decline ; swrl:argument2 ashd:var-cog-decline-code ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( ashd:var-cog-decline-code "decline"^^xsd:string ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:OpportunityInvalidated ; swrl:argument1 ashd:var-cog-decline ]
    ) .
ashd:var-cog-decline a swrl:Variable ; rdfs:label "?decliningOpportunity" .
ashd:var-cog-decline-code a swrl:Variable ; rdfs:label "?declineStageCode" .

# ===========================================================================
# Rule library V2.0 — 60 declarative A-share decision rules (Issue #25)
# ===========================================================================
# These individuals are RuleArtifact specifications, not swrl:Imp Horn rules.
# They share the unified state machine, category layering, evidence/data
# quality conventions and output contract defined in the RDFS layer. They
# describe states and evidence; they never issue a trading instruction.
ashd:rule-library-v2
    a owl:NamedIndividual, ash:RuleLibrary ;
    rdfs:label "A 股投资决策规则库 V2.0"@zh, "A-Share Investment Decision Rule Library V2.0"@en ;
    rdfs:comment "60 条可解释、可验证、可追踪的 A 股投资决策规则；阈值均为待回测初始参数，输出是状态与证据而不是交易指令。"@zh ;
    ash:ruleLibraryVersion "2.0.0" ;
    ash:ruleLibraryCount 60 ;
    ash:ruleLibraryPrinciple "规则不是打分器：不把 60 条规则简单加权成一个总分；每条规则输出状态、证据、适用边界、后续动作和置信度依据。" ;
    ash:ruleLibraryPrinciple "职责分层：OP、VP、AUC、MKT、EVT、POS、RSK、EVA 各司其职，类别之间不越权。" ;
    ash:ruleLibraryPrinciple "统一状态机：状态迁移必须保留时间戳、触发证据、反向证据和数据版本；失效后重新出现要建立新的信号实例。" ;
    ash:ruleLibraryPrinciple "证据优先：关键输入缺失时输出 DATA_INSUFFICIENT；新闻转载和二次解读不得重复计数；历史回测必须包含退市、停牌和风险警示样本。" ;
    ash:ruleLibraryDisclaimer "本文中的阈值均为待验证的初始参数，不是已证明有效的最优值，更不是收益承诺。规则输出是状态与证据，不是直接交易指令；最终交易必须经过风险预算、组合约束、交易授权和交易所规则校验。" ;
    ash:ruleOutputStandard "rule_id、security_id、as_of、timeframe、position_state、state、trigger_evidence[]、supporting_evidence[]、contrary_evidence[]、missing_data[]、parameters_version、valid_until、next_actions[]、source_refs[]、confidence_basis" ;
    ash:libraryUsesStateMachine ashd:state-machine-unified ;
    ash:libraryHasCategory ashd:category-op ;
    ash:libraryHasCategory ashd:category-vp ;
    ash:libraryHasCategory ashd:category-auc ;
    ash:libraryHasCategory ashd:category-mkt ;
    ash:libraryHasCategory ashd:category-evt ;
    ash:libraryHasCategory ashd:category-pos ;
    ash:libraryHasCategory ashd:category-rsk ;
    ash:libraryHasCategory ashd:category-eva ;
    ash:libraryHasRule ashd:rule-op-001 ;
    ash:libraryHasRule ashd:rule-op-002 ;
    ash:libraryHasRule ashd:rule-op-003 ;
    ash:libraryHasRule ashd:rule-op-004 ;
    ash:libraryHasRule ashd:rule-op-005 ;
    ash:libraryHasRule ashd:rule-op-006 ;
    ash:libraryHasRule ashd:rule-op-007 ;
    ash:libraryHasRule ashd:rule-op-008 ;
    ash:libraryHasRule ashd:rule-op-009 ;
    ash:libraryHasRule ashd:rule-op-010 ;
    ash:libraryHasRule ashd:rule-vp-001 ;
    ash:libraryHasRule ashd:rule-vp-002 ;
    ash:libraryHasRule ashd:rule-vp-003 ;
    ash:libraryHasRule ashd:rule-vp-004 ;
    ash:libraryHasRule ashd:rule-vp-005 ;
    ash:libraryHasRule ashd:rule-vp-006 ;
    ash:libraryHasRule ashd:rule-vp-007 ;
    ash:libraryHasRule ashd:rule-vp-008 ;
    ash:libraryHasRule ashd:rule-auc-001 ;
    ash:libraryHasRule ashd:rule-auc-002 ;
    ash:libraryHasRule ashd:rule-auc-003 ;
    ash:libraryHasRule ashd:rule-auc-004 ;
    ash:libraryHasRule ashd:rule-auc-005 ;
    ash:libraryHasRule ashd:rule-auc-006 ;
    ash:libraryHasRule ashd:rule-mkt-001 ;
    ash:libraryHasRule ashd:rule-mkt-002 ;
    ash:libraryHasRule ashd:rule-mkt-003 ;
    ash:libraryHasRule ashd:rule-mkt-004 ;
    ash:libraryHasRule ashd:rule-mkt-005 ;
    ash:libraryHasRule ashd:rule-mkt-006 ;
    ash:libraryHasRule ashd:rule-mkt-007 ;
    ash:libraryHasRule ashd:rule-evt-001 ;
    ash:libraryHasRule ashd:rule-evt-002 ;
    ash:libraryHasRule ashd:rule-evt-003 ;
    ash:libraryHasRule ashd:rule-evt-004 ;
    ash:libraryHasRule ashd:rule-evt-005 ;
    ash:libraryHasRule ashd:rule-evt-006 ;
    ash:libraryHasRule ashd:rule-pos-001 ;
    ash:libraryHasRule ashd:rule-pos-002 ;
    ash:libraryHasRule ashd:rule-pos-003 ;
    ash:libraryHasRule ashd:rule-pos-004 ;
    ash:libraryHasRule ashd:rule-pos-005 ;
    ash:libraryHasRule ashd:rule-pos-006 ;
    ash:libraryHasRule ashd:rule-pos-007 ;
    ash:libraryHasRule ashd:rule-pos-008 ;
    ash:libraryHasRule ashd:rule-rsk-001 ;
    ash:libraryHasRule ashd:rule-rsk-002 ;
    ash:libraryHasRule ashd:rule-rsk-003 ;
    ash:libraryHasRule ashd:rule-rsk-004 ;
