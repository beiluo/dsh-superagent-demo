# ---------------------------------------------------------------------------
# A-Share Investment Decision Ontology — SWRL rule layer
# ---------------------------------------------------------------------------
# SWRL (W3C Member Submission, 2004) is encoded with the RDF concrete syntax:
# swrl:Imp / swrl:body / swrl:head / swrl:ClassAtom /
# swrl:IndividualPropertyAtom / swrl:DatavaluedPropertyAtom /
# swrl:BuiltinAtom / swrl:Variable and the swrlb: built-in library.
#
# The rules are declarative and side-effect free. A production engine must add
# data-freshness, conflict handling and human-approval gates outside SWRL.
# ---------------------------------------------------------------------------
@prefix ash:     <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#> .
@prefix ashd:    <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/data#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl:    <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb:   <http://www.w3.org/2003/11/swrlb#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/swrl>
    a owl:Ontology ;
    owl:imports <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/owl> ;
    dcterms:title "A-Share Investment Decision Ontology — SWRL rules"@en ;
    dcterms:title "A 股投资决策本体 — SWRL 规则层"@zh ;
    dcterms:description "Executable decision and risk rules encoded with the SWRL RDF concrete syntax."@en ;
    dcterms:description "使用 SWRL RDF 具体语法编码的可执行决策与风险规则。"@zh ;
    dcterms:conformsTo <https://www.w3.org/Submission/SWRL/> ;
    rdfs:seeAlso <https://www.w3.org/Submission/SWRL/> ;
    owl:versionInfo "1.11.0" ;
    ash:designNote "SWRL 是 W3C Member Submission，不是 Recommendation；本层明确标注规范状态，并在工程实现中由规则引擎执行。"@zh .

# ===========================================================================
# Variables
# ===========================================================================

ashd:var-company a swrl:Variable ; rdfs:label "?company" .
ashd:var-report a swrl:Variable ; rdfs:label "?report" .
ashd:var-stock a swrl:Variable ; rdfs:label "?stock" .
ashd:var-valuation a swrl:Variable ; rdfs:label "?valuation" .
ashd:var-roe a swrl:Variable ; rdfs:label "?roe" .
ashd:var-pe a swrl:Variable ; rdfs:label "?pe" .
ashd:var-profit a swrl:Variable ; rdfs:label "?profit" .
ashd:var-isst a swrl:Variable ; rdfs:label "?isST" .
ashd:var-debtratio a swrl:Variable ; rdfs:label "?debtRatio" .
ashd:var-interest a swrl:Variable ; rdfs:label "?interestCoverage" .
ashd:var-portfolio a swrl:Variable ; rdfs:label "?portfolio" .
ashd:var-position a swrl:Variable ; rdfs:label "?position" .
ashd:var-averagecost a swrl:Variable ; rdfs:label "?avgCost" .
ashd:var-quote a swrl:Variable ; rdfs:label "?quote" .
ashd:var-price a swrl:Variable ; rdfs:label "?price" .
ashd:var-threshold a swrl:Variable ; rdfs:label "?threshold" .
ashd:var-weight a swrl:Variable ; rdfs:label "?weight" .
ashd:var-decision a swrl:Variable ; rdfs:label "?decision" .
ashd:var-security a swrl:Variable ; rdfs:label "?security" .
ashd:var-risk a swrl:Variable ; rdfs:label "?risk" .
ashd:var-rationale a swrl:Variable ; rdfs:label "?rationale" .
ashd:var-evidence a swrl:Variable ; rdfs:label "?evidence" .
ashd:var-policy a swrl:Variable ; rdfs:label "?policy" .
ashd:var-turnover a swrl:Variable ; rdfs:label "?turnover" .
ashd:var-marketcap a swrl:Variable ; rdfs:label "?marketCap" .
ashd:var-revenuegrowth a swrl:Variable ; rdfs:label "?revenueGrowth" .
ashd:var-profitgrowth a swrl:Variable ; rdfs:label "?profitGrowth" .
ashd:var-recommendation a swrl:Variable ; rdfs:label "?recommendation" .
ashd:var-action a swrl:Variable ; rdfs:label "?action" .
ashd:var-score a swrl:Variable ; rdfs:label "?riskScore" .

# ===========================================================================
# R01 — Value candidate
# ===========================================================================

ashd:rule-value-candidate
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R01" ;
    rdfs:label "价值候选筛选"@zh, "Value candidate screen"@en ;
    rdfs:comment "当公司最近年报 ROE 不低于 15%、PE(TTM) 不高于 20、净利润为正且非 ST 时，推断为价值候选。"@zh ;
    ash:ruleIf "公司最近年报 ROE ≥ 15%，PE(TTM) ≤ 20，净利润 > 0，且 isST = false"@zh ;
    ash:ruleThen "公司被推断为 ash:ValueCandidate（机会信号）"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 20 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:ruleEffectiveFrom "2026-10-01"^^xsd:date ;
    ash:appliesTo ash:ListedCompany ;
    ash:ruleUses ash:ash:roe, ash:peTtm, ash:netProfit, ash:isST ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:ListedCompany ; swrl:argument1 ashd:var-company ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasFinancialReport ; swrl:argument1 ashd:var-company ; swrl:argument2 ashd:var-report ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasSecurity ; swrl:argument1 ashd:var-company ; swrl:argument2 ashd:var-stock ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasValuation ; swrl:argument1 ashd:var-stock ; swrl:argument2 ashd:var-valuation ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:roe ; swrl:argument1 ashd:var-report ; swrl:argument2 ashd:var-roe ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:peTtm ; swrl:argument1 ashd:var-valuation ; swrl:argument2 ashd:var-pe ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:netProfit ; swrl:argument1 ashd:var-report ; swrl:argument2 ashd:var-profit ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:isST ; swrl:argument1 ashd:var-company ; swrl:argument2 ashd:var-isst ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( ashd:var-roe "15.0"^^xsd:decimal ) ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThanOrEqual ; swrl:arguments ( ashd:var-pe "20.0"^^xsd:decimal ) ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-profit "0.0"^^xsd:decimal ) ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( ashd:var-isst "false"^^xsd:boolean ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:ValueCandidate ; swrl:argument1 ashd:var-company ]
    ) .

# ===========================================================================
# R02 — High financial risk
# ===========================================================================

ashd:rule-high-financial-risk
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R02" ;
    rdfs:label "高财务风险识别"@zh, "High financial risk detection"@en ;
    rdfs:comment "资产负债率不低于 70% 且利息保障倍数低于 2 的公司，推断为高财务风险。"@zh ;
    ash:ruleIf "年报资产负债率 ≥ 70%，利息保障倍数 < 2"@zh ;
    ash:ruleThen "公司被推断为 ash:HighFinancialRisk"@zh ;
    ash:severity "high" ;
    ash:rulePriority 10 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.0.0" ;
    ash:ruleOwner "风险管理部" ;
    ash:ruleEffectiveFrom "2026-10-01"^^xsd:date ;
    ash:appliesTo ash:ListedCompany ;
    ash:ruleUses ash:ash:debtRatio, ash:interestCoverage ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:ListedCompany ; swrl:argument1 ashd:var-company ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasFinancialReport ; swrl:argument1 ashd:var-company ; swrl:argument2 ashd:var-report ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:debtRatio ; swrl:argument1 ashd:var-report ; swrl:argument2 ashd:var-debtratio ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:interestCoverage ; swrl:argument1 ashd:var-report ; swrl:argument2 ashd:var-interest ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( ashd:var-debtratio "70.0"^^xsd:decimal ) ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThan ; swrl:arguments ( ashd:var-interest "2.0"^^xsd:decimal ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:HighFinancialRisk ; swrl:argument1 ashd:var-company ]
    ) .

# ===========================================================================
# R03 / R04 — Hard exclusions
# ===========================================================================

ashd:rule-st-exclusion
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R03" ;
    rdfs:label "ST 股票池排除"@zh, "ST universe exclusion"@en ;
    rdfs:comment "isST 为 true 的公司不得进入主动股票池。"@zh ;
    ash:ruleIf "公司 isST = true"@zh ;
    ash:ruleThen "公司被推断为 ash:ExcludedFromUniverse"@zh ;
    ash:severity "high" ;
    ash:rulePriority 1 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.0.0" ;
    ash:ruleOwner "合规部" ;
    ash:ruleEffectiveFrom "2026-10-01"^^xsd:date ;
    ash:appliesTo ash:ListedCompany ;
    ash:ruleUses ash:ash:isST ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:ListedCompany ; swrl:argument1 ashd:var-company ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:isST ; swrl:argument1 ashd:var-company ; swrl:argument2 ashd:var-isst ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( ashd:var-isst "true"^^xsd:boolean ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:ExcludedFromUniverse ; swrl:argument1 ashd:var-company ]
    ) .

ashd:rule-delisting-exclusion
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R04" ;
    rdfs:label "退市风险排除"@zh, "Delisting risk exclusion"@en ;
    rdfs:comment "存在退市风险的公司不得进入主动股票池。"@zh ;
    ash:ruleIf "公司 delistingRisk = true"@zh ;
    ash:ruleThen "公司被推断为 ash:ExcludedFromUniverse"@zh ;
    ash:severity "high" ;
    ash:rulePriority 1 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.0.0" ;
    ash:ruleOwner "合规部" ;
    ash:ruleEffectiveFrom "2026-10-01"^^xsd:date ;
    ash:appliesTo ash:ListedCompany ;
    ash:ruleUses ash:ash:delistingRisk ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:ListedCompany ; swrl:argument1 ashd:var-company ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:delistingRisk ; swrl:argument1 ashd:var-company ; swrl:argument2 ashd:var-isst ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( ashd:var-isst "true"^^xsd:boolean ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:ExcludedFromUniverse ; swrl:argument1 ashd:var-company ]
    ) .

# ===========================================================================
# R05 — Stop-loss
# ===========================================================================

ashd:rule-stop-loss
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R05" ;
    rdfs:label "持仓止损触发"@zh, "Position stop-loss trigger"@en ;
    rdfs:comment "最新价不高于持仓成本乘以 0.8 时，推断为止损触发。"@zh ;
    ash:ruleIf "持仓成本 × 0.8 ≥ 最新价"@zh ;
    ash:ruleThen "持仓被推断为 ash:StopLossTriggered"@zh ;
    ash:severity "high" ;
    ash:rulePriority 5 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.0.0" ;
    ash:ruleOwner "组合管理部" ;
    ash:ruleEffectiveFrom "2026-10-01"^^xsd:date ;
    ash:appliesTo ash:Position ;
    ash:ruleUses ash:ash:avgCost, ash:lastPrice ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Portfolio ; swrl:argument1 ashd:var-portfolio ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:holdsPosition ; swrl:argument1 ashd:var-portfolio ; swrl:argument2 ashd:var-position ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:positionIn ; swrl:argument1 ashd:var-position ; swrl:argument2 ashd:var-stock ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:avgCost ; swrl:argument1 ashd:var-position ; swrl:argument2 ashd:var-averagecost ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasMarketQuote ; swrl:argument1 ashd:var-stock ; swrl:argument2 ashd:var-quote ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:lastPrice ; swrl:argument1 ashd:var-quote ; swrl:argument2 ashd:var-price ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:multiply ; swrl:arguments ( ashd:var-averagecost "0.8"^^xsd:decimal ashd:var-threshold ) ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThanOrEqual ; swrl:arguments ( ashd:var-price ashd:var-threshold ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:StopLossTriggered ; swrl:argument1 ashd:var-position ]
    ) .

# ===========================================================================
# R06 — Concentration
# ===========================================================================

ashd:rule-concentration
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R06" ;
    rdfs:label "单票集中度超限"@zh, "Single-position concentration breach"@en ;
    rdfs:comment "组合中任一持仓权重超过 10% 时，推断为集中度超限。"@zh ;
    ash:ruleIf "组合中存在 positionWeight > 0.10 的持仓"@zh ;
    ash:ruleThen "组合被推断为 ash:ConcentrationBreach"@zh ;
    ash:severity "high" ;
    ash:rulePriority 6 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.0.0" ;
    ash:ruleOwner "组合管理部" ;
    ash:ruleEffectiveFrom "2026-10-01"^^xsd:date ;
    ash:appliesTo ash:Portfolio ;
    ash:ruleUses ash:ash:positionWeight ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Portfolio ; swrl:argument1 ashd:var-portfolio ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:holdsPosition ; swrl:argument1 ashd:var-portfolio ; swrl:argument2 ashd:var-position ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:positionWeight ; swrl:argument1 ashd:var-position ; swrl:argument2 ashd:var-weight ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-weight "0.10"^^xsd:decimal ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:ConcentrationBreach ; swrl:argument1 ashd:var-portfolio ]
    ) .

# ===========================================================================
# R07 — Restricted-list review
# ===========================================================================

ashd:rule-restricted-review
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R07" ;
    rdfs:label "限制名单合规复核"@zh, "Restricted-list compliance review"@en ;
    rdfs:comment "决策标的在限制名单中时，决策必须进入合规复核。"@zh ;
    ash:ruleIf "决策 aboutSecurity 的证券 isRestricted = true"@zh ;
    ash:ruleThen "决策被推断为 ash:RequiresComplianceReview"@zh ;
    ash:severity "high" ;
    ash:rulePriority 2 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.0.0" ;
    ash:ruleOwner "合规部" ;
    ash:ruleEffectiveFrom "2026-10-01"^^xsd:date ;
    ash:appliesTo ash:InvestmentDecision ;
    ash:ruleUses ash:ash:aboutSecurity, ash:isRestricted ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:InvestmentDecision ; swrl:argument1 ashd:var-decision ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:aboutSecurity ; swrl:argument1 ashd:var-decision ; swrl:argument2 ashd:var-security ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:isRestricted ; swrl:argument1 ashd:var-security ; swrl:argument2 ashd:var-isst ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( ashd:var-isst "true"^^xsd:boolean ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:RequiresComplianceReview ; swrl:argument1 ashd:var-decision ]
    ) .

# ===========================================================================
# R08 — Auditable decision
# ===========================================================================

ashd:rule-auditable-decision
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R08" ;
    rdfs:label "可审计决策完整性"@zh, "Auditable decision completeness"@en ;
    rdfs:comment "决策同时具备风险评价、理由、证据和政策依据时，推断为可审计决策。"@zh ;
    ash:ruleIf "决策有风险评价、理由、至少一条证据和至少一项政策依据"@zh ;
    ash:ruleThen "决策被推断为 ash:AuditableDecision"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 30 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:ruleEffectiveFrom "2026-10-01"^^xsd:date ;
    ash:appliesTo ash:InvestmentDecision ;
    ash:ruleUses ash:ash:hasRiskAssessment, ash:hasRationale, ash:basedOn, ash:governedBy ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:InvestmentDecision ; swrl:argument1 ashd:var-decision ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasRiskAssessment ; swrl:argument1 ashd:var-decision ; swrl:argument2 ashd:var-risk ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasRationale ; swrl:argument1 ashd:var-decision ; swrl:argument2 ashd:var-rationale ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:basedOn ; swrl:argument1 ashd:var-decision ; swrl:argument2 ashd:var-evidence ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:governedBy ; swrl:argument1 ashd:var-decision ; swrl:argument2 ashd:var-policy ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:AuditableDecision ; swrl:argument1 ashd:var-decision ]
    ) .

# ===========================================================================
# R09 — Illiquidity
# ===========================================================================

ashd:rule-illiquidity
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R09" ;
    rdfs:label "低流动性证券识别"@zh, "Illiquid security detection"@en ;
    rdfs:comment "换手率低于 0.5% 且总市值低于 50 亿元时，推断为低流动性证券。"@zh ;
    ash:ruleIf "换手率 < 0.5% 且总市值 < 5,000,000,000 元"@zh ;
    ash:ruleThen "证券被推断为 ash:IlliquidSecurity"@zh ;
    ash:severity "high" ;
    ash:rulePriority 8 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.0.0" ;
    ash:ruleOwner "风险管理部" ;
    ash:ruleEffectiveFrom "2026-10-01"^^xsd:date ;
    ash:appliesTo ash:Security ;
    ash:ruleUses ash:ash:turnoverRate, ash:marketCap ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Security ; swrl:argument1 ashd:var-security ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasMarketQuote ; swrl:argument1 ashd:var-security ; swrl:argument2 ashd:var-quote ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:turnoverRate ; swrl:argument1 ashd:var-quote ; swrl:argument2 ashd:var-turnover ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:marketCap ; swrl:argument1 ashd:var-quote ; swrl:argument2 ashd:var-marketcap ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThan ; swrl:arguments ( ashd:var-turnover "0.5"^^xsd:decimal ) ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThan ; swrl:arguments ( ashd:var-marketcap "5000000000"^^xsd:decimal ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:IlliquidSecurity ; swrl:argument1 ashd:var-security ]
    ) .

# ===========================================================================
# R10 — Growth candidate
# ===========================================================================

ashd:rule-growth-candidate
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R10" ;
    rdfs:label "成长候选筛选"@zh, "Growth candidate screen"@en ;
    rdfs:comment "营收增速不低于 25%、净利润增速不低于 20%、PE(TTM) 高于 40 时，推断为成长候选。"@zh ;
    ash:ruleIf "营收增速 ≥ 25%，净利润增速 ≥ 20%，PE(TTM) > 40"@zh ;
    ash:ruleThen "公司被推断为 ash:GrowthCandidate"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 25 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:ruleEffectiveFrom "2026-10-01"^^xsd:date ;
    ash:appliesTo ash:ListedCompany ;
    ash:ruleUses ash:ash:revenueGrowth, ash:profitGrowth, ash:peTtm ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:ListedCompany ; swrl:argument1 ashd:var-company ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasFinancialReport ; swrl:argument1 ashd:var-company ; swrl:argument2 ashd:var-report ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasSecurity ; swrl:argument1 ashd:var-company ; swrl:argument2 ashd:var-stock ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasValuation ; swrl:argument1 ashd:var-stock ; swrl:argument2 ashd:var-valuation ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:revenueGrowth ; swrl:argument1 ashd:var-report ; swrl:argument2 ashd:var-revenuegrowth ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:profitGrowth ; swrl:argument1 ashd:var-report ; swrl:argument2 ashd:var-profitgrowth ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:peTtm ; swrl:argument1 ashd:var-valuation ; swrl:argument2 ashd:var-pe ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( ashd:var-revenuegrowth "25.0"^^xsd:decimal ) ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( ashd:var-profitgrowth "20.0"^^xsd:decimal ) ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-pe "40.0"^^xsd:decimal ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:GrowthCandidate ; swrl:argument1 ashd:var-company ]
    ) .

# ===========================================================================
# R11 — Buy + high risk = second review
# ===========================================================================

ashd:rule-buy-high-risk-review
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R11" ;
    rdfs:label "高风险买入二次复核"@zh, "High-risk buy second review"@en ;
    rdfs:comment "风险分数不低于 60 的证券上给出 BUY 建议时，必须触发第二人复核。"@zh ;
    ash:ruleIf "决策建议 actionCode = BUY 且风险评估 riskScore ≥ 60"@zh ;
    ash:ruleThen "决策被推断为 ash:RequiresSecondReview"@zh ;
    ash:severity "high" ;
    ash:rulePriority 3 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.0.0" ;
    ash:ruleOwner "风险管理部" ;
    ash:ruleEffectiveFrom "2026-10-01"^^xsd:date ;
    ash:appliesTo ash:InvestmentDecision ;
    ash:ruleUses ash:ash:actionCode, ash:riskScore ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:InvestmentDecision ; swrl:argument1 ashd:var-decision ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasRecommendation ; swrl:argument1 ashd:var-decision ; swrl:argument2 ashd:var-recommendation ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:actionCode ; swrl:argument1 ashd:var-recommendation ; swrl:argument2 ashd:var-action ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasRiskAssessment ; swrl:argument1 ashd:var-decision ; swrl:argument2 ashd:var-risk ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:riskScore ; swrl:argument1 ashd:var-risk ; swrl:argument2 ashd:var-score ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( ashd:var-action "BUY"^^xsd:string ) ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( ashd:var-score "60.0"^^xsd:decimal ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:RequiresSecondReview ; swrl:argument1 ashd:var-decision ]
    ) .
# ===========================================================================
# Domain expansion 1.1 — fund, convertible and order rules
# ===========================================================================

ashd:var-fund a swrl:Variable ; rdfs:label "?fund" .
ashd:var-fundshare a swrl:Variable ; rdfs:label "?fundShare" .
ashd:var-tracking a swrl:Variable ; rdfs:label "?trackingError" .
ashd:var-cb a swrl:Variable ; rdfs:label "?convertible" .
ashd:var-premium a swrl:Variable ; rdfs:label "?conversionPremium" .
ashd:var-order a swrl:Variable ; rdfs:label "?order" .
ashd:var-orderstatus a swrl:Variable ; rdfs:label "?orderStatus" .
ashd:var-fundflow a swrl:Variable ; rdfs:label "?netFlowPct" .

ashd:rule-tracking-error
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R12" ;
    rdfs:label "ETF 跟踪误差超限"@zh, "ETF tracking error breach"@en ;
    rdfs:comment "基金份额跟踪误差高于 2% 时，推断为跟踪误差超限。"@zh ;
    ash:ruleIf "基金份额 trackingError > 2.0"@zh ;
    ash:ruleThen "基金份额被推断为 ash:TrackingErrorBreach"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 18 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.1.0" ;
    ash:ruleOwner "指数与量化部" ;
    ash:ruleEffectiveFrom "2026-11-01"^^xsd:date ;
    ash:appliesTo ash:FundShare ;
    ash:ruleUses ash:ash:trackingError ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:FundShare ; swrl:argument1 ashd:var-fundshare ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:trackingError ; swrl:argument1 ashd:var-fundshare ; swrl:argument2 ashd:var-tracking ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-tracking "2.0"^^xsd:decimal ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:TrackingErrorBreach ; swrl:argument1 ashd:var-fundshare ]
    ) .

ashd:rule-convertible-rich
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R13" ;
    rdfs:label "可转债高溢价"@zh, "Convertible bond rich premium"@en ;
    rdfs:comment "可转债转股溢价率高于 30% 时，推断为高溢价状态。"@zh ;
    ash:ruleIf "可转债 conversionPremium > 30.0"@zh ;
    ash:ruleThen "可转债被推断为 ash:ConvertibleRich"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 19 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.1.0" ;
    ash:ruleOwner "固定收益部" ;
    ash:ruleEffectiveFrom "2026-11-01"^^xsd:date ;
    ash:appliesTo ash:ConvertibleBond ;
    ash:ruleUses ash:ash:conversionPremium ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:ConvertibleBond ; swrl:argument1 ashd:var-cb ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:conversionPremium ; swrl:argument1 ashd:var-cb ; swrl:argument2 ashd:var-premium ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-premium "30.0"^^xsd:decimal ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:ConvertibleRich ; swrl:argument1 ashd:var-cb ]
    ) .

ashd:rule-order-blocked
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R14" ;
    rdfs:label "未审批订单阻断"@zh, "Unapproved order blocked"@en ;
    rdfs:comment "订单状态仍为 PENDING 时，推断为交易阻断，不得执行。"@zh ;
    ash:ruleIf "订单 orderStatus = PENDING"@zh ;
    ash:ruleThen "订单被推断为 ash:TradeBlocked"@zh ;
    ash:severity "high" ;
    ash:rulePriority 4 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.1.0" ;
    ash:ruleOwner "交易运营部" ;
    ash:ruleEffectiveFrom "2026-11-01"^^xsd:date ;
    ash:appliesTo ash:Order ;
    ash:ruleUses ash:ash:orderStatus ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Order ; swrl:argument1 ashd:var-order ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:orderStatus ; swrl:argument1 ashd:var-order ; swrl:argument2 ashd:var-orderstatus ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( ashd:var-orderstatus "PENDING"^^xsd:string ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:TradeBlocked ; swrl:argument1 ashd:var-order ]
    ) .

ashd:rule-fund-outflow
    a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R15" ;
    rdfs:label "基金净流出风险"@zh, "Fund outflow risk"@en ;
    rdfs:comment "基金观察期净流入比例低于 -5% 时，推断为基金流出风险。"@zh ;
    ash:ruleIf "基金 netFlowPct < -5.0"@zh ;
    ash:ruleThen "基金被推断为 ash:FundOutflowRisk"@zh ;
    ash:severity "high" ;
    ash:rulePriority 7 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.1.0" ;
    ash:ruleOwner "组合管理部" ;
    ash:ruleEffectiveFrom "2026-11-01"^^xsd:date ;
    ash:appliesTo ash:Fund ;
    ash:ruleUses ash:ash:netFlowPct ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Fund ; swrl:argument1 ashd:var-fund ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:netFlowPct ; swrl:argument1 ashd:var-fund ; swrl:argument2 ashd:var-fundflow ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThan ; swrl:arguments ( ashd:var-fundflow "-5.0"^^xsd:decimal ) ]
    ) ;
    swrl:head (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:FundOutflowRisk ; swrl:argument1 ashd:var-fund ]
    ) .
# ===== Short-term / hot-money rules =====

ashd:var-st-security a swrl:Variable ; rdfs:label "?security" .
ashd:var-st-list a swrl:Variable ; rdfs:label "?list" .
ashd:var-st-netbuy a swrl:Variable ; rdfs:label "?netBuy" .
ashd:var-st-seat a swrl:Variable ; rdfs:label "?seat" .
ashd:var-st-seattype a swrl:Variable ; rdfs:label "?seatType" .
ashd:var-st-streak a swrl:Variable ; rdfs:label "?streak" .
ashd:var-st-days a swrl:Variable ; rdfs:label "?days" .
ashd:var-st-broken a swrl:Variable ; rdfs:label "?broken" .
ashd:var-st-seal a swrl:Variable ; rdfs:label "?seal" .
ashd:var-st-quote a swrl:Variable ; rdfs:label "?quote" .
ashd:var-st-turnover a swrl:Variable ; rdfs:label "?turnover" .
ashd:var-st-ma20 a swrl:Variable ; rdfs:label "?ma20" .
ashd:var-st-ma60 a swrl:Variable ; rdfs:label "?ma60" .
ashd:var-st-company a swrl:Variable ; rdfs:label "?company" .
ashd:var-st-report a swrl:Variable ; rdfs:label "?report" .
ashd:var-st-growth a swrl:Variable ; rdfs:label "?revenueGrowth" .
ashd:var-st-theme a swrl:Variable ; rdfs:label "?theme" .
ashd:var-st-heat a swrl:Variable ; rdfs:label "?heat" .
ashd:var-st-heatscore a swrl:Variable ; rdfs:label "?heatScore" .
ashd:var-st-news a swrl:Variable ; rdfs:label "?news" .

ashd:rule-hotmoney-inflow a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R16" ;
    rdfs:label "游资席位净买入"@zh, "Hot-money seat inflow"@en ;
    rdfs:comment "龙虎榜净买入超过 5000 万且存在游资席位时，推断为游资流入。"@zh ;
    ash:ruleIf "龙虎榜净买入 > 50,000,000 且存在 seatType = hot-money 的席位"@zh ;
    ash:ruleThen "证券被推断为 ash:HotMoneyInflow"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 22 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.2.0" ;
    ash:ruleOwner "短线研究组" ;
    ash:ruleEffectiveFrom "2026-11-01"^^xsd:date ;
    ash:appliesTo ash:Security ;
    ash:ruleUses ash:ash:hasDragonTigerList, ash:dragonTigerNetBuy, ash:hasDragonTigerSeat, ash:seatType ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Security ; swrl:argument1 ashd:var-st-security ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasDragonTigerList ; swrl:argument1 ashd:var-st-security ; swrl:argument2 ashd:var-st-list ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:dragonTigerNetBuy ; swrl:argument1 ashd:var-st-list ; swrl:argument2 ashd:var-st-netbuy ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-st-netbuy "50000000"^^xsd:decimal ) ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasDragonTigerSeat ; swrl:argument1 ashd:var-st-list ; swrl:argument2 ashd:var-st-seat ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:seatType ; swrl:argument1 ashd:var-st-seat ; swrl:argument2 ashd:var-st-seattype ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( ashd:var-st-seattype "hot-money"^^xsd:string ) ]
    ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ash:HotMoneyInflow ; swrl:argument1 ashd:var-st-security ] ) .

ashd:rule-limitup-streak a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R17" ;
    rdfs:label "连板动量"@zh, "Limit-up momentum"@en ;
    rdfs:comment "连板天数不少于 3、炸板不超过 1 次且封单大于 5000 万时，推断为动量信号。"@zh ;
    ash:ruleIf "limitUpDays ≥ 3、brokenBoardCount ≤ 1、sealAmount > 50,000,000"@zh ;
    ash:ruleThen "证券被推断为 ash:MomentumSignal"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 23 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.2.0" ;
    ash:ruleOwner "短线研究组" ;
    ash:ruleEffectiveFrom "2026-11-01"^^xsd:date ;
    ash:appliesTo ash:Security ;
    ash:ruleUses ash:ash:hasLimitUpStreak, ash:limitUpDays, ash:brokenBoardCount, ash:sealAmount ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Security ; swrl:argument1 ashd:var-st-security ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasLimitUpStreak ; swrl:argument1 ashd:var-st-security ; swrl:argument2 ashd:var-st-streak ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:limitUpDays ; swrl:argument1 ashd:var-st-streak ; swrl:argument2 ashd:var-st-days ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:brokenBoardCount ; swrl:argument1 ashd:var-st-streak ; swrl:argument2 ashd:var-st-broken ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:sealAmount ; swrl:argument1 ashd:var-st-streak ; swrl:argument2 ashd:var-st-seal ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( ashd:var-st-days "3"^^xsd:integer ) ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThanOrEqual ; swrl:arguments ( ashd:var-st-broken "1"^^xsd:integer ) ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-st-seal "50000000"^^xsd:decimal ) ]
    ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ash:MomentumSignal ; swrl:argument1 ashd:var-st-security ] ) .

ashd:rule-overheat a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R18" ;
    rdfs:label "短线过热"@zh, "Short-term overheat"@en ;
    rdfs:comment "换手率高于 15% 且连板天数不少于 3 时，推断为过热风险。"@zh ;
    ash:ruleIf "turnoverRate > 15 且 limitUpDays ≥ 3"@zh ;
    ash:ruleThen "证券被推断为 ash:OverheatRisk"@zh ;
    ash:severity "high" ;
    ash:rulePriority 9 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.2.0" ;
    ash:ruleOwner "短线研究组" ;
    ash:ruleEffectiveFrom "2026-11-01"^^xsd:date ;
    ash:appliesTo ash:Security ;
    ash:ruleUses ash:ash:hasMarketQuote, ash:turnoverRate, ash:hasLimitUpStreak, ash:limitUpDays ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Security ; swrl:argument1 ashd:var-st-security ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasMarketQuote ; swrl:argument1 ashd:var-st-security ; swrl:argument2 ashd:var-st-quote ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:turnoverRate ; swrl:argument1 ashd:var-st-quote ; swrl:argument2 ashd:var-st-turnover ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasLimitUpStreak ; swrl:argument1 ashd:var-st-security ; swrl:argument2 ashd:var-st-streak ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:limitUpDays ; swrl:argument1 ashd:var-st-streak ; swrl:argument2 ashd:var-st-days ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-st-turnover "15"^^xsd:decimal ) ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( ashd:var-st-days "3"^^xsd:integer ) ]
    ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ash:OverheatRisk ; swrl:argument1 ashd:var-st-security ] ) .

ashd:rule-board-break a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R19" ;
    rdfs:label "炸板风险"@zh, "Board-break risk"@en ;
    rdfs:comment "连板期间炸板次数达到 2 次时，推断为炸板风险。"@zh ;
    ash:ruleIf "brokenBoardCount ≥ 2"@zh ;
    ash:ruleThen "证券被推断为 ash:BoardBreakRisk"@zh ;
    ash:severity "high" ;
    ash:rulePriority 8 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.2.0" ;
    ash:ruleOwner "短线研究组" ;
    ash:ruleEffectiveFrom "2026-11-01"^^xsd:date ;
    ash:appliesTo ash:Security ;
    ash:ruleUses ash:ash:hasLimitUpStreak, ash:brokenBoardCount ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Security ; swrl:argument1 ashd:var-st-security ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasLimitUpStreak ; swrl:argument1 ashd:var-st-security ; swrl:argument2 ashd:var-st-streak ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:brokenBoardCount ; swrl:argument1 ashd:var-st-streak ; swrl:argument2 ashd:var-st-broken ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( ashd:var-st-broken "2"^^xsd:integer ) ]
    ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ash:BoardBreakRisk ; swrl:argument1 ashd:var-st-security ] ) .

ashd:rule-medium-term-uptrend a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R20" ;
    rdfs:label "中期趋势向上"@zh, "Medium-term uptrend"@en ;
    rdfs:comment "20 日均线高于 60 日均线且营收增速不低于 20% 时，推断为中期趋势向上。"@zh ;
    ash:ruleIf "MA20 > MA60 且 revenueGrowth ≥ 20"@zh ;
    ash:ruleThen "证券被推断为 ash:MediumTermTrend"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 24 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.2.0" ;
    ash:ruleOwner "策略研究组" ;
    ash:ruleEffectiveFrom "2026-11-01"^^xsd:date ;
    ash:appliesTo ash:Security ;
    ash:ruleUses ash:ash:ma20, ash:ma60, ash:issuedBy, ash:hasFinancialReport, ash:revenueGrowth ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Security ; swrl:argument1 ashd:var-st-security ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:ma20 ; swrl:argument1 ashd:var-st-security ; swrl:argument2 ashd:var-st-ma20 ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:ma60 ; swrl:argument1 ashd:var-st-security ; swrl:argument2 ashd:var-st-ma60 ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-st-ma20 ashd:var-st-ma60 ) ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:issuedBy ; swrl:argument1 ashd:var-st-security ; swrl:argument2 ashd:var-st-company ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasFinancialReport ; swrl:argument1 ashd:var-st-company ; swrl:argument2 ashd:var-st-report ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:revenueGrowth ; swrl:argument1 ashd:var-st-report ; swrl:argument2 ashd:var-st-growth ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( ashd:var-st-growth "20"^^xsd:decimal ) ]
    ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ash:MediumTermTrend ; swrl:argument1 ashd:var-st-security ] ) .

ashd:rule-theme-catalyst a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R21" ;
    rdfs:label "主题催化信号"@zh, "Theme catalyst signal"@en ;
    rdfs:comment "公司所属主题热度高于 80 且证券存在新闻催化时，推断为事件驱动信号。"@zh ;
    ash:ruleIf "主题热度 > 80 且证券存在新闻催化"@zh ;
    ash:ruleThen "证券被推断为 ash:EventDrivenSignal"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 26 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.2.0" ;
    ash:ruleOwner "短线研究组" ;
    ash:ruleEffectiveFrom "2026-11-01"^^xsd:date ;
    ash:appliesTo ash:Security ;
    ash:ruleUses ash:ash:issuedBy, ash:hasThemeExposure, ash:hasThemeHeat, ash:themeHeatScore, ash:hasNewsCatalyst ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Security ; swrl:argument1 ashd:var-st-security ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:issuedBy ; swrl:argument1 ashd:var-st-security ; swrl:argument2 ashd:var-st-company ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasThemeExposure ; swrl:argument1 ashd:var-st-company ; swrl:argument2 ashd:var-st-theme ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasThemeHeat ; swrl:argument1 ashd:var-st-theme ; swrl:argument2 ashd:var-st-heat ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:themeHeatScore ; swrl:argument1 ashd:var-st-heat ; swrl:argument2 ashd:var-st-heatscore ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasNewsCatalyst ; swrl:argument1 ashd:var-st-security ; swrl:argument2 ashd:var-st-news ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-st-heatscore "80"^^xsd:decimal ) ]
    ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ash:EventDrivenSignal ; swrl:argument1 ashd:var-st-security ] ) .
# ===== Youzi methodology rules =====

ashd:var-yz-security a swrl:Variable ; rdfs:label "?security" .
ashd:var-yz-auction a swrl:Variable ; rdfs:label "?auction" .
ashd:var-yz-expect a swrl:Variable ; rdfs:label "?expectation" .
ashd:var-yz-expected a swrl:Variable ; rdfs:label "?expectedPremium" .
ashd:var-yz-actual a swrl:Variable ; rdfs:label "?actualPremium" .
ashd:var-yz-vol a swrl:Variable ; rdfs:label "?auctionVolume" .
ashd:var-yz-list a swrl:Variable ; rdfs:label "?list" .
ashd:var-yz-consensus a swrl:Variable ; rdfs:label "?consensus" .
ashd:var-yz-ctype a swrl:Variable ; rdfs:label "?consensusType" .
ashd:var-yz-net a swrl:Variable ; rdfs:label "?netBuy" .
ashd:var-yz-cycle a swrl:Variable ; rdfs:label "?cycle" .
ashd:var-yz-mheight a swrl:Variable ; rdfs:label "?marketHeight" .
ashd:var-yz-height a swrl:Variable ; rdfs:label "?height" .
ashd:var-yz-moneyobj a swrl:Variable ; rdfs:label "?moneyEffectObj" .
ashd:var-yz-money a swrl:Variable ; rdfs:label "?moneyEffect" .
ashd:var-yz-lossobj a swrl:Variable ; rdfs:label "?lossEffectObj" .
ashd:var-yz-loss a swrl:Variable ; rdfs:label "?lossEffect" .
ashd:var-yz-seat a swrl:Variable ; rdfs:label "?seat" .
ashd:var-yz-odt a swrl:Variable ; rdfs:label "?oneDayTrip" .
ashd:var-yz-journal a swrl:Variable ; rdfs:label "?journal" .
ashd:var-yz-dd a swrl:Variable ; rdfs:label "?drawdown" .
ashd:var-yz-investor a swrl:Variable ; rdfs:label "?investor" .

ashd:rule-weak-to-strong a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R22" ;
    rdfs:label "竞价弱转强"@zh, "Weak-to-strong auction"@en ;
    rdfs:comment "预期溢价为负、实际溢价为正且竞价成交额超过 500 万时，推断为弱转强。"@zh ;
    ash:ruleIf "expectedPremium < 0 且 actualPremium > 0 且 auctionVolumeAmount > 5,000,000"@zh ;
    ash:ruleThen "证券被推断为 ash:WeakToStrong"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 27 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.3.0" ;
    ash:ruleOwner "短线研究组" ;
    ash:ruleEffectiveFrom "2026-11-03"^^xsd:date ;
    ash:appliesTo ash:Security ;
    ash:ruleUses ash:ash:hasAuctionSnapshot, ash:hasAuctionExpectation, ash:expectedPremium, ash:actualPremium, ash:auctionVolumeAmount ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Security ; swrl:argument1 ashd:var-yz-security ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasAuctionSnapshot ; swrl:argument1 ashd:var-yz-security ; swrl:argument2 ashd:var-yz-auction ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasAuctionExpectation ; swrl:argument1 ashd:var-yz-auction ; swrl:argument2 ashd:var-yz-expect ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:expectedPremium ; swrl:argument1 ashd:var-yz-expect ; swrl:argument2 ashd:var-yz-expected ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:actualPremium ; swrl:argument1 ashd:var-yz-expect ; swrl:argument2 ashd:var-yz-actual ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:auctionVolumeAmount ; swrl:argument1 ashd:var-yz-auction ; swrl:argument2 ashd:var-yz-vol ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThan ; swrl:arguments ( ashd:var-yz-expected "0"^^xsd:decimal ) ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-yz-actual "0"^^xsd:decimal ) ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-yz-vol "5000000"^^xsd:decimal ) ]
    ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ash:WeakToStrong ; swrl:argument1 ashd:var-yz-security ] ) .

ashd:rule-dragon-tiger-consensus a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R23" ;
    rdfs:label "龙虎榜混合共识"@zh, "Dragon-tiger mixed consensus"@en ;
    rdfs:comment "龙虎榜净买超过 5000 万且游资/机构混合时，推断为资金共识。"@zh ;
    ash:ruleIf "dragonTigerNetBuy > 50,000,000 且 consensusType = mixed"@zh ;
    ash:ruleThen "证券被推断为 ash:HotMoneyInflow"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 28 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.3.0" ;
    ash:ruleOwner "短线研究组" ;
    ash:ruleEffectiveFrom "2026-11-03"^^xsd:date ;
    ash:appliesTo ash:Security ;
    ash:ruleUses ash:ash:hasDragonTigerList, ash:dragonTigerNetBuy, ash:hasDragonTigerConsensus, ash:consensusType ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Security ; swrl:argument1 ashd:var-yz-security ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasDragonTigerList ; swrl:argument1 ashd:var-yz-security ; swrl:argument2 ashd:var-yz-list ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:dragonTigerNetBuy ; swrl:argument1 ashd:var-yz-list ; swrl:argument2 ashd:var-yz-net ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasDragonTigerConsensus ; swrl:argument1 ashd:var-yz-list ; swrl:argument2 ashd:var-yz-consensus ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:consensusType ; swrl:argument1 ashd:var-yz-consensus ; swrl:argument2 ashd:var-yz-ctype ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-yz-net "50000000"^^xsd:decimal ) ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( ashd:var-yz-ctype "mixed"^^xsd:string ) ]
    ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ash:HotMoneyInflow ; swrl:argument1 ashd:var-yz-security ] ) .

ashd:rule-emotion-freeze a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R24" ;
    rdfs:label "情绪冰点"@zh, "Emotion freeze"@en ;
    rdfs:comment "最高连板不超过 2 且亏钱效应高于赚钱效应时，推断为情绪冰点。"@zh ;
    ash:ruleIf "marketHeight ≤ 2 且 lossEffectScore > moneyEffectScore"@zh ;
    ash:ruleThen "情绪周期被推断为 ash:EmotionFreeze"@zh ;
    ash:severity "high" ;
    ash:rulePriority 10 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.3.0" ;
    ash:ruleOwner "短线研究组" ;
    ash:ruleEffectiveFrom "2026-11-03"^^xsd:date ;
    ash:appliesTo ash:SentimentCycle ;
    ash:ruleUses ash:ash:hasMarketHeight, ash:marketHeight, ash:hasMoneyEffect, ash:moneyEffectScore, ash:hasLossEffect, ash:lossEffectScore ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:SentimentCycle ; swrl:argument1 ashd:var-yz-cycle ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasMarketHeight ; swrl:argument1 ashd:var-yz-cycle ; swrl:argument2 ashd:var-yz-mheight ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:marketHeight ; swrl:argument1 ashd:var-yz-mheight ; swrl:argument2 ashd:var-yz-height ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasLossEffect ; swrl:argument1 ashd:var-yz-cycle ; swrl:argument2 ashd:var-yz-lossobj ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:lossEffectScore ; swrl:argument1 ashd:var-yz-lossobj ; swrl:argument2 ashd:var-yz-loss ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasMoneyEffect ; swrl:argument1 ashd:var-yz-cycle ; swrl:argument2 ashd:var-yz-moneyobj ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:moneyEffectScore ; swrl:argument1 ashd:var-yz-moneyobj ; swrl:argument2 ashd:var-yz-money ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThanOrEqual ; swrl:arguments ( ashd:var-yz-height "2"^^xsd:integer ) ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-yz-loss ashd:var-yz-money ) ]
    ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ash:EmotionFreeze ; swrl:argument1 ashd:var-yz-cycle ] ) .

ashd:rule-one-day-trip a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R25" ;
    rdfs:label "一日游风险"@zh, "One-day-trip risk"@en ;
    rdfs:comment "游资席位一日游比例高于 60% 时，推断为一日游风险。"@zh ;
    ash:ruleIf "seatOneDayTripRate > 0.60"@zh ;
    ash:ruleThen "证券被推断为 ash:OneDayTripRisk"@zh ;
    ash:severity "high" ;
    ash:rulePriority 11 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.3.0" ;
    ash:ruleOwner "短线研究组" ;
    ash:ruleEffectiveFrom "2026-11-03"^^xsd:date ;
    ash:appliesTo ash:Security ;
    ash:ruleUses ash:ash:hasDragonTigerList, ash:hasDragonTigerSeat, ash:seatOneDayTripRate ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Security ; swrl:argument1 ashd:var-yz-security ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasDragonTigerList ; swrl:argument1 ashd:var-yz-security ; swrl:argument2 ashd:var-yz-list ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasDragonTigerSeat ; swrl:argument1 ashd:var-yz-list ; swrl:argument2 ashd:var-yz-seat ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:seatOneDayTripRate ; swrl:argument1 ashd:var-yz-seat ; swrl:argument2 ashd:var-yz-odt ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-yz-odt "0.60"^^xsd:decimal ) ]
    ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ash:OneDayTripRisk ; swrl:argument1 ashd:var-yz-security ] ) .

ashd:rule-drawdown-breach a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R26" ;
    rdfs:label "回撤超限"@zh, "Drawdown breach"@en ;
    rdfs:comment "账户最大回撤超过 10% 时，推断为回撤超限。"@zh ;
    ash:ruleIf "maxDrawdown > 10"@zh ;
    ash:ruleThen "投资者被推断为 ash:DrawdownBreach"@zh ;
    ash:severity "high" ;
    ash:rulePriority 6 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.3.0" ;
    ash:ruleOwner "交易风控组" ;
    ash:ruleEffectiveFrom "2026-11-03"^^xsd:date ;
    ash:appliesTo ash:Investor ;
    ash:ruleUses ash:ash:hasTradingJournal, ash:maxDrawdown ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Investor ; swrl:argument1 ashd:var-yz-investor ]
        [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate ash:hasTradingJournal ; swrl:argument1 ashd:var-yz-investor ; swrl:argument2 ashd:var-yz-journal ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:maxDrawdown ; swrl:argument1 ashd:var-yz-journal ; swrl:argument2 ashd:var-yz-dd ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-yz-dd "10"^^xsd:decimal ) ]
    ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ash:DrawdownBreach ; swrl:argument1 ashd:var-yz-investor ] ) .
# ===== Rule expansion 1.7: from public hot-money principles =====

ashd:rule-r27 a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R27" ;
    rdfs:label "市场趋势开启"@zh ;
    rdfs:comment "趋势分数高于 60 时允许进攻。"@zh ;
    ash:ruleIf "趋势分数高于 60 时允许进攻。"@zh ;
    ash:ruleThen "主体被推断为 ash:MarketRiskOn"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 73 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.7.0" ;
    ash:ruleOwner "游资规则组" ;
    ash:ruleCategory "市场" ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:Security ;
    ash:ruleUses ash:marketTrendScore ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Security ; swrl:argument1 ashd:var-r27 ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:marketTrendScore ; swrl:argument1 ashd:var-r27 ; swrl:argument2 ashd:var-r27-v ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-r27-v "60"^^xsd:decimal ) ]
    ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ash:MarketRiskOn ; swrl:argument1 ashd:var-r27 ] ) .
ashd:var-r27 a swrl:Variable ; rdfs:label "?var-r27" .
ashd:var-r27-v a swrl:Variable ; rdfs:label "?var-r27-v" .

ashd:rule-r28 a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R28" ;
    rdfs:label "市场趋势关闭"@zh ;
    rdfs:comment "趋势分数低于 -40 时转为防守。"@zh ;
    ash:ruleIf "趋势分数低于 -40 时转为防守。"@zh ;
    ash:ruleThen "主体被推断为 ash:MarketRiskOff"@zh ;
    ash:severity "high" ;
    ash:rulePriority 72 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.7.0" ;
    ash:ruleOwner "游资规则组" ;
    ash:ruleCategory "市场" ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:Security ;
    ash:ruleUses ash:marketTrendScore ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Security ; swrl:argument1 ashd:var-r28 ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:marketTrendScore ; swrl:argument1 ashd:var-r28 ; swrl:argument2 ashd:var-r28-v ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThan ; swrl:arguments ( ashd:var-r28-v "-40"^^xsd:decimal ) ]
    ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ash:MarketRiskOff ; swrl:argument1 ashd:var-r28 ] ) .
ashd:var-r28 a swrl:Variable ; rdfs:label "?var-r28" .
ashd:var-r28-v a swrl:Variable ; rdfs:label "?var-r28-v" .

ashd:rule-r29 a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R29" ;
    rdfs:label "市场宽度开启"@zh ;
    rdfs:comment "市场宽度高于 70 时风险偏好上升。"@zh ;
    ash:ruleIf "市场宽度高于 70 时风险偏好上升。"@zh ;
    ash:ruleThen "主体被推断为 ash:MarketRiskOn"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 71 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.7.0" ;
    ash:ruleOwner "游资规则组" ;
    ash:ruleCategory "市场" ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:Security ;
    ash:ruleUses ash:marketBreadthScore ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Security ; swrl:argument1 ashd:var-r29 ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:marketBreadthScore ; swrl:argument1 ashd:var-r29 ; swrl:argument2 ashd:var-r29-v ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-r29-v "70"^^xsd:decimal ) ]
    ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ash:MarketRiskOn ; swrl:argument1 ashd:var-r29 ] ) .
ashd:var-r29 a swrl:Variable ; rdfs:label "?var-r29" .
ashd:var-r29-v a swrl:Variable ; rdfs:label "?var-r29-v" .

ashd:rule-r30 a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R30" ;
    rdfs:label "市场宽度走弱"@zh ;
    rdfs:comment "宽度低于 30 时减少开仓。"@zh ;
    ash:ruleIf "宽度低于 30 时减少开仓。"@zh ;
    ash:ruleThen "主体被推断为 ash:MarketBreadthWeak"@zh ;
    ash:severity "high" ;
    ash:rulePriority 70 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.7.0" ;
    ash:ruleOwner "游资规则组" ;
    ash:ruleCategory "市场" ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:Security ;
    ash:ruleUses ash:marketBreadthScore ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Security ; swrl:argument1 ashd:var-r30 ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:marketBreadthScore ; swrl:argument1 ashd:var-r30 ; swrl:argument2 ashd:var-r30-v ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThan ; swrl:arguments ( ashd:var-r30-v "30"^^xsd:decimal ) ]
    ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ash:MarketBreadthWeak ; swrl:argument1 ashd:var-r30 ] ) .
ashd:var-r30 a swrl:Variable ; rdfs:label "?var-r30" .
ashd:var-r30-v a swrl:Variable ; rdfs:label "?var-r30-v" .

ashd:rule-r31 a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R31" ;
    rdfs:label "成交额支持"@zh ;
    rdfs:comment "全市场成交额高于 8000 亿时流动性充足。"@zh ;
    ash:ruleIf "全市场成交额高于 8000 亿时流动性充足。"@zh ;
    ash:ruleThen "主体被推断为 ash:MarketRiskOn"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 69 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.7.0" ;
    ash:ruleOwner "游资规则组" ;
    ash:ruleCategory "市场" ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:Security ;
    ash:ruleUses ash:marketTurnoverAmount ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Security ; swrl:argument1 ashd:var-r31 ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:marketTurnoverAmount ; swrl:argument1 ashd:var-r31 ; swrl:argument2 ashd:var-r31-v ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-r31-v "800000000000"^^xsd:decimal ) ]
    ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ash:MarketRiskOn ; swrl:argument1 ashd:var-r31 ] ) .
ashd:var-r31 a swrl:Variable ; rdfs:label "?var-r31" .
ashd:var-r31-v a swrl:Variable ; rdfs:label "?var-r31-v" .

ashd:rule-r32 a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R32" ;
    rdfs:label "成交额不足"@zh ;
    rdfs:comment "成交额低于 5000 亿时降低交易频率。"@zh ;
    ash:ruleIf "成交额低于 5000 亿时降低交易频率。"@zh ;
    ash:ruleThen "主体被推断为 ash:NoTradeSignal"@zh ;
    ash:severity "high" ;
    ash:rulePriority 68 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.7.0" ;
    ash:ruleOwner "游资规则组" ;
    ash:ruleCategory "市场" ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:Security ;
    ash:ruleUses ash:marketTurnoverAmount ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Security ; swrl:argument1 ashd:var-r32 ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:marketTurnoverAmount ; swrl:argument1 ashd:var-r32 ; swrl:argument2 ashd:var-r32-v ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:lessThan ; swrl:arguments ( ashd:var-r32-v "500000000000"^^xsd:decimal ) ]
    ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ash:NoTradeSignal ; swrl:argument1 ashd:var-r32 ] ) .
ashd:var-r32 a swrl:Variable ; rdfs:label "?var-r32" .
ashd:var-r32-v a swrl:Variable ; rdfs:label "?var-r32-v" .

ashd:rule-r33 a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R33" ;
    rdfs:label "炸板率过高"@zh ;
    rdfs:comment "炸板率高于 50% 时进入退潮。"@zh ;
    ash:ruleIf "炸板率高于 50% 时进入退潮。"@zh ;
    ash:ruleThen "主体被推断为 ash:EmotionEbb"@zh ;
    ash:severity "high" ;
    ash:rulePriority 67 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.7.0" ;
    ash:ruleOwner "游资规则组" ;
    ash:ruleCategory "情绪" ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:Security ;
    ash:ruleUses ash:brokenBoardRate ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Security ; swrl:argument1 ashd:var-r33 ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:brokenBoardRate ; swrl:argument1 ashd:var-r33 ; swrl:argument2 ashd:var-r33-v ]
        [ a swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( ashd:var-r33-v "50"^^xsd:decimal ) ]
    ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate ash:EmotionEbb ; swrl:argument1 ashd:var-r33 ] ) .
ashd:var-r33 a swrl:Variable ; rdfs:label "?var-r33" .
ashd:var-r33-v a swrl:Variable ; rdfs:label "?var-r33-v" .

ashd:rule-r34 a swrl:Imp, ash:RuleArtifact ;
    ash:ruleId "R34" ;
    rdfs:label "封板率强"@zh ;
    rdfs:comment "炸板率低于 20% 时情绪偏强。"@zh ;
    ash:ruleIf "炸板率低于 20% 时情绪偏强。"@zh ;
    ash:ruleThen "主体被推断为 ash:EmotionClimax"@zh ;
    ash:severity "medium" ;
    ash:rulePriority 66 ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "1.7.0" ;
    ash:ruleOwner "游资规则组" ;
    ash:ruleCategory "情绪" ;
    ash:ruleEffectiveFrom "2026-11-04"^^xsd:date ;
    ash:appliesTo ash:Security ;
    ash:ruleUses ash:brokenBoardRate ;
    swrl:body (
        [ a swrl:ClassAtom ; swrl:classPredicate ash:Security ; swrl:argument1 ashd:var-r34 ]
        [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate ash:brokenBoardRate ; swrl:argument1 ashd:var-r34 ; swrl:argument2 ashd:var-r34-v ]
