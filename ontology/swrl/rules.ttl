ashd:rule-relation-op002-evaluated-eva004
    a owl:NamedIndividual, ash:RuleRelation ;
    rdfs:label "OP-002 EVALUATED_BY EVA-004"@zh, "OP-002 EVALUATED_BY EVA-004"@en ;
    rdfs:comment "回踩规则的成功率由 EVA-004 评估。"@zh ;
    ash:relationFrom ashd:rule-op-002 ;
    ash:relationTo ashd:rule-eva-004 ;
    ash:relationType ashd:relation-type-evaluated-by .

ashd:rule-relation-mkt007-conflicts-op001
    a owl:NamedIndividual, ash:RuleRelation ;
    rdfs:label "MKT-007 CONFLICTS OP-001"@zh, "MKT-007 CONFLICTS OP-001"@en ;
    rdfs:comment "板块退潮风险与突破机会冲突，降低新开仓优先级。"@zh ;
    ash:relationFrom ashd:rule-mkt-007 ;
    ash:relationTo ashd:rule-op-001 ;
    ash:relationType ashd:relation-type-conflicts .

# ===========================================================================
# Rule library V2.0 — example run outputs and state changes
# ===========================================================================
# Synthetic examples only. They show the output contract, the evidence
# categories, the DATA_INSUFFICIENT boundary and the transition log.

ashd:rule-run-op-001-20261105 a owl:NamedIndividual, ash:RuleRun ;
    rdfs:label "OP-001 趋势突破运行示例"@zh, "OP-001 trend breakout run example"@en ;
    rdfs:comment "华辰智造 2026-11-05 收盘后的 OP-001 规则运行示例；价格为合成数据，不构成投资建议。"@zh ;
    ash:runOfRule ashd:rule-op-001 ;
    ash:runSecurity ashd:sec-huachen-a ;
    ash:runAsOf "2026-11-05T15:05:00+08:00"^^xsd:dateTime ;
    ash:runTimeframe "1d" ;
    ash:runPositionState "FLAT" ;
    ash:runState ashd:state-candidate ;
    ash:runTriggerEvidence ashd:evidence-rule-op001-breakout-close ;
    ash:runSupportingEvidence ashd:evidence-rule-op001-volume ;
    ash:runContraryEvidence ashd:evidence-rule-op001-sector-weak ;
    ash:runMissingData ashd:missing-rule-op001-intraday ;
    ash:runParametersVersion "OP-001-cn-equity-2026-01" ;
    ash:runValidUntil "2026-11-07"^^xsd:date ;
    ash:runNextActions "VP-001、MKT-001、RSK-001" ;
    ash:runSourceRefs "Issue #25 / OP-001；合成日线行情 2026-11-05" ;
    ash:runConfidenceBasis "价格与成交数据完整，板块反向证据独立；历史样本待回测，因此只输出 CANDIDATE。" ;
    ash:dataQualityFlag "verified:price;estimated:sector" ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:isExample true ;
    ash:exampleNote "用于展示状态、触发/支持/反向/缺失证据、参数版本、有效期与后续动作。"@zh .

ashd:evidence-rule-op001-breakout-close a owl:NamedIndividual, ash:TriggerEvidence ;
    rdfs:label "OP-001 收盘越过压力区"@zh, "OP-001 close above resistance"@en ;
    ash:evidenceRef "合成日线：收盘价 18.62，平台压力上沿 18.50" ;
    ash:evidenceAsOf "2026-11-05"^^xsd:date ;
    ash:evidenceSource "合成日线行情" ;
    ash:evidenceNote "收盘确认越过，但仍需后续价格接受；盘中越线不计入确认。"@zh .

ashd:evidence-rule-op001-volume a owl:NamedIndividual, ash:SupportingEvidence ;
    rdfs:label "OP-001 成交额改善"@zh, "OP-001 volume improvement"@en ;
    ash:evidenceRef "突破日成交额为整理期中位数的 1.45 倍" ;
    ash:evidenceAsOf "2026-11-05"^^xsd:date ;
    ash:evidenceSource "合成日线行情" ;
    ash:evidenceNote "支持突破获得更广泛交易参与；1.45 倍是示例值，阈值待回测。"@zh .

ashd:evidence-rule-op001-sector-weak a owl:NamedIndividual, ash:ContraryEvidence ;
    rdfs:label "OP-001 板块反向证据"@zh, "OP-001 sector contrary evidence"@en ;
    ash:evidenceRef "所属板块当日下跌 1.2%，弱于指数" ;
    ash:evidenceAsOf "2026-11-05"^^xsd:date ;
    ash:evidenceSource "合成板块行情" ;
    ash:evidenceNote "板块环境恶化，突破强度需降级审查。"@zh .

ashd:missing-rule-op001-intraday a owl:NamedIndividual, ash:MissingData ;
    rdfs:label "OP-001 缺失盘中路径"@zh, "OP-001 missing intraday path"@en ;
    ash:evidenceRef "缺少分钟级成交分布" ;
    ash:evidenceAsOf "2026-11-05"^^xsd:date ;
    ash:evidenceSource "合成数据未覆盖" ;
    ash:evidenceNote "无法判断成交是否集中在突破时段；不把缺失解释为没有信号。"@zh .

ashd:rule-run-rsk-007-20261105 a owl:NamedIndividual, ash:RuleRun ;
    rdfs:label "RSK-007 交易条件检查运行示例"@zh, "RSK-007 trading-condition run example"@en ;
    rdfs:comment "交易制度字段缺失时的数据不足示例；硬约束不满足时不得默认放行。"@zh ;
    ash:runOfRule ashd:rule-rsk-007 ;
    ash:runSecurity ashd:sec-huachen-a ;
    ash:runAsOf "2026-11-05T09:25:00+08:00"^^xsd:dateTime ;
    ash:runTimeframe "tick" ;
    ash:runPositionState "FLAT" ;
    ash:runState ashd:state-data-insufficient ;
    ash:runContraryEvidence ashd:evidence-rule-rsk007-missing-limit ;
    ash:runMissingData ashd:missing-rule-rsk007-limit ;
    ash:runParametersVersion "RSK-007-cn-equity-2026-01" ;
    ash:runValidUntil "2026-11-05"^^xsd:date ;
    ash:runNextActions "RSK-002、RSK-006" ;
    ash:runSourceRefs "Issue #25 / RSK-007；合成证券主数据" ;
    ash:runConfidenceBasis "关键制度字段缺失，无法完成硬校验，因此输出 DATA_INSUFFICIENT 而不是 PASS。" ;
    ash:dataQualityFlag "missing:priceLimit" ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:isExample true ;
    ash:exampleNote "用于展示硬约束字段缺失时的数据不足边界与拒单前状态。"@zh .

ashd:evidence-rule-rsk007-missing-limit a owl:NamedIndividual, ash:ContraryEvidence ;
    rdfs:label "RSK-007 涨跌停字段缺失"@zh, "RSK-007 missing price limit"@en ;
    ash:evidenceRef "证券主数据未返回当日涨跌停价" ;
    ash:evidenceAsOf "2026-11-05"^^xsd:date ;
    ash:evidenceSource "合成证券主数据" ;
    ash:evidenceNote "无法判断订单价格是否超限，不得默认放行。"@zh .

ashd:missing-rule-rsk007-limit a owl:NamedIndividual, ash:MissingData ;
    rdfs:label "RSK-007 缺失制度字段"@zh, "RSK-007 missing trading fields"@en ;
    ash:evidenceRef "涨跌停价、可卖数量、交易单位" ;
    ash:evidenceAsOf "2026-11-05"^^xsd:date ;
    ash:evidenceSource "合成证券主数据" ;
    ash:evidenceNote "制度字段缺失属于硬阻断，不是可以忽略的噪声。"@zh .

ashd:rule-state-change-op001-01 a owl:NamedIndividual, ash:RuleStateChange ;
    rdfs:label "OP-001 进入观察"@zh, "OP-001 enters watching"@en ;
    rdfs:comment "2026-11-03 收盘后接近压力区，从 NOT_OBSERVED 迁移到 WATCHING。"@zh ;
    ash:changeOfRun ashd:rule-run-op-001-20261105 ;
    ash:changeFrom ashd:state-not-observed ;
    ash:changeTo ashd:state-watching ;
    ash:changeAt "2026-11-03T15:05:00+08:00"^^xsd:dateTime ;
    ash:changeTriggerEvidence ashd:evidence-rule-op001-approach ;
    ash:changeDataVersion "2026-11-03-daily-v1" ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:isExample true .

ashd:evidence-rule-op001-approach a owl:NamedIndividual, ash:TriggerEvidence ;
    rdfs:label "OP-001 接近压力区"@zh, "OP-001 approaches resistance"@en ;
    ash:evidenceRef "收盘价 18.31，距平台压力上沿 18.50 约 1.0%" ;
    ash:evidenceAsOf "2026-11-03"^^xsd:date ;
    ash:evidenceSource "合成日线行情" ;
    ash:evidenceNote "仅进入观察，不构成触发。"@zh .
