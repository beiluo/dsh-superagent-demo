    ash:transitionCondition "关键数据缺失或口径不一致。" .

ashd:state-transition-data-candidate
    a owl:NamedIndividual, ash:RuleStateTransition ;
    rdfs:label "CANDIDATE → DATA_INSUFFICIENT"@zh, "CANDIDATE to DATA_INSUFFICIENT"@en ;
    rdfs:comment "确认所需数据不足。"@zh ;
