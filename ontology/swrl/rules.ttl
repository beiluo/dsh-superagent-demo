    ash:transitionCondition "候选结构失效。" .

ashd:state-transition-invalidate-triggered
    a owl:NamedIndividual, ash:RuleStateTransition ;
    rdfs:label "TRIGGERED → INVALIDATED"@zh, "TRIGGERED to INVALIDATED"@en ;
    rdfs:comment "触发条件被证伪。"@zh ;
