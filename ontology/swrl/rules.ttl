ashd:rule-op-001
    a ash:DecisionRule, ash:OpportunityRule, ash:RuleArtifact ;
    rdfs:label "趋势突破"@zh, "Trend breakout"@en ;
    rdfs:comment "价格经过可识别的整理或压力测试后，向上越过市场参与者能够观察到的有效压力区域；突破需由收盘位置、成交参与和后续价格接受度共同验证。"@zh ;
    ash:ruleId "OP-001" ;
    ash:ruleCategory "OP 机会结构" ;
    ash:ruleDefinition "价格经过可识别的整理或压力测试后，向上越过市场参与者能够观察到的有效压力区域；突破需由收盘位置、成交参与和后续价格接受度共同验证。"@zh ;
    ash:ruleScope "非持仓买入机会优先；持仓状态下用于判断趋势是否进入新阶段。适用于日线及更高周期；盘中突破只记为候选。排除无可交易价格、长期停牌、异常复牌及无法确认压力位的样本。"@zh ;
    ash:rulePreconditions "数据连续且复权口径一致；压力区域由至少两个可解释的历史转折/密集成交/平台上沿构成；明确突破前的趋势状态；检查近期除权、重大公告和异常波动。"@zh ;
    ash:ruleInputData "OHLC、成交额/量、换手率、ATR、局部高低点、历史平台区间、指数及行业/主题行情、公告与事件时间线。"@zh ;
    ash:ruleObservations "压力区域是否清晰；整理期间高低点是否收敛；突破幅度是否超过正常噪声；收盘是否处于当日振幅上部；成交参与是否改善；相对指数和板块是否走强；突破后是否出现价格接受。"@zh ;
    ash:ruleTrigger "必要条件为有效压力区域被收盘价有效越过，且突破不是由数据异常造成；支持条件包括成交额较整理期常态明显改善、收盘位置强、相对强度上升、板块环境不恶化。盘中越线而收盘回落只进入 `WATCHING`，不算确认。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "放量但收盘靠近低点；突破仅由单笔/极低流动性成交推动；同日板块明显走弱；价格远离突破位且风险收益恶化；次日快速回到平台内部。"@zh ;
    ash:ruleVeto "停牌复牌首日、重大数据错误、涨跌停导致无法验证真实供需、临近退市/重大监管风险、风险约束不允许新开仓。"@zh ;
    ash:ruleStateMachine "`WATCHING`（接近压力）→ `CANDIDATE`（盘中越线）→ `TRIGGERED`（收盘确认越线）→ `CONFIRMED`（后续价格接受）; 收盘回落为 `INVALIDATED`；超过设定观察窗口为 `EXPIRED`。"@zh ;
    ash:ruleNextActions "调用 VP-001 检查放量突破、VP-008 检查量价背离、MKT-001 检查市场风险、MKT-004 检查板块持续性，再交 RSK-001/002 评估盈亏比和风险预算。持仓时联动 POS-001。"@zh ;
    ash:ruleInvalidation "收盘重新落回压力区域下方并持续；突破后形成更低低点破坏结构；原始事件逻辑被公告证伪。"@zh ;
    ash:ruleParameters "整理观察窗 10–30 个交易日；突破容差可用 0.1–0.3 ATR；成交额比较整理期中位数；收盘位置可观察振幅上部 60%–70%。所有阈值按流动性分层校准。"@zh ;
    ash:ruleTypicalScenario "平台上沿多次受阻，缩量整理后放量收盘越过上沿，随后回踩不破并重新走强，属于较完整证据链。"@zh ;
    ash:ruleCounterExample "盘中冲过前高但收盘跌回；单日消息刺激巨量冲高回落；指数暴跌时个股被动脉冲。"@zh ;
    ash:ruleVerification "按市场状态、流动性、板块强弱分层统计 1/3/5/10/20 日收益、最大有利/不利波动（MFE/MAE）、假突破率、触发后可成交比例和扣费后期望收益；与“仅价格突破”基线比较。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "必要条件为有效压力区域被收盘价有效越过，且突破不是由数据异常造成；支持条件包括成交额较整理期常态明显改善、收盘位置强、相对强度上升、板块环境不恶化。盘中越线而收盘回落只进入 `WATCHING`，不算确认。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-op ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-op-001 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-vp-001 ;
    ash:ruleNextRule ashd:rule-vp-008 ;
    ash:ruleNextRule ashd:rule-mkt-001 ;
    ash:ruleNextRule ashd:rule-mkt-004 ;
    ash:ruleNextRule ashd:rule-rsk-001 ;
    ash:ruleNextRule ashd:rule-rsk-002 ;
    ash:ruleNextRule ashd:rule-pos-001 .

ashd:rule-op-002
    a ash:DecisionRule, ash:OpportunityRule, ash:RuleArtifact ;
    rdfs:label "缩量回踩"@zh, "Low-volume pullback"@en ;
    rdfs:comment "有效上行结构形成后，价格回落测试突破位、均线/趋势线或前期需求区域；回落过程中卖压减弱，关键位置获得承接，随后出现止跌或重新转强迹象。"@zh ;
    ash:ruleId "OP-002" ;
    ash:ruleCategory "OP 机会结构" ;
    ash:ruleDefinition "有效上行结构形成后，价格回落测试突破位、均线/趋势线或前期需求区域；回落过程中卖压减弱，关键位置获得承接，随后出现止跌或重新转强迹象。"@zh ;
    ash:ruleScope "已有上行趋势或刚完成有效突破的股票；可用于未持仓的二次介入观察，也可用于持仓回调管理。不能把下跌趋势中的普通缩量反弹认作回踩。"@zh ;
    ash:rulePreconditions "先确认上行结构或 OP-001 突破；明确回踩参考位及允许偏离区间；确认回踩期间没有基本面/事件逻辑反转。"@zh ;
    ash:ruleInputData "日线/分钟 OHLC、成交额、换手率、ATR、突破位、前高/平台、均线、板块与指数状态、公告。"@zh ;
    ash:ruleObservations "回撤深度与速度；下跌日成交是否收缩；低点是否逐步稳定；关键区域附近是否出现下影线/收盘收复；板块是否同步承接；回踩时间是否过长。"@zh ;
    ash:ruleTrigger "价格进入预先定义的支撑区域；回落成交参与低于突破阶段或近期上涨阶段的常态；关键区域未被有效收盘跌破；随后出现止跌证据（如低点不再下移、收盘收复关键位、次日重新站上短周期压力）。仅“缩量下跌”不够触发。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "缩量但持续阴跌；关键位被反复收盘跌破；板块同步退潮；反弹无成交参与；回踩时间过长且结构变成横盘弱势。"@zh ;
    ash:ruleVeto "原突破已被确认失败；发生重大利空或业绩逻辑变化；支撑区域不可定义；流动性不足导致无法可靠观察。"@zh ;
    ash:ruleStateMachine "`WATCHING`（接近支撑）→ `CANDIDATE`（缩量测试）→ `TRIGGERED`（止跌信号出现）→ `CONFIRMED`（重新转强）；有效跌破为 `INVALIDATED`。"@zh ;
    ash:ruleNextActions "联动 VP-004（缩量下跌）判断卖压、VP-006（低位放量）仅在对应低位结构下使用、MKT-004/005 判断板块持续性与内部强弱；通过 RSK 评估入场位置。"@zh ;
    ash:ruleInvalidation "关键支撑被收盘有效跌破；回踩演变为下降趋势；突破前提不再成立。"@zh ;
    ash:ruleParameters "回踩参考位容差以 ATR 或价格区间定义；回踩成交额与突破阶段、近 5–10 日中位数比较；允许回踩时间按策略周期配置，不设置统一固定天数。"@zh ;
    ash:ruleTypicalScenario "突破后回撤至平台上沿附近，成交逐日收缩，低点稳定，随后收盘重新站回短期压力。"@zh ;
    ash:ruleCounterExample "股价连续缩量创新低；支撑位被跌破后因无量而暂时横盘；消息面恶化导致缩量并非卖压衰减。"@zh ;
    ash:ruleVerification "按突破后第几日、回踩深度、成交收缩程度、板块环境分组；统计回踩后 1/3/5/10 日收益、二次跌破率、MAE、可成交率和扣费期望。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "价格进入预先定义的支撑区域；回落成交参与低于突破阶段或近期上涨阶段的常态；关键区域未被有效收盘跌破；随后出现止跌证据（如低点不再下移、收盘收复关键位、次日重新站上短周期压力）。仅“缩量下跌”不够触发。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-op ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-op-002 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-vp-004 ;
    ash:ruleNextRule ashd:rule-vp-006 ;
    ash:ruleNextRule ashd:rule-mkt-004 ;
    ash:ruleNextRule ashd:rule-mkt-005 ;
    ash:ruleRelatedRule ashd:rule-op-001 .

ashd:rule-op-003
    a ash:DecisionRule, ash:OpportunityRule, ash:RuleArtifact ;
    rdfs:label "二次启动"@zh, "Second launch"@en ;
    rdfs:comment "一轮上涨或突破后经历整理/回踩，价格再次向上越过整理区局部压力，显示趋势恢复而非单纯反弹。"@zh ;
    ash:ruleId "OP-003" ;
    ash:ruleCategory "OP 机会结构" ;
    ash:ruleDefinition "一轮上涨或突破后经历整理/回踩，价格再次向上越过整理区局部压力，显示趋势恢复而非单纯反弹。"@zh ;
    ash:ruleScope "有明确第一波上涨、且中间形成可识别整理结构的股票；不适用于连续加速后无整理的高位追涨。"@zh ;
    ash:rulePreconditions "第一波上涨结构有效；整理区间边界明确；整理期间未破坏趋势关键低点；无重大逻辑反转。"@zh ;
    ash:ruleInputData "OHLC、成交额、振幅、局部高低点、均线/ATR、板块强弱、事件信息。"@zh ;
    ash:ruleObservations "第一波上涨质量；整理是否有序；回撤是否可控；整理上沿是否被反复测试；再次启动时成交是否改善；个股相对强度是否恢复。"@zh ;
    ash:ruleTrigger "整理区上沿被有效收盘突破；突破时价格和成交行为较整理期改善；启动后没有立即被压回；市场环境允许承担风险。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "二次冲高成交不足；上沿多次冲击失败；整理低点被破坏；板块主线已退潮；股价距离合理止损位过远。"@zh ;
    ash:ruleVeto "第一波上涨属于一次性消息脉冲且事件已兑现；整理期间出现明显派发结构；流动性或风险约束不合格。"@zh ;
    ash:ruleStateMachine "`WATCHING`（整理形成）→ `CANDIDATE`（测试上沿）→ `TRIGGERED`（有效突破）→ `CONFIRMED`（突破后接受）；跌破整理低点为 `INVALIDATED`。"@zh ;
    ash:ruleNextActions "调用 OP-001、OP-002、VP-001/002/003、MKT-004/005；通过 RSK-001 评估追入后的盈亏比。"@zh ;
    ash:ruleInvalidation "突破失败并回到整理区；整理低点失守；板块/事件前提消失。"@zh ;
    ash:ruleParameters "第一波幅度、整理长度、回撤比例、整理上沿突破容差均按波动率和流动性分层；不得用固定涨幅套所有股票。"@zh ;
    ash:ruleTypicalScenario "主升初段突破后横向整理，波动收敛，回踩不破，随后放量越过整理上沿。"@zh ;
    ash:ruleCounterExample "连续拉升后高位小平台，实际是高位派发；弱势股下跌中继后短暂反抽。"@zh ;
    ash:ruleVerification "与首次突破、普通反弹策略对照；统计二次启动后收益分布、失败率、最大回撤和持有期收益衰减。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "整理区上沿被有效收盘突破；突破时价格和成交行为较整理期改善；启动后没有立即被压回；市场环境允许承担风险。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-op ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-op-003 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-op-001 ;
    ash:ruleNextRule ashd:rule-op-002 ;
    ash:ruleNextRule ashd:rule-vp-001 ;
    ash:ruleNextRule ashd:rule-vp-002 ;
    ash:ruleNextRule ashd:rule-mkt-004 ;
    ash:ruleNextRule ashd:rule-mkt-005 ;
    ash:ruleNextRule ashd:rule-rsk-001 .

ashd:rule-op-004
    a ash:DecisionRule, ash:OpportunityRule, ash:RuleArtifact ;
    rdfs:label "平台整理"@zh, "Range consolidation"@en ;
    rdfs:comment "价格在相对明确的上下边界内反复波动，方向性减弱，市场在重新平衡供需；该规则识别结构，不预设向上突破。"@zh ;
    ash:ruleId "OP-004" ;
    ash:ruleCategory "OP 机会结构" ;
    ash:ruleDefinition "价格在相对明确的上下边界内反复波动，方向性减弱，市场在重新平衡供需；该规则识别结构，不预设向上突破。"@zh ;
    ash:ruleScope "趋势中继、底部构筑或高位整理均可识别，但必须额外标注所处位置与前置趋势。"@zh ;
    ash:rulePreconditions "足够连续的价格数据；可识别区间边界；排除停牌、除权缺口和异常交易造成的假平台。"@zh ;
    ash:ruleInputData "OHLC、成交额、振幅、ATR、局部高低点、换手率、指数/板块行情。"@zh ;
    ash:ruleObservations "区间边界稳定性；区间宽度是否收敛；高低点变化；成交是否萎缩；区间内上涨/下跌日的成交差异；平台所处趋势位置。"@zh ;
    ash:ruleTrigger "在观察窗口内多次触及相近边界，区间内收盘大部分时间保持稳定；波动与成交呈现可描述的平衡状态。输出 `PLATFORM_NEUTRAL`，不直接视为买入机会。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "区间边界不断下移；下跌日成交持续放大；价格虽横盘但相对板块持续走弱；区间由极端低流动性造成。"@zh ;
    ash:ruleVeto "数据缺口严重；区间由单日异常价格拉伸；重大公司行动未正确复权。"@zh ;
    ash:ruleStateMachine "`WATCHING`→`CANDIDATE`→`CONFIRMED`；向上突破转 OP-001，向下破位转 OP-006/风险流程；长期无方向则 `EXPIRED`。"@zh ;
    ash:ruleNextActions "记录平台上沿/下沿和结构标签；向 OP-001、OP-006、VP-002/004 提供结构上下文。"@zh ;
    ash:ruleInvalidation "有效突破任一边界、区间边界漂移或新事件改变供需。"@zh ;
    ash:ruleParameters "观察窗可从 10–30 日起测；平台宽度以 ATR 标准化；触边次数、区间斜率、波动收敛度需回测确定。"@zh ;
    ash:ruleTypicalScenario "趋势股在前高下方窄幅整理，成交逐步收缩。"@zh ;
    ash:ruleCounterExample "连续阴跌但每日跌幅很小，不应误标为健康平台。"@zh ;
    ash:ruleVerification "分别统计上行趋势平台、底部平台、高位平台后向上/向下突破概率，避免把不同位置混合统计。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "在观察窗口内多次触及相近边界，区间内收盘大部分时间保持稳定；波动与成交呈现可描述的平衡状态。输出 `PLATFORM_NEUTRAL`，不直接视为买入机会。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-op ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-op-004 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-op-001 ;
    ash:ruleNextRule ashd:rule-op-006 ;
    ash:ruleNextRule ashd:rule-vp-002 ;
    ash:ruleNextRule ashd:rule-vp-004 .

ashd:rule-op-005
    a ash:DecisionRule, ash:OpportunityRule, ash:RuleArtifact ;
    rdfs:label "底部反转"@zh, "Bottom reversal"@en ;
    rdfs:comment "长期或阶段性下行后，卖压减弱、低点不再有效下移，并出现需求回归和结构性抬高，形成从下跌到筑底再到反转的证据链。"@zh ;
    ash:ruleId "OP-005" ;
    ash:ruleCategory "OP 机会结构" ;
    ash:ruleDefinition "长期或阶段性下行后，卖压减弱、低点不再有效下移，并出现需求回归和结构性抬高，形成从下跌到筑底再到反转的证据链。"@zh ;
    ash:ruleScope "阶段性低位股票；仅用于观察和候选识别，不因“跌得多”自动触发。"@zh ;
    ash:rulePreconditions "定义下跌阶段和潜在底部区域；核查财务、监管、退市、质押、诉讼等基本面风险；区分估值低与价格反转。"@zh ;
    ash:ruleInputData "较长周期 OHLC、成交额、换手率、波动率、历史低点、财务与公告、行业/指数状态。"@zh ;
    ash:ruleObservations "下跌斜率是否减缓；低点是否停止下移；恐慌成交是否释放；反弹是否有持续性；回撤是否守住前低；相对强度是否改善。"@zh ;
    ash:ruleTrigger "至少出现“低点稳定/抬高”和“向上突破局部结构”两类证据；成交参与和市场环境作为支持条件。单纯超跌反弹只进入观察。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "反弹缩量且很快创新低；基本面持续恶化；行业景气继续下行；反弹只由短期消息驱动。"@zh ;
    ash:ruleVeto "退市风险、持续经营重大不确定性、重大财务造假嫌疑或交易限制；不得以技术形态覆盖基本面硬风险。"@zh ;
    ash:ruleStateMachine "`WATCHING`（下跌减速）→ `CANDIDATE`（底部结构）→ `TRIGGERED`（局部压力突破）→ `CONFIRMED`（回踩守住/趋势抬高）；再创新低为 `INVALIDATED`。"@zh ;
    ash:ruleNextActions "联动 VP-006、VP-008、MKT-001、EVT-004/005；若事件驱动则必须核实事件真实性与影响方向。"@zh ;
    ash:ruleInvalidation "有效跌破底部关键低点；新基本面风险改变长期价值判断。"@zh ;
    ash:ruleParameters "底部观察周期按股票波动和行业周期设定；以 ATR 标准化低点容差；避免统一使用“距 52 周低点百分比”。"@zh ;
    ash:ruleTypicalScenario "下跌后多次测试低位不再创新低，反弹高点逐步抬高，随后突破颈线并在回踩中获得承接。"@zh ;
    ash:ruleCounterExample "连续跌停后开板反弹；低估值但盈利持续恶化；单日放量不能证明底部完成。"@zh ;
    ash:ruleVerification "以信号日为基准评估 20/60/120 日收益、再次探底率、最大回撤、行业分层表现及退市/风险样本。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "至少出现“低点稳定/抬高”和“向上突破局部结构”两类证据；成交参与和市场环境作为支持条件。单纯超跌反弹只进入观察。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
