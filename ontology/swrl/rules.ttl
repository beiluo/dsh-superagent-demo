ashd:relation-type-precondition
    a owl:NamedIndividual, ash:RuleRelationType ;
    rdfs:label "前置"@zh, "Precondition"@en ;
    rdfs:comment "规则 A 未成立时，规则 B 不允许确认。"@zh ;
    ash:relationTypeCode "PRECONDITION" ;
    ash:relationTypeDescription "规则 A 未成立时，规则 B 不允许确认。" .

ashd:relation-type-supports
    a owl:NamedIndividual, ash:RuleRelationType ;
    rdfs:label "支持"@zh, "Supports"@en ;
    rdfs:comment "增加证据可信度，但不单独触发。"@zh ;
    ash:relationTypeCode "SUPPORTS" ;
    ash:relationTypeDescription "增加证据可信度，但不单独触发。" .

ashd:relation-type-conflicts
