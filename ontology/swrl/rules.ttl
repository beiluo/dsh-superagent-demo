    ash:belongsToRuleCategory ashd:category-op ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-op-005 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-vp-006 ;
    ash:ruleNextRule ashd:rule-vp-008 ;
    ash:ruleNextRule ashd:rule-mkt-001 ;
    ash:ruleNextRule ashd:rule-evt-004 ;
    ash:ruleNextRule ashd:rule-evt-005 .

ashd:rule-op-006
    a ash:DecisionRule, ash:OpportunityRule, ash:RuleArtifact ;
    rdfs:label "下降趋势反转"@zh, "Downtrend reversal"@en ;
    rdfs:comment "原有下降趋势的关键结构被破坏，表现为下跌高低点序列停止延续，价格收复重要压力并形成更高低点。"@zh ;
    ash:ruleId "OP-006" ;
    ash:ruleCategory "OP 机会结构" ;
    ash:ruleDefinition "原有下降趋势的关键结构被破坏，表现为下跌高低点序列停止延续，价格收复重要压力并形成更高低点。"@zh ;
    ash:ruleScope "下降趋势中的趋势反转候选；与 OP-005 底部反转不同，本规则重点识别趋势结构改变，而非底部区域。"@zh ;
    ash:rulePreconditions "原下降趋势必须可定义；识别最近有效低点、反弹高点和下降压力线；排除短期超跌反抽。"@zh ;
    ash:ruleInputData "OHLC、成交额、ATR、摆动高低点、均线、板块/指数、事件信息。"@zh ;
    ash:ruleObservations "低点是否抬高；反弹高点是否越过前一关键高点；下降压力是否被收复；回踩是否守住；相对强度是否改善。"@zh ;
    ash:ruleTrigger "至少一个关键下降结构高点被收盘突破，随后回撤未破坏新形成的更高低点；成交改善可增强确认。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "突破后快速跌回；新低再次出现；反弹高度不足；行业继续走弱。"@zh ;
    ash:ruleVeto "原下降趋势定义不清；事件造成一次性跳空但无持续交易；关键数据缺失。"@zh ;
    ash:ruleStateMachine "`WATCHING`（下降减速）→ `CANDIDATE`（关键高点测试）→ `TRIGGERED`（收盘越过）→ `CONFIRMED`（回踩守住）；新低为 `INVALIDATED`。"@zh ;
    ash:ruleNextActions "调用 OP-005、OP-001、VP-001/004/008、MKT-005；风险评估中采用更保守的初始仓位假设。"@zh ;
    ash:ruleInvalidation "重新形成更低低点和更低高点；突破位失守。"@zh ;
    ash:ruleParameters "摆动点识别窗口、突破容差、回踩确认窗按周期校准；短线与中线参数分开。"@zh ;
    ash:ruleTypicalScenario "下降趋势中形成更高低点，随后突破最近一轮反弹高点，回踩后再度走强。"@zh ;
    ash:ruleCounterExample "下降趋势中的均线反抽；单日涨停但随后持续走弱。"@zh ;
    ash:ruleVerification "与超跌反弹基线比较；统计趋势反转后 10/20/60 日趋势延续率、假反转率和 MAE。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "至少一个关键下降结构高点被收盘突破，随后回撤未破坏新形成的更高低点；成交改善可增强确认。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-op ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-op-006 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-op-005 ;
    ash:ruleNextRule ashd:rule-op-001 ;
    ash:ruleNextRule ashd:rule-vp-001 ;
    ash:ruleNextRule ashd:rule-vp-004 ;
    ash:ruleNextRule ashd:rule-mkt-005 .

ashd:rule-op-007
    a ash:DecisionRule, ash:OpportunityRule, ash:RuleArtifact ;
    rdfs:label "趋势加速"@zh, "Trend acceleration"@en ;
    rdfs:comment "既有上行趋势的价格推进速度、成交参与或市场关注度明显增强，趋势进入加速阶段；该状态既可能带来动量收益，也意味着波动和回撤风险上升。"@zh ;
    ash:ruleId "OP-007" ;
    ash:ruleCategory "OP 机会结构" ;
    ash:ruleDefinition "既有上行趋势的价格推进速度、成交参与或市场关注度明显增强，趋势进入加速阶段；该状态既可能带来动量收益，也意味着波动和回撤风险上升。"@zh ;
    ash:ruleScope "已有趋势持仓管理和强势股观察；不作为无条件追涨依据。"@zh ;
    ash:rulePreconditions "先确认上行趋势；识别加速前的正常推进节奏；评估涨幅、偏离度、流动性和事件持续性。"@zh ;
    ash:ruleInputData "多周期 OHLC、成交额、换手率、ATR、均线偏离、板块表现、事件与公告。"@zh ;
    ash:ruleObservations "单位时间价格推进速度；上涨日成交扩张；回撤幅度是否变浅；价格偏离趋势参考区间；日内振幅与换手是否异常。"@zh ;
    ash:ruleTrigger "价格推进明显快于此前趋势常态，且成交/相对强度提供支持；输出 `ACCELERATING`，并同时提升风险标记。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "价格加速但成交参与下降；高位巨量长上影；板块龙头转弱；波动扩张但收盘推进效率下降。"@zh ;
    ash:ruleVeto "无既有趋势；仅由除权或数据异常形成的价格变化。"@zh ;
    ash:ruleStateMachine "`WATCHING`→`CANDIDATE`→`TRIGGERED`；出现推进效率下降转 `DECELERATING`；关键趋势位失守转 `INVALIDATED`。"@zh ;
    ash:ruleNextActions "持仓调用 POS-002、POS-004、POS-007；非持仓必须额外通过 RSK-001，禁止因加速状态自动提高仓位。"@zh ;
    ash:ruleInvalidation "价格重新回归常态推进；加速后结构破坏；事件催化被证伪。"@zh ;
    ash:ruleParameters "价格速度、均线偏离和 ATR 扩张采用相对自身历史分位数，不使用全市场单一绝对阈值。"@zh ;
    ash:ruleTypicalScenario "趋势股突破后连续推进，回撤变浅，板块同步增强。"@zh ;
    ash:ruleCounterExample "高位最后一段脉冲式拉升、巨量冲高回落；无成交支撑的价格跳变。"@zh ;
    ash:ruleVerification "比较加速阶段继续持有、分批止盈和追入三种处理的收益/回撤；分行业、波动和市场周期评估。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "价格推进明显快于此前趋势常态，且成交/相对强度提供支持；输出 `ACCELERATING`，并同时提升风险标记。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-op ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-op-007 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-pos-002 ;
    ash:ruleNextRule ashd:rule-pos-004 ;
    ash:ruleNextRule ashd:rule-pos-007 ;
    ash:ruleNextRule ashd:rule-rsk-001 .

ashd:rule-op-008
    a ash:DecisionRule, ash:OpportunityRule, ash:RuleArtifact ;
    rdfs:label "高位横盘"@zh, "High-level consolidation"@en ;
    rdfs:comment "经历显著上涨后，价格在高位区域横向运行；可能是强势换手，也可能是需求衰退或派发，必须结合成交、相对强度和区间结构判断。"@zh ;
    ash:ruleId "OP-008" ;
    ash:ruleCategory "OP 机会结构" ;
    ash:ruleDefinition "经历显著上涨后，价格在高位区域横向运行；可能是强势换手，也可能是需求衰退或派发，必须结合成交、相对强度和区间结构判断。"@zh ;
    ash:ruleScope "高位持仓风险管理和潜在再突破观察；不预设看多。"@zh ;
    ash:rulePreconditions "定义此前上涨幅度和高位区间；确认不是除权/停牌导致的价格失真；标注距离阶段高点和趋势支撑的位置。"@zh ;
    ash:ruleInputData "OHLC、成交额、换手率、振幅、区间高低点、板块/指数、事件。"@zh ;
    ash:ruleObservations "横盘期间高低点是否稳定；成交是有序收缩还是持续放大；下跌日与上涨日成交差异；上沿测试次数；相对强度变化。"@zh ;
    ash:ruleTrigger "高位区间形成并持续达到设定观察长度，输出结构状态；只有向上有效突破且量价支持才升级为机会，向下破位则转风险。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "放量滞涨、长上影密集、相对强度下滑、下沿被反复测试、板块龙头走弱。"@zh ;
    ash:ruleVeto "高位定义不清；流动性极差；关键价格数据异常。"@zh ;
    ash:ruleStateMachine "`WATCHING`→`CANDIDATE`→`CONFIRMED`（高位区间成立）；向上转 OP-001/003，向下转 POS-004/005/006。"@zh ;
    ash:ruleNextActions "持仓优先调用 POS-004、POS-005、POS-007；非持仓等待方向确认，不因横盘本身买入。"@zh ;
    ash:ruleInvalidation "区间有效突破或破位；重大事件重新定价。"@zh ;
    ash:ruleParameters "高位区间以此前趋势波段和 ATR 标准化；观察窗按交易周期设定；成交结构采用上涨/下跌日对比。"@zh ;
    ash:ruleTypicalScenario "主升后高位窄幅整理，成交温和收缩，板块仍强，等待方向选择。"@zh ;
    ash:ruleCounterExample "高位巨量换手、收盘持续走低，被误判为强势横盘。"@zh ;
    ash:ruleVerification "按区间成交结构分类，统计向上突破率、向下破位率、后续收益与回撤。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "高位区间形成并持续达到设定观察长度，输出结构状态；只有向上有效突破且量价支持才升级为机会，向下破位则转风险。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-op ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-op-008 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-pos-004 ;
    ash:ruleNextRule ashd:rule-pos-005 ;
    ash:ruleNextRule ashd:rule-pos-007 ;
    ash:ruleRelatedRule ashd:rule-op-001 ;
    ash:ruleRelatedRule ashd:rule-op-003 .

ashd:rule-op-009
    a ash:DecisionRule, ash:OpportunityRule, ash:RuleArtifact ;
    rdfs:label "分歧转一致"@zh, "Divergence to consensus"@en ;
    rdfs:comment "市场参与者对个股方向存在明显分歧，随后价格行为和成交结果显示买方逐步占优，分歧收敛为方向一致。"@zh ;
    ash:ruleId "OP-009" ;
    ash:ruleCategory "OP 机会结构" ;
    ash:ruleDefinition "市场参与者对个股方向存在明显分歧，随后价格行为和成交结果显示买方逐步占优，分歧收敛为方向一致。"@zh ;
    ash:ruleScope "短线强势股、板块核心股及重要事件股；必须结合市场情绪周期，不能仅凭振幅大判断分歧。"@zh ;
    ash:rulePreconditions "识别分歧来源（获利盘、消息不确定、板块轮动或指数波动）；确认股票仍处于可交易状态；确定关键价格区间。"@zh ;
    ash:ruleInputData "分时成交、分钟 OHLC、日线、换手、封板/开板记录（若可得）、板块和市场情绪、事件。"@zh ;
    ash:ruleObservations "盘中回撤后收复速度；关键价位承接；成交方向变化；收盘相对日内区间位置；板块核心是否同步转强。"@zh ;
    ash:ruleTrigger "分歧阶段出现明显抛压，但关键结构未破；随后价格重新收复分歧区关键位置，成交和板块提供支持。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "反弹无成交；收复后再度快速跌破；板块核心持续走弱；尾盘被动拉升但全天结构偏弱。"@zh ;
    ash:ruleVeto "无法获得足够分钟数据；盘口数据仅为局部快照却被误当完整委托流；一字板无法观察分歧过程。"@zh ;
    ash:ruleStateMachine "`WATCHING`（分歧）→ `CANDIDATE`（承接出现）→ `TRIGGERED`（关键位收复）→ `CONFIRMED`（收盘/次日延续）；再次失守为 `INVALIDATED`。"@zh ;
    ash:ruleNextActions "调用 AUC-005/006（次日竞价验证）、VP-003/008、MKT-002/005；入场仍需 RSK-001。"@zh ;
    ash:ruleInvalidation "分歧区低点被有效跌破；板块情绪转退潮；事件预期被证伪。"@zh ;
    ash:ruleParameters "分歧区以盘中高低点和成交密集区域定义；收复确认可使用分钟收盘/日收盘双层口径。"@zh ;
    ash:ruleTypicalScenario "核心股盘中大幅分歧，关键支撑承接后收复均价线及分歧中枢，收盘强于板块。"@zh ;
    ash:ruleCounterExample "尾盘少量资金拉升造成表面转强，次日竞价和开盘即被抛压。"@zh ;
    ash:ruleVerification "区分盘中转一致、收盘转一致和次日确认，分别统计成功率、隔夜跳空风险和可成交率。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "分歧阶段出现明显抛压，但关键结构未破；随后价格重新收复分歧区关键位置，成交和板块提供支持。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-op ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-op-009 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-auc-005 ;
    ash:ruleNextRule ashd:rule-auc-006 ;
    ash:ruleNextRule ashd:rule-vp-003 ;
    ash:ruleNextRule ashd:rule-vp-008 ;
    ash:ruleNextRule ashd:rule-mkt-002 ;
    ash:ruleNextRule ashd:rule-mkt-005 ;
    ash:ruleNextRule ashd:rule-rsk-001 .

ashd:rule-op-010
    a ash:DecisionRule, ash:OpportunityRule, ash:RuleArtifact ;
    rdfs:label "弱转强"@zh, "Weak-to-strong"@en ;
    rdfs:comment "个股前一阶段表现弱于预期或弱于市场，随后在新的交易时段出现相对强度、价格结构和成交行为的同步改善。"@zh ;
    ash:ruleId "OP-010" ;
    ash:ruleCategory "OP 机会结构" ;
    ash:ruleDefinition "个股前一阶段表现弱于预期或弱于市场，随后在新的交易时段出现相对强度、价格结构和成交行为的同步改善。"@zh ;
    ash:ruleScope "短线交易和事件/板块轮动；需要有明确“弱”的基准，避免事后主观贴标签。"@zh ;
    ash:rulePreconditions "定义前一日/前一阶段的弱势表现；确定比较基准（指数、板块、同类股）；识别潜在催化和关键价位。"@zh ;
    ash:ruleInputData "前收盘、竞价数据、开盘后分钟数据、日线、板块/指数、成交额、事件。"@zh ;
    ash:ruleObservations "竞价相对预期；开盘后是否快速收复关键价位；相对板块强度；成交参与；回落承接；是否出现持续而非瞬时拉升。"@zh ;
    ash:ruleTrigger "相对强度从弱转为强，且价格收复预设关键位；竞价强度仅作支持，连续竞价的承接和收盘表现用于确认。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "高开低走；竞价强但开盘后持续走弱；板块没有跟随；价格上涨但成交极低。"@zh ;
    ash:ruleVeto "前序弱势定义不清；无可比基准；数据缺失；重大负面事件尚未澄清。"@zh ;
    ash:ruleStateMachine "`WATCHING`（弱势基线建立）→ `CANDIDATE`（竞价/开盘改善）→ `TRIGGERED`（关键位收复）→ `CONFIRMED`（盘中/收盘持续强于基准）；冲高回落为 `INVALIDATED`。"@zh ;
    ash:ruleNextActions "联动 AUC-001/003/005、MKT-005/006、VP-001/002；通过 RSK-005 评估高开跳空风险。"@zh ;
    ash:ruleInvalidation "相对强度重新转弱；关键位失守；催化证据被否定。"@zh ;
    ash:ruleParameters "相对强弱比较窗口、竞价偏离、关键价位和确认时间分开配置；避免将高开百分比作为唯一条件。"@zh ;
    ash:ruleTypicalScenario "前日分歧回落，次日竞价不弱，开盘承接强并收复前日分歧中枢，板块同步改善。"@zh ;
    ash:ruleCounterExample "仅竞价高开，开盘后无承接；低流动性股票几笔成交形成虚假强势。"@zh ;
    ash:ruleVerification "按前日弱势类型、竞价表现、板块状态分层，统计开盘后 30/60 分钟及收盘结果、隔夜风险与交易成本。 --- # 第二类：VP 量价行为（8条） VP 类只回答“成交行为是否支持价格变化”。VP 证据必须回到 OP/MKT/POS 等规则中解释，不单独形成买卖决策。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "相对强度从弱转为强，且价格收复预设关键位；竞价强度仅作支持，连续竞价的承接和收盘表现用于确认。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-op ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-op-010 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-auc-001 ;
    ash:ruleNextRule ashd:rule-auc-003 ;
    ash:ruleNextRule ashd:rule-mkt-005 ;
    ash:ruleNextRule ashd:rule-mkt-006 ;
    ash:ruleNextRule ashd:rule-vp-001 ;
    ash:ruleNextRule ashd:rule-vp-002 ;
    ash:ruleNextRule ashd:rule-rsk-005 .

ashd:rule-vp-001
    a ash:DecisionRule, ash:VolumePriceRule, ash:RuleArtifact ;
    rdfs:label "放量突破"@zh, "High-volume breakout"@en ;
    rdfs:comment "价格突破关键区域时，成交参与相对近期常态明显增加，说明突破获得更广泛交易参与。"@zh ;
    ash:ruleId "VP-001" ;
    ash:ruleCategory "VP 量价证据" ;
    ash:ruleDefinition "价格突破关键区域时，成交参与相对近期常态明显增加，说明突破获得更广泛交易参与。"@zh ;
    ash:ruleScope "突破、二次启动、反转等结构中的成交验证；日线和分钟周期分别配置。"@zh ;
    ash:rulePreconditions "必须先有明确突破位；成交额口径一致；剔除集合竞价或特殊大宗成交对日成交额的异常影响（若数据可识别）。"@zh ;
    ash:ruleInputData "成交额、成交量、换手率、OHLC、历史成交分布、流通市值、板块数据。"@zh ;
    ash:ruleObservations "成交相对近端中位数/均值；突破日收盘位置；成交是否集中在突破时段；价格推进效率；换手是否异常。"@zh ;
    ash:ruleTrigger "价格越过已定义关键位，同时成交参与高于自身近期常态；收盘维持突破区域上方。量能阈值按流动性和周期分层。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "放量但收盘弱；成交主要发生在冲高回落阶段；换手极端放大但价格无推进。"@zh ;
    ash:ruleVeto "没有明确关键位；成交数据不完整或口径变化；异常大宗交易主导统计。"@zh ;
    ash:ruleStateMachine "`NOT_OBSERVED`→`WATCHING`→`TRIGGERED`；价格保持突破为 `CONFIRMED`，收盘跌回为 `CONFLICTED/INVALIDATED`。"@zh ;
    ash:ruleNextActions "为 OP-001/003/006 提供支持或反向证据；持仓阶段供 POS-002/004 使用。"@zh ;
    ash:ruleInvalidation "后续价格未接受突破并跌回关键位；成交放大未形成持续推进。"@zh ;
    ash:ruleParameters "与近 5/10/20 日成交额中位数比较；可测试 1.2–1.8 倍区间，不把倍数固定为通用标准。"@zh ;
    ash:ruleTypicalScenario "突破平台上沿时成交额明显高于整理常态，收盘位于当日振幅上部。"@zh ;
    ash:ruleCounterExample "巨量长上影，成交放大却未能站稳压力位。"@zh ;
    ash:ruleVerification "比较放量突破与无量突破的后续收益、假突破率和回撤；按市值、流动性、市场状态分层。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "价格越过已定义关键位，同时成交参与高于自身近期常态；收盘维持突破区域上方。量能阈值按流动性和周期分层。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-vp ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-vp-001 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-op-001 ;
    ash:ruleNextRule ashd:rule-op-003 ;
    ash:ruleNextRule ashd:rule-pos-002 ;
    ash:ruleNextRule ashd:rule-pos-004 .

ashd:rule-vp-002
    a ash:DecisionRule, ash:VolumePriceRule, ash:RuleArtifact ;
    rdfs:label "缩量上涨"@zh, "Low-volume advance"@en ;
    rdfs:comment "价格上涨但成交参与低于近期常态；可能代表卖压轻，也可能代表买方参与不足，必须结合趋势位置判断。"@zh ;
    ash:ruleId "VP-002" ;
    ash:ruleCategory "VP 量价证据" ;
    ash:ruleDefinition "价格上涨但成交参与低于近期常态；可能代表卖压轻，也可能代表买方参与不足，必须结合趋势位置判断。"@zh ;
    ash:ruleScope "趋势延续、整理上行、反弹阶段；不独立判定强势。"@zh ;
    ash:rulePreconditions "明确当前趋势和价格所处位置；对比基准成交期不含异常停牌/涨跌停日。"@zh ;
    ash:ruleInputData "OHLC、成交额、换手率、ATR、趋势结构、板块行情。"@zh ;
    ash:ruleObservations "上涨幅度与成交变化；价格是否沿趋势稳步推进；回撤是否浅；相对强度；流动性是否仍充足。"@zh ;
    ash:ruleTrigger "上涨过程中成交低于自身近期常态，同时价格结构稳定、收盘表现不弱、没有相对强度恶化。输出“卖压可能较轻”，不直接输出买入。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "上涨幅度逐渐缩小；多日缩量但价格停滞；相对板块走弱；成交萎缩到无法交易。"@zh ;
    ash:ruleVeto "流动性不足；价格因涨跌停而缺乏正常成交；数据异常。"@zh ;
    ash:ruleStateMachine "`WATCHING`→`CANDIDATE`→`CONFIRMED`；若价格推进效率下降转 `CONFLICTED`。"@zh ;
    ash:ruleNextActions "趋势中联动 OP-001/003；回踩中联动 OP-002；高位联动 VP-003/007 和 POS-004。"@zh ;
    ash:ruleInvalidation "缩量伴随价格持续走弱或关键位失守。"@zh ;
    ash:ruleParameters "比较近 5/10/20 日成交额中位数，按上涨阶段、趋势位置和流动性分层。"@zh ;
    ash:ruleTypicalScenario "强势趋势股温和缩量上行，回撤时成交更低，关键支撑保持。"@zh ;
    ash:ruleCounterExample "低流动性股票无量缓慢上涨，稍有卖盘即大幅回落。"@zh ;
    ash:ruleVerification "分趋势阶段比较后续延续率、流动性冲击和最大不利波动。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "上涨过程中成交低于自身近期常态，同时价格结构稳定、收盘表现不弱、没有相对强度恶化。输出“卖压可能较轻”，不直接输出买入。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-vp ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-vp-002 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-op-001 ;
    ash:ruleNextRule ashd:rule-op-003 ;
    ash:ruleNextRule ashd:rule-op-002 ;
    ash:ruleNextRule ashd:rule-vp-003 ;
    ash:ruleNextRule ashd:rule-vp-007 ;
    ash:ruleNextRule ashd:rule-pos-004 .

ashd:rule-vp-003
    a ash:DecisionRule, ash:VolumePriceRule, ash:RuleArtifact ;
    rdfs:label "放量滞涨"@zh, "High-volume stagnation"@en ;
    rdfs:comment "成交显著增加，但价格推进幅度有限、收盘偏弱或多次冲高失败，反映供需分歧增大或潜在供给释放。"@zh ;
    ash:ruleId "VP-003" ;
    ash:ruleCategory "VP 量价证据" ;
    ash:ruleDefinition "成交显著增加，但价格推进幅度有限、收盘偏弱或多次冲高失败，反映供需分歧增大或潜在供给释放。"@zh ;
    ash:ruleScope "高位风险、突破失败识别和持仓管理；低位放量需结合 VP-006，不应一概看空。"@zh ;
    ash:rulePreconditions "明确价格位置；区分高位、平台、底部和事件驱动阶段；检查是否有换手、解禁、减持、公告等背景。"@zh ;
    ash:ruleInputData "OHLC、成交额、换手率、振幅、分时成交、历史压力区、事件日历。"@zh ;
    ash:ruleObservations "成交扩张程度；收盘位置；上影线和冲高回落；成交增加但单位成交带来的价格推进下降；后续是否出现更低高点。"@zh ;
    ash:ruleTrigger "成交明显高于自身常态，价格却无法有效推进或收盘走弱；连续出现时证据增强。单日异常需标注待确认。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "高位放量后收盘仍强并突破压力；大额换手后价格继续接受更高区域；明确的事件增量需求。"@zh ;
    ash:ruleVeto "成交统计被大宗交易或异常撮合显著扭曲；无可靠日内数据却推断具体资金行为。"@zh ;
    ash:ruleStateMachine "`WATCHING`→`CANDIDATE`→`TRIGGERED`；后续跌破关键支撑确认风险；重新放量突破可转 `INVALIDATED`。"@zh ;
    ash:ruleNextActions "高位调用 OP-008、POS-004/005/007；突破阶段调用 OP-001 反向审查；配合 MKT-007。"@zh ;
    ash:ruleInvalidation "价格持续向上推进并有效消化供给；原压力区被确认突破。"@zh ;
    ash:ruleParameters "成交扩张按自身历史分位数；价格推进效率可定义为价格变动/成交额变化，但需按波动率标准化。"@zh ;
    ash:ruleTypicalScenario "高位放量冲高，多次未能站稳，收盘落在日内区间下部。"@zh ;
    ash:ruleCounterExample "底部长期换手后放量但价格暂时横盘，随后形成底部反转；不能机械卖出。"@zh ;
    ash:ruleVerification "区分位置和市场环境，比较触发后回撤率、趋势反转率及错误预警率。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "成交明显高于自身常态，价格却无法有效推进或收盘走弱；连续出现时证据增强。单日异常需标注待确认。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-vp ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-vp-003 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-op-008 ;
    ash:ruleNextRule ashd:rule-pos-004 ;
    ash:ruleNextRule ashd:rule-pos-005 ;
    ash:ruleNextRule ashd:rule-op-001 ;
    ash:ruleNextRule ashd:rule-mkt-007 ;
    ash:ruleRelatedRule ashd:rule-vp-006 .

ashd:rule-vp-004
    a ash:DecisionRule, ash:VolumePriceRule, ash:RuleArtifact ;
    rdfs:label "缩量下跌"@zh, "Low-volume decline"@en ;
    rdfs:comment "价格回落时成交参与收缩；可能代表主动卖压减弱，也可能是买盘枯竭、流动性消失。"@zh ;
    ash:ruleId "VP-004" ;
    ash:ruleCategory "VP 量价证据" ;
    ash:ruleDefinition "价格回落时成交参与收缩；可能代表主动卖压减弱，也可能是买盘枯竭、流动性消失。"@zh ;
    ash:ruleScope "上升趋势回踩、平台内部调整和弱势股观察。"@zh ;
    ash:rulePreconditions "识别此前趋势、支撑位和流动性水平；不能脱离价格结构使用。"@zh ;
    ash:ruleInputData "OHLC、成交额、换手率、ATR、关键支撑、板块行情。"@zh ;
    ash:ruleObservations "下跌幅度与成交收缩；低点是否守住；收盘位置；反弹时成交是否恢复；板块同步表现。"@zh ;
    ash:ruleTrigger "下跌期间成交低于近期常态，且关键结构未破；输出“卖压未明显扩张”的证据，不等于买盘强。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "持续阴跌、低点不断下移；成交萎缩到缺乏承接；板块和指数持续走弱。"@zh ;
    ash:ruleVeto "停牌复牌、跌停无成交、成交数据不完整。"@zh ;
    ash:ruleStateMachine "`WATCHING`→`CANDIDATE`→`CONFIRMED`；关键位跌破转 `CONFLICTED/INVALIDATED`。"@zh ;
    ash:ruleNextActions "为 OP-002 提供回踩证据；与 VP-005 对照；持仓联动 POS-003/006。"@zh ;
    ash:ruleInvalidation "卖压重新放大并破坏支撑；趋势环境改变。"@zh ;
    ash:ruleParameters "成交额与近 5/10 日常态比较；下跌幅度按 ATR 标准化。"@zh ;
    ash:ruleTypicalScenario "上升趋势回踩平台上沿，连续缩量但未破位。"@zh ;
    ash:ruleCounterExample "长期弱势股成交越来越少、价格缓慢创新低。"@zh ;
    ash:ruleVerification "按趋势方向、位置、板块状态分层，检验缩量回落后守位概率和反弹质量。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "下跌期间成交低于近期常态，且关键结构未破；输出“卖压未明显扩张”的证据，不等于买盘强。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-vp ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-vp-004 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-op-002 ;
    ash:ruleNextRule ashd:rule-vp-005 ;
    ash:ruleNextRule ashd:rule-pos-003 ;
    ash:ruleNextRule ashd:rule-pos-006 .

ashd:rule-vp-005
    a ash:DecisionRule, ash:VolumePriceRule, ash:RuleArtifact ;
    rdfs:label "放量下跌"@zh, "High-volume decline"@en ;
    rdfs:comment "价格下跌同时成交显著扩张，显示抛售参与增加；可能是风险释放、趋势破坏或恐慌出清，不能只凭放量决定卖出。"@zh ;
    ash:ruleId "VP-005" ;
    ash:ruleCategory "VP 量价证据" ;
    ash:ruleDefinition "价格下跌同时成交显著扩张，显示抛售参与增加；可能是风险释放、趋势破坏或恐慌出清，不能只凭放量决定卖出。"@zh ;
    ash:ruleScope "持仓风险监测、趋势破坏识别和市场风险判断。"@zh ;
    ash:rulePreconditions "明确关键支撑和下跌背景；核查指数、板块、公告、解禁及突发事件。"@zh ;
    ash:ruleInputData "OHLC、成交额、换手率、分时成交、支撑位、板块/指数、事件信息。"@zh ;
    ash:ruleObservations "成交扩张；收盘位置；跌幅与波动率；是否跌破关键结构；板块共振；次日是否继续放量下行。"@zh ;
    ash:ruleTrigger "下跌伴随成交显著高于自身常态，且价格收盘弱或关键位失守；输出风险证据。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "快速下探后收复大部分跌幅；市场整体恐慌但个股相对强；后续成交快速收敛且关键位收复。"@zh ;
    ash:ruleVeto "单一异常成交导致统计失真；价格因除权口径错误形成虚假跌幅。"@zh ;
    ash:ruleStateMachine "`WATCHING`→`TRIGGERED`；关键位收复且后续稳定转 `CONFLICTED` 或解除；趋势结构确认破坏则 `CONFIRMED_RISK`。"@zh ;
    ash:ruleNextActions "持仓联动 POS-005/006/007；市场联动 MKT-001/007；风险联动 RSK-002/005。"@zh ;
    ash:ruleInvalidation "下跌风险被价格收复且没有持续供给；原触发来自数据错误。"@zh ;
    ash:ruleParameters "成交扩张按历史分位数；支撑跌破采用收盘和波动率容差双重确认。"@zh ;
    ash:ruleTypicalScenario "放量长阴跌破平台下沿，板块同步走弱。"@zh ;
    ash:ruleCounterExample "突发恐慌日放量急跌后快速收复，不能把一次性恐慌等同趋势必然反转。"@zh ;
    ash:ruleVerification "比较单日放量下跌与连续放量下跌的后续回撤、反弹和持仓保护效果。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "下跌伴随成交显著高于自身常态，且价格收盘弱或关键位失守；输出风险证据。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-vp ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-vp-005 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-pos-005 ;
    ash:ruleNextRule ashd:rule-pos-006 ;
    ash:ruleNextRule ashd:rule-mkt-001 ;
    ash:ruleNextRule ashd:rule-mkt-007 ;
    ash:ruleNextRule ashd:rule-rsk-002 ;
    ash:ruleNextRule ashd:rule-rsk-005 .

ashd:rule-vp-006
    a ash:DecisionRule, ash:VolumePriceRule, ash:RuleArtifact ;
    rdfs:label "低位放量"@zh, "Low-level volume expansion"@en ;
    rdfs:comment "股票处于阶段性低位或长期下跌后的结构区域，成交参与明显增加；该现象可能代表资金重新关注，也可能是恐慌换手或风险兑现。"@zh ;
    ash:ruleId "VP-006" ;
    ash:ruleCategory "VP 量价证据" ;
    ash:ruleDefinition "股票处于阶段性低位或长期下跌后的结构区域，成交参与明显增加；该现象可能代表资金重新关注，也可能是恐慌换手或风险兑现。"@zh ;
    ash:ruleScope "底部观察和反转研究；必须由 OP-005/006 的价格结构确认。"@zh ;
    ash:rulePreconditions "低位定义基于历史价格结构而非简单跌幅；排除退市、财务恶化和重大负面事件；确认成交扩张来源可解释。"@zh ;
    ash:ruleInputData "长短周期 OHLC、成交额、换手率、历史分位、财务/公告、行业状态。"@zh ;
    ash:ruleObservations "放量发生的位置；收盘相对日内区间；低点是否守住；后续成交是否持续；相对强度是否改善；是否出现连续更高低点。"@zh ;
    ash:ruleTrigger "阶段低位出现显著成交扩张，且价格没有同步大幅失守关键低点；仅进入 `CANDIDATE`，需后续结构确认。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "放量长阴并创新低；重大利空导致被动换手；成交集中在下跌而非收复阶段。"@zh ;
    ash:ruleVeto "基本面硬风险；低位判断依赖错误复权；成交数据异常。"@zh ;
    ash:ruleStateMachine "`WATCHING`→`CANDIDATE`→`TRIGGERED`（放量后结构稳定）→`CONFIRMED`（OP-005/006确认）；新低为 `INVALIDATED`。"@zh ;
    ash:ruleNextActions "联动 OP-005/006、VP-008、EVT-004/005；不得单独触发买入。"@zh ;
    ash:ruleInvalidation "阶段低点被有效跌破；放量后持续无承接。"@zh ;
    ash:ruleParameters "低位按历史区间/波动结构识别；成交扩张按自身历史分位；观察后续 3–10 个交易日结构。"@zh ;
    ash:ruleTypicalScenario "长期下跌后低位放量止跌，随后低点抬高并突破局部压力。"@zh ;
    ash:ruleCounterExample "连续跌停打开后的巨量换手，随后再次下跌。"@zh ;
    ash:ruleVerification "按事件类型、行业景气和价格结构分组，检验低位放量后反转率、再创新低率及回撤。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "阶段低位出现显著成交扩张，且价格没有同步大幅失守关键低点；仅进入 `CANDIDATE`，需后续结构确认。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-vp ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-vp-006 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-op-005 ;
    ash:ruleNextRule ashd:rule-op-006 ;
    ash:ruleNextRule ashd:rule-vp-008 ;
    ash:ruleNextRule ashd:rule-evt-004 ;
    ash:ruleNextRule ashd:rule-evt-005 .

ashd:rule-vp-007
    a ash:DecisionRule, ash:VolumePriceRule, ash:RuleArtifact ;
    rdfs:label "高位放量"@zh, "High-level volume expansion"@en ;
    rdfs:comment "价格处于显著上涨后的高位区域，成交参与突然扩大；可能是趋势换手，也可能是筹码分歧和供给释放。"@zh ;
    ash:ruleId "VP-007" ;
    ash:ruleCategory "VP 量价证据" ;
    ash:ruleDefinition "价格处于显著上涨后的高位区域，成交参与突然扩大；可能是趋势换手，也可能是筹码分歧和供给释放。"@zh ;
    ash:ruleScope "高位持仓风险管理和新开仓风险过滤。"@zh ;
    ash:rulePreconditions "定义高位区间和此前上涨阶段；标记涨幅、波动和板块周期；识别事件是否造成合理换手。"@zh ;
    ash:ruleInputData "OHLC、成交额、换手率、分时、阶段涨幅、板块/指数、公告。"@zh ;
    ash:ruleObservations "成交放大后价格推进效率；收盘位置；上影线；换手连续性；板块核心强弱；次日承接。"@zh ;
    ash:ruleTrigger "高位成交明显扩张；根据价格结果分为 `HIGH_VOLUME_ACCEPTANCE`（放量仍强）或 `HIGH_VOLUME_REJECTION`（放量滞涨/收弱）。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "放量后有效突破并保持；行业催化带来持续新增需求；换手后低点不断抬高。"@zh ;
    ash:ruleVeto "无法确认高位位置；成交数据口径异常。"@zh ;
    ash:ruleStateMachine "`WATCHING`→`TRIGGERED`；收盘强且延续为接受，收盘弱且破位为风险确认。"@zh ;
    ash:ruleNextActions "联动 VP-003、OP-008、POS-004/007、MKT-007；不自动卖出或做空。"@zh ;
    ash:ruleInvalidation "价格持续接受高位并形成新的有效平台；或数据被证伪。"@zh ;
    ash:ruleParameters "高位以趋势波段位置和历史分位定义；成交扩张按自身常态分层。"@zh ;
    ash:ruleTypicalScenario "高位巨量但收盘靠近低点，次日无法修复。"@zh ;
    ash:ruleCounterExample "高位放量换手后突破并连续走强。"@zh ;
    ash:ruleVerification "分成接受/拒绝两类，比较未来收益、回撤和止盈策略差异。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "高位成交明显扩张；根据价格结果分为 `HIGH_VOLUME_ACCEPTANCE`（放量仍强）或 `HIGH_VOLUME_REJECTION`（放量滞涨/收弱）。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-vp ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-vp-007 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-vp-003 ;
    ash:ruleNextRule ashd:rule-op-008 ;
    ash:ruleNextRule ashd:rule-pos-004 ;
    ash:ruleNextRule ashd:rule-pos-007 ;
    ash:ruleNextRule ashd:rule-mkt-007 .

ashd:rule-vp-008
    a ash:DecisionRule, ash:VolumePriceRule, ash:RuleArtifact ;
    rdfs:label "量价背离"@zh, "Price-volume divergence"@en ;
    rdfs:comment "价格趋势与成交参与、价格推进效率或相对强度出现持续不一致，提示趋势质量变化；背离是预警而非反转确认。"@zh ;
    ash:ruleId "VP-008" ;
    ash:ruleCategory "VP 量价证据" ;
    ash:ruleDefinition "价格趋势与成交参与、价格推进效率或相对强度出现持续不一致，提示趋势质量变化；背离是预警而非反转确认。"@zh ;
    ash:ruleScope "趋势健康度监测、突破质量审查和持仓管理。"@zh ;
    ash:rulePreconditions "明确比较的价格波段和成交指标；选择同一周期；避免用任意两段不对应的波段制造背离。"@zh ;
    ash:ruleInputData "OHLC、成交额/量、换手率、相对强度、波动率、板块行情。"@zh ;
    ash:ruleObservations "价格创新高而成交参与未跟随；价格创新高但推进效率下降；上涨日与下跌日成交结构变化；相对强度走弱。"@zh ;
    ash:ruleTrigger "至少两个对应波段出现可重复的价格与成交/相对强度不一致；持续性比单点背离更重要。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "价格突破后成交随后补充；相对强度恢复；背离发生在健康缩量整理中。"@zh ;
    ash:ruleVeto "波段匹配不合理；数据周期不一致；样本过短。"@zh ;
    ash:ruleStateMachine "`WATCHING`→`CANDIDATE`→`TRIGGERED`（背离成立）→`CONFIRMED`（价格结构进一步转弱）；价格继续强势则 `INVALIDATED`。"@zh ;
    ash:ruleNextActions "趋势股联动 POS-004/005；突破联动 OP-001；市场联动 MKT-004/007。"@zh ;
    ash:ruleInvalidation "价格和成交重新同步；背离未在有效期内得到价格确认。"@zh ;
    ash:ruleParameters "至少两个匹配波段；窗口和背离强度按周期设定；不使用单一指标交叉作为唯一判据。"@zh ;
    ash:ruleTypicalScenario "股价多次新高，但成交参与和相对板块强度逐步下降，随后跌破趋势支撑。"@zh ;
    ash:ruleCounterExample "趋势健康推进中的自然缩量，价格仍稳步上行。"@zh ;
    ash:ruleVerification "统计背离出现后趋势反转的提前量、误报率、收益回撤改善程度。 --- # 第三类：AUC 集合竞价（6条） AUC 规则只使用集合竞价阶段可获得的数据。集合竞价字段必须核实供应商定义、时间截点和历史覆盖；不能把未匹配量、虚拟撮合价或局部快照解释为完整委托流水。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "至少两个对应波段出现可重复的价格与成交/相对强度不一致；持续性比单点背离更重要。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-vp ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-vp-008 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-pos-004 ;
    ash:ruleNextRule ashd:rule-pos-005 ;
    ash:ruleNextRule ashd:rule-op-001 ;
    ash:ruleNextRule ashd:rule-mkt-004 ;
    ash:ruleNextRule ashd:rule-mkt-007 .

ashd:rule-auc-001
    a ash:DecisionRule, ash:AuctionRule, ash:RuleArtifact ;
    rdfs:label "高开超预期"@zh, "Higher open above expectations"@en ;
    rdfs:comment "竞价形成的开盘预期明显强于基于前一交易日结构、板块环境和已知事件所建立的合理预期。"@zh ;
    ash:ruleId "AUC-001" ;
    ash:ruleCategory "AUC 竞价证据" ;
    ash:ruleDefinition "竞价形成的开盘预期明显强于基于前一交易日结构、板块环境和已知事件所建立的合理预期。"@zh ;
    ash:ruleScope "短线观察；重点用于验证事件/板块强势延续，不作为独立追高信号。"@zh ;
    ash:rulePreconditions "建立预期基线；区分除权、停牌复牌、公告跳空和普通交易日；竞价数据时间戳与口径可靠。"@zh ;
    ash:ruleInputData "前收盘、竞价价格、竞价成交额/量、未匹配量方向、近期波动、板块竞价、事件信息。"@zh ;
    ash:ruleObservations "竞价涨幅相对历史波动是否异常；竞价成交参与；相对板块强弱；未匹配买卖力量（若字段定义明确）；开盘后承接。"@zh ;
    ash:ruleTrigger "竞价价格高于预期区间，且成交参与和板块环境提供支持；先标记 `OPEN_EXPECTATION_STRONG`，开盘后需确认。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "高开但竞价成交很弱；板块普遍低开；开盘后快速回落；事件已经充分兑现。"@zh ;
    ash:ruleVeto "复牌/除权等特殊情形未单独建模；竞价字段口径不明；涨停封单导致价格不可交易。"@zh ;
    ash:ruleStateMachine "`WATCHING`→`CANDIDATE`（竞价高开）→`TRIGGERED`（竞价确认）→`CONFIRMED`（开盘后承接）；高开低走为 `INVALIDATED`。"@zh ;
    ash:ruleNextActions "联动 OP-010、AUC-003、MKT-005、RSK-005；开盘后观察 VP 证据。"@zh ;
    ash:ruleInvalidation "开盘后迅速跌破竞价关键价位且无法收复。"@zh ;
    ash:ruleParameters "以个股历史竞价分布、前日波动和板块竞价为基准，不设全市场统一高开百分比。"@zh ;
    ash:ruleTypicalScenario "板块核心股前一日强势，次日竞价成交充分且明显强于同板块。"@zh ;
    ash:ruleCounterExample "竞价虚高、成交极少，开盘后卖盘释放。"@zh ;
    ash:ruleVerification "比较竞价强度分位与开盘后 5/15/30/60 分钟收益、冲高回落率和可成交率。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "竞价价格高于预期区间，且成交参与和板块环境提供支持；先标记 `OPEN_EXPECTATION_STRONG`，开盘后需确认。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-auc ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-auc-001 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-op-010 ;
    ash:ruleNextRule ashd:rule-auc-003 ;
    ash:ruleNextRule ashd:rule-mkt-005 ;
    ash:ruleNextRule ashd:rule-rsk-005 .

ashd:rule-auc-002
    a ash:DecisionRule, ash:AuctionRule, ash:RuleArtifact ;
    rdfs:label "低开超预期"@zh, "Lower open below expectations"@en ;
    rdfs:comment "竞价开盘预期显著弱于基于前日结构、板块和已知事件的合理预期，提示潜在负面信息或供给压力。"@zh ;
    ash:ruleId "AUC-002" ;
    ash:ruleCategory "AUC 竞价证据" ;
    ash:ruleDefinition "竞价开盘预期显著弱于基于前日结构、板块和已知事件的合理预期，提示潜在负面信息或供给压力。"@zh ;
    ash:ruleScope "持仓风险管理、开盘风险控制；低开后也可能形成修复，不自动等于卖出。"@zh ;
    ash:rulePreconditions "有明确预期基线；核查隔夜公告、外围市场和板块变化；确认是否除权或特殊复牌。"@zh ;
    ash:ruleInputData "前收盘、竞价价格、竞价量额、未匹配方向、板块竞价、指数期货/外围参考（如策略允许）、公告。"@zh ;
    ash:ruleObservations "低开幅度相对个股常态；竞价成交参与；卖方未匹配量；板块同步程度；开盘后修复速度。"@zh ;
    ash:ruleTrigger "竞价价格显著低于预期且有成交/卖压证据；输出风险预警。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "低开但成交很小；开盘后快速收复前收/关键支撑；板块同步修复。"@zh ;
    ash:ruleVeto "未调整除权因素；竞价数据缺失；特殊交易状态。"@zh ;
    ash:ruleStateMachine "`WATCHING`→`TRIGGERED`；开盘持续走弱为 `CONFIRMED_RISK`；快速收复则转 `CONFLICTED/RECOVERING`。"@zh ;
    ash:ruleNextActions "联动 POS-004/006、VP-005、RSK-005；开盘执行仍需检查是否跌停、是否可成交。"@zh ;
    ash:ruleInvalidation "开盘后卖压消退且关键位收复；低开由已知且已定价因素造成。"@zh ;
    ash:ruleParameters "相对个股历史竞价分布定义“超预期”；按事件日/普通日分别建模。"@zh ;
    ash:ruleTypicalScenario "持仓股无新增利空却大幅低开，竞价成交和卖方未匹配量同时异常。"@zh ;
    ash:ruleCounterExample "除权导致的机械低开；全市场系统性低开后迅速修复。"@zh ;
    ash:ruleVerification "检验竞价低开对开盘后最大不利波动和止损执行质量的预测能力。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "竞价价格显著低于预期且有成交/卖压证据；输出风险预警。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-auc ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-auc-002 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-pos-004 ;
    ash:ruleNextRule ashd:rule-pos-006 ;
    ash:ruleNextRule ashd:rule-vp-005 ;
    ash:ruleNextRule ashd:rule-rsk-005 .

ashd:rule-auc-003
    a ash:DecisionRule, ash:AuctionRule, ash:RuleArtifact ;
    rdfs:label "竞价抢筹"@zh, "Auction accumulation"@en ;
    rdfs:comment "集合竞价阶段买方需求明显增强，竞价价格与成交参与共同体现买方积极性；“抢筹”仅作为行为描述，不推断具体资金身份。"@zh ;
    ash:ruleId "AUC-003" ;
    ash:ruleCategory "AUC 竞价证据" ;
    ash:ruleDefinition "集合竞价阶段买方需求明显增强，竞价价格与成交参与共同体现买方积极性；“抢筹”仅作为行为描述，不推断具体资金身份。"@zh ;
    ash:ruleScope "短线强势股、事件催化和板块核心股的开盘前观察。"@zh ;
    ash:rulePreconditions "确认竞价数据按时间序列完整；明确竞价成交额、量、未匹配量字段的定义；区分 9:15–9:20 与 9:20–9:25 可撤单规则造成的行为差异。"@zh ;
    ash:ruleInputData "竞价分时价格、成交量额、未匹配量及方向、前收盘、板块竞价。"@zh ;
    ash:ruleObservations "竞价价格变化方向；成交参与随时间变化；未匹配买量变化；最后阶段价格是否稳定；板块同类股是否共振。"@zh ;
    ash:ruleTrigger "竞价价格逐步抬升或维持强势，成交参与增加，且最后阶段没有明显转弱；开盘后仍需验证。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "前段强、后段显著回落；竞价量大但价格下移；板块无响应；开盘后主动卖压占优。"@zh ;
    ash:ruleVeto "只有单一时点快照；不能识别时间段；把未匹配量误当真实成交量。"@zh ;
    ash:ruleStateMachine "`WATCHING`→`CANDIDATE`→`TRIGGERED`；开盘后承接确认为 `CONFIRMED`，高开低走为 `INVALIDATED`。"@zh ;
    ash:ruleNextActions "联动 AUC-001/005、OP-010、MKT-005；通过 RSK-005 判断高开追入风险。"@zh ;
    ash:ruleInvalidation "开盘后竞价优势迅速消失；关键价位被跌破。"@zh ;
    ash:ruleParameters "竞价阶段分段观察；成交量、价格斜率和未匹配量分别标准化，不把单一字段作为充分条件。"@zh ;
    ash:ruleTypicalScenario "竞价后段买方需求持续增强，竞价价稳定在区间上沿，开盘后承接延续。"@zh ;
    ash:ruleCounterExample "竞价最后一刻显示强势，但开盘后迅速回落；不能推断为真实主力抢筹。"@zh ;
    ash:ruleVerification "按竞价阶段、板块强度和流动性分层，统计开盘后延续率及冲高回落率。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "竞价价格逐步抬升或维持强势，成交参与增加，且最后阶段没有明显转弱；开盘后仍需验证。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-auc ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-auc-003 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-auc-001 ;
    ash:ruleNextRule ashd:rule-auc-005 ;
    ash:ruleNextRule ashd:rule-op-010 ;
    ash:ruleNextRule ashd:rule-mkt-005 ;
    ash:ruleNextRule ashd:rule-rsk-005 .

ashd:rule-auc-004
    a ash:DecisionRule, ash:AuctionRule, ash:RuleArtifact ;
    rdfs:label "竞价撤单风险"@zh, "Auction order-cancellation risk"@en ;
    rdfs:comment "竞价期间可观察到的报价/未匹配量变化呈现明显反转或不稳定，提示开盘预期可能脆弱。若数据源不提供完整委托与撤单明细，只能称“竞价信号衰减”，不能确认具体撤单行为。"@zh ;
    ash:ruleId "AUC-004" ;
    ash:ruleCategory "AUC 竞价证据" ;
    ash:ruleDefinition "竞价期间可观察到的报价/未匹配量变化呈现明显反转或不稳定，提示开盘预期可能脆弱。若数据源不提供完整委托与撤单明细，只能称“竞价信号衰减”，不能确认具体撤单行为。"@zh ;
    ash:ruleScope "竞价信号质量审查；用于降低对竞价强弱的信任度。"@zh ;
    ash:rulePreconditions "明确数据源能否提供逐时点委托/未匹配数据；确认撤单规则与时间窗口；禁止从两个快照直接推断全部撤单行为。"@zh ;
    ash:ruleInputData "竞价逐时点价格、未匹配量、成交量、时间戳、竞价规则。"@zh ;
    ash:ruleObservations "买方未匹配量是否快速消失；竞价价是否同步下移；变化是否集中在可撤单时段；最后阶段是否稳定。"@zh ;
    ash:ruleTrigger "强势竞价信号在后续时间点显著衰减，且价格同步转弱；标记 `AUCTION_SIGNAL_DECAY`。只有具备完整委托事件数据时才可标记撤单统计。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "未匹配量变化由撮合成交自然消化；竞价价格仍稳定；后段重新增强。"@zh ;
    ash:ruleVeto "数据源只有汇总日字段；无法区分成交、撤单和撮合机制。"@zh ;
    ash:ruleStateMachine "`WATCHING`→`TRIGGERED`（信号衰减）→开盘后持续弱势为 `CONFIRMED_RISK`；数据不足为 `DATA_INSUFFICIENT`。"@zh ;
    ash:ruleNextActions "降低 AUC-001/003 的证据权重；开盘后用 VP 与 OP 重新判断，不凭该规则直接卖出。"@zh ;
    ash:ruleInvalidation "后续竞价阶段重新稳定，或开盘后价格承接验证原信号。"@zh ;
    ash:ruleParameters "以竞价分段变化率和价格同步变化为基础；按数据源能力设定可识别等级。"@zh ;
    ash:ruleTypicalScenario "早段竞价显示强买方未匹配量，后段明显下降且竞价价格回落。"@zh ;
    ash:ruleCounterExample "未匹配量下降但成交量增加、价格稳定，可能是正常撮合消化。"@zh ;
    ash:ruleVerification "对照原始逐时点数据与开盘后走势，评估信号衰减对冲高回落的增量预测价值。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "强势竞价信号在后续时间点显著衰减，且价格同步转弱；标记 `AUCTION_SIGNAL_DECAY`。只有具备完整委托事件数据时才可标记撤单统计。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-auc ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-auc-004 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-auc-001 ;
    ash:ruleNextRule ashd:rule-auc-003 .

ashd:rule-auc-005
    a ash:DecisionRule, ash:AuctionRule, ash:RuleArtifact ;
    rdfs:label "竞价弱转强"@zh, "Auction weak-to-strong"@en ;
    rdfs:comment "竞价早段偏弱，但后段价格、成交参与或未匹配方向改善，显示开盘预期修复。"@zh ;
    ash:ruleId "AUC-005" ;
    ash:ruleCategory "AUC 竞价证据" ;
    ash:ruleDefinition "竞价早段偏弱，但后段价格、成交参与或未匹配方向改善，显示开盘预期修复。"@zh ;
    ash:ruleScope "前一日分歧、板块修复或个股预期差交易的观察。"@zh ;
    ash:rulePreconditions "竞价数据分段可用；定义早段弱势基准；确认不存在数据缺口和特殊交易状态。"@zh ;
    ash:ruleInputData "竞价分时价格、量额、未匹配量、前收盘、板块竞价、前一日分时结构。"@zh ;
    ash:ruleObservations "竞价前后段斜率；成交参与变化；买卖未匹配量变化；竞价收盘位置；同板块修复程度。"@zh ;
    ash:ruleTrigger "后段竞价较早段明显改善，价格收复预设参考位，成交参与同步增强；开盘后确认承接才升级。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "价格改善但成交缺乏；最后一分钟拉高；板块仍弱；开盘即跌回。"@zh ;
    ash:ruleVeto "无法分段取数；仅有最终竞价结果；数据时间戳不可靠。"@zh ;
    ash:ruleStateMachine "`WATCHING`→`CANDIDATE`（早弱）→`TRIGGERED`（后段修复）→`CONFIRMED`（开盘承接）；高开低走为 `INVALIDATED`。"@zh ;
    ash:ruleNextActions "联动 OP-009/010、MKT-002/005、VP-001；风险流程检查跳空和可成交性。"@zh ;
    ash:ruleInvalidation "开盘后无法维持竞价修复成果。"@zh ;
    ash:ruleParameters "早段/后段分界按交易所竞价机制；修复幅度按个股历史竞价波动标准化。"@zh ;
    ash:ruleTypicalScenario "前一日分歧回落，竞价早段偏弱，最后阶段买方需求恢复，开盘后继续收复。"@zh ;
    ash:ruleCounterExample "竞价最后几笔抬价但开盘后无后续买盘。"@zh ;
    ash:ruleVerification "对比“最终竞价强度”与“竞价路径变化”对开盘后表现的解释力。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "后段竞价较早段明显改善，价格收复预设参考位，成交参与同步增强；开盘后确认承接才升级。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-auc ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-auc-005 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-op-009 ;
    ash:ruleNextRule ashd:rule-op-010 ;
    ash:ruleNextRule ashd:rule-mkt-002 ;
    ash:ruleNextRule ashd:rule-mkt-005 ;
    ash:ruleNextRule ashd:rule-vp-001 .

ashd:rule-auc-006
    a ash:DecisionRule, ash:AuctionRule, ash:RuleArtifact ;
    rdfs:label "竞价强转弱"@zh, "Auction strong-to-weak"@en ;
    rdfs:comment "竞价早段强势，但后段价格、成交参与或未匹配方向转弱，提示早期强势预期衰减。"@zh ;
    ash:ruleId "AUC-006" ;
    ash:ruleCategory "AUC 竞价证据" ;
    ash:ruleDefinition "竞价早段强势，但后段价格、成交参与或未匹配方向转弱，提示早期强势预期衰减。"@zh ;
    ash:ruleScope "高位强势股、持仓隔夜风险和竞价追涨过滤。"@zh ;
    ash:rulePreconditions "竞价分段数据可用；定义早段强势基准；识别板块竞价和隔夜事件。"@zh ;
    ash:ruleInputData "竞价逐时点价格、量额、未匹配量、前收盘、板块竞价、公告。"@zh ;
    ash:ruleObservations "竞价价格回落；买方未匹配量减少；成交参与变化；最后阶段是否靠近区间下沿；板块是否同步转弱。"@zh ;
    ash:ruleTrigger "早段强势而后段明显衰减，且价格/供需变化方向一致；开盘后持续走弱确认风险。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "价格小幅回落但仍维持强势区间；未匹配量下降由撮合成交解释；开盘后迅速修复。"@zh ;
    ash:ruleVeto "只有单一竞价汇总字段；不能可靠识别路径变化。"@zh ;
    ash:ruleStateMachine "`WATCHING`→`TRIGGERED`（竞价转弱）→`CONFIRMED_RISK`（开盘延续）；开盘修复转 `CONFLICTED`。"@zh ;
    ash:ruleNextActions "联动 POS-004/005、VP-003、RSK-005；对 AUC-001/003 的信号降级。"@zh ;
    ash:ruleInvalidation "开盘后收复竞价回落区且成交支持。"@zh ;
    ash:ruleParameters "分段价格变化、未匹配量变化和成交量变化分别建模；不可只用最终开盘价。"@zh ;
    ash:ruleTypicalScenario "高位股竞价前段强，后段买方需求快速衰减，开盘后持续走低。"@zh ;
    ash:ruleCounterExample "竞价阶段正常撮合使未匹配量下降，但价格保持强势。"@zh ;
    ash:ruleVerification "统计竞价强转弱对开盘后回撤、冲高失败和隔夜风险的预测增量。 --- # 第四类：MKT 市场与板块（7条）"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "早段强势而后段明显衰减，且价格/供需变化方向一致；开盘后持续走弱确认风险。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-auc ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-auc-006 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-pos-004 ;
    ash:ruleNextRule ashd:rule-pos-005 ;
    ash:ruleNextRule ashd:rule-vp-003 ;
    ash:ruleNextRule ashd:rule-rsk-005 ;
    ash:ruleNextRule ashd:rule-auc-001 ;
    ash:ruleNextRule ashd:rule-auc-003 .

ashd:rule-mkt-001
    a ash:DecisionRule, ash:MarketRegimeRule, ash:RuleArtifact ;
    rdfs:label "市场风险状态"@zh, "Market risk state"@en ;
    rdfs:comment "判断全市场当前是否处于风险偏好收缩、广泛抛售或流动性恶化状态，为所有个股机会设置环境约束。"@zh ;
    ash:ruleId "MKT-001" ;
    ash:ruleCategory "MKT 市场环境" ;
    ash:ruleDefinition "判断全市场当前是否处于风险偏好收缩、广泛抛售或流动性恶化状态，为所有个股机会设置环境约束。"@zh ;
    ash:ruleScope "全市场每日/盘中；对非持仓开仓和持仓风险均有效。"@zh ;
    ash:rulePreconditions "明确市场统计范围；处理停牌、涨跌停和新股；指数不能单独代表市场广度。"@zh ;
    ash:ruleInputData "主要指数、上涨/下跌家数、涨跌停数量、跌停封单/开板、成交额、波动率、行业广度、市场资金数据（如可验证）。"@zh ;
    ash:ruleObservations "下跌是否广泛；跌停风险是否扩散；成交额是否异常收缩/放大；指数与个股广度是否背离；风险是否集中于少数行业。"@zh ;
    ash:ruleTrigger "多个独立市场维度同时恶化，且持续超过单一噪声时段；输出 `RISK_OFF`、`NEUTRAL` 或 `RISK_ON` 状态。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "指数下跌但上涨家数改善；跌停数量收敛；市场广度修复；成交恢复且风险扩散停止。"@zh ;
    ash:ruleVeto "市场统计口径不完整；节假日前后或特殊制度日未校准。"@zh ;
    ash:ruleStateMachine "`NORMAL`→`WARNING`→`RISK_OFF`；风险指标改善后逐级恢复，不允许单日反弹直接从高危跳回正常。"@zh ;
    ash:ruleNextActions "限制新开仓数量/风险预算；联动 RSK-002/003/004、MKT-002；持仓检查 POS-005/006。"@zh ;
    ash:ruleInvalidation "市场广度、跌停扩散和成交压力持续修复。"@zh ;
    ash:ruleParameters "使用历史分位和多指标组合；各指标权重需按不同市场阶段检验，不设单一指数阈值。"@zh ;
    ash:ruleTypicalScenario "指数下跌、下跌家数扩大、跌停增加、成交放大且多数行业走弱。"@zh ;
    ash:ruleCounterExample "指数受权重股拖累下跌，但市场广度改善，不应机械判定全面风险。"@zh ;
    ash:ruleVerification "检验风险状态对未来 1/3/5 日市场回撤、策略胜率和组合最大回撤的预测价值。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "多个独立市场维度同时恶化，且持续超过单一噪声时段；输出 `RISK_OFF`、`NEUTRAL` 或 `RISK_ON` 状态。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-mkt ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-mkt-001 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-rsk-002 ;
    ash:ruleNextRule ashd:rule-rsk-003 ;
    ash:ruleNextRule ashd:rule-mkt-002 ;
    ash:ruleNextRule ashd:rule-pos-005 ;
    ash:ruleNextRule ashd:rule-pos-006 .

ashd:rule-mkt-002
    a ash:DecisionRule, ash:MarketRegimeRule, ash:RuleArtifact ;
    rdfs:label "市场情绪周期"@zh, "Market sentiment cycle"@en ;
    rdfs:comment "识别短线风险偏好从启动、扩散、高潮、分歧到退潮/修复的阶段变化。情绪周期是市场状态描述，不是精确的固定日历周期。"@zh ;
    ash:ruleId "MKT-002" ;
    ash:ruleCategory "MKT 市场环境" ;
    ash:ruleDefinition "识别短线风险偏好从启动、扩散、高潮、分歧到退潮/修复的阶段变化。情绪周期是市场状态描述，不是精确的固定日历周期。"@zh ;
    ash:ruleScope "短线策略、题材股和涨跌停生态；不直接替代中长期趋势判断。"@zh ;
    ash:rulePreconditions "定义观察市场范围和短线样本；处理新股、ST、不同涨跌幅限制及停牌样本。"@zh ;
    ash:ruleInputData "涨停/跌停家数、连板高度、炸板率、封板质量、晋级率、开板回封、市场广度、成交额、龙头表现。"@zh ;
    ash:ruleObservations "赚钱效应扩散程度；高度股持续性；失败交易的亏损幅度；涨停家数与封板质量；退潮是否从局部扩散。"@zh ;
    ash:ruleTrigger "多项情绪指标形成一致状态特征，标记 `IGNITION`、`EXPANSION`、`CLIMAX`、`DIVERGENCE`、`DECLINE`、`REPAIR`。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "情绪指标互相矛盾；龙头与广度背离；单一题材极热但全市场风险偏好下降。"@zh ;
    ash:ruleVeto "涨跌停数据不完整；样本池定义变更未做版本记录。"@zh ;
    ash:ruleStateMachine "阶段状态可按证据迁移，但允许局部反复；必须记录阶段判断置信度和冲突信号。"@zh ;
    ash:ruleNextActions "决定短线策略是否启用、降低/恢复风险预算；联动 MKT-003/007、AUC、RSK-002。"@zh ;
    ash:ruleInvalidation "后续市场行为不再符合阶段特征；阶段判断被新的广度/高度数据推翻。"@zh ;
    ash:ruleParameters "连板高度、晋级率、炸板率和跌停扩散采用滚动分位数；按交易制度变化重新校准。"@zh ;
    ash:ruleTypicalScenario "涨停扩散、晋级率提升、核心股持续走强，属于扩散；高位核心股集体断板、跌停扩散，属于退潮。"@zh ;
    ash:ruleCounterExample "一天涨停数量激增但次日全部低开，不应判定稳定主升周期。"@zh ;
    ash:ruleVerification "用阶段标签检验各策略在不同阶段的胜率、盈亏比和回撤；标签需由当时可见数据生成，防止未来函数。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "多项情绪指标形成一致状态特征，标记 `IGNITION`、`EXPANSION`、`CLIMAX`、`DIVERGENCE`、`DECLINE`、`REPAIR`。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-mkt ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-mkt-002 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-mkt-003 ;
    ash:ruleNextRule ashd:rule-mkt-007 ;
    ash:ruleNextRule ashd:rule-rsk-002 .

ashd:rule-mkt-003
    a ash:DecisionRule, ash:MarketRegimeRule, ash:RuleArtifact ;
    rdfs:label "板块集体启动"@zh, "Sector collective launch"@en ;
    rdfs:comment "某行业/主题内多只股票在相近时间出现相对强度和成交改善，显示板块需求扩散，而非单一个股脉冲。"@zh ;
    ash:ruleId "MKT-003" ;
    ash:ruleCategory "MKT 市场环境" ;
    ash:ruleDefinition "某行业/主题内多只股票在相近时间出现相对强度和成交改善，显示板块需求扩散，而非单一个股脉冲。"@zh ;
    ash:ruleScope "行业、概念和主题板块；需要区分官方行业分类与动态主题分类。"@zh ;
    ash:rulePreconditions "板块成分与分类时间点可追溯；避免使用未来才纳入的成分股；排除单一权重股对指数的扭曲。"@zh ;
    ash:ruleInputData "板块指数/成分股涨跌、成交额、上涨比例、涨停分布、龙头/中军表现、事件信息。"@zh ;
    ash:ruleObservations "上涨家数占比；强势股数量；成交额扩散；龙头与跟随股同步；板块相对大盘强度；启动是否由单只股票贡献。"@zh ;
    ash:ruleTrigger "板块内多只成分股同步走强，且成交参与扩散、相对指数走强；仅龙头上涨不算集体启动。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "板块指数上涨但多数成分股下跌；成交集中于单一权重股；龙头冲高回落。"@zh ;
    ash:ruleVeto "板块分类不可靠或成分历史不可还原；主题名称重复但实质不同。"@zh ;
    ash:ruleStateMachine "`WATCHING`→`CANDIDATE`→`TRIGGERED`→`CONFIRMED`（持续扩散）；广度快速收缩为 `INVALIDATED`。"@zh ;
    ash:ruleNextActions "调用 MKT-004/005、EVT-002/003、OP-001/003；从板块内部筛选个股，而不是直接买板块涨幅最大者。"@zh ;
    ash:ruleInvalidation "板块广度衰退、核心股失守、事件传导逻辑被证伪。"@zh ;
    ash:ruleParameters "成分上涨比例、相对强度、成交扩散度采用历史分位；按板块成分数量调整。"@zh ;
    ash:ruleTypicalScenario "产业催化后板块龙头、中军和多只补涨股同步放量走强。"@zh ;
    ash:ruleCounterExample "指数仅因一只大市值成分上涨而走强。"@zh ;
    ash:ruleVerification "测量启动后板块超额收益、广度持续时间、龙头与跟随股收益差异。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "板块内多只成分股同步走强，且成交参与扩散、相对指数走强；仅龙头上涨不算集体启动。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-mkt ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-mkt-003 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-mkt-004 ;
    ash:ruleNextRule ashd:rule-mkt-005 ;
    ash:ruleNextRule ashd:rule-evt-002 ;
    ash:ruleNextRule ashd:rule-evt-003 ;
    ash:ruleNextRule ashd:rule-op-001 ;
    ash:ruleNextRule ashd:rule-op-003 .

ashd:rule-mkt-004
    a ash:DecisionRule, ash:MarketRegimeRule, ash:RuleArtifact ;
    rdfs:label "板块持续性"@zh, "Sector durability"@en ;
    rdfs:comment "判断板块启动后是否持续吸引资金和市场关注，是否从单日脉冲发展为多日趋势。"@zh ;
    ash:ruleId "MKT-004" ;
    ash:ruleCategory "MKT 市场环境" ;
    ash:ruleDefinition "判断板块启动后是否持续吸引资金和市场关注，是否从单日脉冲发展为多日趋势。"@zh ;
    ash:ruleScope "已启动板块的跟踪和个股持仓管理。"@zh ;
    ash:rulePreconditions "已有 MKT-003 或明确板块启动事件；成分股分类稳定；定义持续性观察窗口。"@zh ;
    ash:ruleInputData "板块收益、成交额、上涨比例、领涨股表现、核心股回撤、事件更新。"@zh ;
    ash:ruleObservations "连续相对强势；成交是否维持；板块内部轮动是否健康；龙头是否保持结构；新成员是否扩散。"@zh ;
    ash:ruleTrigger "板块在多个观察日维持相对强度和广度，回调时没有全面失守；单日大涨不满足。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "成交快速萎缩；上涨集中度过高；核心股破位；板块指数上涨但多数成分走弱。"@zh ;
    ash:ruleVeto "成分历史无法追溯；主题分类频繁变化导致统计失真。"@zh ;
    ash:ruleStateMachine "`NEW`→`DEVELOPING`→`SUSTAINED`→`FADING`→`ENDED`。"@zh ;
    ash:ruleNextActions "持续阶段支持 OP-002/003；衰退阶段触发 MKT-007、POS-004/005。"@zh ;
    ash:ruleInvalidation "板块相对强度和广度持续低于基准；催化被证伪或兑现。"@zh ;
    ash:ruleParameters "持续天数、相对强度、成交维持度和广度分位按板块类型校准。"@zh ;
    ash:ruleTypicalScenario "板块连续数日强于指数，龙头回调有承接，内部出现有序轮动。"@zh ;
    ash:ruleCounterExample "单日政策消息脉冲，次日成交和广度均快速衰退。"@zh ;
    ash:ruleVerification "评估不同持续性状态对板块未来超额收益、回撤和个股跟随成功率的解释力。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "板块在多个观察日维持相对强度和广度，回调时没有全面失守；单日大涨不满足。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-mkt ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-mkt-004 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-op-002 ;
    ash:ruleNextRule ashd:rule-op-003 ;
    ash:ruleNextRule ashd:rule-mkt-007 ;
    ash:ruleNextRule ashd:rule-pos-004 ;
    ash:ruleNextRule ashd:rule-pos-005 ;
    ash:ruleRelatedRule ashd:rule-mkt-003 .

ashd:rule-mkt-005
    a ash:DecisionRule, ash:MarketRegimeRule, ash:RuleArtifact ;
    rdfs:label "板块内部强弱"@zh, "Intra-sector relative strength"@en ;
    rdfs:comment "识别板块内部的领涨、核心、中军、跟随和弱势成员，判断个股在板块中的相对位置及角色变化。"@zh ;
    ash:ruleId "MKT-005" ;
    ash:ruleCategory "MKT 市场环境" ;
    ash:ruleDefinition "识别板块内部的领涨、核心、中军、跟随和弱势成员，判断个股在板块中的相对位置及角色变化。"@zh ;
    ash:ruleScope "板块选股和持仓比较；角色是动态标签，不是永久身份。"@zh ;
    ash:rulePreconditions "板块成分与流动性数据完整；剔除不具可比性的特殊股票；角色判断基于当时信息。"@zh ;
    ash:ruleInputData "个股收益、成交额、换手、相对强度、涨跌停表现、回撤、板块成分。"@zh ;
    ash:ruleObservations "领涨持续性；成交容量；上涨时弹性与回撤；板块调整时抗跌性；跟随扩散；角色轮换。"@zh ;
    ash:ruleTrigger "个股在板块相对强度、成交参与和结构表现上持续处于某一角色区间；单日涨幅排名不足以定义龙头。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "高弹性但持续性差；成交大但相对强度下降；所谓核心股在板块回调中显著弱于同类。"@zh ;
    ash:ruleVeto "板块归属错误；样本太少；流动性差异造成排名偏差。"@zh ;
    ash:ruleStateMachine "`UNCLASSIFIED`→`LEADER/CORE/MIDCAP/FOLLOWER/WEAK`；随新证据更新并保留历史角色。"@zh ;
    ash:ruleNextActions "选股优先评估核心与强跟随；联动 MKT-004/007、OP-001/009/010。"@zh ;
    ash:ruleInvalidation "相对强度和成交结构持续改变，角色重新分类。"@zh ;
    ash:ruleParameters "采用多窗口相对强度、成交容量和回撤韧性；不设单一涨幅排名。"@zh ;
    ash:ruleTypicalScenario "板块回调时某股抗跌，板块修复时率先突破，角色由跟随升级为核心候选。"@zh ;
    ash:ruleCounterExample "因单日一字涨停被误判龙头，实际无成交、无持续性。"@zh ;
    ash:ruleVerification "检验角色标签对后续超额收益、回撤韧性和交易可执行性的预测能力。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "个股在板块相对强度、成交参与和结构表现上持续处于某一角色区间；单日涨幅排名不足以定义龙头。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-mkt ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-mkt-005 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-mkt-004 ;
    ash:ruleNextRule ashd:rule-mkt-007 ;
    ash:ruleNextRule ashd:rule-op-001 ;
    ash:ruleNextRule ashd:rule-op-009 .

ashd:rule-mkt-006
    a ash:DecisionRule, ash:MarketRegimeRule, ash:RuleArtifact ;
    rdfs:label "个股独立走强"@zh, "Independent relative strength"@en ;
    rdfs:comment "个股在所属板块或大盘偏弱时仍表现出显著相对强度，可能反映独立催化或独特供需结构。"@zh ;
    ash:ruleId "MKT-006" ;
    ash:ruleCategory "MKT 市场环境" ;
    ash:ruleDefinition "个股在所属板块或大盘偏弱时仍表现出显著相对强度，可能反映独立催化或独特供需结构。"@zh ;
    ash:ruleScope "独立事件驱动、强势股筛选和组合分散研究。"@zh ;
    ash:rulePreconditions "确定合理对照指数和板块；排除停牌、涨跌停和低流动性造成的统计偏差；核查个股独立事件。"@zh ;
    ash:ruleInputData "个股与指数/板块收益、成交额、相对强度、公告/新闻、行业分类。"@zh ;
    ash:ruleObservations "相对收益持续性；下跌环境中的抗跌；成交是否有真实扩张；独立事件是否可验证；走势是否与板块脱钩。"@zh ;
    ash:ruleTrigger "个股在多个观察窗口持续强于板块和指数，并有价格结构或事件证据支持。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "仅一天逆势上涨；成交极低；消息未经证实；次日相对强度消失。"@zh ;
    ash:ruleVeto "对照板块不匹配；数据不完整；价格受特殊交易状态影响。"@zh ;
    ash:ruleStateMachine "`WATCHING`→`CANDIDATE`→`TRIGGERED`→`CONFIRMED`；相对强度消失为 `EXPIRED/INVALIDATED`。"@zh ;
    ash:ruleNextActions "调用 EVT-001/002/003、OP-001/006、RSK-006；不能因“独立走强”而忽略市场风险。"@zh ;
    ash:ruleInvalidation "个股不再强于基准；独立事件被证伪。"@zh ;
    ash:ruleParameters "多窗口超额收益分位；按行业、规模和波动率匹配对照组。"@zh ;
    ash:ruleTypicalScenario "大盘和板块回调时，个股因订单/政策事件维持强势并突破关键位。"@zh ;
    ash:ruleCounterExample "小盘低流动性股票因几笔成交逆势上涨。"@zh ;
    ash:ruleVerification "比较独立走强组与板块强势组未来收益、回撤及事件持续性。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "个股在多个观察窗口持续强于板块和指数，并有价格结构或事件证据支持。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-mkt ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-mkt-006 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-evt-001 ;
    ash:ruleNextRule ashd:rule-evt-002 ;
    ash:ruleNextRule ashd:rule-op-001 ;
    ash:ruleNextRule ashd:rule-op-006 ;
    ash:ruleNextRule ashd:rule-rsk-006 .

ashd:rule-mkt-007
    a ash:DecisionRule, ash:MarketRegimeRule, ash:RuleArtifact ;
    rdfs:label "板块退潮风险"@zh, "Sector fade risk"@en ;
    rdfs:comment "板块上涨扩散停止，核心股走弱，跟随股承接消失，市场资金从该主题撤离或转向其他方向。"@zh ;
    ash:ruleId "MKT-007" ;
    ash:ruleCategory "MKT 市场环境" ;
    ash:ruleDefinition "板块上涨扩散停止，核心股走弱，跟随股承接消失，市场资金从该主题撤离或转向其他方向。"@zh ;
    ash:ruleScope "板块持仓风险、题材股新开仓过滤。"@zh ;
    ash:rulePreconditions "此前板块已形成启动/持续状态；明确核心股和广度基线；避免将正常轮动误判为退潮。"@zh ;
    ash:ruleInputData "板块指数、成分股广度、核心股走势、成交额、涨停/炸板/跌停数据、事件更新。"@zh ;
    ash:ruleObservations "核心股破位；跟随股大面积回落；成交扩张但下跌占优；板块相对强度转负；新催化缺失或被证伪。"@zh ;
    ash:ruleTrigger "核心结构转弱与板块广度恶化同时出现，或多个独立风险维度持续恶化。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "核心股仍强；板块只是缩量轮动；新事件带来持续需求；板块广度快速修复。"@zh ;
    ash:ruleVeto "板块分类变动；样本数据不足；个股停牌造成广度误判。"@zh ;
    ash:ruleStateMachine "`HEALTHY`→`WARNING`→`DECLINING`→`EXIT_RISK`；修复需多日证据确认。"@zh ;
    ash:ruleNextActions "持仓调用 POS-004/005/006/007；新开仓降低优先级；市场情绪联动 MKT-002。"@zh ;
    ash:ruleInvalidation "核心股和板块广度重新恢复，且持续性得到确认。"@zh ;
    ash:ruleParameters "广度下降速度、核心股回撤、板块相对强度和成交结构组合判定。"@zh ;
    ash:ruleTypicalScenario "龙头断板/破位，板块多只跟随股放量下跌，跌停扩散。"@zh ;
    ash:ruleCounterExample "龙头短暂回调但板块中军和多数成分保持强势。"@zh ;
    ash:ruleVerification "评估退潮预警的提前量、误报率，以及对持仓最大回撤的改善。 --- # 第五类：EVT 事件驱动（6条） 事件规则必须区分“事实”“解释”“影响路径”“市场预期”“价格反应”。新闻情绪正负不等于投资影响正负。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "核心结构转弱与板块广度恶化同时出现，或多个独立风险维度持续恶化。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-mkt ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-mkt-007 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-pos-004 ;
    ash:ruleNextRule ashd:rule-pos-005 ;
    ash:ruleNextRule ashd:rule-mkt-002 .

ashd:rule-evt-001
    a ash:DecisionRule, ash:EventRule, ash:RuleArtifact ;
    rdfs:label "重大利好识别"@zh, "Material positive event"@en ;
    rdfs:comment "识别可能实质改变公司盈利、现金流、竞争地位或估值预期的正向事件，并评估其可信度和可持续性。"@zh ;
    ash:ruleId "EVT-001" ;
    ash:ruleCategory "EVT 事件证据" ;
    ash:ruleDefinition "识别可能实质改变公司盈利、现金流、竞争地位或估值预期的正向事件，并评估其可信度和可持续性。"@zh ;
    ash:ruleScope "公告、合同、订单、产品、技术突破、资产变化、监管政策等；以公司公告和权威来源优先。"@zh ;
    ash:rulePreconditions "事件来源可追溯；区分公司公告、媒体报道、市场传闻和二次解读；确认事件主体与证券主体一致。"@zh ;
    ash:ruleInputData "公告全文、新闻原文、发布时间、合同金额/期限/对手方（公开披露部分）、公司历史业务、财务基线、市场预期。"@zh ;
    ash:ruleObservations "真实性；对收入/利润/现金流影响；相对公司体量的重要性；兑现时间；持续性；是否已被市场预期；是否附带条件。"@zh ;
    ash:ruleTrigger "事件被可靠来源确认，且存在清晰、可解释的经营影响路径；输出影响方向、影响对象、时间范围和不确定性。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "金额含税/框架协议而非确定订单；合同占比很小；交付条件不确定；市场早已充分反映；利好伴随高成本或稀释。"@zh ;
    ash:ruleVeto "未经证实传闻；来源断章取义；事件主体错配；重大关键条款缺失。"@zh ;
    ash:ruleStateMachine "`UNVERIFIED`→`VERIFIED`→`IMPACT_ASSESSING`→`POSITIVE/NEUTRAL/NEGATIVE`；后续公告变化可修正。"@zh ;
    ash:ruleNextActions "重大事件联动 EVT-002/004/006；价格层调用 OP、VP、MKT；风险层检查公告不确定性。"@zh ;
    ash:ruleInvalidation "事件被撤销、合同终止、交付失败或影响低于预期。"@zh ;
    ash:ruleParameters "事件重要性按金额/收入/利润/资产规模比例分层；不能只按新闻热度。"@zh ;
    ash:ruleTypicalScenario "公司披露有明确金额、期限和交付安排的重大订单，且与主营业务直接相关。"@zh ;
    ash:ruleCounterExample "仅签署战略合作框架，无金额、无采购承诺、无落地时间。"@zh ;
    ash:ruleVerification "记录事件首次公开时间，评估公告后价格反应、后续经营数据兑现度和市场预期差。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "事件被可靠来源确认，且存在清晰、可解释的经营影响路径；输出影响方向、影响对象、时间范围和不确定性。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-evt ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-evt-001 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-evt-002 ;
    ash:ruleNextRule ashd:rule-evt-004 .

ashd:rule-evt-002
    a ash:DecisionRule, ash:EventRule, ash:RuleArtifact ;
    rdfs:label "产业链事件传导"@zh, "Industry-chain transmission"@en ;
    rdfs:comment "从产业链上游/下游事件出发，识别可能受影响的环节、公司及影响方向，避免把产业新闻简单映射到所有相关股票。"@zh ;
    ash:ruleId "EVT-002" ;
    ash:ruleCategory "EVT 事件证据" ;
    ash:ruleDefinition "从产业链上游/下游事件出发，识别可能受影响的环节、公司及影响方向，避免把产业新闻简单映射到所有相关股票。"@zh ;
    ash:ruleScope "产业政策、供需变化、技术迭代、价格变化、资本开支、供应链中断等。"@zh ;
    ash:rulePreconditions "产业链关系有证据来源；公司业务暴露度可验证；明确事件发生环节和传导时滞。"@zh ;
    ash:ruleInputData "事件原文、产业链结构、公司分部收入/产品、客户供应商披露、产能/价格/订单数据。"@zh ;
    ash:ruleObservations "事件影响环节；受益/受损方向；公司业务暴露比例；替代能力；传导时滞；利润弹性；竞争格局变化。"@zh ;
    ash:ruleTrigger "事件与产业链环节存在可验证联系，且目标公司在该环节有实际业务暴露；必须写出“事件→环节→公司业务→财务变量”的完整路径。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "公司业务占比很低；技术路线不匹配；产能无法兑现；上游涨价反而挤压下游利润。"@zh ;
    ash:ruleVeto "仅凭概念标签关联；供应链关系来自未经核实的网络传闻；事件方向不明确。"@zh ;
    ash:ruleStateMachine "`EVENT_DETECTED`→`CHAIN_MAPPED`→`EXPOSURE_VERIFIED`→`IMPACT_ESTIMATED`→`PRICE_VALIDATED`。"@zh ;
    ash:ruleNextActions "公司层调用 EVT-001/004/005；价格层调用 MKT-003/006、OP-001；未验证暴露的公司只进入观察名单。"@zh ;
    ash:ruleInvalidation "产业链路径被证伪；公司披露不支持业务暴露；事件影响被竞争或替代抵消。"@zh ;
    ash:ruleParameters "暴露度、传导时滞和利润敏感度按行业单独配置，不设通用阈值。"@zh ;
    ash:ruleTypicalScenario "下游资本开支上调，供应链披露显示某公司为相关设备核心供应商，订单/收入随后验证。"@zh ;
    ash:ruleCounterExample "某公司被市场归入热门概念，但主营收入与事件环节关系很弱。"@zh ;
    ash:ruleVerification "保存事件图谱证据与公司暴露判断，回看后续订单、收入、毛利率及股价反应，统计映射准确率。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "事件与产业链环节存在可验证联系，且目标公司在该环节有实际业务暴露；必须写出“事件→环节→公司业务→财务变量”的完整路径。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-evt ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-evt-002 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-evt-001 ;
    ash:ruleNextRule ashd:rule-evt-004 ;
    ash:ruleNextRule ashd:rule-mkt-003 ;
    ash:ruleNextRule ashd:rule-mkt-006 ;
    ash:ruleNextRule ashd:rule-op-001 .

ashd:rule-evt-003
    a ash:DecisionRule, ash:EventRule, ash:RuleArtifact ;
    rdfs:label "政策催化"@zh, "Policy catalyst"@en ;
    rdfs:comment "识别政策从发布、落地、执行到影响行业/企业的传导过程，区分方向性表态与可执行政策。"@zh ;
    ash:ruleId "EVT-003" ;
    ash:ruleCategory "EVT 事件证据" ;
    ash:ruleDefinition "识别政策从发布、落地、执行到影响行业/企业的传导过程，区分方向性表态与可执行政策。"@zh ;
    ash:ruleScope "国家、部委、地方政策及监管规则；政策原文优先。"@zh ;
    ash:rulePreconditions "确认发布机构、政策层级、适用对象、生效时间和执行细则；区分征求意见稿与正式文件。"@zh ;
    ash:ruleInputData "政策原文、配套细则、适用范围、财政/税收/采购安排、行业数据、公司业务暴露。"@zh ;
    ash:ruleObservations "政策确定性；约束/支持对象；资金来源；执行主体；落地时间；行业供需影响；受益企业实际暴露。"@zh ;
    ash:ruleTrigger "正式政策或明确执行安排已发布，且可识别影响路径；仅会议表态标记为低确定性观察。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "缺少预算/执行细则；政策约束强于扶持；企业无法获得政策资源；市场早已预期。"@zh ;
    ash:ruleVeto "文件真实性无法核实；适用范围不包括目标公司；政策仍处于传闻阶段。"@zh ;
    ash:ruleStateMachine "`RUMOR`→`DRAFT`→`FORMAL`→`IMPLEMENTING`→`EFFECT_OBSERVED`；政策变化可回退。"@zh ;
    ash:ruleNextActions "联动 EVT-002、EVT-001、EVT-006；价格反应通过 MKT/OP 验证。"@zh ;
    ash:ruleInvalidation "政策延期、撤回、执行力度低于预期或公司不符合条件。"@zh ;
    ash:ruleParameters "按政策层级、确定性、执行资源和影响时滞分类；不做简单正负面分数。"@zh ;
    ash:ruleTypicalScenario "正式政策明确补贴对象、标准、资金来源和执行周期，相关公司产品符合条件。"@zh ;
    ash:ruleCounterExample "政策会议提到鼓励某产业，但没有落地细则，市场却把所有概念股视为直接受益。"@zh ;
    ash:ruleVerification "记录政策阶段，追踪执行数据、行业订单和公司财务兑现；区分短期主题行情与长期基本面影响。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "正式政策或明确执行安排已发布，且可识别影响路径；仅会议表态标记为低确定性观察。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-evt ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-evt-003 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-evt-002 ;
    ash:ruleNextRule ashd:rule-evt-001 ;
    ash:ruleNextRule ashd:rule-evt-006 .

ashd:rule-evt-004
    a ash:DecisionRule, ash:EventRule, ash:RuleArtifact ;
    rdfs:label "业绩超预期"@zh, "Earnings beat"@en ;
    rdfs:comment "公司实际或预告业绩显著优于可获得的市场预期/自身指引，并判断超预期来自可持续经营改善还是一次性因素。"@zh ;
    ash:ruleId "EVT-004" ;
    ash:ruleCategory "EVT 事件证据" ;
    ash:ruleDefinition "公司实际或预告业绩显著优于可获得的市场预期/自身指引，并判断超预期来自可持续经营改善还是一次性因素。"@zh ;
    ash:ruleScope "业绩预告、快报、季报、年报及正式业绩说明。"@zh ;
    ash:rulePreconditions "预期基线有来源和时间戳；会计口径一致；区分扣非与非经常性损益；考虑季节性。"@zh ;
    ash:ruleInputData "收入、利润、扣非利润、毛利率、费用率、现金流、订单、指引、分析师预期（若可得）。"@zh ;
    ash:ruleObservations "实际相对预期差；增长质量；利润与现金流匹配；业务分部贡献；一次性收益；指引变化。"@zh ;
    ash:ruleTrigger "实际数据或正式预告高于可比预期，且改善来源有经营证据；输出超预期来源与持续性等级。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "利润增长主要来自非经常性收益；收入/现金流不匹配；应收/存货异常；下一季度指引转弱。"@zh ;
    ash:ruleVeto "预期基线不可验证；财务口径不一致；数据未经正式披露。"@zh ;
    ash:ruleStateMachine "`EXPECTED`→`RELEASED`→`BEAT_ASSESSING`→`SUSTAINABLE_BEAT/ONE_OFF_BEAT/NO_BEAT`。"@zh ;
    ash:ruleNextActions "联动 EVT-001、EVT-006、OP-001、MKT-006；价格高开风险联动 AUC-001/RSK-005。"@zh ;
    ash:ruleInvalidation "后续财报修正、审计意见或经营数据推翻原判断。"@zh ;
    ash:ruleParameters "超预期幅度按行业、季节性和公司历史波动分层；不能用单一同比增速。"@zh ;
    ash:ruleTypicalScenario "收入、扣非利润和经营现金流同步改善，且公司上调后续指引。"@zh ;
    ash:ruleCounterExample "净利润大增但主要来自资产处置或补贴，主营经营未改善。"@zh ;
    ash:ruleVerification "事件窗口收益、后续季度兑现率、盈利预测修正和估值变化分开评估。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "实际数据或正式预告高于可比预期，且改善来源有经营证据；输出超预期来源与持续性等级。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-evt ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-evt-004 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-evt-001 ;
    ash:ruleNextRule ashd:rule-evt-006 ;
    ash:ruleNextRule ashd:rule-op-001 ;
    ash:ruleNextRule ashd:rule-mkt-006 ;
    ash:ruleNextRule ashd:rule-auc-001 ;
    ash:ruleNextRule ashd:rule-rsk-005 .

ashd:rule-evt-005
    a ash:DecisionRule, ash:EventRule, ash:RuleArtifact ;
    rdfs:label "业绩不及预期"@zh, "Earnings miss"@en ;
    rdfs:comment "实际业绩低于可比预期或公司指引，分析差异来自需求、价格、成本、竞争、会计或一次性因素。"@zh ;
    ash:ruleId "EVT-005" ;
    ash:ruleCategory "EVT 事件证据" ;
    ash:ruleDefinition "实际业绩低于可比预期或公司指引，分析差异来自需求、价格、成本、竞争、会计或一次性因素。"@zh ;
    ash:ruleScope "财报、业绩预告、业绩快报及经营数据披露。"@zh ;
    ash:rulePreconditions "建立可信预期基线；统一会计口径；识别季节性、并表和资产重组影响。"@zh ;
    ash:ruleInputData "收入、利润、扣非、毛利率、费用率、现金流、存货、应收、订单、指引。"@zh ;
    ash:ruleObservations "低于预期幅度；主营与非经常性贡献；毛利率/费用变化；现金流质量；未来指引；行业共性或公司特异性。"@zh ;
    ash:ruleTrigger "正式披露数据低于可比预期，且差异不能被合理季节性/口径解释；输出负面影响路径。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "利润低于预期但现金流和订单强；一次性费用导致短期偏差；管理层给出可验证修复计划。"@zh ;
    ash:ruleVeto "预期基线不可核实；财报口径变更未调整；未经证实的媒体数字。"@zh ;
    ash:ruleStateMachine "`EXPECTED`→`RELEASED`→`MISS_ASSESSING`→`STRUCTURAL_NEGATIVE/TEMPORARY_MISS/NO_MISS`。"@zh ;
    ash:ruleNextActions "持仓联动 POS-005/006、RSK-005；非持仓降低优先级；若行业共性则联动 MKT-007/EVT-002。"@zh ;
    ash:ruleInvalidation "后续订单、现金流或指引证明问题短暂且已修复。"@zh ;
    ash:ruleParameters "按行业利润波动、公司历史指引准确度和预期分歧校准。"@zh ;
    ash:ruleTypicalScenario "收入低于预期、毛利率下滑、经营现金流恶化且公司下调指引。"@zh ;
    ash:ruleCounterExample "单季利润因季节性低于预期，但全年订单与现金流并未恶化。"@zh ;
    ash:ruleVerification "评估披露后跳空、后续趋势、盈利预测下修和基本面修复时间。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "正式披露数据低于可比预期，且差异不能被合理季节性/口径解释；输出负面影响路径。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-evt ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-evt-005 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-pos-005 ;
    ash:ruleNextRule ashd:rule-pos-006 ;
    ash:ruleNextRule ashd:rule-rsk-005 ;
    ash:ruleNextRule ashd:rule-mkt-007 ;
    ash:ruleNextRule ashd:rule-evt-002 .

ashd:rule-evt-006
    a ash:DecisionRule, ash:EventRule, ash:RuleArtifact ;
    rdfs:label "事件兑现与反转"@zh, "Event realization and reversal"@en ;
    rdfs:comment "市场此前交易的事件预期已经部分或全部兑现，或实际结果与预期出现差异，导致原有价格驱动减弱甚至反向。"@zh ;
    ash:ruleId "EVT-006" ;
    ash:ruleCategory "EVT 事件证据" ;
    ash:ruleDefinition "市场此前交易的事件预期已经部分或全部兑现，或实际结果与预期出现差异，导致原有价格驱动减弱甚至反向。"@zh ;
    ash:ruleScope "重大订单、政策、业绩、产品发布、会议、审批、并购重组等事件交易。"@zh ;
    ash:rulePreconditions "记录事件首次公开时间、预期形成过程、关键兑现节点和市场此前价格反应。"@zh ;
    ash:ruleInputData "事件时间线、公告/新闻、价格成交、市场预期、板块表现、后续经营数据。"@zh ;
    ash:ruleObservations "事件是否落地；结果与预期差；价格是否提前反映；利好兑现后是否继续走强；成交和相对强度是否衰减。"@zh ;
    ash:ruleTrigger "关键节点到来且实际结果低于/符合/高于预期，或价格对事件出现明显反向反应；必须区分“事实兑现”和“股价反应”。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "事件落地后公司继续获得订单/政策支持；市场仍持续上修预期；价格和成交保持强势。"@zh ;
    ash:ruleVeto "事件尚未到兑现节点；市场预期无法重建；仅凭上涨后回调判断利好出尽。"@zh ;
    ash:ruleStateMachine "`ANTICIPATED`→`APPROACHING`→`REALIZED`→`PRICED_IN/BEAT/MISS`→`TREND_REASSESSMENT`。"@zh ;
    ash:ruleNextActions "持仓联动 POS-004/005/007；非持仓重新评估 OP；事件影响减弱时不再沿用旧催化标签。"@zh ;
    ash:ruleInvalidation "出现新的增量事件或兑现结果被修正。"@zh ;
    ash:ruleParameters "事件窗口按事件类型配置；预期差需保留事件前市场价格和分析师/公司指引快照。"@zh ;
    ash:ruleTypicalScenario "市场提前大幅上涨交易订单预期，公告落地但金额低于传闻，股价放量走弱。"@zh ;
    ash:ruleCounterExample "利好公告后短暂回落，但后续订单持续超预期，不能简单认定兑现结束。"@zh ;
    ash:ruleVerification "比较事件前后收益、成交、预期修正和基本面兑现；统计“买预期卖事实”标签的误判率。 --- # 第六类：POS 持仓管理（8条） POS 规则处理已有持仓。所有动作必须受交易授权、账户可用数量、T+1、涨跌停和风险预算约束。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "关键节点到来且实际结果低于/符合/高于预期，或价格对事件出现明显反向反应；必须区分“事实兑现”和“股价反应”。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-evt ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-evt-006 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-pos-004 ;
    ash:ruleNextRule ashd:rule-pos-005 .

ashd:rule-pos-001
    a ash:DecisionRule, ash:PositionRule, ash:RuleArtifact ;
    rdfs:label "趋势延续持有"@zh, "Hold trend continuation"@en ;
    rdfs:comment "持仓标的的原始买入逻辑仍成立，价格结构、相对强度和风险状态未出现足以否定趋势的证据，因此继续持有。"@zh ;
    ash:ruleId "POS-001" ;
    ash:ruleCategory "POS 持仓管理" ;
    ash:ruleDefinition "持仓标的的原始买入逻辑仍成立，价格结构、相对强度和风险状态未出现足以否定趋势的证据，因此继续持有。"@zh ;
    ash:ruleScope "已持仓且初始交易逻辑为趋势/突破/事件趋势的仓位。"@zh ;
    ash:rulePreconditions "保存买入时的 thesis、关键失效位、计划持有周期、初始风险和仓位；不能事后随意改变买入理由。"@zh ;
    ash:ruleInputData "持仓成本与数量、OHLC、成交额、趋势结构、板块/指数、事件更新、风险预算。"@zh ;
    ash:ruleObservations "趋势高低点是否延续；关键支撑是否守住；相对强度；成交质量；事件兑现；组合集中度。"@zh ;
    ash:ruleTrigger "趋势结构仍有效，未触发 POS-005/006 或 RSK 硬约束；继续持有是默认动作，但需定期重新验证。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "趋势推进效率下降、放量滞涨、板块退潮、基本面假设变化。"@zh ;
    ash:ruleVeto "硬止损/风险预算触发；重大信息证伪；交易授权撤销；证券停牌/退市等特殊风险。"@zh ;
    ash:ruleStateMachine "`HOLDING_HEALTHY`→`HOLDING_WARNING`→`REDUCE/EXIT_REVIEW`；恢复需重新满足原始逻辑。"@zh ;
    ash:ruleNextActions "联动 POS-002/003/004/005、MKT-004、EVT-006；每日更新但避免因噪声频繁交易。"@zh ;
    ash:ruleInvalidation "原始趋势结构破坏或交易 thesis 不成立。"@zh ;
    ash:ruleParameters "趋势失效位、检查频率和持有周期按策略设定；不得只按浮盈比例决定持有。"@zh ;
    ash:ruleTypicalScenario "趋势股沿更高低点运行，板块持续强势，回调成交收缩。"@zh ;
    ash:ruleCounterExample "股价仍盈利但关键结构已破坏，不能因成本价心理锚定而继续持有。"@zh ;
    ash:ruleVerification "比较规则持有与固定持有期/固定止盈基线的收益、回撤和换手成本。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "趋势结构仍有效，未触发 POS-005/006 或 RSK 硬约束；继续持有是默认动作，但需定期重新验证。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-pos ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-pos-001 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-pos-002 ;
    ash:ruleNextRule ashd:rule-pos-003 ;
    ash:ruleNextRule ashd:rule-mkt-004 ;
    ash:ruleNextRule ashd:rule-evt-006 ;
    ash:ruleRelatedRule ashd:rule-pos-005 ;
    ash:ruleRelatedRule ashd:rule-pos-006 .

ashd:rule-pos-002
    a ash:DecisionRule, ash:PositionRule, ash:RuleArtifact ;
    rdfs:label "趋势加速管理"@zh, "Manage trend acceleration"@en ;
    rdfs:comment "持仓进入加速阶段时，管理收益回吐风险和趋势延续机会，避免过早清仓或无纪律追加强仓。"@zh ;
    ash:ruleId "POS-002" ;
    ash:ruleCategory "POS 持仓管理" ;
    ash:ruleDefinition "持仓进入加速阶段时，管理收益回吐风险和趋势延续机会，避免过早清仓或无纪律追加强仓。"@zh ;
    ash:ruleScope "已有浮盈且趋势明显加速的持仓。"@zh ;
    ash:rulePreconditions "持仓 thesis 仍成立；识别加速阶段与初始风险；预设分批止盈和跟踪退出规则。"@zh ;
    ash:ruleInputData "持仓数量/成本、价格速度、ATR、成交额、换手、板块强度、事件。"@zh ;
    ash:ruleObservations "价格偏离趋势参考；推进效率；日内振幅；高位成交结构；板块核心表现；浮盈回撤容忍。"@zh ;
    ash:ruleTrigger "OP-007 确认加速，且持仓浮盈/风险结构达到预设管理区间；进入加速管理模式。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "趋势仍健康且波动可控；加速由持续基本面上修支撑；过早止盈可能显著损失趋势收益。"@zh ;
    ash:ruleVeto "没有明确持仓计划；加仓会超风险预算；交易制度不允许当日卖出可用数量。"@zh ;
    ash:ruleStateMachine "`NORMAL_HOLD`→`ACCELERATION_MANAGEMENT`→`TRAILING_PROTECTION`→`REDUCE/EXIT`。"@zh ;
    ash:ruleNextActions "调用 POS-007 分批止盈、RSK-002/003 检查风险；加仓必须单独满足 POS-008。"@zh ;
    ash:ruleInvalidation "加速结束并回归正常趋势；趋势结构破坏则升级退出审查。"@zh ;
    ash:ruleParameters "以 ATR 跟踪、阶段高点回撤和趋势位组合；分批比例按策略和流动性校准。"@zh ;
    ash:ruleTypicalScenario "趋势股连续加速后波动扩大，按计划部分兑现并保留趋势仓。"@zh ;
    ash:ruleCounterExample "只因涨幅大就全部卖出，导致强趋势后续收益被系统性截断。"@zh ;
    ash:ruleVerification "比较不止盈、固定止盈、分批止盈和跟踪止盈的收益分布与回撤。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "OP-007 确认加速，且持仓浮盈/风险结构达到预设管理区间；进入加速管理模式。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-pos ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-pos-002 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-pos-007 ;
    ash:ruleNextRule ashd:rule-rsk-002 ;
    ash:ruleNextRule ashd:rule-rsk-003 ;
    ash:ruleNextRule ashd:rule-pos-008 ;
    ash:ruleRelatedRule ashd:rule-op-007 .

ashd:rule-pos-003
    a ash:DecisionRule, ash:PositionRule, ash:RuleArtifact ;
    rdfs:label "正常回调持有"@zh, "Hold normal pullback"@en ;
    rdfs:comment "持仓在既有趋势中出现幅度和成交结构均处于正常范围的回调，关键结构未破坏，因此不因短期下跌而过度反应。"@zh ;
    ash:ruleId "POS-003" ;
    ash:ruleCategory "POS 持仓管理" ;
    ash:ruleDefinition "持仓在既有趋势中出现幅度和成交结构均处于正常范围的回调，关键结构未破坏，因此不因短期下跌而过度反应。"@zh ;
    ash:ruleScope "趋势持仓；不适用于下降趋势或重大负面事件。"@zh ;
    ash:rulePreconditions "建立趋势基线和关键支撑；定义正常回调幅度/时间；确认回调不是由基本面变化触发。"@zh ;
    ash:ruleInputData "OHLC、成交额、ATR、支撑位、板块表现、事件、持仓风险。"@zh ;
    ash:ruleObservations "回撤深度；回调持续时间；成交是否收缩；低点是否守住；板块同步程度；反弹质量。"@zh ;
    ash:ruleTrigger "回调未超出策略容忍范围，成交未显示持续抛售，关键位保持有效。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "放量下跌；关键支撑被收盘跌破；板块退潮；事件逻辑变化。"@zh ;
    ash:ruleVeto "回调已超出初始风险预算；持仓因 T+1 无法当日卖出时需记录可执行时间，不得假设可即时退出。"@zh ;
    ash:ruleStateMachine "`PULLBACK_WATCHING`→`NORMAL_PULLBACK`→`RECOVERY`；结构破坏转 POS-006。"@zh ;
    ash:ruleNextActions "继续观察；联动 VP-004、OP-002、MKT-004；禁止仅因回调触发自动加仓。"@zh ;
    ash:ruleInvalidation "回调转为趋势破坏，或原始趋势依据消失。"@zh ;
    ash:ruleParameters "回撤按 ATR、趋势波段比例和支撑结构综合定义；回调时间按周期配置。"@zh ;
    ash:ruleTypicalScenario "趋势股回踩突破位，成交收缩，随后重新站回短期均线/压力。"@zh ;
    ash:ruleCounterExample "放量跌破支撑后仍以“正常回调”解释。"@zh ;
    ash:ruleVerification "统计正常回调分类准确率、错误持有造成的 MAE、回调后恢复时间。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "回调未超出策略容忍范围，成交未显示持续抛售，关键位保持有效。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-pos ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-pos-003 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-vp-004 ;
    ash:ruleNextRule ashd:rule-op-002 ;
    ash:ruleNextRule ashd:rule-mkt-004 ;
    ash:ruleRelatedRule ashd:rule-pos-006 .

ashd:rule-pos-004
    a ash:DecisionRule, ash:PositionRule, ash:RuleArtifact ;
    rdfs:label "高位分歧管理"@zh, "Manage high-level divergence"@en ;
    rdfs:comment "高位持仓出现明显分歧，管理浮盈保护和趋势继续的平衡；判断是健康换手还是趋势衰竭。"@zh ;
    ash:ruleId "POS-004" ;
    ash:ruleCategory "POS 持仓管理" ;
    ash:ruleDefinition "高位持仓出现明显分歧，管理浮盈保护和趋势继续的平衡；判断是健康换手还是趋势衰竭。"@zh ;
    ash:ruleScope "显著上涨后的持仓，尤其短线/主题股。"@zh ;
    ash:rulePreconditions "明确高位区间、持仓浮盈和原始退出计划；区分高位分歧与正常日内波动。"@zh ;
    ash:ruleInputData "OHLC、分时、成交额、换手、阶段高点、板块情绪、核心股表现。"@zh ;
    ash:ruleObservations "冲高回落；上影线；放量滞涨；开板/回封；收盘位置；次日竞价与板块反馈。"@zh ;
    ash:ruleTrigger "高位出现分歧证据且至少一个价格/成交维度恶化；进入风险观察，不自动清仓。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "分歧后强势收复；成交换手后价格继续接受高位；板块仍扩散。"@zh ;
    ash:ruleVeto "数据无法观察盘中过程；将单次振幅误判为趋势衰竭。"@zh ;
    ash:ruleStateMachine "`HIGH_LEVEL_NORMAL`→`DIVERGENCE_WARNING`→`REDUCE_REVIEW`→`EXIT_REVIEW`；重新转强可回到观察状态。"@zh ;
    ash:ruleNextActions "联动 VP-003/007/008、OP-009、MKT-002/007、POS-007。"@zh ;
    ash:ruleInvalidation "价格持续走强并消化分歧；或关键支撑失守确认恶化。"@zh ;
    ash:ruleParameters "高位定义、回撤幅度、成交扩张和收盘位置按波动率分层。"@zh ;
    ash:ruleTypicalScenario "高位放量震荡，收盘仍守住关键位，次日竞价修复，继续观察而非机械卖出。"@zh ;
    ash:ruleCounterExample "高位放量长阴、板块退潮，仍仅因此前盈利而忽略风险。"@zh ;
    ash:ruleVerification "比较分歧预警后不同减仓比例的最终收益、回撤和卖飞率。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "高位出现分歧证据且至少一个价格/成交维度恶化；进入风险观察，不自动清仓。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-pos ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-pos-004 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-vp-003 ;
    ash:ruleNextRule ashd:rule-vp-007 ;
    ash:ruleNextRule ashd:rule-op-009 ;
    ash:ruleNextRule ashd:rule-mkt-002 ;
    ash:ruleNextRule ashd:rule-mkt-007 ;
    ash:ruleNextRule ashd:rule-pos-007 .

ashd:rule-pos-005
    a ash:DecisionRule, ash:PositionRule, ash:RuleArtifact ;
    rdfs:label "趋势衰竭"@zh, "Trend exhaustion"@en ;
    rdfs:comment "趋势仍可能没有完全反转，但价格推进效率、相对强度和成交结构持续恶化，原有持仓优势正在消失。"@zh ;
    ash:ruleId "POS-005" ;
    ash:ruleCategory "POS 持仓管理" ;
    ash:ruleDefinition "趋势仍可能没有完全反转，但价格推进效率、相对强度和成交结构持续恶化，原有持仓优势正在消失。"@zh ;
    ash:ruleScope "中短期趋势持仓；作为减仓/退出评估信号。"@zh ;
    ash:rulePreconditions "原趋势已确认；建立趋势推进常态；至少使用多个观察窗口而非单日判断。"@zh ;
    ash:ruleInputData "OHLC、成交额、ATR、相对强度、均线/摆动点、板块、事件。"@zh ;
    ash:ruleObservations "新高推进幅度下降；回撤加深；成交放大但价格推进不足；相对强度下滑；趋势低点间距变化。"@zh ;
    ash:ruleTrigger "多个独立趋势质量维度持续恶化，且不是单纯正常回调；输出 `TREND_WEAKENING`。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "价格快速恢复新高；相对强度重新走强；事件/业绩持续上修。"@zh ;
    ash:ruleVeto "单一指标短暂恶化；数据窗口过短；市场整体异常导致个股指标失真。"@zh ;
    ash:ruleStateMachine "`HEALTHY`→`WEAKENING`→`DETERIORATING`→`EXIT_REVIEW`；修复后可降级预警。"@zh ;
    ash:ruleNextActions "联动 VP-003/008、OP-008、MKT-007、POS-007；检查组合集中度。"@zh ;
    ash:ruleInvalidation "趋势质量恢复；或进一步恶化至 POS-006。"@zh ;
    ash:ruleParameters "推进效率、回撤深度、相对强度分位和观察窗口按策略校准。"@zh ;
    ash:ruleTypicalScenario "连续创新高但每次推进幅度变小，成交越来越大，收盘位置转弱。"@zh ;
    ash:ruleCounterExample "上涨途中短暂缩量横盘，被误判为衰竭。"@zh ;
    ash:ruleVerification "检验衰竭状态对未来回撤和提前减仓收益的改善，统计卖飞成本。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "多个独立趋势质量维度持续恶化，且不是单纯正常回调；输出 `TREND_WEAKENING`。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-pos ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-pos-005 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-vp-003 ;
    ash:ruleNextRule ashd:rule-vp-008 ;
    ash:ruleNextRule ashd:rule-op-008 ;
    ash:ruleNextRule ashd:rule-mkt-007 ;
    ash:ruleNextRule ashd:rule-pos-007 ;
    ash:ruleRelatedRule ashd:rule-pos-006 .

ashd:rule-pos-006
    a ash:DecisionRule, ash:PositionRule, ash:RuleArtifact ;
    rdfs:label "关键支撑失守"@zh, "Key support breach"@en ;
    rdfs:comment "持仓价格有效跌破买入逻辑所依赖的关键结构位，原始交易假设受到实质挑战。"@zh ;
    ash:ruleId "POS-006" ;
    ash:ruleCategory "POS 持仓管理" ;
    ash:ruleDefinition "持仓价格有效跌破买入逻辑所依赖的关键结构位，原始交易假设受到实质挑战。"@zh ;
    ash:ruleScope "所有有明确结构失效位的持仓。"@zh ;
    ash:rulePreconditions "买入前已记录失效位和价格口径；考虑 ATR 噪声、收盘确认和交易可执行性。"@zh ;
    ash:ruleInputData "实时/日线价格、支撑位、ATR、成交额、持仓可卖数量、涨跌停状态。"@zh ;
    ash:ruleObservations "跌破幅度；收盘是否在支撑下方；成交是否放大；是否快速收复；板块与事件是否同步恶化。"@zh ;
    ash:ruleTrigger "价格按预设规则有效跌破关键位；盘中刺穿但收盘收复可标记观察，不自动判定结构失效。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "快速收复支撑；跌破由异常瞬时成交造成；板块同步修复。"@zh ;
    ash:ruleVeto "支撑位定义不清；价格数据复权错误；交易所停牌/跌停导致无法执行。"@zh ;
    ash:ruleStateMachine "`SUPPORT_TEST`→`BREAK_WARNING`→`BROKEN`→`EXIT_PENDING/EXITED`；收复后需重新验证。"@zh ;
    ash:ruleNextActions "触发退出评估和 RSK-002；根据 T+1、跌停和可卖数量生成可执行计划，不虚构成交。"@zh ;
    ash:ruleInvalidation "关键位重新收复并形成新的支撑结构；原突破逻辑仍需重建。"@zh ;
    ash:ruleParameters "支撑容差使用 ATR；收盘确认周期按交易策略设定；极端风险可设置盘中硬阈值。"@zh ;
    ash:ruleTypicalScenario "平台突破买入后，价格放量收盘跌回平台内部并跌破回踩低点。"@zh ;
    ash:ruleCounterExample "盘中短暂跌破支撑，尾盘收复且成交显示抛压衰减。"@zh ;
    ash:ruleVerification "评估不同失效确认方式对止损滑移、最大回撤和过早退出的影响。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "价格按预设规则有效跌破关键位；盘中刺穿但收盘收复可标记观察，不自动判定结构失效。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-pos ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-pos-006 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-rsk-002 .

ashd:rule-pos-007
    a ash:DecisionRule, ash:PositionRule, ash:RuleArtifact ;
    rdfs:label "分批止盈"@zh, "Scale-out profit taking"@en ;
    rdfs:comment "持仓达到预设收益/结构条件后，分阶段兑现部分仓位，同时保留剩余仓位参与可能的趋势延续。"@zh ;
    ash:ruleId "POS-007" ;
    ash:ruleCategory "POS 持仓管理" ;
    ash:ruleDefinition "持仓达到预设收益/结构条件后，分阶段兑现部分仓位，同时保留剩余仓位参与可能的趋势延续。"@zh ;
    ash:ruleScope "已有浮盈的趋势/事件/短线持仓；具体比例按策略配置。"@zh ;
    ash:rulePreconditions "买入时已定义目标区间、风险预算和剩余仓位管理方法；确认卖出数量可用。"@zh ;
    ash:ruleInputData "持仓成本/数量、可卖数量、浮盈、价格结构、ATR、流动性、费用税费。"@zh ;
    ash:ruleObservations "达到目标区间；趋势是否加速/衰竭；关键压力位；成交结构；组合集中度；剩余仓位风险。"@zh ;
    ash:ruleTrigger "达到事先设定的价格/结构/风险条件之一，且减仓后仍符合组合目标；不以固定盈利百分比替代趋势判断。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "趋势强度继续增强且风险预算允许持有；价格有效突破压力并有量价支持。"@zh ;
    ash:ruleVeto "当日买入股票受 T+1 限制不可卖；跌停无成交；授权不允许自动卖出；费用/税费未计入。"@zh ;
    ash:ruleStateMachine "`PROFIT_PROTECT_WATCH`→`PARTIAL_EXIT_TRIGGERED`→`PARTIAL_FILLED`→`REMAINDER_MANAGED`→`CLOSED`。"@zh ;
    ash:ruleNextActions "剩余仓位转 POS-001/002/005；更新组合风险和已实现盈亏。"@zh ;
    ash:ruleInvalidation "未成交不代表止盈完成；订单取消/部分成交后重新计算仓位和风险。"@zh ;
    ash:ruleParameters "分批比例、目标层级、跟踪止盈规则按策略测试；必须计入交易费用和税费。"@zh ;
    ash:ruleTypicalScenario "趋势加速后在预设压力区域减持部分，剩余仓位用趋势失效位管理。"@zh ;
    ash:ruleCounterExample "仅因盈利达到某百分比就全部卖出，忽略趋势仍强；或在不可卖日错误地记录为已止盈。"@zh ;
    ash:ruleVerification "与全仓止盈、固定止盈、跟踪止盈比较净收益、回撤、卖飞率和交易成本。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "达到事先设定的价格/结构/风险条件之一，且减仓后仍符合组合目标；不以固定盈利百分比替代趋势判断。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-pos ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-pos-007 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-pos-001 ;
    ash:ruleNextRule ashd:rule-pos-002 .

ashd:rule-pos-008
    a ash:DecisionRule, ash:PositionRule, ash:RuleArtifact ;
    rdfs:label "条件加仓"@zh, "Conditional add"@en ;
    rdfs:comment "已有持仓在原始逻辑继续成立且新增证据改善时，按风险预算增加仓位；加仓不是摊平亏损。"@zh ;
    ash:ruleId "POS-008" ;
    ash:ruleCategory "POS 持仓管理" ;
    ash:ruleDefinition "已有持仓在原始逻辑继续成立且新增证据改善时，按风险预算增加仓位；加仓不是摊平亏损。"@zh ;
    ash:ruleScope "趋势延续、突破确认或回踩后二次启动；不适用于逻辑恶化中的亏损仓。"@zh ;
    ash:rulePreconditions "原始仓位风险可控；加仓触发条件事先定义；组合集中度、可用资金和单笔风险预算有余量。"@zh ;
    ash:ruleInputData "持仓成本/数量、当前价、初始止损、加仓后组合风险、趋势结构、成交、板块状态。"@zh ;
    ash:ruleObservations "新结构是否确认；加仓位置是否合理；加仓后平均成本变化；总风险是否上升到预算外；相关性与集中度。"@zh ;
    ash:ruleTrigger "出现新的独立确认（如回踩后再启动、突破新平台），且加仓后的最坏计划风险仍在预算内。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "价格远离合理失效位；趋势加速过度；板块退潮；加仓仅为降低账面成本。"@zh ;
    ash:ruleVeto "当前仓位已超风险预算；亏损扩大且原逻辑受损；资金/授权不足；T+1 与交易规则不允许。"@zh ;
    ash:ruleStateMachine "`ADD_WATCHING`→`ADD_CANDIDATE`→`RISK_APPROVED`→`ORDER_PENDING`→`FILLED/REJECTED`。"@zh ;
    ash:ruleNextActions "先调用 RSK-001/002/003，再生成模拟订单；订单成交后重算持仓成本、风险和退出位。"@zh ;
    ash:ruleInvalidation "加仓条件消失、风险审批失败或订单不可成交。"@zh ;
    ash:ruleParameters "每次加仓风险额度、加仓次数和总仓位上限由策略配置；不使用亏损百分比自动补仓。"@zh ;
    ash:ruleTypicalScenario "首次突破小仓试错，回踩守住并二次启动，且组合风险有空间，再增加有限仓位。"@zh ;
    ash:ruleCounterExample "买入后下跌，为摊低成本不断补仓。"@zh ;
    ash:ruleVerification "比较分批建仓与一次建仓的净收益、回撤、资金占用和失败策略损失。 --- # 第七类：RSK 风险控制（7条） RSK 属于约束层。硬约束优先于机会信号；风险审批失败时，即使 OP/EVT 看多也不得执行。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "出现新的独立确认（如回踩后再启动、突破新平台），且加仓后的最坏计划风险仍在预算内。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-pos ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-pos-008 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-rsk-001 ;
    ash:ruleNextRule ashd:rule-rsk-002 .

ashd:rule-rsk-001
    a ash:DecisionRule, ash:RiskRule, ash:RuleArtifact ;
    rdfs:label "盈亏比过滤"@zh, "Reward-risk filter"@en ;
    rdfs:comment "评估从计划入场价到合理失效位的潜在损失，与可解释目标区域的潜在收益是否匹配。"@zh ;
    ash:ruleId "RSK-001" ;
    ash:ruleCategory "RSK 风险约束" ;
    ash:ruleDefinition "评估从计划入场价到合理失效位的潜在损失，与可解释目标区域的潜在收益是否匹配。"@zh ;
    ash:ruleScope "所有新开仓、加仓和策略切换。"@zh ;
    ash:rulePreconditions "有计划入场区、失效位、目标区间；目标价不能只用主观乐观预测；考虑跳空和流动性风险。"@zh ;
    ash:ruleInputData "计划价格、结构止损位、目标区域、ATR、历史波动、费用税费、可成交性。"@zh ;
    ash:ruleObservations "潜在收益/风险比；止损距离；目标可达性；胜率样本可信度；跳空损失；交易成本。"@zh ;
    ash:ruleTrigger "扣除费用后预期收益空间相对风险达到策略最低要求；同时目标与失效位有结构依据。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "目标区域阻力密集；止损过远；价格已大幅偏离合理入场；历史胜率来自小样本。"@zh ;
    ash:ruleVeto "无法定义失效位；无法估计可成交价格；盈亏比依赖无证据的远期目标。"@zh ;
    ash:ruleStateMachine "`UNASSESSED`→`PASS`/`FAIL`/`INSUFFICIENT_EVIDENCE`；价格变化后必须重算。"@zh ;
    ash:ruleNextActions "通过后交 RSK-002 风险预算；失败则等待更好价格或放弃。"@zh ;
    ash:ruleInvalidation "价格、目标或失效位改变；市场波动显著上升。"@zh ;
    ash:ruleParameters "最低盈亏比按策略类型设定并用样本期望值校验；不能统一要求所有策略固定 2:1。"@zh ;
    ash:ruleTypicalScenario "突破后距离失效位较近，目标区间有空间，费用后盈亏比仍符合策略门槛。"@zh ;
    ash:ruleCounterExample "目标价很远但没有历史/基本面依据，表面盈亏比极高。"@zh ;
    ash:ruleVerification "按盈亏比区间统计真实胜率、平均盈利/亏损和净期望，检查门槛是否有区分力。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "扣除费用后预期收益空间相对风险达到策略最低要求；同时目标与失效位有结构依据。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-rsk ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-rsk-001 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-rsk-002 .

ashd:rule-rsk-002
    a ash:DecisionRule, ash:RiskRule, ash:RuleArtifact ;
    rdfs:label "单笔风险预算"@zh, "Per-trade risk budget"@en ;
    rdfs:comment "限制单笔交易在计划失效情景下对账户净值造成的损失，仓位由风险预算和止损距离反推。"@zh ;
    ash:ruleId "RSK-002" ;
    ash:ruleCategory "RSK 风险约束" ;
    ash:ruleDefinition "限制单笔交易在计划失效情景下对账户净值造成的损失，仓位由风险预算和止损距离反推。"@zh ;
    ash:ruleScope "新开仓、加仓和持仓风险变化。"@zh ;
    ash:rulePreconditions "账户净值、可用资金、失效位和极端跳空假设可得；策略风险上限明确。"@zh ;
    ash:ruleInputData "账户权益、计划入场价、失效价、交易单位、费用税费、波动和流动性。"@zh ;
    ash:ruleObservations "计划损失占净值比例；同方向风险叠加；跳空损失；订单可执行性；账户可用资金。"@zh ;
    ash:ruleTrigger "根据风险预算计算最大允许股数，向下取整到交易单位；加仓后仍不得超过单笔/组合风险上限。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "止损位不可靠；股票可能连续跌停；流动性不足导致退出价格远差于计划。"@zh ;
    ash:ruleVeto "账户数据缺失；止损不可定义；仓位超过资金或风险上限；交易权限不足。"@zh ;
    ash:ruleStateMachine "`UNSIZED`→`SIZED`→`APPROVED`/`REJECTED`；价格或净值变化时重新计算。"@zh ;
    ash:ruleNextActions "将允许数量传递给订单模块；订单成交后以实际成交价重算风险。"@zh ;
    ash:ruleInvalidation "账户净值、价格、止损位或波动假设变化。"@zh ;
    ash:ruleParameters "单笔风险比例由用户/策略授权配置；文档不替用户设定具体账户风险百分比。"@zh ;
    ash:ruleTypicalScenario "同样风险额度下，止损距离越远，允许股数越少。"@zh ;
    ash:ruleCounterExample "固定买入 1000 股，不随波动和止损距离变化。"@zh ;
    ash:ruleVerification "回测账户级回撤、连续亏损、跳空损失和风险预算偏离率。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "根据风险预算计算最大允许股数，向下取整到交易单位；加仓后仍不得超过单笔/组合风险上限。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-rsk ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-rsk-002 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> .

ashd:rule-rsk-003
    a ash:DecisionRule, ash:RiskRule, ash:RuleArtifact ;
    rdfs:label "组合集中度"@zh, "Portfolio concentration"@en ;
    rdfs:comment "限制账户对单一股票、行业、主题、因子或高度相关风险的暴露，防止多个看似不同的持仓实际押注同一风险。"@zh ;
    ash:ruleId "RSK-003" ;
    ash:ruleCategory "RSK 风险约束" ;
    ash:ruleDefinition "限制账户对单一股票、行业、主题、因子或高度相关风险的暴露，防止多个看似不同的持仓实际押注同一风险。"@zh ;
    ash:ruleScope "全组合持仓和新开仓审批。"@zh ;
    ash:rulePreconditions "持仓证券分类、主题映射和相关性数据有时间戳；区分行业重叠与业务相关。"@zh ;
    ash:ruleInputData "持仓市值、净值、行业/主题、历史相关性、风险贡献、现金比例。"@zh ;
    ash:ruleObservations "单股权重；行业/主题总权重；相关性簇；共同事件风险；流动性集中度。"@zh ;
    ash:ruleTrigger "新交易使任一集中度超过策略上限，或多个持仓风险高度同向；限制新增或要求减仓评估。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "持仓虽同主题但驱动因素/期限不同；相关性在当前市场阶段显著下降（需谨慎验证）。"@zh ;
    ash:ruleVeto "分类缺失；组合市值或账户权益不完整。"@zh ;
    ash:ruleStateMachine "`WITHIN_LIMIT`→`NEAR_LIMIT`→`BREACH`→`REBALANCE_REQUIRED`。"@zh ;
    ash:ruleNextActions "新开仓审批拒绝/缩量；已有仓位按策略优先级和流动性制定调整顺序。"@zh ;
    ash:ruleInvalidation "持仓变化、相关性结构改变或主题分类更新。"@zh ;
    ash:ruleParameters "单股/行业/主题上限由账户配置；相关性使用滚动窗口并做压力情景测试。"@zh ;
    ash:ruleTypicalScenario "同时持有多只光模块、算力和通信设备股，实际高度暴露于同一 AI 资本开支周期。"@zh ;
    ash:ruleCounterExample "只按股票数量判断分散，持有十只同一主题股票仍高度集中。"@zh ;
    ash:ruleVerification "对比集中度限制前后的组合最大回撤、波动、收益和行业冲击损失。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "新交易使任一集中度超过策略上限，或多个持仓风险高度同向；限制新增或要求减仓评估。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-rsk ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-rsk-003 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> .

ashd:rule-rsk-004
    a ash:DecisionRule, ash:RiskRule, ash:RuleArtifact ;
    rdfs:label "连续亏损控制"@zh, "Consecutive-loss control"@en ;
    rdfs:comment "当策略或账户连续出现亏损、回撤扩大或交易质量下降时，降低风险暴露并检查策略是否失效。"@zh ;
    ash:ruleId "RSK-004" ;
    ash:ruleCategory "RSK 风险约束" ;
    ash:ruleDefinition "当策略或账户连续出现亏损、回撤扩大或交易质量下降时，降低风险暴露并检查策略是否失效。"@zh ;
    ash:ruleScope "单策略、单账户和整个模拟交易系统。"@zh ;
    ash:rulePreconditions "每笔交易有策略标签、净盈亏、费用和执行记录；区分随机亏损与规则/执行问题。"@zh ;
    ash:ruleInputData "连续亏损次数、滚动净值、策略期望、胜率、盈亏比、滑点/成交偏差（若模拟模型纳入）。"@zh ;
    ash:ruleObservations "连续亏损长度；滚动回撤；近期胜率/盈亏比偏离；亏损是否集中于同一市场状态；执行偏差。"@zh ;
    ash:ruleTrigger "达到策略设定的连续亏损或回撤阈值，进入降风险/暂停状态；单次亏损不自动证明策略失效。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "亏损在统计预期范围内；样本量不足；市场状态与策略适用环境不同。"@zh ;
    ash:ruleVeto "盈亏数据不完整；未扣除费用；重复订单被计为多笔独立交易。"@zh ;
    ash:ruleStateMachine "`NORMAL`→`CAUTION`→`RISK_REDUCED`→`PAUSED`→`REVIEW`→`REACTIVATED`。"@zh ;
    ash:ruleNextActions "暂停新增或降低单笔风险；EVA-005/006/007 分析；只有通过复核才恢复。"@zh ;
    ash:ruleInvalidation "达到恢复条件且策略有效性复核通过。"@zh ;
    ash:ruleParameters "连续亏损次数、回撤阈值、观察样本量按策略频率设定。"@zh ;
    ash:ruleTypicalScenario "策略在市场退潮期连续亏损，系统降风险并识别适用环境变化。"@zh ;
    ash:ruleCounterExample "两笔正常止损就永久停用策略；或连续亏损后反而加大仓位“回本”。"@zh ;
    ash:ruleVerification "回测暂停机制对最大回撤、恢复速度和长期收益的影响。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "达到策略设定的连续亏损或回撤阈值，进入降风险/暂停状态；单次亏损不自动证明策略失效。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-rsk ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-rsk-004 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-eva-005 ;
    ash:ruleNextRule ashd:rule-eva-006 .

ashd:rule-rsk-005
    a ash:DecisionRule, ash:RiskRule, ash:RuleArtifact ;
    rdfs:label "跳空风险"@zh, "Gap risk"@en ;
    rdfs:comment "评估隔夜事件、市场情绪和个股特征导致开盘价格越过计划止损/入场位的风险。"@zh ;
    ash:ruleId "RSK-005" ;
    ash:ruleCategory "RSK 风险约束" ;
    ash:ruleDefinition "评估隔夜事件、市场情绪和个股特征导致开盘价格越过计划止损/入场位的风险。"@zh ;
    ash:ruleScope "所有隔夜持仓、新开仓和重大事件前后。"@zh ;
    ash:rulePreconditions "记录持仓隔夜暴露；识别财报、政策、公告、海外市场等事件；明确 A 股涨跌停约束。"@zh ;
    ash:ruleInputData "历史跳空分布、公告日历、隔夜市场、竞价数据、涨跌停价格、持仓数量。"@zh ;
    ash:ruleObservations "历史跳空幅度和方向；事件重要性；流动性；竞价低开/高开；跌停可成交风险。"@zh ;
    ash:ruleTrigger "事件或历史分布显示跳空损失可能超出计划风险；降低隔夜暴露或提高风险等级。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "事件已充分披露且市场反应稳定；竞价供需改善；风险敞口较小。"@zh ;
    ash:ruleVeto "不能把止损单假设为一定按止损价成交；跌停/停牌时无法保证退出。"@zh ;
    ash:ruleStateMachine "`NORMAL_OVERNIGHT`→`GAP_WARNING`→`HIGH_GAP_RISK`→事件后重新评估。"@zh ;
    ash:ruleNextActions "联动 AUC-002/006、EVT、POS-006；对模拟账户按真实可交易规则处理未成交订单。"@zh ;
    ash:ruleInvalidation "风险事件窗口结束且价格/成交恢复正常。"@zh ;
    ash:ruleParameters "按个股跳空分位、事件类型、流动性和市场状态建立风险等级。"@zh ;
    ash:ruleTypicalScenario "业绩预告前持仓，可能出现超出日常波动的隔夜跳空。"@zh ;
    ash:ruleCounterExample "普通交易日小幅低开不应被当成重大跳空风险。"@zh ;
    ash:ruleVerification "统计止损价与实际可成交价偏差、隔夜最大不利跳空和风险预算超限频率。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "事件或历史分布显示跳空损失可能超出计划风险；降低隔夜暴露或提高风险等级。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-rsk ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-rsk-005 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-auc-002 ;
    ash:ruleNextRule ashd:rule-auc-006 ;
    ash:ruleNextRule ashd:rule-pos-006 .

ashd:rule-rsk-006
    a ash:DecisionRule, ash:RiskRule, ash:RuleArtifact ;
    rdfs:label "流动性风险"@zh, "Liquidity risk"@en ;
    rdfs:comment "评估目标仓位能否在合理时间和价格范围内建立/退出，防止信号正确但无法成交。"@zh ;
    ash:ruleId "RSK-006" ;
    ash:ruleCategory "RSK 风险约束" ;
    ash:ruleDefinition "评估目标仓位能否在合理时间和价格范围内建立/退出，防止信号正确但无法成交。"@zh ;
    ash:ruleScope "所有交易，尤其小市值、低成交额和异常波动股票。"@zh ;
    ash:rulePreconditions "明确计划订单规模；使用真实成交额、盘口深度或可得代理；区分正常日与极端日。"@zh ;
    ash:ruleInputData "成交额、换手率、盘口深度（若可得）、历史冲击、涨跌停、停牌状态、订单规模。"@zh ;
    ash:ruleObservations "订单规模占日均成交比例；成交连续性；买卖价差；盘口深度；极端行情流动性衰减。"@zh ;
    ash:ruleTrigger "计划仓位相对流动性过大，或近期成交异常萎缩；缩小仓位、分批执行或拒绝交易。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "流动性恢复且订单规模占比合理；有稳定成交深度。"@zh ;
    ash:ruleVeto "关键成交数据缺失；连续无量涨跌停；停牌或交易状态异常。"@zh ;
    ash:ruleStateMachine "`LIQUID`→`WATCH`→`CONSTRAINED`→`UNTRADABLE`；恢复需重新检查。"@zh ;
    ash:ruleNextActions "向订单模块输出最大参与比例/限价约束；不得把理论仓位当成可成交仓位。"@zh ;
    ash:ruleInvalidation "成交和盘口恢复；但极端行情假设仍需保留。"@zh ;
    ash:ruleParameters "订单参与率上限按策略与市场冲击测试设定；日均成交额窗口至少多窗口比较。"@zh ;
    ash:ruleTypicalScenario "计划买入金额占个股近期日均成交额比例过高，必须缩小或分批。"@zh ;
    ash:ruleCounterExample "日均成交额看似充足，但连续跌停时仍无法退出。"@zh ;
    ash:ruleVerification "模拟不同订单规模下成交率、平均成交价偏差和极端退出时间。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "计划仓位相对流动性过大，或近期成交异常萎缩；缩小仓位、分批执行或拒绝交易。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-rsk ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-rsk-006 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> .

ashd:rule-rsk-007
    a ash:DecisionRule, ash:RiskRule, ash:RuleArtifact ;
    rdfs:label "交易条件限制"@zh, "Trading-condition constraints"@en ;
    rdfs:comment "在下单前检查证券状态、交易日历、涨跌停、T+1、交易单位、账户资金和权限等制度性约束。"@zh ;
    ash:ruleId "RSK-007" ;
    ash:ruleCategory "RSK 风险约束" ;
    ash:ruleDefinition "在下单前检查证券状态、交易日历、涨跌停、T+1、交易单位、账户资金和权限等制度性约束。"@zh ;
    ash:ruleScope "所有真实/模拟 A 股订单；属于执行前硬校验。"@zh ;
    ash:rulePreconditions "证券主数据、交易所规则、交易日历和账户状态及时更新；区分沪深主板、创业板、科创板、北交所及风险警示股票规则。"@zh ;
    ash:ruleInputData "证券代码/板块、交易日期、停复牌、涨跌停价、可买卖数量、可用资金、最小申报单位、费用规则。"@zh ;
    ash:ruleObservations "是否交易日/交易时段；证券是否停牌；价格是否超限；当日买入数量是否可卖；资金和持仓是否足够；订单类型是否支持。"@zh ;
    ash:ruleTrigger "每笔订单提交前执行完整校验；任一硬约束不满足则拒单并给出明确原因。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "交易状态或账户数据更新后，重新校验通过。"@zh ;
    ash:ruleVeto "任何必要制度字段缺失或过期；不得默认放行。"@zh ;
    ash:ruleStateMachine "`PRECHECK`→`PASS`/`REJECTED`→`ORDER_SUBMITTED`→`PARTIAL/FILLED/CANCELED/REJECTED`。"@zh ;
    ash:ruleNextActions "拒单时不更新持仓；部分成交按实际成交数量更新；未成交订单继续管理。"@zh ;
    ash:ruleInvalidation "交易规则、账户或证券状态变化后必须重新校验。"@zh ;
    ash:ruleParameters "制度参数从权威交易所/券商规则配置，不在策略文件中硬编码长期固定值。"@zh ;
    ash:ruleTypicalScenario "当日买入股票因 T+1 不可卖；涨停价买入无卖盘导致订单未成交。"@zh ;
    ash:ruleCounterExample "模拟系统只按信号价直接记账，忽略涨跌停和交易时段。"@zh ;
    ash:ruleVerification "构造停牌、涨跌停、T+1、资金不足、非交易时段等测试用例，检查拒单率和状态一致性。 --- # 第八类：EVA 结果评估（8条） EVA 评估的对象包括规则、策略、决策和执行。评估必须保留当时可见信息，禁止用未来数据回填当时判断。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "每笔订单提交前执行完整校验；任一硬约束不满足则拒单并给出明确原因。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-rsk ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-rsk-007 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> .

ashd:rule-eva-001
    a ash:DecisionRule, ash:EvaluationRule, ash:RuleArtifact ;
    rdfs:label "买入判断验证"@zh, "Buy decision validation"@en ;
    rdfs:comment "检验买入决策在触发时是否具备有效证据，以及买入后价格路径是否符合原始假设。"@zh ;
    ash:ruleId "EVA-001" ;
    ash:ruleCategory "EVA 结果评估" ;
    ash:ruleDefinition "检验买入决策在触发时是否具备有效证据，以及买入后价格路径是否符合原始假设。"@zh ;
    ash:ruleScope "所有已执行和未执行的买入候选；必须区分信号正确性与成交结果。"@zh ;
    ash:rulePreconditions "保存决策时间、当时数据快照、规则状态、入场计划、失效位、目标和风险预算。"@zh ;
    ash:ruleInputData "信号快照、实际成交、后续 OHLC、费用、市场/板块状态、事件变化。"@zh ;
    ash:ruleObservations "信号后收益；MFE/MAE；止损是否触发；入场价格偏差；可成交率；原始 thesis 是否兑现。"@zh ;
    ash:ruleTrigger "每笔交易在预设观察期结束或退出后进入评估；未成交信号也要记录机会结果，但不能计入真实交易盈亏。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "盈利来自偶然跳空而非规则逻辑；亏损由执行错误而非信号错误造成。"@zh ;
    ash:ruleVeto "缺少决策时点快照；未来数据泄漏；成交记录不完整。"@zh ;
    ash:ruleStateMachine "`PENDING`→`OBSERVING`→`MATURED`→`ATTRIBUTED`。"@zh ;
    ash:ruleNextActions "归因至 OP/VP/AUC/MKT/EVT 规则，提供 EVA-003/004/007/008。"@zh ;
    ash:ruleInvalidation "观察期未结束或数据修订时重新计算并保留版本。"@zh ;
    ash:ruleParameters "观察窗口按策略持有周期设定；短线与趋势策略不可共用同一窗口。"@zh ;
    ash:ruleTypicalScenario "突破买入后 5 日内达到目标或跌破失效位，按原计划评估。"@zh ;
    ash:ruleCounterExample "只看最终是否赚钱，不分析入场时是否有证据、风险是否合理。"@zh ;
    ash:ruleVerification "计算胜率、平均盈亏、期望收益、MFE/MAE、执行偏差和不同市场状态下的稳定性。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "每笔交易在预设观察期结束或退出后进入评估；未成交信号也要记录机会结果，但不能计入真实交易盈亏。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-eva ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-eva-001 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-eva-003 ;
    ash:ruleNextRule ashd:rule-eva-004 .

ashd:rule-eva-002
    a ash:DecisionRule, ash:EvaluationRule, ash:RuleArtifact ;
    rdfs:label "卖出判断验证"@zh, "Sell decision validation"@en ;
    rdfs:comment "评估卖出/减仓是否在风险恶化或目标兑现时合理，以及退出后价格继续运行造成的机会成本。"@zh ;
    ash:ruleId "EVA-002" ;
    ash:ruleCategory "EVA 结果评估" ;
    ash:ruleDefinition "评估卖出/减仓是否在风险恶化或目标兑现时合理，以及退出后价格继续运行造成的机会成本。"@zh ;
    ash:ruleScope "止损、止盈、风险减仓、策略退出和人工干预。"@zh ;
    ash:rulePreconditions "记录卖出原因、规则触发、卖出计划、可卖数量和实际成交；区分主动退出与被动无法成交。"@zh ;
    ash:ruleInputData "卖出信号、持仓状态、实际成交、退出后价格、费用税费、市场状态。"@zh ;
    ash:ruleObservations "卖出后最大继续上涨空间；卖出前最大回撤；实际退出价与计划价差；是否遵守规则；卖出原因是否成立。"@zh ;
    ash:ruleTrigger "每次退出后进入评估；未成交退出计划需作为执行失败单独记录。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "退出后上涨不必然说明卖出错误；退出前已出现风险恶化，后续上涨可能是概率事件。"@zh ;
    ash:ruleVeto "未区分信号退出与交易限制；缺少后续价格路径。"@zh ;
    ash:ruleStateMachine "`EXIT_PENDING`→`EXITED`→`POST_EXIT_OBSERVING`→`ATTRIBUTED`。"@zh ;
    ash:ruleNextActions "反馈 POS-005/006/007、RSK-005/006 和执行模块。"@zh ;
    ash:ruleInvalidation "观察期未结束；数据或成交修订。"@zh ;
    ash:ruleParameters "退出后观察窗口按策略周期设置；统计机会成本但不据此简单否定纪律退出。"@zh ;
    ash:ruleTypicalScenario "结构破坏触发卖出，之后继续下跌，证明退出保护有效。"@zh ;
    ash:ruleCounterExample "卖出后股价反弹就认定卖出错误，忽略当时风险证据。"@zh ;
    ash:ruleVerification "统计退出后收益、回撤避免、卖飞率、执行偏差和净值保护贡献。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "每次退出后进入评估；未成交退出计划需作为执行失败单独记录。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-eva ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-eva-002 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-pos-005 ;
    ash:ruleNextRule ashd:rule-pos-006 ;
    ash:ruleNextRule ashd:rule-rsk-005 ;
    ash:ruleNextRule ashd:rule-rsk-006 .

ashd:rule-eva-003
    a ash:DecisionRule, ash:EvaluationRule, ash:RuleArtifact ;
    rdfs:label "突破成功率评估"@zh, "Breakout success evaluation"@en ;
    rdfs:comment "评估 OP-001/VP-001 所定义的突破在不同条件下是否具有统计优势。"@zh ;
    ash:ruleId "EVA-003" ;
    ash:ruleCategory "EVA 结果评估" ;
    ash:ruleDefinition "评估 OP-001/VP-001 所定义的突破在不同条件下是否具有统计优势。"@zh ;
    ash:ruleScope "所有突破信号实例；按市场、行业、流动性和突破类型分层。"@zh ;
    ash:rulePreconditions "突破定义和确认时点固定；样本包含失败案例；避免同一股票连续信号重复计数。"@zh ;
    ash:ruleInputData "突破信号、突破位、成交结构、市场状态、后续价格路径、交易成本。"@zh ;
    ash:ruleObservations "突破后达到目标比例；假突破率；突破后最大有利/不利波动；回踩成功率；信号间隔和样本独立性。"@zh ;
    ash:ruleTrigger "累计样本达到最低统计要求后计算；样本不足只报告观察值，不给稳定性结论。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "成功率提高但平均亏损扩大；只在单一牛市阶段有效；收益由少数极端样本贡献。"@zh ;
    ash:ruleVeto "未来函数、幸存者偏差、参数过拟合或样本标签不一致。"@zh ;
    ash:ruleStateMachine "`INSUFFICIENT_SAMPLE`→`EVALUATING`→`ROBUST/UNSTABLE/DEGRADED`。"@zh ;
    ash:ruleNextActions "反馈 OP-001 参数和策略启用条件；不得只按成功率选择规则。"@zh ;
    ash:ruleInvalidation "市场结构、交易制度或数据源变化导致历史表现不再适用。"@zh ;
    ash:ruleParameters "分层维度至少包括市场风险状态、流动性、板块强度和突破类型。"@zh ;
    ash:ruleTypicalScenario "放量平台突破在风险偏好较好时表现稳定，但在退潮期假突破率明显上升。"@zh ;
    ash:ruleCounterExample "整体成功率高，但失败时连续跌停导致损失远大于盈利。"@zh ;
    ash:ruleVerification "滚动样本外测试、置信区间、净期望、MFE/MAE、稳定性和容量测试。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "累计样本达到最低统计要求后计算；样本不足只报告观察值，不给稳定性结论。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-eva ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-eva-003 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-op-001 ;
    ash:ruleRelatedRule ashd:rule-vp-001 .

ashd:rule-eva-004
    a ash:DecisionRule, ash:EvaluationRule, ash:RuleArtifact ;
    rdfs:label "回踩成功率评估"@zh, "Pullback success evaluation"@en ;
    rdfs:comment "评估 OP-002 缩量回踩是否能识别有效支撑测试，以及回踩后的趋势恢复概率。"@zh ;
    ash:ruleId "EVA-004" ;
    ash:ruleCategory "EVA 结果评估" ;
    ash:ruleDefinition "评估 OP-002 缩量回踩是否能识别有效支撑测试，以及回踩后的趋势恢复概率。"@zh ;
    ash:ruleScope "突破后回踩、趋势中继回踩；不同前置结构分开统计。"@zh ;
    ash:rulePreconditions "回踩参考位、容差、回踩起点和确认标准事先定义；不得事后挑选最低点。"@zh ;
    ash:ruleInputData "突破/趋势信号、回踩深度、成交变化、板块状态、后续价格路径。"@zh ;
    ash:ruleObservations "支撑守住率；回踩后重新启动率；二次破位率；回踩持续时间；MAE/MFE。"@zh ;
    ash:ruleTrigger "回踩样本完成预设观察窗口后评估；尚未完成的样本保持 `PENDING`。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "成功率高但入场价格过差；只在少数热门板块有效；缩量指标对结果没有增量解释力。"@zh ;
    ash:ruleVeto "回踩样本定义不一致；同一波段多次重复计数；数据缺失。"@zh ;
    ash:ruleStateMachine "`PENDING`→`SUCCESS/FAILURE/AMBIGUOUS`→`AGGREGATED`。"@zh ;
    ash:ruleNextActions "调整 OP-002 的结构条件、观察窗和风险边界。"@zh ;
    ash:ruleInvalidation "市场制度或策略周期改变后重新分段评估。"@zh ;
    ash:ruleParameters "回踩深度、时间、成交收缩和板块状态分别分组。"@zh ;
    ash:ruleTypicalScenario "突破位附近缩量止跌并重新转强，定义为成功；有效跌破并延续下行定义为失败。"@zh ;
    ash:ruleCounterExample "价格短暂反弹后再次破位，却在反弹当天提前标记成功。"@zh ;
    ash:ruleVerification "样本外验证回踩规则对收益、回撤和入场成本的增量贡献。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "回踩样本完成预设观察窗口后评估；尚未完成的样本保持 `PENDING`。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-eva ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-eva-004 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-op-002 .

ashd:rule-eva-005
    a ash:DecisionRule, ash:EvaluationRule, ash:RuleArtifact ;
    rdfs:label "策略盈亏比评估"@zh, "Strategy reward-risk evaluation"@en ;
    rdfs:comment "评估策略真实平均盈利与平均亏损的比例，验证计划盈亏比是否在实际执行中兑现。"@zh ;
    ash:ruleId "EVA-005" ;
    ash:ruleCategory "EVA 结果评估" ;
    ash:ruleDefinition "评估策略真实平均盈利与平均亏损的比例，验证计划盈亏比是否在实际执行中兑现。"@zh ;
    ash:ruleScope "每个策略版本和独立策略组合。"@zh ;
    ash:rulePreconditions "交易归属策略唯一或按明确规则分配；净盈亏包含费用税费；部分成交和分批退出正确聚合。"@zh ;
    ash:ruleInputData "交易流水、成本、卖出回款、费用、税费、持仓周期、策略版本。"@zh ;
    ash:ruleObservations "平均盈利、平均亏损、盈亏比、中位数、尾部损失、极端盈利贡献、盈亏分布偏态。"@zh ;
    ash:ruleTrigger "达到样本量和观察期后计算；同时报告均值、中位数和分位数。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "高盈亏比但胜率过低；少数大赚掩盖大量小亏；尾部亏损失控。"@zh ;
    ash:ruleVeto "漏记费用；重复计数；未实现盈亏与已实现盈亏混用。"@zh ;
    ash:ruleStateMachine "`COLLECTING`→`SAMPLE_READY`→`EVALUATED`→`DEGRADED/ACCEPTABLE`。"@zh ;
    ash:ruleNextActions "与 EVA-006 期望收益联合判断，不单独据此优化策略。"@zh ;
    ash:ruleInvalidation "策略版本或市场状态改变后重新评估。"@zh ;
    ash:ruleParameters "按策略类型和市场状态分别计算；最低样本量通过统计功效分析设定。"@zh ;
    ash:ruleTypicalScenario "趋势策略胜率一般但平均盈利显著高于平均亏损，净期望仍为正。"@zh ;
    ash:ruleCounterExample "只报告最大盈利/最大亏损，忽略全部交易分布。"@zh ;
    ash:ruleVerification "滚动窗口、样本外测试、bootstrap 置信区间和尾部风险评估。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "达到样本量和观察期后计算；同时报告均值、中位数和分位数。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-eva ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-eva-005 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:ruleNextRule ashd:rule-eva-006 .

ashd:rule-eva-006
    a ash:DecisionRule, ash:EvaluationRule, ash:RuleArtifact ;
    rdfs:label "策略期望收益评估"@zh, "Strategy expected return evaluation"@en ;
    rdfs:comment "估计策略每笔交易的长期平均净收益，并判断其是否在扣除成本、风险和容量约束后仍具优势。"@zh ;
    ash:ruleId "EVA-006" ;
    ash:ruleCategory "EVA 结果评估" ;
    ash:ruleDefinition "估计策略每笔交易的长期平均净收益，并判断其是否在扣除成本、风险和容量约束后仍具优势。"@zh ;
    ash:ruleScope "所有策略、规则组合和策略版本。"@zh ;
    ash:rulePreconditions "交易样本、成本模型和执行模拟可信；策略信号不使用未来数据；训练/验证/测试时间段严格分离。"@zh ;
    ash:ruleInputData "胜率、平均盈利、平均亏损、费用税费、交易频率、回撤、资金占用、成交容量。"@zh ;
    ash:ruleObservations "单笔净期望；年化/周期收益；回撤；收益波动；资金占用；不同市场状态表现；容量衰减。"@zh ;
    ash:ruleTrigger "在足够样本和样本外测试后计算；净期望置信区间、风险和容量均需报告。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "样本内表现好但样本外失效；收益依赖少数极端行情；扩大资金后收益快速衰减。"@zh ;
    ash:ruleVeto "未来函数、幸存者偏差、参数过拟合、交易成本低估。"@zh ;
    ash:ruleStateMachine "`RESEARCH`→`BACKTESTED`→`OUT_OF_SAMPLE`→`PAPER_TRADING`→`APPROVED/REJECTED/REVIEW`。"@zh ;
    ash:ruleNextActions "决定策略是否进入模拟运行、风险预算和观察名单；实盘授权必须独立审批。"@zh ;
    ash:ruleInvalidation "滚动期望显著下降、市场结构变化或执行容量不再成立。"@zh ;
    ash:ruleParameters "使用滚动样本、walk-forward 和压力测试；阈值由策略目标和账户风险偏好确定。"@zh ;
    ash:ruleTypicalScenario "策略样本外仍有正净期望，且最大回撤、成交容量在约束内。"@zh ;
    ash:ruleCounterExample "回测收益很高，但手续费、涨跌停无法成交和未来函数未处理。"@zh ;
    ash:ruleVerification "时间序列样本外、不同市场阶段、成本敏感性、参数扰动、容量与极端情景测试。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "在足够样本和样本外测试后计算；净期望置信区间、风险和容量均需报告。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-eva ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-eva-006 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> .

ashd:rule-eva-007
    a ash:DecisionRule, ash:EvaluationRule, ash:RuleArtifact ;
    rdfs:label "失败案例归因"@zh, "Failure attribution"@en ;
    rdfs:comment "将失败交易拆解为信号识别、证据质量、市场环境、事件理解、风险控制、执行和数据问题，避免简单归咎于“市场不好”。"@zh ;
    ash:ruleId "EVA-007" ;
    ash:ruleCategory "EVA 结果评估" ;
    ash:ruleDefinition "将失败交易拆解为信号识别、证据质量、市场环境、事件理解、风险控制、执行和数据问题，避免简单归咎于“市场不好”。"@zh ;
    ash:ruleScope "亏损交易、错过交易、异常盈利和规则冲突案例。"@zh ;
    ash:rulePreconditions "保留决策链、数据快照、Agent 观点、规则触发和订单日志；区分当时可知与事后信息。"@zh ;
    ash:ruleInputData "信号记录、证据引用、反向观点、审批结果、订单/成交、后续行情和事件。"@zh ;
    ash:ruleObservations "是否遵循规则；关键证据是否错误；是否忽略反向证据；风险预算是否合理；是否发生执行偏差；是否属于正常概率损失。"@zh ;
    ash:ruleTrigger "交易退出或观察期结束后进行归因；重大异常交易优先复盘。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "亏损虽发生但过程符合策略预期，属于正常分布；盈利也可能是运气而非正确决策。"@zh ;
    ash:ruleVeto "缺少原始日志；使用事后信息伪造当时推理；把所有亏损都归为模型错误。"@zh ;
    ash:ruleStateMachine "`UNREVIEWED`→`EVIDENCE_COLLECTED`→`CAUSE_CLASSIFIED`→`ACTION_ASSIGNED`→`CLOSED`。"@zh ;
    ash:ruleNextActions "将问题映射到具体规则/参数/数据源/执行模块；形成可验证的改进任务。"@zh ;
    ash:ruleInvalidation "新证据出现时允许修订归因，但保留旧版本和变更理由。"@zh ;
    ash:ruleParameters "归因分类采用统一标签；每笔交易允许多因归因，但指定主因与次因。"@zh ;
    ash:ruleTypicalScenario "突破信号有效，但因追入过晚导致盈亏比不合格，归因为入场位置/风险过滤，而非突破规则本身。"@zh ;
    ash:ruleCounterExample "股票下跌就把原因归为“市场情绪差”，不检查买入时是否忽略了放量滞涨。"@zh ;
    ash:ruleVerification "统计各类失败原因频率、损失贡献和整改后复发率。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "交易退出或观察期结束后进行归因；重大异常交易优先复盘。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
    ash:ruleStatus "active" ;
    ash:ruleVersion "2.0.0" ;
    ash:ruleOwner "投资决策委员会" ;
    ash:severity "info" ;
    ash:ruleEffectiveFrom "2026-11-05"^^xsd:date ;
    ash:ruleBasis "Issue #25 A股投资决策规则库 V2.0；阈值为待回测初始参数" ;
    ash:appliesTo ash:AShare ;
    ash:belongsToRuleCategory ashd:category-eva ;
    ash:usesRuleStateMachine ashd:state-machine-unified ;
    ash:hasRuleParameter ashd:parameter-eva-007 ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> .

ashd:rule-eva-008
    a ash:DecisionRule, ash:EvaluationRule, ash:RuleArtifact ;
    rdfs:label "规则有效性监测"@zh, "Rule effectiveness monitoring"@en ;
    rdfs:comment "持续监测单条规则的触发频率、预测能力、收益贡献、稳定性和数据依赖，识别规则衰减、过拟合或市场环境变化。"@zh ;
    ash:ruleId "EVA-008" ;
    ash:ruleCategory "EVA 结果评估" ;
    ash:ruleDefinition "持续监测单条规则的触发频率、预测能力、收益贡献、稳定性和数据依赖，识别规则衰减、过拟合或市场环境变化。"@zh ;
    ash:ruleScope "全部 60 条规则及其参数版本。"@zh ;
    ash:rulePreconditions "规则版本化；每次运行保存输入数据、输出状态和后续结果；有足够样本和监测窗口。"@zh ;
    ash:ruleInputData "规则触发日志、样本结果、参数版本、数据质量、市场状态、策略表现。"@zh ;
    ash:ruleObservations "触发率变化；命中率/误报率；净期望；样本外表现；市场状态敏感性；数据缺失率；规则间冲突率。"@zh ;
    ash:ruleTrigger "滚动表现显著偏离历史基线、数据质量恶化或规则冲突增加时，标记 `DEGRADING` 并启动复核。"@zh ;
    ash:ruleSupportingEvidence "触发条件中列出的支持条件；支持证据只增强可信度，不单独触发。" ;
    ash:ruleContraryEvidence "短期波动处于统计区间；样本量不足；市场状态暂时不适用该规则。"@zh ;
    ash:ruleVeto "样本量不足却强行停用；参数调整后不保留旧版本；只监控盈利不监控风险。"@zh ;
    ash:ruleStateMachine "`ACTIVE`→`MONITORING`→`WARNING`→`DEGRADING`→`SUSPENDED/RECALIBRATING`→`ACTIVE`。"@zh ;
    ash:ruleNextActions "冻结版本、开展样本外复测、审查数据源与适用环境；只有通过验证才能重新启用。"@zh ;
    ash:ruleInvalidation "市场制度、数据口径、参与者结构或规则前提变化，旧规则不再适用。"@zh ;
    ash:ruleParameters "监测窗口按触发频率设定；使用控制图/滚动分位/置信区间，不以单次亏损触发停用。"@zh ;
    ash:ruleTypicalScenario "某突破规则过去在趋势市有效，近期在震荡市误报率上升，系统将其限定到适用环境。"@zh ;
    ash:ruleCounterExample "连续两笔亏损就修改参数，造成追逐历史噪声。"@zh ;
    ash:ruleVerification "版本对照、样本外复测、参数敏感性、规则停用/恢复前后表现和漂移检测。 --- # 9. 规则关系与调用顺序 ## 9.1 非持仓买入主流程 1. **市场准入**：MKT-001、MKT-002 判断市场风险和情绪状态。 2. **机会发现**：OP-001 至 OP-010 识别价格结构；EVT-001 至 EVT-004 识别事件机会。 3. **板块定位**：MKT-003/004/005/006 判断板块启动、持续性和个股位置。 4. **证据验证**：VP-001 至 VP-008 检查量价支持/反向证据；AUC-001 至 AUC-006 仅在竞价时段提供开盘证据。 5. **反向审查**：检查 VP-003/005/008、MKT-007、EVT-005/006 等否定证据。 6. **风险审批**：RSK-001 盈亏比 → RSK-002 风险预算 → RSK-003 集中度 → RSK-005/006/007 执行条件。 7. **授权与下单**：只有满足交易授权和制度校验后才进入模拟订单模块。 8. **结果反馈**：EVA-001/003/004/005/006/007/008。 ## 9.2 持仓管理主流程 1. POS-001 检查原始逻辑是否延续。 2. POS-003 区分正常回调；POS-002 处理趋势加速。 3. POS-004 识别高位分歧；POS-005 识别趋势衰竭；POS-006 识别结构失效。 4. POS-007 分批止盈；POS-008 只有在新证据与风险审批通过时加仓。 5. RSK-002/003/005/006/007 对所有动作拥有否决权。 6. EVA-002/005/006/007/008 对退出和策略表现进行复核。 ## 9.3 规则关系类型 - **前置（PRECONDITION）**：规则 A 未成立时，规则 B 不允许确认。例如 OP-004 平台整理可作为 OP-001 突破的结构前置。 - **支持（SUPPORTS）**：增加证据可信度，但不单独触发。例如 VP-001 支持 OP-001。 - **冲突（CONFLICTS）**：存在相反证据，暂停升级。例如 OP-001 突破触发但 VP-003 放量滞涨。 - **否决（VETOES）**：硬约束优先级最高。例如 RSK-007 拒绝交易。 - **后续（FOLLOWED_BY）**：触发后必须继续检查。例如 OP-001 确认后进入 RSK-001。 - **评估（EVALUATED_BY）**：规则结果由 EVA 规则验证。 ## 9.4 关键防重复设计 - OP-001 是“突破机会结构”；VP-001 是“突破时成交参与证据”。两者不是重复规则。 - OP-002 是“趋势回踩机会”；VP-004 是“回落期间成交收缩证据”。缩量下跌本身不是买入信号。 - OP-005 是“底部反转结构”；VP-006 是“低位成交扩张现象”。低位放量不等于底部完成。 - OP-009 是“分歧转一致的价格结构”；AUC-005 是“竞价路径由弱转强的开盘前证据”。 - OP-010 是“个股相对表现由弱转强”；AUC-001/003 只能提供竞价层支持。 - POS-005 是持仓趋势质量衰减；VP-003/008 是其可能使用的量价证据。 - RSK 规则是约束层，不与机会规则做加权抵消。硬风险不能被多个看多信号抵消。 --- # 10. 规则引擎执行与数据结构建议 ## 10.1 单次规则运行记录 ```json {   \"rule_id\": \"OP-001\",   \"rule_version\": \"2.0.0\",   \"security_id\": \"600000.SH\",   \"as_of\": \"2026-11-05T15:05:00+08:00\",   \"timeframe\": \"1d\",   \"position_state\": \"FLAT\",   \"state\": \"CANDIDATE\",   \"trigger_evidence\": [],   \"supporting_evidence\": [],   \"contrary_evidence\": [],   \"missing_data\": [],   \"parameters_version\": \"OP-001-cn-equity-2026-01\",   \"valid_until\": \"2026-11-07T15:00:00+08:00\",   \"next_actions\": [\"VP-001\", \"MKT-001\", \"RSK-001\"],   \"source_refs\": [] } ``` ## 10.2 规则版本管理 每次修改必须记录： - 规则版本、修改时间、修改人/Agent。 - 修改原因和所依据的样本。 - 修改前后触发条件差异。 - 历史回测与样本外表现。 - 是否影响已有持仓和正在运行的策略。 - 回滚版本与回滚条件。 禁止静默修改规则阈值。策略运行时必须固定规则版本，避免同一笔交易中途改变判断标准。 ## 10.3 规则冲突处理优先级 1. 数据完整性和交易制度硬约束。 2. 账户风险预算与组合风险约束。 3. 原始交易逻辑是否被否定。 4. 市场环境和板块风险。 5. 个股机会结构。 6. 量价、竞价和事件支持证据。 7. 模型观点、语言解释和主观置信度。 多个 Agent 意见不一致时，不采用简单多数投票。应检查证据来源、时间、独立性、可验证性和适用条件；同一新闻的多个转载不能算多份独立证据。 ## 10.4 A股执行层必须单独实现 以下内容属于交易执行/账户约束，不是技术信号： - 交易日历、交易时段、集合竞价与连续竞价阶段。 - 不同板块/证券类别的涨跌幅限制和申报规则。 - T+1 可卖数量、当日买入冻结数量。 - 停牌、退市整理、风险警示、临时停牌等状态。 - 交易单位、最小价格变动单位、订单类型。 - 资金可用、持仓可用、手续费、印花税及其他费用。 - 涨跌停无对手盘、部分成交、撤单失败、订单超时。 - 真实行情时间戳、延迟、复权口径和数据供应商故障。 模拟交易必须以订单和成交事件更新账户，不能在规则触发时直接假设成交。 --- # 11. 回测与验收标准 ## 11.1 每条规则最低验收项目 - **定义一致性**：不同运行实例对同一输入是否产生一致状态。 - **数据正确性**：数据字段、单位、时间戳、复权口径是否正确。 - **时间因果性**：规则触发时只使用当时可获得的信息。 - **反向证据**：是否能识别并记录反例，而非只找支持证据。 - **样本外稳定性**：不同年份、市场阶段和股票分层下是否仍有效。 - **可执行性**：信号产生时是否有真实可成交价格和合理流动性。 - **风险结果**：最大不利波动、跳空损失和组合回撤是否可接受。 - **增量价值**：该规则是否比已有规则/简单基线带来额外解释力或收益改善。 ## 11.2 评估指标 | 指标 | 含义 | 注意事项 | |---|---|---| | 胜率 | 盈利交易数/有效交易数 | 不能脱离盈亏比 | | 平均盈利/平均亏损 | 盈亏幅度结构 | 必须扣费 | | 净期望 | 单笔平均净收益 | 需要样本外检验 | | MFE | 持仓期间最大有利波动 | 用于评估目标与止盈 | | MAE | 持仓期间最大不利波动 | 用于评估止损与仓位 | | 假信号率 | 触发后未达到规则目标的比例 | 目标和观察窗须预先定义 | | 可成交率 | 信号产生后实际可按模型成交的比例 | 涨跌停和流动性必须纳入 | | 最大回撤 | 净值峰谷最大跌幅 | 组合层面关键指标 | | 参数稳定性 | 参数微调后结果是否剧烈变化 | 防止过拟合 | | 样本外表现 | 未参与调参的数据表现 | 作为上线主要依据之一 | ## 11.3 建议验证流程 1. **规则单测**：人为构造典型场景、反例、边界值和缺失数据。 2. **历史回放**：按当时可见数据逐日/逐分钟重放，禁止未来函数。 3. **样本内研究**：只用于形成假设和参数候选。 4. **样本外验证**：时间切分，参数冻结。 5. **滚动前推（Walk-forward）**：定期重估，但不回写历史结果。 6. **模拟盘观察**：真实行情、真实交易时段、模拟订单撮合。 7. **漂移监控**：监控触发频率、误报率、净期望和数据源变化。 8. **人工复核**：重大规则变更先审查，不能自动把短期盈利当作升级依据。 --- # 12. 当前版本的明确边界与下一阶段工作 本版本提供 60 条规则的完整业务规范和初始判断框架，但**尚不代表所有阈值已通过历史回测**。尤其以下部分必须通过真实数据验收后才能进入自动化执行： 1. 猫爪数据等供应商的字段口径、历史覆盖、更新延迟和缺失率。 2. 竞价数据是否能提供逐时点路径，能否区分成交、未匹配量变化和撤单。 3. 主题/行业历史成分是否可回溯，避免未来成分偏差。 4. 涨跌停、停牌、T+1 和订单撮合模拟是否与交易所制度一致。 5. 各规则参数按股票流动性、波动率、板块和市场状态分层校准。 6. 规则之间的冲突、重复触发和状态迁移需要通过历史回放验证。 7. 策略的胜率、盈亏比和期望收益必须来自样本外/模拟盘结果，不允许由规则描述本身推定。"@zh ;
    ash:ruleConfidenceBasis "数据完整性、证据独立性、历史样本表现；不能用模型主观确信代替。" ;
    ash:ruleIf "滚动表现显著偏离历史基线、数据质量恶化或规则冲突增加时，标记 `DEGRADING` 并启动复核。"@zh ;
    ash:ruleThen "输出状态、证据、适用边界、后续动作与置信度依据；不直接生成交易指令。" ;
