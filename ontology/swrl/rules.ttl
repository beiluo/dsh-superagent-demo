    ash:transitionOfMachine ashd:state-machine-unified ;
    ash:transitionFrom ashd:state-watching ;
    ash:transitionTo ashd:state-conflicted ;
    ash:transitionKind "conflict" ;
    ash:transitionCondition "出现与形态相反的证据。" .

ashd:state-transition-conflict-candidate
    a owl:NamedIndividual, ash:RuleStateTransition ;
    rdfs:label "CANDIDATE → CONFLICTED"@zh, "CANDIDATE to CONFLICTED"@en ;
    rdfs:comment "确认前出现强反向证据。"@zh ;
    ash:transitionOfMachine ashd:state-machine-unified ;
    ash:transitionFrom ashd:state-candidate ;
    ash:transitionTo ashd:state-conflicted ;
    ash:transitionKind "conflict" ;
    ash:transitionCondition "确认前出现强反向证据。" .

ashd:state-transition-conflict-triggered
    a owl:NamedIndividual, ash:RuleStateTransition ;
    rdfs:label "TRIGGERED → CONFLICTED"@zh, "TRIGGERED to CONFLICTED"@en ;
    rdfs:comment "触发后出现强反向证据，暂停升级。"@zh ;
    ash:transitionOfMachine ashd:state-machine-unified ;
    ash:transitionFrom ashd:state-triggered ;
    ash:transitionTo ashd:state-conflicted ;
    ash:transitionKind "conflict" ;
    ash:transitionCondition "触发后出现强反向证据，暂停升级。" .

ashd:state-transition-conflict-confirmed
    a owl:NamedIndividual, ash:RuleStateTransition ;
    rdfs:label "CONFIRMED → CONFLICTED"@zh, "CONFIRMED to CONFLICTED"@en ;
    rdfs:comment "确认后反向证据破坏原判断。"@zh ;
    ash:transitionOfMachine ashd:state-machine-unified ;
    ash:transitionFrom ashd:state-confirmed ;
    ash:transitionTo ashd:state-conflicted ;
    ash:transitionKind "conflict" ;
    ash:transitionCondition "确认后反向证据破坏原判断。" .

ashd:state-transition-resolve-conflict
    a owl:NamedIndividual, ash:RuleStateTransition ;
    rdfs:label "CONFLICTED → CANDIDATE"@zh, "CONFLICTED to CANDIDATE"@en ;
