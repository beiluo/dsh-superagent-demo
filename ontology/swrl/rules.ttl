ashd:convention-dq-price
    a owl:NamedIndividual, ash:DataQualityConvention ;
    rdfs:label "价格口径统一"@zh, "Data quality convention DQ-PRICE"@en ;
    rdfs:comment "同一规则内统一前复权、后复权或不复权口径；交易执行价必须使用真实未复权价格，趋势研究可使用复权序列但需记录口径。"@zh ;
    ash:conventionCode "DQ-PRICE" ;
    ash:conventionRequirement "同一规则内统一前复权、后复权或不复权口径；交易执行价必须使用真实未复权价格，趋势研究可使用复权序列但需记录口径。" ;
    ash:conventionAppliesTo ashd:rule-library-v2 .

ashd:convention-dq-volume
    a owl:NamedIndividual, ash:DataQualityConvention ;
    rdfs:label "成交口径统一"@zh, "Data quality convention DQ-VOLUME"@en ;
    rdfs:comment "成交额、成交量和换手率的来源、单位、是否包含集合竞价必须明确；跨数据源不直接拼接。"@zh ;
    ash:conventionCode "DQ-VOLUME" ;
    ash:conventionRequirement "成交额、成交量和换手率的来源、单位、是否包含集合竞价必须明确；跨数据源不直接拼接。" ;
    ash:conventionAppliesTo ashd:rule-library-v2 .

ashd:convention-dq-time
    a owl:NamedIndividual, ash:DataQualityConvention ;
    rdfs:label "时间口径统一"@zh, "Data quality convention DQ-TIME"@en ;
    rdfs:comment "日线信号在收盘后确认；盘中信号标记为临时状态；集合竞价、连续竞价和收盘后数据不混用。"@zh ;
    ash:conventionCode "DQ-TIME" ;
    ash:conventionRequirement "日线信号在收盘后确认；盘中信号标记为临时状态；集合竞价、连续竞价和收盘后数据不混用。" ;
    ash:conventionAppliesTo ashd:rule-library-v2 .

ashd:convention-dq-cross-section
    a owl:NamedIndividual, ash:DataQualityConvention ;
    rdfs:label "横截面比较"@zh, "Data quality convention DQ-CROSS-SECTION"@en ;
    rdfs:comment "个股相对强弱必须与同一交易日、同一市场范围和合理行业或主题样本比较。"@zh ;
    ash:conventionCode "DQ-CROSS-SECTION" ;
    ash:conventionRequirement "个股相对强弱必须与同一交易日、同一市场范围和合理行业或主题样本比较。" ;
    ash:conventionAppliesTo ashd:rule-library-v2 .

ashd:convention-dq-missing
    a owl:NamedIndividual, ash:DataQualityConvention ;
    rdfs:label "数据缺失"@zh, "Data quality convention DQ-MISSING"@en ;
    rdfs:comment "关键输入缺失时输出 DATA_INSUFFICIENT，不得把缺失解释为没有风险或没有信号。"@zh ;
    ash:conventionCode "DQ-MISSING" ;
    ash:conventionRequirement "关键输入缺失时输出 DATA_INSUFFICIENT，不得把缺失解释为没有风险或没有信号。" ;
    ash:conventionAppliesTo ashd:rule-library-v2 .

ashd:convention-dq-event-dedup
    a owl:NamedIndividual, ash:DataQualityConvention ;
    rdfs:label "事件去重"@zh, "Data quality convention DQ-EVENT-DEDUP"@en ;
    rdfs:comment "同一公告或新闻的转载、快讯和媒体解读关联到同一事件实体，避免重复计数。"@zh ;
    ash:conventionCode "DQ-EVENT-DEDUP" ;
    ash:conventionRequirement "同一公告或新闻的转载、快讯和媒体解读关联到同一事件实体，避免重复计数。" ;
    ash:conventionAppliesTo ashd:rule-library-v2 .

ashd:convention-dq-survivorship
    a owl:NamedIndividual, ash:DataQualityConvention ;
    rdfs:label "幸存者偏差"@zh, "Data quality convention DQ-SURVIVORSHIP"@en ;
    rdfs:comment "历史回测必须包含退市、停牌、风险警示和历史成分变更，不能只用当前上市股票回测。"@zh ;
    ash:conventionCode "DQ-SURVIVORSHIP" ;
    ash:conventionRequirement "历史回测必须包含退市、停牌、风险警示和历史成分变更，不能只用当前上市股票回测。" ;
    ash:conventionAppliesTo ashd:rule-library-v2 .

ashd:parameter-op-001
    a owl:NamedIndividual, ash:RuleParameter ;
    rdfs:label "OP-001 参数占位"@zh, "OP-001 parameter placeholder"@en ;
    rdfs:comment "OP-001 的初始参数占位：待回测，不是已证明有效的最优值。"@zh ;
    ash:parameterName "OP-001 初始参数" ;
    ash:parameterInitialRange "整理观察窗 10–30 个交易日；突破容差可用 0.1–0.3 ATR；成交额比较整理期中位数；收盘位置可观察振幅上部 60%–70%。所有阈值按流动性分层校准。"@zh ;
    ash:parameterStatus "initial" ;
    ash:parameterNote "待回测（未验证）；不得把初始阈值当作收益承诺或生产参数。" ;
    ash:parameterVersion "OP-001-cn-equity-2026-01" ;
    ash:parameterCalibration "按流动性、波动率、板块和市场状态分层校准。" ;
    ash:parameterOfRule ashd:rule-op-001 .

