ashd:state-not-observed
    a owl:NamedIndividual, ash:RuleState ;
    rdfs:label "未观察"@zh, "Not observed"@en ;
    rdfs:comment "未进入观察范围。"@zh ;
    ash:stateCode "NOT_OBSERVED" ;
    ash:stateDescription "未进入观察范围。" ;
    ash:stateOrder 1 ;
    ash:stateTerminal false .

ashd:state-watching
    a owl:NamedIndividual, ash:RuleState ;
    rdfs:label "观察中"@zh, "Watching"@en ;
    rdfs:comment "形态初步出现，继续收集证据。"@zh ;
    ash:stateCode "WATCHING" ;
    ash:stateDescription "形态初步出现，继续收集证据。" ;
    ash:stateOrder 2 ;
    ash:stateTerminal false .

ashd:state-candidate
    a owl:NamedIndividual, ash:RuleState ;
    rdfs:label "候选"@zh, "Candidate"@en ;
    rdfs:comment "核心条件基本具备，等待关键确认。"@zh ;
    ash:stateCode "CANDIDATE" ;
    ash:stateDescription "核心条件基本具备，等待关键确认。" ;
    ash:stateOrder 3 ;
    ash:stateTerminal false .

ashd:state-triggered
    a owl:NamedIndividual, ash:RuleState ;
    rdfs:label "触发"@zh, "Triggered"@en ;
    rdfs:comment "规则触发条件在规定周期内满足。"@zh ;
    ash:stateCode "TRIGGERED" ;
    ash:stateDescription "规则触发条件在规定周期内满足。" ;
    ash:stateOrder 4 ;
    ash:stateTerminal false .

ashd:state-confirmed
    a owl:NamedIndividual, ash:RuleState ;
    rdfs:label "确认"@zh, "Confirmed"@en ;
    rdfs:comment "后续价格、成交或事件证据确认，允许进入下一层评估。"@zh ;
    ash:stateCode "CONFIRMED" ;
    ash:stateDescription "后续价格、成交或事件证据确认，允许进入下一层评估。" ;
    ash:stateOrder 5 ;
    ash:stateTerminal false .

ashd:state-conflicted
    a owl:NamedIndividual, ash:RuleState ;
    rdfs:label "冲突"@zh, "Conflicted"@en ;
    rdfs:comment "同时存在强反向证据，必须暂停升级。"@zh ;
    ash:stateCode "CONFLICTED" ;
    ash:stateDescription "同时存在强反向证据，必须暂停升级。" ;
    ash:stateOrder 6 ;
    ash:stateTerminal false .

ashd:state-invalidated
    a owl:NamedIndividual, ash:RuleState ;
    rdfs:label "失效"@zh, "Invalidated"@en ;
    rdfs:comment "关键结构或逻辑被破坏；重新出现时建立新的信号实例。"@zh ;
    ash:stateCode "INVALIDATED" ;
    ash:stateDescription "关键结构或逻辑被破坏；重新出现时建立新的信号实例。" ;
    ash:stateOrder 7 ;
    ash:stateTerminal true .

ashd:state-expired
    a owl:NamedIndividual, ash:RuleState ;
    rdfs:label "过期"@zh, "Expired"@en ;
    rdfs:comment "超过有效期，信号不再有效。"@zh ;
    ash:stateCode "EXPIRED" ;
    ash:stateDescription "超过有效期，信号不再有效。" ;
    ash:stateOrder 8 ;
    ash:stateTerminal true .

ashd:state-data-insufficient
    a owl:NamedIndividual, ash:RuleState ;
    rdfs:label "数据不足"@zh, "Data insufficient"@en ;
    rdfs:comment "关键数据不足或口径不一致；不得把缺失解释为没有风险或没有信号。"@zh ;
    ash:stateCode "DATA_INSUFFICIENT" ;
    ash:stateDescription "关键数据不足或口径不一致；不得把缺失解释为没有风险或没有信号。" ;
    ash:stateOrder 9 ;
    ash:stateTerminal false .

ashd:state-machine-unified
    a owl:NamedIndividual, ash:RuleStateMachine ;
    rdfs:label "统一规则状态机"@zh, "Unified rule state machine"@en ;
    rdfs:comment "所有 60 条规则共享的状态机：状态迁移必须保留时间戳、触发证据、反向证据和数据版本；不能无依据地从失效回到确认。"@zh ;
    ash:transitionOfMachine ashd:state-machine-unified ;
    ash:hasRuleState ashd:state-not-observed ;
    ash:hasRuleState ashd:state-watching ;
    ash:hasRuleState ashd:state-candidate ;
    ash:hasRuleState ashd:state-triggered ;
    ash:hasRuleState ashd:state-confirmed ;
    ash:hasRuleState ashd:state-conflicted ;
    ash:hasRuleState ashd:state-invalidated ;
    ash:hasRuleState ashd:state-expired ;
    ash:hasRuleState ashd:state-data-insufficient .

ashd:state-transition-start
    a owl:NamedIndividual, ash:RuleStateTransition ;
    rdfs:label "NOT_OBSERVED → WATCHING"@zh, "NOT_OBSERVED to WATCHING"@en ;
    rdfs:comment "规则进入观察范围并有初步形态。"@zh ;
    ash:transitionOfMachine ashd:state-machine-unified ;
    ash:transitionFrom ashd:state-not-observed ;
    ash:transitionTo ashd:state-watching ;
    ash:transitionKind "normal" ;
    ash:transitionCondition "规则进入观察范围并有初步形态。" .

ashd:state-transition-observe
    a owl:NamedIndividual, ash:RuleStateTransition ;
    rdfs:label "WATCHING → CANDIDATE"@zh, "WATCHING to CANDIDATE"@en ;
    rdfs:comment "核心条件基本具备，等待关键确认。"@zh ;
    ash:transitionOfMachine ashd:state-machine-unified ;
    ash:transitionFrom ashd:state-watching ;
    ash:transitionTo ashd:state-candidate ;
    ash:transitionKind "normal" ;
    ash:transitionCondition "核心条件基本具备，等待关键确认。" .

ashd:state-transition-trigger
    a owl:NamedIndividual, ash:RuleStateTransition ;
    rdfs:label "CANDIDATE → TRIGGERED"@zh, "CANDIDATE to TRIGGERED"@en ;
    rdfs:comment "触发条件在规定周期内满足。"@zh ;
    ash:transitionOfMachine ashd:state-machine-unified ;
    ash:transitionFrom ashd:state-candidate ;
    ash:transitionTo ashd:state-triggered ;
    ash:transitionKind "normal" ;
    ash:transitionCondition "触发条件在规定周期内满足。" .

ashd:state-transition-confirm
    a owl:NamedIndividual, ash:RuleStateTransition ;
    rdfs:label "TRIGGERED → CONFIRMED"@zh, "TRIGGERED to CONFIRMED"@en ;
    rdfs:comment "后续价格、成交或事件证据确认。"@zh ;
    ash:transitionOfMachine ashd:state-machine-unified ;
    ash:transitionFrom ashd:state-triggered ;
    ash:transitionTo ashd:state-confirmed ;
