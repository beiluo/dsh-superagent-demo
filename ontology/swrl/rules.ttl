    ash:transitionCondition "后续价格、成交或事件证据确认。" .

ashd:state-transition-conflict-watch
    a owl:NamedIndividual, ash:RuleStateTransition ;
    rdfs:label "WATCHING → CONFLICTED"@zh, "WATCHING to CONFLICTED"@en ;
