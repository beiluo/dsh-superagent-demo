    ash:transitionCondition "关键结构被破坏。" .

ashd:state-transition-invalidate-candidate
    a owl:NamedIndividual, ash:RuleStateTransition ;
    rdfs:label "CANDIDATE → INVALIDATED"@zh, "CANDIDATE to INVALIDATED"@en ;
    rdfs:comment "候选结构失效。"@zh ;
