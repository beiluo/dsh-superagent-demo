    rdfs:label "持仓管理（POS）"@zh, "持仓管理 (POS)"@en ;
    rdfs:comment "规则职责类别：持仓管理；管理持仓延续、减仓、止盈和加仓；不绕过风险预算与交易约束。"@zh ;
