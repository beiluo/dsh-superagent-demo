ashd:state-transition-data-recover
    a owl:NamedIndividual, ash:RuleStateTransition ;
    rdfs:label "DATA_INSUFFICIENT → NOT_OBSERVED"@zh, "DATA_INSUFFICIENT to NOT_OBSERVED"@en ;
    rdfs:comment "数据恢复后重新建立观察实例。"@zh ;
    ash:transitionOfMachine ashd:state-machine-unified ;
    ash:transitionFrom ashd:state-data-insufficient ;
    ash:transitionTo ashd:state-not-observed ;
