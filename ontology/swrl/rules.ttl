    ash:transitionCondition "触发条件被证伪。" .

ashd:state-transition-invalidate-confirmed
    a owl:NamedIndividual, ash:RuleStateTransition ;
    rdfs:label "CONFIRMED → INVALIDATED"@zh, "CONFIRMED to INVALIDATED"@en ;
    rdfs:comment "确认后的关键结构或逻辑被破坏。"@zh ;
    ash:transitionOfMachine ashd:state-machine-unified ;
    ash:transitionFrom ashd:state-confirmed ;
