    ash:libraryRequiresConvention ashd:convention-dq-price ;
    ash:libraryRequiresConvention ashd:convention-dq-volume ;
    ash:libraryRequiresConvention ashd:convention-dq-time ;
    ash:libraryRequiresConvention ashd:convention-dq-cross-section ;
    ash:libraryRequiresConvention ashd:convention-dq-missing ;
    ash:libraryRequiresConvention ashd:convention-dq-event-dedup ;
    ash:libraryRequiresConvention ashd:convention-dq-survivorship ;
    dcterms:source <https://github.com/beiluo/dsh-superagent-demo/issues/25> ;
    ash:isExample true .

ashd:category-op
    a owl:NamedIndividual, ash:RuleCategory ;
    rdfs:label "机会结构（OP）"@zh, "机会结构 (OP)"@en ;
    rdfs:comment "规则职责类别：机会结构；识别可交易的价格结构与机会形态；不独立决定仓位。"@zh ;
    ash:categoryCode "OP" ;
    ash:categoryName "机会结构" ;
    ash:categoryResponsibility "识别可交易的价格结构与机会形态" ;
    ash:categoryBoundary "不独立决定仓位" ;
    ash:categoryOrder 1 ;
    ash:categoryRuleClass ash:OpportunityRule ;
    ash:categoryHasRule ashd:rule-op-001 ;
    ash:categoryHasRule ashd:rule-op-002 ;
    ash:categoryHasRule ashd:rule-op-003 ;
    ash:categoryHasRule ashd:rule-op-004 ;
    ash:categoryHasRule ashd:rule-op-005 ;
    ash:categoryHasRule ashd:rule-op-006 ;
    ash:categoryHasRule ashd:rule-op-007 ;
    ash:categoryHasRule ashd:rule-op-008 ;
    ash:categoryHasRule ashd:rule-op-009 ;
    ash:categoryHasRule ashd:rule-op-010 .

ashd:category-vp
    a owl:NamedIndividual, ash:RuleCategory ;
    rdfs:label "量价证据（VP）"@zh, "量价证据 (VP)"@en ;
    rdfs:comment "规则职责类别：量价证据；判断价格变化是否得到成交行为支持；不单独产生买入信号。"@zh ;
    ash:categoryCode "VP" ;
    ash:categoryName "量价证据" ;
    ash:categoryResponsibility "判断价格变化是否得到成交行为支持" ;
    ash:categoryBoundary "不单独产生买入信号" ;
    ash:categoryOrder 2 ;
    ash:categoryRuleClass ash:VolumePriceRule ;
    ash:categoryHasRule ashd:rule-vp-001 ;
    ash:categoryHasRule ashd:rule-vp-002 ;
    ash:categoryHasRule ashd:rule-vp-003 ;
    ash:categoryHasRule ashd:rule-vp-004 ;
    ash:categoryHasRule ashd:rule-vp-005 ;
    ash:categoryHasRule ashd:rule-vp-006 ;
    ash:categoryHasRule ashd:rule-vp-007 ;
    ash:categoryHasRule ashd:rule-vp-008 .

ashd:category-auc
    a owl:NamedIndividual, ash:RuleCategory ;
    rdfs:label "竞价证据（AUC）"@zh, "竞价证据 (AUC)"@en ;
