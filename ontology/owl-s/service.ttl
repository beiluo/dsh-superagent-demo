# ---------------------------------------------------------------------------
# A-Share Investment Decision Ontology — OWL-S service layer
# ---------------------------------------------------------------------------
# OWL-S 1.2 (W3C Member Submission, 2004) is used to describe the decision
# service at three levels: Profile (what it does), Process Model (how it does
# it) and Grounding (how to invoke it). The WSDL endpoint is illustrative.
# ---------------------------------------------------------------------------
@prefix ash:       <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#> .
@prefix ashd:      <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/data#> .
@prefix dcterms:   <http://purl.org/dc/terms/> .
@prefix expr:      <http://www.daml.org/services/owl-s/1.2/generic/Expression.owl#> .
@prefix grounding: <http://www.daml.org/services/owl-s/1.2/Grounding.owl#> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix process:   <http://www.daml.org/services/owl-s/1.2/Process.owl#> .
@prefix profile:   <http://www.daml.org/services/owl-s/1.2/Profile.owl#> .
@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix service:   <http://www.daml.org/services/owl-s/1.2/Service.owl#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .

<https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/owl-s>
    a owl:Ontology ;
    owl:imports <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/owl> ;
    owl:imports <http://www.daml.org/services/owl-s/1.2/Service.owl> ;
    owl:imports <http://www.daml.org/services/owl-s/1.2/Profile.owl> ;
    owl:imports <http://www.daml.org/services/owl-s/1.2/Process.owl> ;
    owl:imports <http://www.daml.org/services/owl-s/1.2/Grounding.owl> ;
    dcterms:title "A-Share Investment Decision Ontology — OWL-S service"@en ;
    dcterms:title "A 股投资决策本体 — OWL-S 服务层"@zh ;
    dcterms:description "Profile, process model and WSDL grounding for an auditable A-share investment decision service."@en ;
    dcterms:description "可审计 A 股投资决策服务的 OWL-S Profile、流程模型与 WSDL Grounding。"@zh ;
    dcterms:conformsTo <https://www.w3.org/Submission/OWL-S/> ;
    rdfs:seeAlso <https://www.daml.org/services/owl-s/1.2/overview/> ;
    owl:versionInfo "1.6.0" ;
    ash:designNote "OWL-S 是 W3C Member Submission；服务端点、WSDL 文档和操作名均为示意，不指向生产系统。"@zh .

# ===========================================================================
# Service, profile, process model and grounding
# ===========================================================================

ashd:svc-ashare-decision
    a service:Service, ash:DecisionService ;
    service:presents ashd:profile-ashare-decision ;
    service:describedBy ashd:process-ashare-decision ;
    service:supports ashd:grounding-ashare-decision ;
    ash:serviceVersion "1.0.0" ;
    ash:endpointStatus "illustrative" ;
    ash:humanApprovalRequired true ;
    rdfs:label "A 股投资决策服务"@zh, "A-Share Investment Decision Service"@en ;
    rdfs:comment "输入证券池、投资者画像与数据包，输出可审计的投资决策、风险评估和理由链。"@zh ;
    ash:isExample true ;
    ash:exampleNote "示例服务，不连接真实交易系统。"@zh .

ashd:logic-swrl a expr:LogicLanguage ;
    expr:refURI <https://www.w3.org/Submission/SWRL/> ;
    rdfs:label "SWRL"@en ;
    rdfs:comment "前置条件表达式使用 SWRL 语义。"@zh .

ashd:precond-data-freshness a expr:Condition ;
    expr:expressionLanguage ashd:logic-swrl ;
    expr:expressionBody "行情数据截止日距决策日不超过 1 个交易日；财务报告为最近一个已披露报告期。"@zh ;
    rdfs:label "数据新鲜度前置条件"@zh ;
    ash:isExample true .

ashd:precond-suitability a expr:Condition ;
    expr:expressionLanguage ashd:logic-swrl ;
    expr:expressionBody "投资者画像的风险承受能力不低于决策风险等级对应的最低承受能力，且单票权重不超过 maxSingleWeight。"@zh ;
    rdfs:label "适当性前置条件"@zh ;
    ash:isExample true .

ashd:precond-policy-active a expr:Condition ;
    expr:expressionLanguage ashd:logic-swrl ;
    expr:expressionBody "ODRL 决策使用政策与数据使用政策均处于 active 状态，且未超过有效期。"@zh ;
    rdfs:label "政策有效性前置条件"@zh ;
    ash:isExample true .

ashd:precond-not-restricted a expr:Condition ;
    expr:expressionLanguage ashd:logic-swrl ;
    expr:expressionBody "标的证券不在限制交易、观察或禁投名单中；若命中，则必须进入人工合规复核。"@zh ;
    rdfs:label "限制名单前置条件"@zh ;
    ash:isExample true .

ashd:category-decision-support a profile:ServiceCategory ;
    profile:categoryName "Investment Decision Support" ;
    profile:taxonomy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#service-taxonomy> ;
    profile:code "INV-DEC-01" ;
    rdfs:label "投资决策支持"@zh .

ashd:profile-ashare-decision a profile:Profile ;
    profile:serviceName "A-Share Investment Decision Service" ;
    profile:textDescription "面向合格投资者的 A 股投资决策支持服务：读取公司、证券、财务、行情、估值与风险数据，执行 SWRL 规则，输出带证据链、风险评价和 ODRL 政策约束的投资建议。" ;
    profile:serviceClassification <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#service-classification-decision> ;
    profile:serviceProduct <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#product-decision-report> ;
    profile:serviceCategory ashd:category-decision-support ;
    profile:has_process ashd:process-ashare-decision ;
    profile:hasInput
        ashd:in-security-universe ,
        ashd:in-investor-profile ,
        ashd:in-as-of-date ,
        ashd:in-market-data ,
        ashd:in-constraints ;
    profile:hasOutput
        ashd:out-decision ,
        ashd:out-risk ,
        ashd:out-rationale ,
        ashd:out-order-intent ;
    profile:hasPrecondition
        ashd:precond-data-freshness ,
        ashd:precond-suitability ,
        ashd:precond-policy-active ,
        ashd:precond-not-restricted ;
    rdfs:label "A 股投资决策服务 Profile"@zh ;
    rdfs:comment "声明服务能力、输入、输出、前置条件与流程引用。"@zh ;
    ash:isExample true .

ashd:in-security-universe a process:Input ;
    process:parameterType <http://www.w3.org/2001/XMLSchema#string> ;
    rdfs:label "证券池"@zh ;
    rdfs:comment "待评估的 A 股证券代码列表或筛选条件。"@zh ;
    ash:isExample true .

ashd:in-investor-profile a process:Input ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#InvestorProfile> ;
    rdfs:label "投资者画像"@zh ;
    rdfs:comment "风险承受能力、投资期限、单票上限与排除规则。"@zh ;
    ash:isExample true .

ashd:in-as-of-date a process:Input ;
    process:parameterType <http://www.w3.org/2001/XMLSchema#date> ;
    rdfs:label "决策基准日"@zh ;
    rdfs:comment "用于选择行情、估值和财报版本的基准日期。"@zh ;
    ash:isExample true .

ashd:in-market-data a process:Input ;
    process:parameterType <http://www.w3.org/2001/XMLSchema#anyURI> ;
    rdfs:label "市场数据包"@zh ;
    rdfs:comment "行情、估值、财务报告、公告和宏观指标的版本化数据包。"@zh ;
    ash:isExample true .

ashd:in-constraints a process:Input ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#InvestorProfile> ;
    rdfs:label "组合与合规约束"@zh ;
    rdfs:comment "行业上限、单票上限、流动性门槛和限制名单。"@zh ;
    ash:isExample true .

ashd:out-decision a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#InvestmentDecision> ;
    rdfs:label "投资决策"@zh ;
    rdfs:comment "带建议、目标价、止损价、期限和置信度的决策实例。"@zh ;
    ash:isExample true .

ashd:out-risk a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#RiskAssessment> ;
    rdfs:label "风险评估"@zh ;
    rdfs:comment "风险分数、等级和风险因子。"@zh ;
    ash:isExample true .

ashd:out-rationale a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#DecisionRationale> ;
    rdfs:label "决策理由"@zh ;
    rdfs:comment "包含正面证据、关键假设和反方观点的理由链。"@zh ;
    ash:isExample true .

ashd:out-order-intent a process:Output ;
    process:parameterType <http://www.w3.org/2001/XMLSchema#string> ;
    rdfs:label "订单意图"@zh ;
    rdfs:comment "仅供人工确认的订单意图，不直接触发交易。"@zh ;
    ash:isExample true .

# ===========================================================================
# Atomic processes
# ===========================================================================

ashd:step-data-quality a process:AtomicProcess ;
    process:hasInput ashd:in-security-universe, ashd:in-market-data ;
    process:hasOutput ashd:data-validated ;
    rdfs:label "01 数据接入与质量校验"@zh ;
    rdfs:comment "校验证券主数据、行情、财报和估值的时间戳、完整性与异常值。"@zh ;
    ash:isExample true .

ashd:data-validated a process:Output ;
    process:parameterType <http://www.w3.org/2001/XMLSchema#anyURI> ;
    rdfs:label "已校验数据包"@zh ;
    ash:isExample true .

ashd:step-factor-computation a process:AtomicProcess ;
    process:hasInput ashd:data-validated, ashd:in-as-of-date ;
    process:hasOutput ashd:factors-computed ;
    rdfs:label "02 因子与估值计算"@zh ;
    rdfs:comment "计算 ROE、PE、PB、营收增速、利润增速、换手率和市值等指标。"@zh ;
    ash:isExample true .

ashd:factors-computed a process:Output ;
    process:parameterType <http://www.w3.org/2001/XMLSchema#anyURI> ;
    rdfs:label "因子快照"@zh ;
    ash:isExample true .

ashd:step-risk-assessment a process:AtomicProcess ;
    process:hasInput ashd:factors-computed, ashd:data-validated ;
    process:hasOutput ashd:out-risk ;
    rdfs:label "03 风险与流动性评估"@zh ;
    rdfs:comment "评估市场、信用、流动性、集中度、模型与 ESG 风险，生成风险分数和等级。"@zh ;
    ash:isExample true .

ashd:step-rule-reasoning a process:AtomicProcess ;
    process:hasInput ashd:factors-computed, ashd:out-risk ;
    process:hasOutput ashd:signals-derived ;
    rdfs:label "04 SWRL 规则推理"@zh ;
    rdfs:comment "执行价值候选、高财务风险、止损、集中度、限制名单和可审计性规则。"@zh ;
    ash:isExample true .

ashd:signals-derived a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#Signal> ;
    rdfs:label "推断信号集"@zh ;
    ash:isExample true .

ashd:step-portfolio-construction a process:AtomicProcess ;
    process:hasInput ashd:signals-derived, ashd:in-investor-profile, ashd:in-constraints ;
    process:hasOutput ashd:portfolio-proposal ;
    rdfs:label "05 组合与约束优化"@zh ;
    rdfs:comment "在单票上限、行业约束、流动性门槛和风险预算下生成组合建议。"@zh ;
    ash:isExample true .

ashd:portfolio-proposal a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#Portfolio> ;
    rdfs:label "组合建议"@zh ;
    ash:isExample true .

ashd:step-compliance a process:AtomicProcess ;
    process:hasInput ashd:portfolio-proposal, ashd:in-constraints ;
    process:hasOutput ashd:compliance-result ;
    rdfs:label "06 合规与适当性检查"@zh ;
    rdfs:comment "检查限制名单、投资者适当性、单票集中度、数据使用政策和人工复核要求。"@zh ;
    ash:isExample true .

ashd:compliance-result a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#ComplianceCheck> ;
    rdfs:label "合规检查结果"@zh ;
    ash:isExample true .

ashd:step-decision-generation a process:AtomicProcess ;
    process:hasInput ashd:portfolio-proposal, ashd:out-risk, ashd:signals-derived, ashd:compliance-result ;
    process:hasOutput ashd:out-decision, ashd:out-rationale, ashd:out-order-intent ;
    rdfs:label "07 决策报告生成"@zh ;
    rdfs:comment "汇总建议、目标价、止损价、证据链、反方观点和人工复核标记。"@zh ;
    ash:isExample true .

# ===========================================================================
# Composite process: sequence of atomic processes
# ===========================================================================

ashd:process-ashare-decision a process:CompositeProcess ;
    process:hasInput
        ashd:in-security-universe ,
        ashd:in-investor-profile ,
        ashd:in-as-of-date ,
        ashd:in-market-data ,
        ashd:in-constraints ;
    process:hasOutput
        ashd:out-decision ,
        ashd:out-risk ,
        ashd:out-rationale ,
        ashd:out-order-intent ;
    process:hasPrecondition
        ashd:precond-data-freshness ,
        ashd:precond-suitability ,
        ashd:precond-policy-active ,
        ashd:precond-not-restricted ;
    process:composedOf [
        a process:Sequence ;
        process:components (
            [ a process:Perform ; process:process ashd:step-data-quality ]
            [ a process:Perform ; process:process ashd:step-factor-computation ]
            [ a process:Perform ; process:process ashd:step-risk-assessment ]
            [ a process:Perform ; process:process ashd:step-rule-reasoning ]
            [ a process:Perform ; process:process ashd:step-portfolio-construction ]
            [ a process:Perform ; process:process ashd:step-compliance ]
            [ a process:Perform ; process:process ashd:step-decision-generation ]
        )
    ] ;
    rdfs:label "A 股投资决策流程"@zh ;
    rdfs:comment "数据校验 → 因子计算 → 风险评估 → 规则推理 → 组合优化 → 合规检查 → 决策生成。"@zh ;
    ash:isExample true .

# ===========================================================================
# WSDL grounding (illustrative only)
# ===========================================================================

ashd:grounding-ashare-decision a grounding:WsdlGrounding ;
    grounding:hasAtomicProcessGrounding
        ashd:ground-data-quality ,
        ashd:ground-factor ,
        ashd:ground-risk ,
        ashd:ground-rule ,
        ashd:ground-portfolio ,
        ashd:ground-compliance ,
        ashd:ground-decision ;
    rdfs:label "A 股投资决策服务 WSDL Grounding（示意）"@zh ;
    rdfs:comment "仅为 OWL-S 结构演示，端点与 WSDL 文档均不指向生产系统。"@zh ;
    ash:isExample true .

ashd:ground-data-quality a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-data-quality ;
    grounding:wsdlDocument "https://example.org/ashare-decision/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-decision/service" ;
    grounding:wsdlPort "DecisionPort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "DecisionPortType" ; grounding:operation "validateData" ] ;
    ash:isExample true .

ashd:ground-factor a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-factor-computation ;
    grounding:wsdlDocument "https://example.org/ashare-decision/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-decision/service" ;
    grounding:wsdlPort "DecisionPort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "DecisionPortType" ; grounding:operation "computeFactors" ] ;
    ash:isExample true .

ashd:ground-risk a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-risk-assessment ;
    grounding:wsdlDocument "https://example.org/ashare-decision/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-decision/service" ;
    grounding:wsdlPort "DecisionPort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "DecisionPortType" ; grounding:operation "assessRisk" ] ;
    ash:isExample true .

ashd:ground-rule a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-rule-reasoning ;
    grounding:wsdlDocument "https://example.org/ashare-decision/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-decision/service" ;
    grounding:wsdlPort "DecisionPort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "DecisionPortType" ; grounding:operation "runRules" ] ;
    ash:isExample true .

ashd:ground-portfolio a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-portfolio-construction ;
    grounding:wsdlDocument "https://example.org/ashare-decision/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-decision/service" ;
    grounding:wsdlPort "DecisionPort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "DecisionPortType" ; grounding:operation "constructPortfolio" ] ;
    ash:isExample true .

ashd:ground-compliance a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-compliance ;
    grounding:wsdlDocument "https://example.org/ashare-decision/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-decision/service" ;
    grounding:wsdlPort "DecisionPort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "DecisionPortType" ; grounding:operation "checkCompliance" ] ;
    ash:isExample true .

ashd:ground-decision a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-decision-generation ;
    grounding:wsdlDocument "https://example.org/ashare-decision/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-decision/service" ;
    grounding:wsdlPort "DecisionPort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "DecisionPortType" ; grounding:operation "generateDecision" ] ;
    ash:isExample true .
