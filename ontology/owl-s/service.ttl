# ---------------------------------------------------------------------------
# A-Share Investment Decision Ontology — OWL-S service layer
# ---------------------------------------------------------------------------
# OWL-S 1.2 (W3C Member Submission, 2004) is used to describe the decision
# service at three levels: Profile (what it does), Process Model (how it does
# it) and Grounding (how to invoke it). The WSDL endpoint is illustrative.
# ---------------------------------------------------------------------------
@prefix ash:       <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#> .
@prefix ashd:      <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/data#> .
@prefix dcterms:   <http://purl.org/dc/terms/> .
@prefix expr:      <http://www.daml.org/services/owl-s/1.2/generic/Expression.owl#> .
@prefix grounding: <http://www.daml.org/services/owl-s/1.2/Grounding.owl#> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix process:   <http://www.daml.org/services/owl-s/1.2/Process.owl#> .
@prefix profile:   <http://www.daml.org/services/owl-s/1.2/Profile.owl#> .
@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix service:   <http://www.daml.org/services/owl-s/1.2/Service.owl#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .

<https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/owl-s>
    a owl:Ontology ;
    owl:imports <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/owl> ;
    owl:imports <http://www.daml.org/services/owl-s/1.2/Service.owl> ;
    owl:imports <http://www.daml.org/services/owl-s/1.2/Profile.owl> ;
    owl:imports <http://www.daml.org/services/owl-s/1.2/Process.owl> ;
    owl:imports <http://www.daml.org/services/owl-s/1.2/Grounding.owl> ;
    dcterms:title "A-Share Investment Decision Ontology — OWL-S service"@en ;
    dcterms:title "A 股投资决策本体 — OWL-S 服务层"@zh ;
    dcterms:description "Profile, process model and WSDL grounding for an auditable A-share investment decision service."@en ;
    dcterms:description "可审计 A 股投资决策服务的 OWL-S Profile、流程模型与 WSDL Grounding。"@zh ;
    dcterms:conformsTo <https://www.w3.org/Submission/OWL-S/> ;
    rdfs:seeAlso <https://www.daml.org/services/owl-s/1.2/overview/> ;
    owl:versionInfo "1.10.0" ;
    ash:designNote "OWL-S 是 W3C Member Submission；服务端点、WSDL 文档和操作名均为示意，不指向生产系统。"@zh .

# ===========================================================================
# Service, profile, process model and grounding
# ===========================================================================

ashd:svc-ashare-decision
    a service:Service, ash:DecisionService ;
    service:presents ashd:profile-ashare-decision ;
    service:describedBy ashd:process-ashare-decision ;
    service:supports ashd:grounding-ashare-decision ;
    ash:serviceVersion "1.0.0" ;
    ash:endpointStatus "illustrative" ;
    ash:humanApprovalRequired true ;
    rdfs:label "A 股投资决策服务"@zh, "A-Share Investment Decision Service"@en ;
    rdfs:comment "输入证券池、投资者画像与数据包，输出可审计的投资决策、风险评估和理由链。"@zh ;
    ash:isExample true ;
    ash:exampleNote "示例服务，不连接真实交易系统。"@zh .

ashd:logic-swrl a expr:LogicLanguage ;
    expr:refURI <https://www.w3.org/Submission/SWRL/> ;
    rdfs:label "SWRL"@en ;
    rdfs:comment "前置条件表达式使用 SWRL 语义。"@zh .

ashd:precond-data-freshness a expr:Condition ;
    expr:expressionLanguage ashd:logic-swrl ;
    expr:expressionBody "行情数据截止日距决策日不超过 1 个交易日；财务报告为最近一个已披露报告期。"@zh ;
    rdfs:label "数据新鲜度前置条件"@zh ;
    ash:isExample true .

ashd:precond-suitability a expr:Condition ;
    expr:expressionLanguage ashd:logic-swrl ;
    expr:expressionBody "投资者画像的风险承受能力不低于决策风险等级对应的最低承受能力，且单票权重不超过 maxSingleWeight。"@zh ;
    rdfs:label "适当性前置条件"@zh ;
    ash:isExample true .

ashd:precond-policy-active a expr:Condition ;
    expr:expressionLanguage ashd:logic-swrl ;
    expr:expressionBody "ODRL 决策使用政策与数据使用政策均处于 active 状态，且未超过有效期。"@zh ;
    rdfs:label "政策有效性前置条件"@zh ;
    ash:isExample true .

ashd:precond-not-restricted a expr:Condition ;
    expr:expressionLanguage ashd:logic-swrl ;
    expr:expressionBody "标的证券不在限制交易、观察或禁投名单中；若命中，则必须进入人工合规复核。"@zh ;
    rdfs:label "限制名单前置条件"@zh ;
    ash:isExample true .

ashd:category-decision-support a profile:ServiceCategory ;
    profile:categoryName "Investment Decision Support" ;
    profile:taxonomy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#service-taxonomy> ;
    profile:code "INV-DEC-01" ;
    rdfs:label "投资决策支持"@zh .

ashd:profile-ashare-decision a profile:Profile ;
    profile:serviceName "A-Share Investment Decision Service" ;
    profile:textDescription "面向合格投资者的 A 股投资决策支持服务：读取公司、证券、财务、行情、估值与风险数据，执行 SWRL 规则，输出带证据链、风险评价和 ODRL 政策约束的投资建议。" ;
    profile:serviceClassification <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#service-classification-decision> ;
    profile:serviceProduct <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#product-decision-report> ;
    profile:serviceCategory ashd:category-decision-support ;
    profile:has_process ashd:process-ashare-decision ;
    profile:hasInput
        ashd:in-security-universe ,
        ashd:in-investor-profile ,
        ashd:in-as-of-date ,
        ashd:in-market-data ,
        ashd:in-constraints ;
    profile:hasOutput
        ashd:out-decision ,
        ashd:out-risk ,
        ashd:out-rationale ,
        ashd:out-order-intent ;
    profile:hasPrecondition
        ashd:precond-data-freshness ,
        ashd:precond-suitability ,
        ashd:precond-policy-active ,
        ashd:precond-not-restricted ;
    rdfs:label "A 股投资决策服务 Profile"@zh ;
    rdfs:comment "声明服务能力、输入、输出、前置条件与流程引用。"@zh ;
    ash:isExample true .

ashd:in-security-universe a process:Input ;
    process:parameterType <http://www.w3.org/2001/XMLSchema#string> ;
    rdfs:label "证券池"@zh ;
    rdfs:comment "待评估的 A 股证券代码列表或筛选条件。"@zh ;
    ash:isExample true .

ashd:in-investor-profile a process:Input ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#InvestorProfile> ;
    rdfs:label "投资者画像"@zh ;
    rdfs:comment "风险承受能力、投资期限、单票上限与排除规则。"@zh ;
    ash:isExample true .

ashd:in-as-of-date a process:Input ;
    process:parameterType <http://www.w3.org/2001/XMLSchema#date> ;
    rdfs:label "决策基准日"@zh ;
    rdfs:comment "用于选择行情、估值和财报版本的基准日期。"@zh ;
    ash:isExample true .

ashd:in-market-data a process:Input ;
    process:parameterType <http://www.w3.org/2001/XMLSchema#anyURI> ;
    rdfs:label "市场数据包"@zh ;
    rdfs:comment "行情、估值、财务报告、公告和宏观指标的版本化数据包。"@zh ;
    ash:isExample true .

ashd:in-constraints a process:Input ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#InvestorProfile> ;
    rdfs:label "组合与合规约束"@zh ;
    rdfs:comment "行业上限、单票上限、流动性门槛和限制名单。"@zh ;
    ash:isExample true .

ashd:out-decision a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#InvestmentDecision> ;
    rdfs:label "投资决策"@zh ;
    rdfs:comment "带建议、目标价、止损价、期限和置信度的决策实例。"@zh ;
    ash:isExample true .

ashd:out-risk a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#RiskAssessment> ;
    rdfs:label "风险评估"@zh ;
    rdfs:comment "风险分数、等级和风险因子。"@zh ;
    ash:isExample true .

ashd:out-rationale a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#DecisionRationale> ;
    rdfs:label "决策理由"@zh ;
    rdfs:comment "包含正面证据、关键假设和反方观点的理由链。"@zh ;
    ash:isExample true .

ashd:out-order-intent a process:Output ;
    process:parameterType <http://www.w3.org/2001/XMLSchema#string> ;
    rdfs:label "订单意图"@zh ;
    rdfs:comment "仅供人工确认的订单意图，不直接触发交易。"@zh ;
    ash:isExample true .

# ===========================================================================
# Atomic processes
# ===========================================================================

ashd:step-data-quality a process:AtomicProcess ;
    process:hasInput ashd:in-security-universe, ashd:in-market-data ;
    process:hasOutput ashd:data-validated ;
    rdfs:label "01 数据接入与质量校验"@zh ;
    rdfs:comment "校验证券主数据、行情、财报和估值的时间戳、完整性与异常值。"@zh ;
    ash:isExample true .

ashd:data-validated a process:Output ;
    process:parameterType <http://www.w3.org/2001/XMLSchema#anyURI> ;
    rdfs:label "已校验数据包"@zh ;
    ash:isExample true .

ashd:step-factor-computation a process:AtomicProcess ;
    process:hasInput ashd:data-validated, ashd:in-as-of-date ;
    process:hasOutput ashd:factors-computed ;
    rdfs:label "02 因子与估值计算"@zh ;
    rdfs:comment "计算 ROE、PE、PB、营收增速、利润增速、换手率和市值等指标。"@zh ;
    ash:isExample true .

ashd:factors-computed a process:Output ;
    process:parameterType <http://www.w3.org/2001/XMLSchema#anyURI> ;
    rdfs:label "因子快照"@zh ;
    ash:isExample true .

ashd:step-risk-assessment a process:AtomicProcess ;
    process:hasInput ashd:factors-computed, ashd:data-validated ;
    process:hasOutput ashd:out-risk ;
    rdfs:label "03 风险与流动性评估"@zh ;
    rdfs:comment "评估市场、信用、流动性、集中度、模型与 ESG 风险，生成风险分数和等级。"@zh ;
    ash:isExample true .

ashd:step-rule-reasoning a process:AtomicProcess ;
    process:hasInput ashd:factors-computed, ashd:out-risk ;
    process:hasOutput ashd:signals-derived ;
    rdfs:label "04 SWRL 规则推理"@zh ;
    rdfs:comment "执行价值候选、高财务风险、止损、集中度、限制名单和可审计性规则。"@zh ;
    ash:isExample true .

ashd:signals-derived a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#Signal> ;
    rdfs:label "推断信号集"@zh ;
    ash:isExample true .

ashd:step-portfolio-construction a process:AtomicProcess ;
    process:hasInput ashd:signals-derived, ashd:in-investor-profile, ashd:in-constraints ;
    process:hasOutput ashd:portfolio-proposal ;
    rdfs:label "05 组合与约束优化"@zh ;
    rdfs:comment "在单票上限、行业约束、流动性门槛和风险预算下生成组合建议。"@zh ;
    ash:isExample true .

ashd:portfolio-proposal a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#Portfolio> ;
    rdfs:label "组合建议"@zh ;
    ash:isExample true .

ashd:step-compliance a process:AtomicProcess ;
    process:hasInput ashd:portfolio-proposal, ashd:in-constraints ;
    process:hasOutput ashd:compliance-result ;
    rdfs:label "06 合规与适当性检查"@zh ;
    rdfs:comment "检查限制名单、投资者适当性、单票集中度、数据使用政策和人工复核要求。"@zh ;
    ash:isExample true .

ashd:compliance-result a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#ComplianceCheck> ;
    rdfs:label "合规检查结果"@zh ;
    ash:isExample true .

ashd:step-decision-generation a process:AtomicProcess ;
    process:hasInput ashd:portfolio-proposal, ashd:out-risk, ashd:signals-derived, ashd:compliance-result ;
    process:hasOutput ashd:out-decision, ashd:out-rationale, ashd:out-order-intent ;
    rdfs:label "07 决策报告生成"@zh ;
    rdfs:comment "汇总建议、目标价、止损价、证据链、反方观点和人工复核标记。"@zh ;
    ash:isExample true .

# ===========================================================================
# Composite process: sequence of atomic processes
# ===========================================================================

ashd:process-ashare-decision a process:CompositeProcess ;
    process:hasInput
        ashd:in-security-universe ,
        ashd:in-investor-profile ,
        ashd:in-as-of-date ,
        ashd:in-market-data ,
        ashd:in-constraints ;
    process:hasOutput
        ashd:out-decision ,
        ashd:out-risk ,
        ashd:out-rationale ,
        ashd:out-order-intent ;
    process:hasPrecondition
        ashd:precond-data-freshness ,
        ashd:precond-suitability ,
        ashd:precond-policy-active ,
        ashd:precond-not-restricted ;
    process:composedOf [
        a process:Sequence ;
        process:components (
            [ a process:Perform ; process:process ashd:step-data-quality ]
            [ a process:Perform ; process:process ashd:step-factor-computation ]
            [ a process:Perform ; process:process ashd:step-risk-assessment ]
            [ a process:Perform ; process:process ashd:step-rule-reasoning ]
            [ a process:Perform ; process:process ashd:step-portfolio-construction ]
            [ a process:Perform ; process:process ashd:step-compliance ]
            [ a process:Perform ; process:process ashd:step-decision-generation ]
        )
    ] ;
    rdfs:label "A 股投资决策流程"@zh ;
    rdfs:comment "数据校验 → 因子计算 → 风险评估 → 规则推理 → 组合优化 → 合规检查 → 决策生成。"@zh ;
    ash:isExample true .

# ===========================================================================
# WSDL grounding (illustrative only)
# ===========================================================================

ashd:grounding-ashare-decision a grounding:WsdlGrounding ;
    grounding:hasAtomicProcessGrounding
        ashd:ground-data-quality ,
        ashd:ground-factor ,
        ashd:ground-risk ,
        ashd:ground-rule ,
        ashd:ground-portfolio ,
        ashd:ground-compliance ,
        ashd:ground-decision ;
    rdfs:label "A 股投资决策服务 WSDL Grounding（示意）"@zh ;
    rdfs:comment "仅为 OWL-S 结构演示，端点与 WSDL 文档均不指向生产系统。"@zh ;
    ash:isExample true .

ashd:ground-data-quality a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-data-quality ;
    grounding:wsdlDocument "https://example.org/ashare-decision/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-decision/service" ;
    grounding:wsdlPort "DecisionPort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "DecisionPortType" ; grounding:operation "validateData" ] ;
    ash:isExample true .

ashd:ground-factor a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-factor-computation ;
    grounding:wsdlDocument "https://example.org/ashare-decision/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-decision/service" ;
    grounding:wsdlPort "DecisionPort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "DecisionPortType" ; grounding:operation "computeFactors" ] ;
    ash:isExample true .

ashd:ground-risk a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-risk-assessment ;
    grounding:wsdlDocument "https://example.org/ashare-decision/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-decision/service" ;
    grounding:wsdlPort "DecisionPort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "DecisionPortType" ; grounding:operation "assessRisk" ] ;
    ash:isExample true .

ashd:ground-rule a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-rule-reasoning ;
    grounding:wsdlDocument "https://example.org/ashare-decision/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-decision/service" ;
    grounding:wsdlPort "DecisionPort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "DecisionPortType" ; grounding:operation "runRules" ] ;
    ash:isExample true .

ashd:ground-portfolio a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-portfolio-construction ;
    grounding:wsdlDocument "https://example.org/ashare-decision/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-decision/service" ;
    grounding:wsdlPort "DecisionPort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "DecisionPortType" ; grounding:operation "constructPortfolio" ] ;
    ash:isExample true .

ashd:ground-compliance a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-compliance ;
    grounding:wsdlDocument "https://example.org/ashare-decision/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-decision/service" ;
    grounding:wsdlPort "DecisionPort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "DecisionPortType" ; grounding:operation "checkCompliance" ] ;
    ash:isExample true .

ashd:ground-decision a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-decision-generation ;
    grounding:wsdlDocument "https://example.org/ashare-decision/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-decision/service" ;
    grounding:wsdlPort "DecisionPort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "DecisionPortType" ; grounding:operation "generateDecision" ] ;
    ash:isExample true .


# ===========================================================================
# Domain expansion 1.3 — decision lifecycle service
# ===========================================================================
# A second service makes the decision lifecycle explicit: account snapshot,
# risk-budget check, trade point, sizing, constraint gate, order intent,
# execution review and rule iteration. The endpoint is illustrative.

ashd:svc-trade-lifecycle a service:Service, ash:DecisionService ;
    service:presents ashd:profile-trade-lifecycle ;
    service:describedBy ashd:process-trade-lifecycle ;
    service:supports ashd:grounding-trade-lifecycle ;
    ash:serviceVersion "1.3.0" ;
    ash:endpointStatus "illustrative" ;
    ash:humanApprovalRequired true ;
    rdfs:label "A 股交易决策生命周期服务"@zh, "A-Share Trade Decision Lifecycle Service"@en ;
    rdfs:comment "从账户与持仓状态出发，经风险预算、买卖点、仓位测算、约束检查、订单意图、执行质量到复盘的闭环服务。"@zh ;
    ash:isExample true ;
    ash:exampleNote "示例服务，不连接真实账户或交易通道。"@zh .

ashd:precond-risk-budget a expr:Condition ;
    expr:expressionLanguage ashd:logic-swrl ;
    expr:expressionBody "组合风险预算使用率低于 100%；单笔计划风险不超过 riskPerTradeLimit；预计单票权重不超过 maxSingleNameWeight。"@zh ;
    rdfs:label "风险预算前置条件"@zh ;
    ash:isExample true .

ashd:profile-trade-lifecycle a profile:Profile ;
    profile:serviceName "A-Share Trade Decision Lifecycle Service" ;
    profile:textDescription "读取账户与持仓状态，按组合风险预算计算买卖点与仓位，经过约束与人工审批后生成订单意图，并记录执行质量、结果与复盘，把发现回写为规则修订。" ;
    profile:serviceClassification <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#service-classification-decision> ;
    profile:serviceProduct <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#product-decision-report> ;
    profile:serviceCategory ashd:category-decision-support ;
    profile:has_process ashd:process-trade-lifecycle ;
    profile:hasInput
        ashd:in-account-state ,
        ashd:in-risk-budget ,
        ashd:in-market-snapshot ,
        ashd:in-trade-policy ;
    profile:hasOutput
        ashd:out-trade-plan ,
        ashd:out-order-intent-lifecycle ,
        ashd:out-execution-quality ,
        ashd:out-post-review ,
        ashd:out-rule-revision ;
    profile:hasPrecondition
        ashd:precond-data-freshness ,
        ashd:precond-risk-budget ,
        ashd:precond-policy-active ,
        ashd:precond-not-restricted ;
    rdfs:label "交易决策生命周期 Profile"@zh ;
    ash:isExample true .

ashd:in-account-state a process:Input ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#AccountState> ;
    rdfs:label "账户与持仓状态"@zh ;
    rdfs:comment "现金、购买力、持仓可卖数量、成本与浮盈亏快照。"@zh ;
    ash:isExample true .

ashd:in-risk-budget a process:Input ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#RiskBudget> ;
    rdfs:label "组合风险预算"@zh ;
    rdfs:comment "总风险资本、单笔风险、单票与行业上限、回撤和 VaR 限额。"@zh ;
    ash:isExample true .

ashd:in-market-snapshot a process:Input ;
    process:parameterType <http://www.w3.org/2001/XMLSchema#anyURI> ;
    rdfs:label "行情与风险快照"@zh ;
    rdfs:comment "最新价、技术指标、波动率与市场状态快照。"@zh ;
    ash:isExample true .

ashd:in-trade-policy a process:Input ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#DecisionPolicy> ;
    rdfs:label "交易与数据政策"@zh ;
    rdfs:comment "ODRL 交易护栏、人工批准与数据使用政策。"@zh ;
    ash:isExample true .

ashd:out-trade-plan a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#TradePlan> ;
    rdfs:label "交易计划"@zh ;
    rdfs:comment "含买点、止损、目标、仓位、风险金额与有效期的计划。"@zh ;
    ash:isExample true .

ashd:out-order-intent-lifecycle a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#OrderIntent> ;
    rdfs:label "订单意图"@zh ;
    rdfs:comment "等待人工确认、不直接触发交易的订单意图。"@zh ;
    ash:isExample true .

ashd:out-execution-quality a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#ExecutionQuality> ;
    rdfs:label "执行质量"@zh ;
    rdfs:comment "滑点、成交率、延迟与市场冲击。"@zh ;
    ash:isExample true .

ashd:out-post-review a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#PostTradeReview> ;
    rdfs:label "交易后复盘"@zh ;
    rdfs:comment "过程评分、结果评分、复盘发现与经验教训。"@zh ;
    ash:isExample true .

ashd:out-rule-revision a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#RuleRevision> ;
    rdfs:label "规则修订"@zh ;
    rdfs:comment "由复盘发现触发的规则或阈值修订记录。"@zh ;
    ash:isExample true .

ashd:step-account-snapshot a process:AtomicProcess ;
    process:hasInput ashd:in-account-state, ashd:in-market-snapshot ;
    process:hasOutput ashd:lc-account-validated ;
    rdfs:label "01 账户与持仓快照"@zh ;
    rdfs:comment "校验现金、购买力、可卖数量、冻结数量与持仓成本。"@zh ;
    ash:isExample true .

ashd:lc-account-validated a process:Output ;
    process:parameterType <http://www.w3.org/2001/XMLSchema#anyURI> ;
    rdfs:label "已校验账户状态"@zh ;
    ash:isExample true .

ashd:step-budget-check a process:AtomicProcess ;
    process:hasInput ashd:lc-account-validated, ashd:in-risk-budget ;
    process:hasOutput ashd:lc-budget-checked ;
    rdfs:label "02 风险预算检查"@zh ;
    rdfs:comment "检查总预算使用率、单笔风险、单票上限、回撤与 VaR 限额。"@zh ;
    ash:isExample true .

ashd:lc-budget-checked a process:Output ;
    process:parameterType <http://www.w3.org/2001/XMLSchema#anyURI> ;
    rdfs:label "风险预算结果"@zh ;
    ash:isExample true .

ashd:step-trade-point a process:AtomicProcess ;
    process:hasInput ashd:lc-budget-checked, ashd:in-market-snapshot ;
    process:hasOutput ashd:lc-trade-points ;
    rdfs:label "03 买卖点与触发条件"@zh ;
    rdfs:comment "根据估值、技术位与 ATR 计算买点、止损、目标和触发条件。"@zh ;
    ash:isExample true .

ashd:lc-trade-points a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#PriceLevel> ;
    rdfs:label "价格点位"@zh ;
    ash:isExample true .

ashd:step-sizing a process:AtomicProcess ;
    process:hasInput ashd:lc-trade-points, ashd:in-risk-budget ;
    process:hasOutput ashd:out-trade-plan ;
    rdfs:label "04 仓位测算"@zh ;
    rdfs:comment "按单笔风险金额、止损距离与预计权重计算数量，生成交易计划。"@zh ;
    ash:isExample true .

ashd:step-constraint-gate a process:AtomicProcess ;
    process:hasInput ashd:out-trade-plan, ashd:in-trade-policy, ashd:in-risk-budget ;
    process:hasOutput ashd:lc-constraint-result ;
    rdfs:label "05 约束与审批"@zh ;
    rdfs:comment "检查预计权重、购买力、限制名单、适当性与 ODRL 人工批准。"@zh ;
    ash:isExample true .

ashd:lc-constraint-result a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#ComplianceCheck> ;
    rdfs:label "约束检查结果"@zh ;
    ash:isExample true .

ashd:step-order-intent a process:AtomicProcess ;
    process:hasInput ashd:lc-constraint-result, ashd:out-trade-plan ;
    process:hasOutput ashd:out-order-intent-lifecycle ;
    rdfs:label "06 订单意图"@zh ;
    rdfs:comment "把通过约束的交易计划转为等待人工确认的订单意图。"@zh ;
    ash:isExample true .

ashd:step-execution-review a process:AtomicProcess ;
    process:hasInput ashd:out-order-intent-lifecycle, ashd:in-market-snapshot ;
    process:hasOutput ashd:out-execution-quality, ashd:out-post-review ;
    rdfs:label "07 执行与复盘"@zh ;
    rdfs:comment "记录成交、滑点、结果与过程，生成复盘发现和经验教训。"@zh ;
    ash:isExample true .

ashd:step-rule-iteration a process:AtomicProcess ;
    process:hasInput ashd:out-post-review ;
    process:hasOutput ashd:out-rule-revision ;
    rdfs:label "08 规则迭代"@zh ;
    rdfs:comment "把重复高严重度发现转为规则修订，进入下一轮决策。"@zh ;
    ash:isExample true .

ashd:process-trade-lifecycle a process:CompositeProcess ;
    process:hasInput
        ashd:in-account-state ,
        ashd:in-risk-budget ,
        ashd:in-market-snapshot ,
        ashd:in-trade-policy ;
    process:hasOutput
        ashd:out-trade-plan ,
        ashd:out-order-intent-lifecycle ,
        ashd:out-execution-quality ,
        ashd:out-post-review ,
        ashd:out-rule-revision ;
    process:hasPrecondition
        ashd:precond-data-freshness ,
        ashd:precond-risk-budget ,
        ashd:precond-policy-active ,
        ashd:precond-not-restricted ;
    process:composedOf [
        a process:Sequence ;
        process:components (
            [ a process:Perform ; process:process ashd:step-account-snapshot ]
            [ a process:Perform ; process:process ashd:step-budget-check ]
            [ a process:Perform ; process:process ashd:step-trade-point ]
            [ a process:Perform ; process:process ashd:step-sizing ]
            [ a process:Perform ; process:process ashd:step-constraint-gate ]
            [ a process:Perform ; process:process ashd:step-order-intent ]
            [ a process:Perform ; process:process ashd:step-execution-review ]
            [ a process:Perform ; process:process ashd:step-rule-iteration ]
        )
    ] ;
    rdfs:label "交易决策生命周期流程"@zh ;
    rdfs:comment "账户快照 → 风险预算 → 买卖点 → 仓位测算 → 约束审批 → 订单意图 → 执行复盘 → 规则迭代。"@zh ;
    ash:isExample true .

ashd:grounding-trade-lifecycle a grounding:WsdlGrounding ;
    grounding:hasAtomicProcessGrounding
        ashd:ground-account-snapshot ,
        ashd:ground-budget-check ,
        ashd:ground-trade-point ,
        ashd:ground-sizing ,
        ashd:ground-constraint-gate ,
        ashd:ground-order-intent ,
        ashd:ground-execution-review ,
        ashd:ground-rule-iteration ;
    rdfs:label "交易决策生命周期 WSDL Grounding（示意）"@zh ;
    ash:isExample true .

ashd:ground-account-snapshot a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-account-snapshot ;
    grounding:wsdlDocument "https://example.org/ashare-lifecycle/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-lifecycle/service" ;
    grounding:wsdlPort "LifecyclePort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "LifecyclePortType" ; grounding:operation "snapshotAccount" ] ;
    ash:isExample true .

ashd:ground-budget-check a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-budget-check ;
    grounding:wsdlDocument "https://example.org/ashare-lifecycle/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-lifecycle/service" ;
    grounding:wsdlPort "LifecyclePort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "LifecyclePortType" ; grounding:operation "checkRiskBudget" ] ;
    ash:isExample true .

ashd:ground-trade-point a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-trade-point ;
    grounding:wsdlDocument "https://example.org/ashare-lifecycle/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-lifecycle/service" ;
    grounding:wsdlPort "LifecyclePort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "LifecyclePortType" ; grounding:operation "computeTradePoints" ] ;
    ash:isExample true .

ashd:ground-sizing a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-sizing ;
    grounding:wsdlDocument "https://example.org/ashare-lifecycle/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-lifecycle/service" ;
    grounding:wsdlPort "LifecyclePort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "LifecyclePortType" ; grounding:operation "sizePosition" ] ;
    ash:isExample true .

ashd:ground-constraint-gate a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-constraint-gate ;
    grounding:wsdlDocument "https://example.org/ashare-lifecycle/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-lifecycle/service" ;
    grounding:wsdlPort "LifecyclePort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "LifecyclePortType" ; grounding:operation "gateConstraints" ] ;
    ash:isExample true .

ashd:ground-order-intent a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-order-intent ;
    grounding:wsdlDocument "https://example.org/ashare-lifecycle/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-lifecycle/service" ;
    grounding:wsdlPort "LifecyclePort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "LifecyclePortType" ; grounding:operation "createOrderIntent" ] ;
    ash:isExample true .

ashd:ground-execution-review a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-execution-review ;
    grounding:wsdlDocument "https://example.org/ashare-lifecycle/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-lifecycle/service" ;
    grounding:wsdlPort "LifecyclePort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "LifecyclePortType" ; grounding:operation "reviewExecution" ] ;
    ash:isExample true .

ashd:ground-rule-iteration a grounding:WsdlAtomicProcessGrounding ;
    grounding:owlsProcess ashd:step-rule-iteration ;
    grounding:wsdlDocument "https://example.org/ashare-lifecycle/service.wsdl" ;
    grounding:wsdlService "https://example.org/ashare-lifecycle/service" ;
    grounding:wsdlPort "LifecyclePort" ;
    grounding:wsdlOperation [ a grounding:WsdlOperationRef ; grounding:portType "LifecyclePortType" ; grounding:operation "reviseRules" ] ;
    ash:isExample true .

# ===========================================================================
# Domain expansion 1.10 — trading cognition service
# ===========================================================================
# The third service describes the requested pipeline as one process:
# market cognition -> opportunity identification -> trading judgment ->
# behavior management -> outcome verification. The endpoint is illustrative.

ashd:svc-trading-cognition a service:Service, ash:DecisionService ;
    service:presents ashd:profile-trading-cognition ;
    service:describedBy ashd:process-trading-cognition ;
    service:supports ashd:grounding-trading-cognition ;
    ash:serviceVersion "1.10.0" ;
    ash:endpointStatus "illustrative" ;
    ash:humanApprovalRequired true ;
    rdfs:label "A 股五引擎交易认知服务"@zh, "A-Share Five-Engine Trading Cognition Service"@en ;
    rdfs:comment "从市场认知、个股认知与事件认知出发，识别交易机会，形成分场景交易判断，管理行为并用结果验证判断。"@zh ;
    ash:isExample true ;
    ash:exampleNote "示例服务，不连接真实行情、账户或交易通道。"@zh .

ashd:precond-cognition-evidence a expr:Condition ;
    expr:expressionLanguage ashd:logic-swrl ;
    expr:expressionBody "反向证据必须逐条审查并写明处置；判断必须包含失效条件；非持仓与已持仓使用不同的判断流程；判断版本变化必须记录触发证据。"@zh ;
    rdfs:label "认知证据与版本前置条件"@zh ;
    ash:isExample true .

ashd:profile-trading-cognition a profile:Profile ;
    profile:serviceName "A-Share Five-Engine Trading Cognition Service" ;
    profile:textDescription "读取市场、板块、个股、量价、竞价、盘中与事件证据，先识别机会结构，再做多维证据验证、反向证据审查和风险收益评估，最后按非持仓或已持仓场景形成可版本化判断、行为规则与结果验证。" ;
    profile:serviceClassification <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#service-classification-decision> ;
    profile:serviceProduct <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#product-decision-report> ;
    profile:serviceCategory ashd:category-decision-support ;
    profile:has_process ashd:process-trading-cognition ;
    profile:hasInput
        ashd:in-cognition-security ,
        ashd:in-market-snapshot ,
        ashd:in-account-state ,
        ashd:in-trade-policy ;
    profile:hasOutput
        ashd:out-market-cognition ,
        ashd:out-stock-cognition ,
        ashd:out-event-cognition ,
        ashd:out-opportunity-assessment ,
        ashd:out-trading-judgment ,
        ashd:out-behavior-rule ,
        ashd:out-outcome-verification ;
    profile:hasPrecondition
        ashd:precond-data-freshness ,
        ashd:precond-cognition-evidence ,
        ashd:precond-policy-active ,
        ashd:precond-not-restricted ;
    rdfs:label "五引擎交易认知 Profile"@zh ;
    rdfs:comment "声明市场、个股、事件、机会与决策五个引擎的输入、输出、前置条件和流程引用。"@zh ;
    ash:isExample true .

ashd:in-cognition-security a process:Input ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#Security> ;
    rdfs:label "认知标的"@zh ;
    rdfs:comment "需要判断的证券及其公司、行业、主题与持仓状态。"@zh ;
    ash:isExample true .

ashd:out-market-cognition a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#MarketCognition> ;
    rdfs:label "市场认知"@zh ;
    rdfs:comment "市场趋势、广度、情绪、流动性、风险偏好与短线生态。"@zh ;
    ash:isExample true .

ashd:out-stock-cognition a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#StockCognition> ;
    rdfs:label "个股认知"@zh ;
    rdfs:comment "趋势阶段、价格结构、量价、竞价与盘中行为。"@zh ;
    ash:isExample true .

ashd:out-event-cognition a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#EventCognition> ;
    rdfs:label "事件认知"@zh ;
    rdfs:comment "事件真实性、业务相关性、是否已反映、板块共振与价格确认。"@zh ;
    ash:isExample true .

ashd:out-opportunity-assessment a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#OpportunityAssessment> ;
    rdfs:label "机会评估"@zh ;
    rdfs:comment "机会结构、阶段、支持证据、反向证据与风险收益。"@zh ;
    ash:isExample true .

ashd:out-trading-judgment a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#TradingJudgment> ;
    rdfs:label "交易判断"@zh ;
    rdfs:comment "分场景的结构化判断记录，含失效条件与版本。"@zh ;
    ash:isExample true .

ashd:out-behavior-rule a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#BehaviorRule> ;
    rdfs:label "行为管理规则"@zh ;
    rdfs:comment "建仓、加仓、持有、减仓、止盈、止损与观望条件。"@zh ;
    ash:isExample true .

ashd:out-outcome-verification a process:Output ;
    process:parameterType <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#OutcomeVerification> ;
    rdfs:label "结果验证"@zh ;
    rdfs:comment "用市场结果验证判断逻辑，并回写经验或规则修订。"@zh ;
    ash:isExample true .

ashd:step-market-cognition a process:AtomicProcess ;
    process:hasInput ashd:in-cognition-security, ashd:in-market-snapshot ;
    process:hasOutput ashd:out-market-cognition, ashd:cog-market-ready ;
    rdfs:label "01 市场认知"@zh ;
    rdfs:comment "识别市场趋势、广度、情绪、流动性、风险偏好、短线生态与板块状态。"@zh ;
    ash:isExample true .

ashd:cog-market-ready a process:Output ;
    process:parameterType <http://www.w3.org/2001/XMLSchema#anyURI> ;
    rdfs:label "市场环境结论"@zh ;
    ash:isExample true .

ashd:step-stock-cognition a process:AtomicProcess ;
    process:hasInput ashd:cog-market-ready, ashd:in-cognition-security ;
    process:hasOutput ashd:out-stock-cognition ;
    rdfs:label "02 个股认知"@zh ;
    rdfs:comment "识别趋势方向与阶段、价格位置、关键位、结构、量价、竞价与盘中行为。"@zh ;
    ash:isExample true .

ashd:step-event-cognition a process:AtomicProcess ;
    process:hasInput ashd:out-stock-cognition, ashd:in-market-snapshot ;
    process:hasOutput ashd:out-event-cognition ;
    rdfs:label "03 事件认知"@zh ;
    rdfs:comment "判断事件是否真实、与业务相关、已被反映、形成板块共振并被价格确认。"@zh ;
    ash:isExample true .

ashd:step-opportunity-identification a process:AtomicProcess ;
    process:hasInput ashd:out-stock-cognition, ashd:out-event-cognition, ashd:cog-market-ready ;
    process:hasOutput ashd:out-opportunity-assessment ;
    rdfs:label "04 机会识别"@zh ;
    rdfs:comment "识别机会结构，汇总支持证据与反向证据，评估机会阶段与确认条件。"@zh ;
    ash:isExample true .

ashd:step-trading-judgment a process:AtomicProcess ;
    process:hasInput ashd:out-opportunity-assessment, ashd:in-account-state ;
    process:hasOutput ashd:out-trading-judgment ;
    rdfs:label "05 交易判断"@zh ;
    rdfs:comment "按非持仓或已持仓场景，检查反向证据、风险收益、集中度与失效条件，形成判断版本。"@zh ;
    ash:isExample true .

ashd:step-behavior-management a process:AtomicProcess ;
    process:hasInput ashd:out-trading-judgment ;
    process:hasOutput ashd:out-behavior-rule ;
    rdfs:label "06 行为管理"@zh ;
    rdfs:comment "为判断生成建仓、加仓、持有、减仓、止盈、止损与观望规则及优先级。"@zh ;
    ash:isExample true .

ashd:step-outcome-verification a process:AtomicProcess ;
    process:hasInput ashd:out-trading-judgment, ashd:in-market-snapshot ;
    process:hasOutput ashd:out-outcome-verification ;
    rdfs:label "07 结果验证"@zh ;
    rdfs:comment "用真实市场结果验证逻辑是否成立，记录经验并触发判断或规则修订。"@zh ;
    ash:isExample true .

ashd:process-trading-cognition a process:CompositeProcess ;
    process:hasInput
        ashd:in-cognition-security ,
        ashd:in-market-snapshot ,
        ashd:in-account-state ,
        ashd:in-trade-policy ;
    process:hasOutput
        ashd:out-market-cognition ,
        ashd:out-stock-cognition ,
        ashd:out-event-cognition ,
        ashd:out-opportunity-assessment ,
        ashd:out-trading-judgment ,
        ashd:out-behavior-rule ,
        ashd:out-outcome-verification ;
    process:hasPrecondition
        ashd:precond-data-freshness ,
        ashd:precond-cognition-evidence ,
        ashd:precond-policy-active ,
        ashd:precond-not-restricted ;
    process:composedOf [
        a process:Sequence ;
        process:components (
            [ a process:Perform ; process:process ashd:step-market-cognition ]
            [ a process:Perform ; process:process ashd:step-stock-cognition ]
            [ a process:Perform ; process:process ashd:step-event-cognition ]
            [ a process:Perform ; process:process ashd:step-opportunity-identification ]
            [ a process:Perform ; process:process ashd:step-trading-judgment ]
            [ a process:Perform ; process:process ashd:step-behavior-management ]
            [ a process:Perform ; process:process ashd:step-outcome-verification ]
        )
    ] ;
    rdfs:label "五引擎交易认知流程"@zh ;
    rdfs:comment "市场认知 → 个股认知 → 事件认知 → 机会识别 → 交易判断 → 行为管理 → 结果验证。"@zh ;
    ash:isExample true .

ashd:grounding-trading-cognition a grounding:WsdlGrounding ;
    grounding:hasAtomicProcessGrounding
        ashd:ground-market-cognition ,
        ashd:ground-stock-cognition ,
        ashd:ground-event-cognition ,
        ashd:ground-opportunity-identification ,
        ashd:ground-trading-judgment ,
        ashd:ground-behavior-management ,
        ashd:ground-outcome-verification ;
    rdfs:label "五引擎交易认知 WSDL Grounding（示意）"@zh ;
    ash:isExample true .

ashd:ground-market-cognition a grounding:WsdlAtomicProcessGrounding ;
