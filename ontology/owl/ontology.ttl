# ---------------------------------------------------------------------------
# A-Share Investment Decision Ontology — OWL 2 layer
# ---------------------------------------------------------------------------
# OWL 2 DL axioms: restrictions, property characteristics, keys, class
# disjointness and named-individual identity. The ontology is deliberately
# modular so the RDFS vocabulary remains readable on its own.
# ---------------------------------------------------------------------------
@prefix ash:     <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#> .
@prefix ashs:    <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/skos#> .
@prefix ashd:    <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/data#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/owl>
    a owl:Ontology ;
    owl:imports <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> ;
    dcterms:title "A-Share Investment Decision Ontology — OWL 2 axioms"@en ;
    dcterms:title "A 股投资决策本体 — OWL 2 公理层"@zh ;
    dcterms:description "OWL 2 DL class expressions, restrictions, property characteristics, keys and identity constraints."@en ;
    dcterms:description "OWL 2 DL 类表达式、限制、属性特征、键与个体区分约束。"@zh ;
    dcterms:conformsTo <https://www.w3.org/TR/owl2-overview/> ;
    dcterms:conformsTo <https://www.w3.org/TR/owl2-syntax/> ;
    dcterms:conformsTo <https://www.w3.org/TR/owl2-mapping-to-rdf/> ;
    dcterms:source <https://spec.edmcouncil.org/fibo/> ;
    rdfs:seeAlso <https://www.w3.org/TR/owl2-primer/> ;
    owl:versionInfo "1.0.0" ;
    ash:designNote "采用 OWL 2 DL；模块边界对应 FIBO 的 domain module 思路，但领域内容完全独立编写。"@zh .

# ===========================================================================
# Annotation properties used by the design and the browser
# ===========================================================================

ash:example a owl:AnnotationProperty ;
    rdfs:label "示例"@zh, "example"@en ;
    rdfs:comment "用于在类或属性上给出领域示例的注解属性。"@zh .

ash:ruleUses a owl:AnnotationProperty ;
    rdfs:label "规则使用"@zh, "rule uses"@en ;
    rdfs:comment "标记 SWRL 规则读取的类或属性，便于治理与影响分析。"@zh ;
    rdfs:range rdf:Resource .

ash:appliesTo a owl:AnnotationProperty ;
    rdfs:label "适用对象"@zh, "applies to"@en ;
    rdfs:comment "标记规则主要约束的领域类。"@zh ;
    rdfs:range rdfs:Class .

ash:competencyQuestion a owl:AnnotationProperty ;
    rdfs:label "能力问题"@zh, "competency question"@en ;
    rdfs:comment "本体必须能够回答的领域问题，用于验收。"@zh .

ash:designNote a owl:AnnotationProperty ;
    rdfs:label "设计注记"@zh, "design note"@en ;
    rdfs:comment "记录建模取舍、规范依据或实现限制。"@zh .

# ===========================================================================
# Class restrictions
# ===========================================================================

ash:ListedCompany rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:hasSecurity ;
      owl:someValuesFrom ash:Security ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:primaryIndustry ;
      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass skos:Concept ] .

ash:AShare rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:tradesOn ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:MarketSegment ] .

ash:Security rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:listedOn ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:Exchange ] .

ash:FinancialReport rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:reportsOn ;
      owl:someValuesFrom ash:ListedCompany ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:reportPeriod ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:MarketQuote rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:quoteOf ;
      owl:someValuesFrom ash:Security ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:lastPrice ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:dataAsOf ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:Valuation rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:valuationOf ;
      owl:someValuesFrom ash:Security ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:peTtm ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:InvestmentDecision rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:aboutSecurity ;
      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:Security ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:hasRecommendation ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:Recommendation ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:hasRationale ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:DecisionRationale ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:hasRiskAssessment ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:RiskAssessment ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:decidedFor ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:InvestorProfile ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:hasHorizon ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:InvestmentHorizon ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:governedBy ;
      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:DecisionPolicy ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:hasComplianceCheck ;
      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:ComplianceCheck ] .

ash:DecisionRationale rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:rationaleText ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:hasEvidence ;
      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:Evidence ] .

ash:RiskAssessment rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:assessesSecurity ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:Security ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:riskScore ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:hasRiskLevel ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:RiskLevel ] .

ash:Portfolio rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:followsStrategy ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:InvestmentStrategy ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:hasBenchmark ;
      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:Index ] .

ash:Position rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:positionIn ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:Security ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:positionWeight ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:avgCost ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:InvestorProfile rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:riskTolerance ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:maxSingleWeight ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:Recommendation rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:actionCode ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:ComplianceCheck rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:checksDecision ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:InvestmentDecision ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:passed ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:AuditableDecision rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:hasRiskAssessment ;
      owl:someValuesFrom ash:RiskAssessment ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:hasRationale ;
      owl:someValuesFrom ash:DecisionRationale ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:basedOn ;
      owl:someValuesFrom ash:Evidence ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:governedBy ;
      owl:someValuesFrom ash:DecisionPolicy ] .

# ===========================================================================
# Property characteristics
# ===========================================================================

ash:listedOn a owl:FunctionalProperty .
ash:hasRecommendation a owl:FunctionalProperty .
ash:hasRationale a owl:FunctionalProperty .
ash:hasRiskAssessment a owl:FunctionalProperty .
ash:decidedFor a owl:FunctionalProperty .
ash:hasHorizon a owl:FunctionalProperty .
ash:aboutSecurity a owl:FunctionalProperty .
ash:aboutCompany a owl:FunctionalProperty .
ash:generatedBy a owl:FunctionalProperty .
ash:hasRiskLevel a owl:FunctionalProperty .
ash:assessesSecurity a owl:FunctionalProperty .
ash:checksDecision a owl:FunctionalProperty .
ash:followsStrategy a owl:FunctionalProperty .
ash:hasBenchmark a owl:FunctionalProperty .

ash:hasParentCompany a owl:TransitiveProperty .
ash:hasSubsidiary a owl:TransitiveProperty .
ash:relatedParty a owl:SymmetricProperty .

ash:hasSecurity owl:inverseOf ash:issuedBy .
ash:issuedBy owl:inverseOf ash:hasSecurity .
ash:listedOn owl:inverseOf ash:lists .
ash:lists owl:inverseOf ash:listedOn .
ash:hasFinancialReport owl:inverseOf ash:reportsOn .
ash:reportsOn owl:inverseOf ash:hasFinancialReport .
ash:hasMarketQuote owl:inverseOf ash:quoteOf .
ash:quoteOf owl:inverseOf ash:hasMarketQuote .
ash:hasValuation owl:inverseOf ash:valuationOf .
ash:valuationOf owl:inverseOf ash:hasValuation .
ash:hasCorporateEvent owl:inverseOf ash:eventOf .
ash:eventOf owl:inverseOf ash:hasCorporateEvent .
ash:aboutSecurity owl:inverseOf ash:subjectOfDecision .
ash:subjectOfDecision owl:inverseOf ash:aboutSecurity .
ash:hasRiskAssessment owl:inverseOf ash:assessesDecision .
ash:assessesDecision owl:inverseOf ash:hasRiskAssessment .
ash:holdsPosition owl:inverseOf ash:positionOf .
ash:positionOf owl:inverseOf ash:holdsPosition .
ash:hasParentCompany owl:inverseOf ash:hasSubsidiary .
ash:hasSubsidiary owl:inverseOf ash:hasParentCompany .

# Functional data properties
ash:securityCode a owl:FunctionalProperty .
ash:exchangeCode a owl:FunctionalProperty .
ash:securityName a owl:FunctionalProperty .
ash:companyName a owl:FunctionalProperty .
ash:companyCode a owl:FunctionalProperty .
ash:isin a owl:FunctionalProperty .
ash:listingDate a owl:FunctionalProperty .
ash:delistingDate a owl:FunctionalProperty .
ash:isST a owl:FunctionalProperty .
ash:delistingRisk a owl:FunctionalProperty .
ash:isSuspended a owl:FunctionalProperty .
