ash:Account rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:hasAccountState ;
      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:AccountState ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:holdsPortfolio ;
      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:Portfolio ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:accountCode ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:AccountState rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:accountStateOf ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:Account ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:cashBalance ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:buyingPower ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:Position rdfs:subClassOf
