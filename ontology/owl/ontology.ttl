# ===== Youzi methodology restrictions =====

ash:SeatRank rdfs:subClassOf [ a owl:Restriction ;
      owl:onProperty ash:seatRankNumber ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:AuctionExpectation rdfs:subClassOf [ a owl:Restriction ;
      owl:onProperty ash:expectedPremium ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:actualPremium ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:TradingJournal rdfs:subClassOf [ a owl:Restriction ;
