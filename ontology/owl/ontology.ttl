      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:OrderIntent rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:orderIntentOf ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:TradePlan ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:orderIntentSide ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:ExecutionQuality rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:executionQualityOf ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:Trade ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:slippageBps ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:DecisionOutcome rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:outcomeOf ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:InvestmentDecision ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:outcomeStatus ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:PostTradeReview rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:reviewsDecision ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:InvestmentDecision ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:reviewVerdict ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:reviewCompletedDate ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:ReviewFinding rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:findingType ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:findingSeverity ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:LessonLearned rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:lessonText ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:RuleRevision rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:revisionOfRule ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:RuleArtifact ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:revisionStatus ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:DecisionCycle rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:cycleId ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:cycleForSecurity ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:Security ] .

ash:DecisionContext rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty ash:contextAsOf ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:contextAccountState ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:AccountState ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:contextRiskBudget ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass ash:RiskBudget ] .

# ---- property characteristics ----

ash:hasAccount a owl:FunctionalProperty .
ash:hasAccountState a owl:FunctionalProperty .
ash:hasPositionState a owl:FunctionalProperty .
ash:hasRiskBudget a owl:FunctionalProperty .
ash:hasPortfolioRiskSnapshot a owl:FunctionalProperty .
ash:hasOutcome a owl:FunctionalProperty .
ash:planSide a owl:FunctionalProperty .
ash:planStatus a owl:FunctionalProperty .
ash:planId a owl:FunctionalProperty .
ash:riskBudgetUtilization a owl:FunctionalProperty .
ash:riskPerTradeLimit a owl:FunctionalProperty .
ash:riskBudgetTotal a owl:FunctionalProperty .
ash:maxSingleNameWeight a owl:FunctionalProperty .
ash:sizingQuantity a owl:FunctionalProperty .
ash:sizingWeight a owl:FunctionalProperty .
ash:projectedWeight a owl:FunctionalProperty .
ash:sizingRiskAmount a owl:FunctionalProperty .
ash:priceLevelValue a owl:FunctionalProperty .
ash:reviewVerdict a owl:FunctionalProperty .
ash:reviewCompletedDate a owl:FunctionalProperty .
ash:outcomeStatus a owl:FunctionalProperty .
ash:revisionId a owl:FunctionalProperty .
ash:revisionStatus a owl:FunctionalProperty .
ash:cycleId a owl:FunctionalProperty .
ash:contextAsOf a owl:FunctionalProperty .

ash:supersedesDecision a owl:TransitiveProperty .

ash:hasAccount owl:inverseOf ash:accountOf .
ash:accountOf owl:inverseOf ash:hasAccount .
ash:holdsPortfolio owl:inverseOf ash:portfolioHeldByAccount .
ash:portfolioHeldByAccount owl:inverseOf ash:holdsPortfolio .
ash:hasAccountState owl:inverseOf ash:accountStateOf .
ash:accountStateOf owl:inverseOf ash:hasAccountState .
ash:hasPositionState owl:inverseOf ash:positionStateOf .
ash:positionStateOf owl:inverseOf ash:hasPositionState .
ash:hasPositionLot owl:inverseOf ash:lotOfPosition .
ash:lotOfPosition owl:inverseOf ash:hasPositionLot .
ash:hasCashMovement owl:inverseOf ash:cashMovementOf .
ash:cashMovementOf owl:inverseOf ash:hasCashMovement .
ash:hasRiskBudget owl:inverseOf ash:riskBudgetOf .
ash:riskBudgetOf owl:inverseOf ash:hasRiskBudget .
ash:hasRiskAllocation owl:inverseOf ash:riskAllocationOf .
ash:riskAllocationOf owl:inverseOf ash:hasRiskAllocation .
ash:hasRiskLimit owl:inverseOf ash:riskLimitOf .
ash:riskLimitOf owl:inverseOf ash:hasRiskLimit .
ash:hasRiskUtilization owl:inverseOf ash:riskUtilizationOf .
ash:riskUtilizationOf owl:inverseOf ash:hasRiskUtilization .
ash:hasRiskContribution owl:inverseOf ash:riskContributionOf .
ash:riskContributionOf owl:inverseOf ash:hasRiskContribution .
ash:hasPortfolioRiskSnapshot owl:inverseOf ash:portfolioRiskSnapshotOf .
ash:portfolioRiskSnapshotOf owl:inverseOf ash:hasPortfolioRiskSnapshot .
ash:hasTradePlan owl:inverseOf ash:tradePlanOfDecision .
ash:tradePlanOfDecision owl:inverseOf ash:hasTradePlan .
ash:hasEntryPrice owl:inverseOf ash:entryPriceOf .
ash:entryPriceOf owl:inverseOf ash:hasEntryPrice .
ash:hasStopPrice owl:inverseOf ash:stopPriceOf .
ash:stopPriceOf owl:inverseOf ash:hasStopPrice .
ash:hasTargetPrice owl:inverseOf ash:targetPriceOf .
ash:targetPriceOf owl:inverseOf ash:hasTargetPrice .
ash:hasPriceLevel owl:inverseOf ash:priceLevelOf .
ash:priceLevelOf owl:inverseOf ash:hasPriceLevel .
ash:hasEntryTrigger owl:inverseOf ash:entryTriggerOf .
ash:entryTriggerOf owl:inverseOf ash:hasEntryTrigger .
ash:hasExitTrigger owl:inverseOf ash:exitTriggerOf .
ash:exitTriggerOf owl:inverseOf ash:hasExitTrigger .
ash:hasTradeSizing owl:inverseOf ash:sizingForPlan .
ash:sizingForPlan owl:inverseOf ash:hasTradeSizing .
ash:hasOrderIntent owl:inverseOf ash:orderIntentOf .
ash:orderIntentOf owl:inverseOf ash:hasOrderIntent .
ash:intentRealizedBy owl:inverseOf ash:realizesIntent .
ash:realizesIntent owl:inverseOf ash:intentRealizedBy .
ash:exitPlanForPosition owl:inverseOf ash:exitPlanOfPosition .
ash:exitPlanOfPosition owl:inverseOf ash:exitPlanForPosition .
ash:hasExecutionQuality owl:inverseOf ash:executionQualityOf .
ash:executionQualityOf owl:inverseOf ash:hasExecutionQuality .
ash:hasOutcome owl:inverseOf ash:outcomeOf .
ash:outcomeOf owl:inverseOf ash:hasOutcome .
ash:hasPostTradeReview owl:inverseOf ash:reviewsDecision .
ash:reviewsDecision owl:inverseOf ash:hasPostTradeReview .
ash:hasReviewFinding owl:inverseOf ash:findingOfReview .
ash:findingOfReview owl:inverseOf ash:hasReviewFinding .
ash:hasLesson owl:inverseOf ash:lessonOfReview .
ash:lessonOfReview owl:inverseOf ash:hasLesson .
ash:hasAttribution owl:inverseOf ash:attributionOfReview .
ash:attributionOfReview owl:inverseOf ash:hasAttribution .
ash:resultsInRevision owl:inverseOf ash:revisionFromReview .
ash:revisionFromReview owl:inverseOf ash:resultsInRevision .
ash:revisionOfRule owl:inverseOf ash:ruleRevisedBy .
ash:ruleRevisedBy owl:inverseOf ash:revisionOfRule .
ash:hasDecisionCycle owl:inverseOf ash:cycleOfPortfolio .
ash:cycleOfPortfolio owl:inverseOf ash:hasDecisionCycle .
ash:hasCycleDecision owl:inverseOf ash:decisionCycleOf .
ash:decisionCycleOf owl:inverseOf ash:hasCycleDecision .
ash:hasCycleExecution owl:inverseOf ash:executionCycleOf .
ash:executionCycleOf owl:inverseOf ash:hasCycleExecution .
ash:hasCycleReview owl:inverseOf ash:reviewCycleOf .
ash:reviewCycleOf owl:inverseOf ash:hasCycleReview .
ash:hasDecisionContext owl:inverseOf ash:contextOfDecision .
ash:contextOfDecision owl:inverseOf ash:hasDecisionContext .
ash:supersedesDecision owl:inverseOf ash:supersededByDecision .
ash:supersededByDecision owl:inverseOf ash:supersedesDecision .

# ---- keys ----

ash:Account owl:hasKey ( ash:accountCode ) .
ash:AccountState owl:hasKey ( ash:accountStateOf ash:dataAsOf ) .
ash:PositionState owl:hasKey ( ash:positionStateOf ash:dataAsOf ) .
ash:RiskBudget owl:hasKey ( ash:riskBudgetOf ash:riskBudgetAsOf ) .
ash:TradePlan owl:hasKey ( ash:planId ) .
ash:OrderIntent owl:hasKey ( ash:orderIntentId ) .
ash:RuleRevision owl:hasKey ( ash:revisionId ) .
ash:DecisionCycle owl:hasKey ( ash:cycleId ) .
ash:PostTradeReview owl:hasKey ( ash:reviewsDecision ash:reviewCompletedDate ) .

# ---- disjointness ----

[] a owl:AllDisjointClasses ;
   owl:members ( ash:Account ash:Portfolio ) .

[] a owl:AllDisjointClasses ;
   owl:members ( ash:AccountState ash:PositionState ) .

[] a owl:AllDisjointClasses ;
   owl:members ( ash:RiskBudget ash:RiskLimit ) .

[] a owl:AllDisjointClasses ;
   owl:members ( ash:EntryPlan ash:ExitPlan ) .

[] a owl:AllDisjointClasses ;
   owl:members ( ash:TradePlan ash:Trade ) .

