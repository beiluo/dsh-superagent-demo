ash:dataAsOf a owl:FunctionalProperty .
ash:dataSource a owl:FunctionalProperty .
ash:dataQualityFlag a owl:FunctionalProperty .
ash:reportPeriod a owl:FunctionalProperty .
ash:fiscalYearEnd a owl:FunctionalProperty .
ash:revenue a owl:FunctionalProperty .
ash:netProfit a owl:FunctionalProperty .
ash:roe a owl:FunctionalProperty .
ash:roa a owl:FunctionalProperty .
ash:debtRatio a owl:FunctionalProperty .
ash:interestCoverage a owl:FunctionalProperty .
ash:operatingCashFlow a owl:FunctionalProperty .
ash:revenueGrowth a owl:FunctionalProperty .
ash:profitGrowth a owl:FunctionalProperty .
ash:eps a owl:FunctionalProperty .
ash:lastPrice a owl:FunctionalProperty .
ash:changePct a owl:FunctionalProperty .
ash:volume a owl:FunctionalProperty .
ash:turnoverRate a owl:FunctionalProperty .
ash:marketCap a owl:FunctionalProperty .
ash:peTtm a owl:FunctionalProperty .
ash:pb a owl:FunctionalProperty .
ash:psTtm a owl:FunctionalProperty .
ash:dividendYield a owl:FunctionalProperty .
ash:decisionId a owl:FunctionalProperty .
ash:decisionDate a owl:FunctionalProperty .
ash:validUntil a owl:FunctionalProperty .
ash:confidence a owl:FunctionalProperty .
ash:targetPrice a owl:FunctionalProperty .
ash:stopLoss a owl:FunctionalProperty .
ash:positionWeight a owl:FunctionalProperty .
ash:avgCost a owl:FunctionalProperty .
ash:quantity a owl:FunctionalProperty .
ash:riskScore a owl:FunctionalProperty .
ash:rationaleText a owl:FunctionalProperty .
ash:assumption a owl:FunctionalProperty .
ash:counterArgument a owl:FunctionalProperty .
ash:actionCode a owl:FunctionalProperty .
ash:riskTolerance a owl:FunctionalProperty .
ash:maxSingleWeight a owl:FunctionalProperty .
ash:passed a owl:FunctionalProperty .
ash:ruleId a owl:FunctionalProperty .
ash:severity a owl:FunctionalProperty .
ash:rulePriority a owl:FunctionalProperty .
ash:ruleIf a owl:FunctionalProperty .
ash:ruleThen a owl:FunctionalProperty .
ash:ruleStatus a owl:FunctionalProperty .
ash:ruleVersion a owl:FunctionalProperty .
ash:ruleOwner a owl:FunctionalProperty .
ash:ruleEffectiveFrom a owl:FunctionalProperty .
ash:policyVersion a owl:FunctionalProperty .
ash:reviewDate a owl:FunctionalProperty .
ash:isExample a owl:FunctionalProperty .
ash:exampleNote a owl:FunctionalProperty .
ash:humanApprovalRequired a owl:FunctionalProperty .
ash:serviceVersion a owl:FunctionalProperty .
ash:endpointStatus a owl:FunctionalProperty .

# ===========================================================================
# Keys
# ===========================================================================

ash:ListedCompany owl:hasKey ( ash:companyCode ) .
ash:Security owl:hasKey ( ash:securityCode ash:listedOn ) .
ash:Exchange owl:hasKey ( ash:exchangeCode ) .
ash:FinancialReport owl:hasKey ( ash:reportsOn ash:reportPeriod ) .
ash:MarketQuote owl:hasKey ( ash:quoteOf ash:dataAsOf ) .
ash:Valuation owl:hasKey ( ash:valuationOf ash:dataAsOf ) .
ash:InvestmentDecision owl:hasKey ( ash:decisionId ) .

# ===========================================================================
# Disjointness
# ===========================================================================

[] a owl:AllDisjointClasses ;
   owl:members ( ash:ListedCompany ash:Investor ash:ServiceProvider ash:Regulator ) .

[] a owl:AllDisjointClasses ;
   owl:members ( ash:Security ash:Index ) .

[] a owl:AllDisjointClasses ;
   owl:members ( ash:FinancialReport ash:MarketQuote ash:Valuation ash:MacroIndicator ash:Disclosure ash:ResearchReport ash:NewsItem ) .

[] a owl:AllDisjointClasses ;
   owl:members ( ash:InvestmentDecision ash:DecisionRationale ash:Recommendation ash:Portfolio ash:Position ash:InvestorProfile ash:ComplianceCheck ) .

[] a owl:AllDisjointClasses ;
   owl:members ( ash:MarketRisk ash:CreditRisk ash:LiquidityRisk ash:OperationalRisk ash:ComplianceRisk ash:ConcentrationRisk ash:ModelRisk ash:ESGRisk ) .

[] a owl:AllDisjointClasses ;
   owl:members ( ash:Exchange ash:MarketSegment ) .

# ===========================================================================
# Named individuals: controlled vocabularies
# ===========================================================================

ashd:rec-buy a owl:NamedIndividual, ash:Recommendation ;
    ash:actionCode "BUY" ;
    rdfs:label "增持"@zh, "Buy"@en ;
    rdfs:comment "在风险预算内增加目标证券暴露。"@zh ;
    ash:isExample true .

ashd:rec-hold a owl:NamedIndividual, ash:Recommendation ;
    ash:actionCode "HOLD" ;
    rdfs:label "持有"@zh, "Hold"@en ;
    rdfs:comment "维持现有暴露，不新增也不减少。"@zh ;
    ash:isExample true .

ashd:rec-sell a owl:NamedIndividual, ash:Recommendation ;
    ash:actionCode "SELL" ;
    rdfs:label "减持"@zh, "Sell"@en ;
    rdfs:comment "降低或退出目标证券暴露。"@zh ;
    ash:isExample true .

ashd:rec-watch a owl:NamedIndividual, ash:Recommendation ;
    ash:actionCode "WATCH" ;
    rdfs:label "观察"@zh, "Watch"@en ;
    rdfs:comment "暂不建仓，等待估值、业绩或事件信号进一步确认。"@zh ;
    ash:isExample true .

ashd:rec-avoid a owl:NamedIndividual, ash:Recommendation ;
    ash:actionCode "AVOID" ;
    rdfs:label "回避"@zh, "Avoid"@en ;
    rdfs:comment "因风险、合规或能力圈原因不参与。"@zh ;
    ash:isExample true .

[] a owl:AllDifferent ;
   owl:members ( ashd:rec-buy ashd:rec-hold ashd:rec-sell ashd:rec-watch ashd:rec-avoid ) .

ashd:risk-low a owl:NamedIndividual, ash:RiskLevel ;
    rdfs:label "低"@zh, "Low"@en ;
    rdfs:comment "风险分数 0—25。"@zh ;
    ash:isExample true .

ashd:risk-medium a owl:NamedIndividual, ash:RiskLevel ;
    rdfs:label "中"@zh, "Medium"@en ;
    rdfs:comment "风险分数 26—50。"@zh ;
    ash:isExample true .

ashd:risk-high a owl:NamedIndividual, ash:RiskLevel ;
    rdfs:label "高"@zh, "High"@en ;
    rdfs:comment "风险分数 51—75。"@zh ;
    ash:isExample true .

ashd:risk-extreme a owl:NamedIndividual, ash:RiskLevel ;
    rdfs:label "极高"@zh, "Extreme"@en ;
    rdfs:comment "风险分数 76—100。"@zh ;
    ash:isExample true .

[] a owl:AllDifferent ;
   owl:members ( ashd:risk-low ashd:risk-medium ashd:risk-high ashd:risk-extreme ) .

ashd:horizon-short a owl:NamedIndividual, ash:InvestmentHorizon ;
    rdfs:label "短期（1—3 个月）"@zh, "Short term (1–3 months)"@en ;
    ash:isExample true .

ashd:horizon-medium a owl:NamedIndividual, ash:InvestmentHorizon ;
    rdfs:label "中期（3—12 个月）"@zh, "Medium term (3–12 months)"@en ;
    ash:isExample true .

ashd:horizon-long a owl:NamedIndividual, ash:InvestmentHorizon ;
    rdfs:label "长期（1—3 年）"@zh, "Long term (1–3 years)"@en ;
    ash:isExample true .

[] a owl:AllDifferent ;
   owl:members ( ashd:horizon-short ashd:horizon-medium ashd:horizon-long ) .

# ===========================================================================
# Competency questions as ontology annotations
# ===========================================================================

ash:competency-question-01 a owl:NamedIndividual, ash:CompetencyQuestion ;
    rdfs:label "CQ01 哪些公司同时满足高 ROE、低 PE、正利润且非 ST？"@zh ;
    ash:competencyQuestion "哪些公司同时满足高 ROE、低 PE、正利润且非 ST？"@zh ;
    ash:isExample true .

ash:competency-question-02 a owl:NamedIndividual, ash:CompetencyQuestion ;
    rdfs:label "CQ02 哪些公司的资产负债率过高且利息保障倍数不足？"@zh ;
    ash:competencyQuestion "哪些公司的资产负债率过高且利息保障倍数不足？"@zh ;
    ash:isExample true .

ash:competency-question-03 a owl:NamedIndividual, ash:CompetencyQuestion ;
    rdfs:label "CQ03 当前决策的建议、目标价、止损价和风险等级是什么？"@zh ;
    ash:competencyQuestion "当前决策的建议、目标价、止损价和风险等级是什么？"@zh ;
    ash:isExample true .

ash:competency-question-04 a owl:NamedIndividual, ash:CompetencyQuestion ;
    rdfs:label "CQ04 某项决策引用了哪些证据、理由和政策？"@zh ;
    ash:competencyQuestion "某项决策引用了哪些证据、理由和政策？"@zh ;
    ash:isExample true .

ash:competency-question-05 a owl:NamedIndividual, ash:CompetencyQuestion ;
    rdfs:label "CQ05 哪些持仓权重超过组合的单票集中度上限？"@zh ;
    ash:competencyQuestion "哪些持仓权重超过组合的单票集中度上限？"@zh ;
    ash:isExample true .

ash:competency-question-06 a owl:NamedIndividual, ash:CompetencyQuestion ;
    rdfs:label "CQ06 某项决策服务需要哪些输入、输出和前置条件？"@zh ;
    ash:competencyQuestion "某项决策服务需要哪些输入、输出和前置条件？"@zh ;
    ash:isExample true .

ash:competency-question-07 a owl:NamedIndividual, ash:CompetencyQuestion ;
    rdfs:label "CQ07 哪些 ODRL 政策禁止将决策报告分发给非合格投资者？"@zh ;
    ash:competencyQuestion "哪些 ODRL 政策禁止将决策报告分发给非合格投资者？"@zh ;
    ash:isExample true .

ash:competency-question-08 a owl:NamedIndividual, ash:CompetencyQuestion ;
    rdfs:label "CQ08 各行业一级概念下有哪些子概念？"@zh ;
    ash:competencyQuestion "各行业一级概念下有哪些子概念？"@zh ;
    ash:isExample true .

ash:competency-question-09 a owl:NamedIndividual, ash:CompetencyQuestion ;
    rdfs:label "CQ09 哪些 SWRL 规则处于 active 状态，责任人是谁？"@zh ;
    ash:competencyQuestion "哪些 SWRL 规则处于 active 状态，责任人是谁？"@zh ;
    ash:isExample true .

ash:competency-question-10 a owl:NamedIndividual, ash:CompetencyQuestion ;
    rdfs:label "CQ10 哪些投资决策缺少风险评估，需要完整性修复？"@zh ;
    ash:competencyQuestion "哪些投资决策缺少风险评估，需要完整性修复？"@zh ;
    ash:isExample true .
