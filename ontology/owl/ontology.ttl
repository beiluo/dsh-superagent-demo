ash:hasApproval owl:inverseOf ash:approves .
ash:approves owl:inverseOf ash:hasApproval .

ash:Fund owl:hasKey ( ash:fundCode ) .
ash:Bond owl:hasKey ( ash:bondCode ) .
ash:Order owl:hasKey ( ash:orderId ) .

[] a owl:AllDisjointClasses ;
   owl:members ( ash:Fund ash:Repo ash:Derivative ) .

[] a owl:AllDisjointClasses ;
   owl:members ( ash:FundShare ash:Bond ) .

[] a owl:AllDisjointClasses ;
   owl:members ( ash:Order ash:Trade ) .
# ===== Short-term / hot-money restrictions =====

ash:LimitUpStreak rdfs:subClassOf [ a owl:Restriction ;
      owl:onProperty ash:limitUpDays ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:brokenBoardCount ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:sealAmount ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:DragonTigerList rdfs:subClassOf [ a owl:Restriction ;
      owl:onProperty ash:dragonTigerNetBuy ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:HotMoneySeat rdfs:subClassOf [ a owl:Restriction ;
      owl:onProperty ash:seatName ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:seatType ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:seatNetBuy ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:seatWinRate ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:ThemeHeat rdfs:subClassOf [ a owl:Restriction ;
      owl:onProperty ash:themeHeatScore ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:AuctionSnapshot rdfs:subClassOf [ a owl:Restriction ;
      owl:onProperty ash:auctionVolumeRatio ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:auctionPriceChange ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:TechnicalSignal rdfs:subClassOf [ a owl:Restriction ;
      owl:onProperty ash:signalStrength ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty ash:signalHorizon ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .

ash:NewsCatalyst rdfs:subClassOf [ a owl:Restriction ;
      owl:onProperty ash:catalystType ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass skos:Concept ] .

