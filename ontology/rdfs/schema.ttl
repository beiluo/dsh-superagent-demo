    rdfs:label "排板"@zh, "Queue Board"@en ;
    rdfs:comment "在涨停价排队等待成交。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:ResealBoard a owl:Class ;
