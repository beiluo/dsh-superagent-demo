ash:unrealizedPnlPct a owl:DatatypeProperty ;
    rdfs:domain ash:PositionState ;
    rdfs:range xsd:decimal ;
    rdfs:label "浮动盈亏率"@zh, "unrealized PnL percent"@en ;
    rdfs:comment "持仓未实现盈亏占成本的比例，以百分数表示。"@zh .

ash:realizedPnl a owl:DatatypeProperty ;
