# ===== Youzi methodology expansion 1.3 =====

ash:SeatRank a owl:Class ;
    rdfs:subClassOf ash:InformationObject ;
    rdfs:label "席位排名"@zh, "Seat Rank"@en ;
    rdfs:comment "龙虎榜买方或卖方前五席位的名次与金额结构。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:SeatStyle a owl:Class ;
    rdfs:subClassOf ash:InformationObject ;
    rdfs:label "席位风格"@zh, "Seat Style"@en ;
    rdfs:comment "营业部/机构、一日游/波段/锁仓/加码等交易风格。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:DragonTigerConsensus a owl:Class ;
    rdfs:subClassOf ash:AssessmentResult ;
    rdfs:label "龙虎榜共识"@zh, "Dragon-Tiger Consensus"@en ;
    rdfs:comment "买方席位中游资与机构的组合及一致性。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:DragonTigerTrigger a owl:Class ;
    rdfs:subClassOf ash:InformationObject ;
    rdfs:label "龙虎榜触发原因"@zh, "Dragon-Tiger Trigger"@en ;
    rdfs:comment "涨幅偏离、换手率、振幅或连续涨幅等上榜触发条件。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:BuySellConcentration a owl:Class ;
    rdfs:subClassOf ash:AssessmentResult ;
    rdfs:label "买卖集中度"@zh, "Buy/Sell Concentration"@en ;
    rdfs:comment "买一与卖一、买方总额与卖方总额的集中程度。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:SeatReputation a owl:Class ;
    rdfs:subClassOf ash:AssessmentResult ;
    rdfs:label "席位口碑"@zh, "Seat Reputation"@en ;
    rdfs:comment "席位的历史胜率、一日游倾向与跟随价值。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:AuctionPhase a owl:Class ;
    rdfs:subClassOf ash:InformationObject ;
    rdfs:label "竞价时段"@zh, "Auction Phase"@en ;
    rdfs:comment "9:15–9:20、9:20–9:25、9:25–9:30 等集合竞价阶段。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:AuctionExpectation a owl:Class ;
    rdfs:subClassOf ash:AssessmentResult ;
    rdfs:label "竞价预期"@zh, "Auction Expectation"@en ;
    rdfs:comment "对次日开盘溢价的预判及依据。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:AuctionSurprise a owl:Class ;
    rdfs:subClassOf ash:AssessmentResult ;
    rdfs:label "竞价预期差"@zh, "Auction Surprise"@en ;
    rdfs:comment "实际开盘相对预期偏强或偏弱的程度。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:WeakToStrong a owl:Class ;
    rdfs:subClassOf ash:Signal ;
    rdfs:label "弱转强"@zh, "Weak-to-Strong"@en ;
    rdfs:comment "竞价或开盘由弱转强、承接超预期的信号。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:StrongToWeak a owl:Class ;
    rdfs:subClassOf ash:Signal ;
    rdfs:label "强转弱"@zh, "Strong-to-Weak"@en ;
    rdfs:comment "竞价或开盘由强转弱、承接不及预期的信号。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:SentimentCycle a owl:Class ;
    rdfs:subClassOf ash:InformationObject ;
    rdfs:label "情绪周期"@zh, "Sentiment Cycle"@en ;
    rdfs:comment "市场炒作从启动到迷茫的阶段序列。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:MarketHeight a owl:Class ;
    rdfs:subClassOf ash:AssessmentResult ;
    rdfs:label "市场高度"@zh, "Market Height"@en ;
    rdfs:comment "最高连板、涨停家数与空间高度。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:MoneyEffect a owl:Class ;
    rdfs:subClassOf ash:AssessmentResult ;
    rdfs:label "赚钱效应"@zh, "Money Effect"@en ;
    rdfs:comment "涨停溢价、连板晋级与追涨收益的综合状态。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:LossEffect a owl:Class ;
    rdfs:subClassOf ash:AssessmentResult ;
    rdfs:label "亏钱效应"@zh, "Loss Effect"@en ;
    rdfs:comment "炸板、跌停与高位股回撤的综合状态。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:EmotionFreeze a owl:Class ;
    rdfs:subClassOf ash:Signal ;
    rdfs:label "情绪冰点"@zh, "Emotion Freeze"@en ;
    rdfs:comment "连板高度低、亏钱效应主导、交易清淡的阶段信号。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:BoardTactic a owl:Class ;
    rdfs:subClassOf ash:InformationObject ;
