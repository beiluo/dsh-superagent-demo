ash:VolumeTurnoverBoard a owl:Class ;
    rdfs:subClassOf ash:BoardTactic ;
    rdfs:label "放量换手板"@zh, "Volume-Turnover Board"@en ;
    rdfs:comment "经过充分换手后封板，筹码成本更接近涨停价。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:LockupBehavior a owl:Class ;
    rdfs:subClassOf ash:InformationObject ;
    rdfs:label "锁仓行为"@zh, "Lockup Behavior"@en ;
    rdfs:comment "买一席位继续持有、等待接力的行为。"@zh ;
