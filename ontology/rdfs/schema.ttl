    rdfs:comment "持有期内相对建仓价的最大不利变动，以百分数表示。"@zh .

ash:maxFavorableExcursion a owl:DatatypeProperty ;
    rdfs:domain ash:DecisionOutcome ;
    rdfs:range xsd:decimal ;
    rdfs:label "最大有利偏移"@zh, "max favorable excursion"@en ;
    rdfs:comment "持有期内相对建仓价的最大有利变动，以百分数表示。"@zh .

ash:outcomeStatus a owl:DatatypeProperty ;
