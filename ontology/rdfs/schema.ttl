    rdfs:comment "尾部 5% 情景下的预期损失，以总资产百分比表示。"@zh .

ash:portfolioBeta a owl:DatatypeProperty ;
    rdfs:domain ash:PortfolioRiskSnapshot ;
    rdfs:range xsd:decimal ;
    rdfs:label "组合 Beta"@zh, "portfolio beta"@en ;
    rdfs:comment "组合相对基准的市场敏感度。"@zh .

ash:portfolioTrackingError a owl:DatatypeProperty ;
    rdfs:domain ash:PortfolioRiskSnapshot ;
    rdfs:range xsd:decimal ;
    rdfs:label "组合跟踪误差"@zh, "portfolio tracking error"@en ;
    rdfs:comment "组合相对基准的跟踪误差，以百分数表示。"@zh .

ash:concentrationHhi a owl:DatatypeProperty ;
    rdfs:domain ash:PortfolioRiskSnapshot ;
