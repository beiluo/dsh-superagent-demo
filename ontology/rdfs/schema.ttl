    rdfs:comment "交易计划失效日期。"@zh .

ash:plannedQuantity a owl:DatatypeProperty ;
    rdfs:domain ash:TradePlan ;
    rdfs:range xsd:decimal ;
    rdfs:label "计划数量"@zh, "planned quantity"@en ;
    rdfs:comment "计划买入或卖出的证券数量。"@zh .

ash:plannedNotional a owl:DatatypeProperty ;
    rdfs:domain ash:TradePlan ;
    rdfs:range xsd:decimal ;
    rdfs:label "计划金额"@zh, "planned notional"@en ;
    rdfs:comment "计划成交金额，单位：人民币元。"@zh .

ash:plannedWeight a owl:DatatypeProperty ;
    rdfs:domain ash:TradePlan ;
    rdfs:range xsd:decimal ;
