    rdfs:comment "价格点位的计算依据，例如估值、技术位或 ATR 倍数。"@zh .

ash:triggerType a owl:DatatypeProperty ;
    rdfs:domain ash:TradeTrigger ;
    rdfs:range xsd:string ;
    rdfs:label "触发类型"@zh, "trigger type"@en ;
    rdfs:comment "PRICE、TECHNICAL、FUNDAMENTAL、TIME 或 REBALANCE。"@zh .

ash:triggerCondition a owl:DatatypeProperty ;
    rdfs:domain ash:TradeTrigger ;
    rdfs:range xsd:string ;
    rdfs:label "触发条件"@zh, "trigger condition"@en ;
    rdfs:comment "触发交易计划的自然语言或表达式条件。"@zh .

ash:sizingQuantity a owl:DatatypeProperty ;
    rdfs:domain ash:PositionSizing ;
    rdfs:range xsd:decimal ;
    rdfs:label "测算数量"@zh, "sizing quantity"@en ;
    rdfs:comment "按风险预算与止损距离计算的数量。"@zh .

ash:sizingWeight a owl:DatatypeProperty ;
    rdfs:domain ash:PositionSizing ;
    rdfs:range xsd:decimal ;
    rdfs:label "测算权重变化"@zh, "sizing weight"@en ;
    rdfs:comment "仓位测算对应的权重变化，取值 0—1。"@zh .

ash:sizingRiskAmount a owl:DatatypeProperty ;
    rdfs:domain ash:PositionSizing ;
    rdfs:range xsd:decimal ;
    rdfs:label "测算风险金额"@zh, "sizing risk amount"@en ;
    rdfs:comment "仓位测算得到的计划风险金额，单位：人民币元。"@zh .

ash:sizingAsOf a owl:DatatypeProperty ;
    rdfs:domain ash:PositionSizing ;
    rdfs:range xsd:date ;
    rdfs:label "测算日期"@zh, "sizing as of"@en ;
    rdfs:comment "仓位测算采用的行情与预算日期。"@zh .

ash:orderIntentId a owl:DatatypeProperty ;
    rdfs:domain ash:OrderIntent ;
    rdfs:range xsd:string ;
    rdfs:label "意图编号"@zh, "order intent id"@en ;
    rdfs:comment "订单意图的稳定业务编号。"@zh .

ash:orderIntentSide a owl:DatatypeProperty ;
    rdfs:domain ash:OrderIntent ;
    rdfs:range xsd:string ;
    rdfs:label "意图方向"@zh, "order intent side"@en ;
    rdfs:comment "订单意图方向：BUY 或 SELL。"@zh .

ash:orderIntentQuantity a owl:DatatypeProperty ;
    rdfs:domain ash:OrderIntent ;
    rdfs:range xsd:decimal ;
    rdfs:label "意图数量"@zh, "order intent quantity"@en ;
    rdfs:comment "订单意图的证券数量。"@zh .

ash:orderIntentPrice a owl:DatatypeProperty ;
    rdfs:domain ash:OrderIntent ;
    rdfs:range xsd:decimal ;
    rdfs:label "意图价格"@zh, "order intent price"@en ;
    rdfs:comment "订单意图的参考价格，单位：人民币元/股。"@zh .

ash:orderIntentStatus a owl:DatatypeProperty ;
    rdfs:domain ash:OrderIntent ;
    rdfs:range xsd:string ;
    rdfs:label "意图状态"@zh, "order intent status"@en ;
    rdfs:comment "DRAFT、PENDING_APPROVAL、APPROVED、SENT、FILLED 或 CANCELLED。"@zh .

ash:slippageBps a owl:DatatypeProperty ;
    rdfs:domain ash:ExecutionQuality ;
    rdfs:range xsd:decimal ;
    rdfs:label "成交滑点"@zh, "slippage bps"@en ;
    rdfs:comment "成交价相对计划价的滑点，以基点表示。"@zh .

ash:fillRate a owl:DatatypeProperty ;
    rdfs:domain ash:ExecutionQuality ;
    rdfs:range xsd:decimal ;
    rdfs:label "成交率"@zh, "fill rate"@en ;
    rdfs:comment "实际成交数量占委托数量的比例，取值 0—1。"@zh .

ash:executionLatencyMs a owl:DatatypeProperty ;
    rdfs:domain ash:ExecutionQuality ;
    rdfs:range xsd:integer ;
    rdfs:label "执行延迟"@zh, "execution latency"@en ;
    rdfs:comment "从下单到成交回报的毫秒数。"@zh .

ash:marketImpactBps a owl:DatatypeProperty ;
    rdfs:domain ash:ExecutionQuality ;
    rdfs:range xsd:decimal ;
    rdfs:label "市场冲击"@zh, "market impact bps"@en ;
    rdfs:comment "成交对市场价格造成的冲击，以基点表示。"@zh .

ash:realizedReturn a owl:DatatypeProperty ;
    rdfs:domain ash:DecisionOutcome ;
    rdfs:range xsd:decimal ;
    rdfs:label "已实现收益率"@zh, "realized return"@en ;
    rdfs:comment "决策执行后的已实现收益率，以百分数表示。"@zh .

ash:realizedPnlAmount a owl:DatatypeProperty ;
    rdfs:domain ash:DecisionOutcome ;
    rdfs:range xsd:decimal ;
    rdfs:label "已实现盈亏金额"@zh, "realized PnL amount"@en ;
    rdfs:comment "决策执行后的已实现盈亏，单位：人民币元。"@zh .

ash:holdingPeriodDays a owl:DatatypeProperty ;
    rdfs:domain ash:DecisionOutcome ;
    rdfs:range xsd:integer ;
    rdfs:label "持有期"@zh, "holding period days"@en ;
    rdfs:comment "从建仓到退出的持有天数。"@zh .

ash:maxAdverseExcursion a owl:DatatypeProperty ;
    rdfs:domain ash:DecisionOutcome ;
    rdfs:range xsd:decimal ;
