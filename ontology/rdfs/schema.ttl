    rdfs:label "批次成本"@zh, "lot cost"@en ;
    rdfs:comment "建仓批次的单位成本，单位：人民币元/股。"@zh .

ash:lotOpenDate a owl:DatatypeProperty ;
    rdfs:domain ash:PositionLot ;
    rdfs:range xsd:date ;
    rdfs:label "批次建仓日"@zh, "lot open date"@en ;
    rdfs:comment "建仓批次的成交日期。"@zh .

ash:cashMovementType a owl:DatatypeProperty ;
