    rdfs:label "组合波动率"@zh, "portfolio volatility"@en ;
    rdfs:comment "组合年化波动率，以百分数表示。"@zh .

ash:portfolioVar95 a owl:DatatypeProperty ;
    rdfs:domain ash:PortfolioRiskSnapshot ;
    rdfs:range xsd:decimal ;
    rdfs:label "组合 VaR95"@zh, "portfolio VaR 95"@en ;
    rdfs:comment "95% 置信水平下的组合 VaR，以总资产百分比表示。"@zh .

ash:expectedShortfall a owl:DatatypeProperty ;
