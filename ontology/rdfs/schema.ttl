# ===== Skill catalog expansion 1.4 =====

ash:SkillCatalog a owl:Class ;
    rdfs:subClassOf ash:InformationObject ;
    rdfs:label "技能目录"@zh, "Skill Catalog"@en ;
    rdfs:comment "外部方法论技能的目录与章节索引。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:SkillArtifact a owl:Class ;
    rdfs:subClassOf ash:InformationObject ;
    rdfs:label "技能文档"@zh, "Skill Artifact"@en ;
    rdfs:comment "一份可引用的交易方法论技能文档。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:SkillSection a owl:Class ;
    rdfs:subClassOf ash:InformationObject ;
    rdfs:label "技能章节"@zh, "Skill Section"@en ;
    rdfs:comment "技能文档中的章节标题与主题索引，不包含原文正文。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .


ash:hasSkill a owl:ObjectProperty ; rdfs:domain ash:SkillCatalog ; rdfs:range ash:SkillArtifact ; rdfs:label "包含技能"@zh .
ash:hasSkillSection a owl:ObjectProperty ; rdfs:domain ash:SkillArtifact ; rdfs:range ash:SkillSection ; rdfs:label "包含章节"@zh .
ash:hasSkillTopic a owl:ObjectProperty ; rdfs:domain ash:InformationObject ; rdfs:range skos:Concept ; rdfs:label "技能主题"@zh .
ash:skillTitle a owl:DatatypeProperty ; rdfs:domain ash:SkillArtifact ; rdfs:range xsd:string ; rdfs:label "技能标题"@zh .
ash:skillUrl a owl:DatatypeProperty ; rdfs:domain ash:SkillArtifact ; rdfs:range xsd:anyURI ; rdfs:label "技能地址"@zh .
ash:skillOrder a owl:DatatypeProperty ; rdfs:domain ash:SkillArtifact ; rdfs:range xsd:integer ; rdfs:label "技能序号"@zh .
ash:sectionTitle a owl:DatatypeProperty ; rdfs:domain ash:SkillSection ; rdfs:range xsd:string ; rdfs:label "章节标题"@zh .
ash:sectionOrder a owl:DatatypeProperty ; rdfs:domain ash:SkillSection ; rdfs:range xsd:integer ; rdfs:label "章节序号"@zh .
ash:TraderStatement a owl:Class ;
    rdfs:subClassOf ash:InformationObject ;
    rdfs:label "游资原话摘录"@zh, "Trader Statement"@en ;
    rdfs:comment "公开语料中的短句摘录/原则，标注说话者与来源；不代表本人确认，不构成投资建议。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .


ash:hasStatement a owl:ObjectProperty ; rdfs:domain ash:SkillArtifact ; rdfs:range ash:TraderStatement ; rdfs:label "包含原话"@zh .
ash:statementText a owl:DatatypeProperty ; rdfs:domain ash:TraderStatement ; rdfs:range xsd:string ; rdfs:label "原话摘录"@zh .
ash:statementSpeaker a owl:DatatypeProperty ; rdfs:domain ash:TraderStatement ; rdfs:range xsd:string ; rdfs:label "说话者"@zh .
ash:statementType a owl:DatatypeProperty ; rdfs:domain ash:TraderStatement ; rdfs:range xsd:string ; rdfs:label "原话类型"@zh .
ash:statementStatus a owl:DatatypeProperty ; rdfs:domain ash:TraderStatement ; rdfs:range xsd:string ; rdfs:label "原话状态"@zh .
ash:statementOrder a owl:DatatypeProperty ; rdfs:domain ash:TraderStatement ; rdfs:range xsd:integer ; rdfs:label "原话序号"@zh .
# ===== Rule expansion 1.7 =====

ash:MarketRiskOff a owl:Class ;
    rdfs:subClassOf ash:Signal ;
    rdfs:label "市场风险关闭"@zh, "Market Risk Off"@en ;
    rdfs:comment "市场趋势、宽度或赚钱效应不支持开仓。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:MarketRiskOn a owl:Class ;
    rdfs:subClassOf ash:Signal ;
    rdfs:label "市场风险开启"@zh, "Market Risk On"@en ;
    rdfs:comment "市场趋势、宽度与赚钱效应支持开仓。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:EmotionStart a owl:Class ;
    rdfs:subClassOf ash:Signal ;
    rdfs:label "情绪启动"@zh, "Emotion Start"@en ;
    rdfs:comment "连板高度打开、赚钱效应回升。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:EmotionClimax a owl:Class ;
    rdfs:subClassOf ash:Signal ;
    rdfs:label "情绪高潮"@zh, "Emotion Climax"@en ;
    rdfs:comment "主线加速、连板增多、扩散充分。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:EmotionEbb a owl:Class ;
    rdfs:subClassOf ash:Signal ;
    rdfs:label "情绪退潮"@zh, "Emotion Ebb"@en ;
    rdfs:comment "炸板率上升、高位股亏钱效应扩散。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:LeaderConfirmed a owl:Class ;
    rdfs:subClassOf ash:Signal ;
    rdfs:label "龙头确认"@zh, "Leader Confirmed"@en ;
    rdfs:comment "题材龙头打出身位、换手与带动性。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:ThemeMainline a owl:Class ;
    rdfs:subClassOf ash:Signal ;
    rdfs:label "主线确认"@zh, "Theme Mainline"@en ;
    rdfs:comment "主题热度、排名与扩散度同时占优。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:AuctionStrong a owl:Class ;
    rdfs:subClassOf ash:Signal ;
    rdfs:label "竞价强势"@zh, "Auction Strong"@en ;
    rdfs:comment "竞价溢价、量比与承接超预期。"@zh ;
    rdfs:isDefinedBy <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share/rdfs> .

ash:AuctionWeak a owl:Class ;
