    rdfs:range xsd:string ;
    rdfs:label "资金变动类型"@zh, "cash movement type"@en ;
    rdfs:comment "DEPOSIT、WITHDRAW、BUY、SELL、DIVIDEND 或 FEE。"@zh .

ash:cashMovementAmount a owl:DatatypeProperty ;
    rdfs:domain ash:CashMovement ;
    rdfs:range xsd:decimal ;
    rdfs:label "资金变动金额"@zh, "cash movement amount"@en ;
    rdfs:comment "资金变动金额，单位：人民币元。"@zh .

ash:cashMovementDate a owl:DatatypeProperty ;
    rdfs:domain ash:CashMovement ;
    rdfs:range xsd:date ;
    rdfs:label "资金变动日期"@zh, "cash movement date"@en ;
    rdfs:comment "资金变动发生的日期。"@zh .

ash:riskBudgetTotal a owl:DatatypeProperty ;
    rdfs:domain ash:RiskBudget ;
    rdfs:range xsd:decimal ;
    rdfs:label "风险预算总额"@zh, "risk budget total"@en ;
    rdfs:comment "组合可承担的风险资本总额，单位：人民币元。"@zh .

ash:riskBudgetUsed a owl:DatatypeProperty ;
    rdfs:domain ash:RiskBudget ;
    rdfs:range xsd:decimal ;
    rdfs:label "已用风险预算"@zh, "risk budget used"@en ;
    rdfs:comment "当前持仓已占用的风险预算，单位：人民币元。"@zh .

ash:riskBudgetRemaining a owl:DatatypeProperty ;
    rdfs:domain ash:RiskBudget ;
    rdfs:range xsd:decimal ;
    rdfs:label "剩余风险预算"@zh, "risk budget remaining"@en ;
    rdfs:comment "尚未被占用的风险预算，单位：人民币元。"@zh .

ash:riskBudgetUtilization a owl:DatatypeProperty ;
    rdfs:domain ash:RiskBudget ;
    rdfs:range xsd:decimal ;
    rdfs:label "风险预算使用率"@zh, "risk budget utilization"@en ;
    rdfs:comment "已用风险预算占总额的百分比。"@zh .

ash:riskPerTradeLimit a owl:DatatypeProperty ;
    rdfs:domain ash:RiskBudget ;
    rdfs:range xsd:decimal ;
    rdfs:label "单笔风险预算"@zh, "risk per-trade limit"@en ;
    rdfs:comment "组合允许单一交易承担的最大风险金额，单位：人民币元。"@zh .

ash:maxPortfolioLoss a owl:DatatypeProperty ;
    rdfs:domain ash:RiskBudget ;
    rdfs:range xsd:decimal ;
    rdfs:label "组合最大亏损"@zh, "max portfolio loss"@en ;
    rdfs:comment "组合在压力情景下允许的最大亏损，单位：人民币元。"@zh .

ash:maxGrossExposure a owl:DatatypeProperty ;
    rdfs:domain ash:RiskBudget ;
    rdfs:range xsd:decimal ;
    rdfs:label "最大总敞口"@zh, "max gross exposure"@en ;
    rdfs:comment "组合总敞口上限，以总资产比例表示。"@zh .

ash:maxSectorWeight a owl:DatatypeProperty ;
    rdfs:domain ash:RiskBudget ;
    rdfs:range xsd:decimal ;
    rdfs:label "行业权重上限"@zh, "max sector weight"@en ;
    rdfs:comment "单一行业最大权重，取值 0—1。"@zh .

ash:maxDrawdownLimit a owl:DatatypeProperty ;
    rdfs:domain ash:RiskBudget ;
    rdfs:range xsd:decimal ;
    rdfs:label "最大回撤限额"@zh, "max drawdown limit"@en ;
    rdfs:comment "组合允许的最大回撤，以百分数表示。"@zh .

ash:varLimit a owl:DatatypeProperty ;
    rdfs:domain ash:RiskBudget ;
    rdfs:range xsd:decimal ;
