    rdfs:comment "复盘综合评分，0—100。"@zh .

ash:processScore a owl:DatatypeProperty ;
    rdfs:domain ash:PostTradeReview ;
    rdfs:range xsd:decimal ;
    rdfs:label "过程评分"@zh, "process score"@en ;
    rdfs:comment "决策与执行过程质量评分，0—100。"@zh .

ash:outcomeScore a owl:DatatypeProperty ;
    rdfs:domain ash:PostTradeReview ;
    rdfs:range xsd:decimal ;
    rdfs:label "结果评分"@zh, "outcome score"@en ;
    rdfs:comment "结果质量评分，0—100；需与过程评分分开以避免结果偏见。"@zh .

ash:reviewCompletedDate a owl:DatatypeProperty ;
    rdfs:domain ash:PostTradeReview ;
    rdfs:range xsd:date ;
    rdfs:label "复盘完成日"@zh, "review completed date"@en ;
    rdfs:comment "复盘实际完成的日期。"@zh .

ash:reviewDueDate a owl:DatatypeProperty ;
    rdfs:domain ash:PostTradeReview ;
    rdfs:range xsd:date ;
    rdfs:label "复盘截止日"@zh, "review due date"@en ;
    rdfs:comment "复盘要求完成的截止日期。"@zh .

ash:reviewOverdueDays a owl:DatatypeProperty ;
    rdfs:domain ash:PostTradeReview ;
    rdfs:range xsd:integer ;
    rdfs:label "复盘逾期天数"@zh, "review overdue days"@en ;
    rdfs:comment "超过复盘截止日的天数，0 表示未逾期。"@zh .

ash:findingType a owl:DatatypeProperty ;
    rdfs:domain ash:ReviewFinding ;
    rdfs:range xsd:string ;
    rdfs:label "发现类型"@zh, "finding type"@en ;
    rdfs:comment "RULE_GAP、PROCESS_GAP、EXECUTION_GAP、DATA_GAP 或 JUDGEMENT_GAP。"@zh .

ash:findingSeverity a owl:DatatypeProperty ;
    rdfs:domain ash:ReviewFinding ;
    rdfs:range xsd:string ;
    rdfs:label "发现严重程度"@zh, "finding severity"@en ;
    rdfs:comment "high、medium 或 low。"@zh .

ash:findingRecommendation a owl:DatatypeProperty ;
    rdfs:domain ash:ReviewFinding ;
    rdfs:range xsd:string ;
    rdfs:label "改进建议"@zh, "finding recommendation"@en ;
    rdfs:comment "针对复盘发现的具体改进建议。"@zh .

ash:findingOccurrenceCount a owl:DatatypeProperty ;
    rdfs:domain ash:ReviewFinding ;
    rdfs:range xsd:integer ;
    rdfs:label "重复出现次数"@zh, "finding occurrence count"@en ;
    rdfs:comment "同类发现在一段时间内出现的次数。"@zh .

ash:lessonText a owl:DatatypeProperty ;
    rdfs:domain ash:LessonLearned ;
    rdfs:range xsd:string ;
    rdfs:label "经验内容"@zh, "lesson text"@en ;
    rdfs:comment "从复盘沉淀出的经验或教训。"@zh .

ash:lessonAction a owl:DatatypeProperty ;
    rdfs:domain ash:LessonLearned ;
    rdfs:range xsd:string ;
    rdfs:label "改进行动"@zh, "lesson action"@en ;
    rdfs:comment "为落实经验而采取的流程、规则或数据改进行动。"@zh .

ash:lessonStatus a owl:DatatypeProperty ;
    rdfs:domain ash:LessonLearned ;
    rdfs:range xsd:string ;
    rdfs:label "改进状态"@zh, "lesson status"@en ;
    rdfs:comment "OPEN、IN_PROGRESS、DONE 或 DROPPED。"@zh .

ash:attributionEffect a owl:DatatypeProperty ;
    rdfs:domain ash:PerformanceAttribution ;
    rdfs:range xsd:string ;
    rdfs:label "归因来源"@zh, "attribution effect"@en ;
    rdfs:comment "ALLOCATION、SELECTION、TIMING、COST 或 LUCK。"@zh .

ash:attributionPct a owl:DatatypeProperty ;
    rdfs:domain ash:PerformanceAttribution ;
    rdfs:range xsd:decimal ;
    rdfs:label "归因贡献"@zh, "attribution percent"@en ;
    rdfs:comment "该来源对结果的贡献百分比。"@zh .

ash:revisionId a owl:DatatypeProperty ;
    rdfs:domain ash:RuleRevision ;
    rdfs:range xsd:string ;
    rdfs:label "修订编号"@zh, "revision id"@en ;
    rdfs:comment "规则修订的稳定业务编号。"@zh .

ash:revisionRationale a owl:DatatypeProperty ;
    rdfs:domain ash:RuleRevision ;
    rdfs:range xsd:string ;
    rdfs:label "修订理由"@zh, "revision rationale"@en ;
    rdfs:comment "规则修订所依据的复盘发现与理由。"@zh .

ash:revisionEffectiveFrom a owl:DatatypeProperty ;
    rdfs:domain ash:RuleRevision ;
    rdfs:range xsd:date ;
    rdfs:label "修订生效日"@zh, "revision effective from"@en ;
    rdfs:comment "规则修订生效日期。"@zh .

ash:revisionStatus a owl:DatatypeProperty ;
    rdfs:domain ash:RuleRevision ;
    rdfs:range xsd:string ;
    rdfs:label "修订状态"@zh, "revision status"@en ;
    rdfs:comment "PROPOSED、REVIEWING、ADOPTED 或 REJECTED。"@zh .

ash:cycleId a owl:DatatypeProperty ;
    rdfs:domain ash:DecisionCycle ;
    rdfs:range xsd:string ;
    rdfs:label "周期编号"@zh, "cycle id"@en ;
    rdfs:comment "决策周期的稳定业务编号。"@zh .

ash:cycleNumber a owl:DatatypeProperty ;
    rdfs:domain ash:DecisionCycle ;
    rdfs:range xsd:integer ;
    rdfs:label "周期序号"@zh, "cycle number"@en ;
    rdfs:comment "同一组合或证券的决策周期序号。"@zh .

ash:cycleStatus a owl:DatatypeProperty ;
    rdfs:domain ash:DecisionCycle ;
    rdfs:range xsd:string ;
    rdfs:label "周期状态"@zh, "cycle status"@en ;
    rdfs:comment "OPEN、EXECUTED、REVIEWED 或 CLOSED。"@zh .

ash:contextAsOf a owl:DatatypeProperty ;
    rdfs:domain ash:DecisionContext ;
    rdfs:range xsd:date ;
    rdfs:label "上下文日期"@zh, "context as of"@en ;
    rdfs:comment "决策上下文快照的日期。"@zh .

ash:marketRegime a owl:DatatypeProperty ;
    rdfs:domain ash:DecisionContext ;
    rdfs:range xsd:string ;
    rdfs:label "市场状态"@zh, "market regime"@en ;
    rdfs:comment "决策时点的市场状态，例如 trend、range、risk-off 或 event-driven。"@zh .

ash:maxSingleNameWeight a owl:DatatypeProperty ;
    rdfs:domain ash:RiskBudget ;
    rdfs:range xsd:decimal ;
    rdfs:label "单票权重上限"@zh, "max single-name weight"@en ;
    rdfs:comment "风险预算允许的单一证券最大权重，取值 0—1；与投资者画像的单票上限分别治理。"@zh .
