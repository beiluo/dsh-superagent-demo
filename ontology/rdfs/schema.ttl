    rdfs:comment "组合 VaR 限额，以总资产百分比表示。"@zh .

ash:riskBudgetAsOf a owl:DatatypeProperty ;
    rdfs:domain ash:RiskBudget ;
    rdfs:range xsd:date ;
    rdfs:label "风险预算日期"@zh, "risk budget as of"@en ;
    rdfs:comment "风险预算生效或快照的日期。"@zh .

ash:budgetAmount a owl:DatatypeProperty ;
    rdfs:domain ash:RiskBudgetAllocation ;
    rdfs:range xsd:decimal ;
    rdfs:label "分配额度"@zh, "budget amount"@en ;
    rdfs:comment "分配给证券、策略或行业的风险预算额度，单位：人民币元。"@zh .

ash:budgetUsed a owl:DatatypeProperty ;
    rdfs:domain ash:RiskBudgetAllocation ;
    rdfs:range xsd:decimal ;
    rdfs:label "已用额度"@zh, "budget used"@en ;
    rdfs:comment "分配额度中已被持仓占用的金额，单位：人民币元。"@zh .

ash:budgetUtilization a owl:DatatypeProperty ;
    rdfs:domain ash:RiskBudgetAllocation ;
    rdfs:range xsd:decimal ;
    rdfs:label "额度使用率"@zh, "budget utilization"@en ;
    rdfs:comment "已用额度占分配额度的百分比。"@zh .

ash:riskLimitType a owl:DatatypeProperty ;
    rdfs:domain ash:RiskLimit ;
    rdfs:range xsd:string ;
    rdfs:label "限额类型"@zh, "risk limit type"@en ;
    rdfs:comment "SINGLE_NAME_WEIGHT、RISK_PER_TRADE、MAX_DRAWDOWN、VAR 或 SECTOR_WEIGHT。"@zh .

ash:riskLimitThreshold a owl:DatatypeProperty ;
    rdfs:domain ash:RiskLimit ;
    rdfs:range xsd:decimal ;
    rdfs:label "限额阈值"@zh, "risk limit threshold"@en ;
    rdfs:comment "风险限额的阈值；权重为 0—1，金额单位为人民币元，比率为百分数。"@zh .

ash:riskLimitHard a owl:DatatypeProperty ;
