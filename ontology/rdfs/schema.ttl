    rdfs:label "限额使用率"@zh, "risk utilization percent"@en ;
    rdfs:comment "当前使用量占风险限额的百分比。"@zh .

ash:riskUtilizationStatus a owl:DatatypeProperty ;
    rdfs:domain ash:RiskUtilization ;
    rdfs:range xsd:string ;
    rdfs:label "限额状态"@zh, "risk utilization status"@en ;
    rdfs:comment "NORMAL、WARNING、BREACH 或 HALT。"@zh .

ash:riskContributionPct a owl:DatatypeProperty ;
    rdfs:domain ash:RiskContribution ;
    rdfs:range xsd:decimal ;
    rdfs:label "风险贡献占比"@zh, "risk contribution percent"@en ;
    rdfs:comment "该持仓或行业对组合总风险的贡献百分比。"@zh .

ash:marginalRiskContribution a owl:DatatypeProperty ;
