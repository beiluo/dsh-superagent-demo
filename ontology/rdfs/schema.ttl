    rdfs:range xsd:string ;
    rdfs:label "计划编号"@zh, "plan id"@en ;
    rdfs:comment "交易计划的稳定业务编号。"@zh .

ash:planSide a owl:DatatypeProperty ;
    rdfs:domain ash:TradePlan ;
    rdfs:range xsd:string ;
