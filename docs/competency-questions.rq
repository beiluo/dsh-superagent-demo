# Competency questions for the A-share investment decision ontology.
# Each query is separated by a marker comment so scripts/validate.py can parse
# the file one query at a time. Prefixes are repeated for copy/paste use.

# --- CQ ---
# CQ01: Which companies pass the value-candidate screen?
PREFIX ash: <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?company ?companyName ?roe ?pe WHERE {
  ?company a ash:ListedCompany ;
           ash:companyName ?companyName ;
           ash:hasFinancialReport ?report ;
           ash:hasSecurity ?stock .
  ?stock ash:hasValuation ?valuation .
  ?report ash:roe ?roe ;
          ash:netProfit ?profit .
  ?valuation ash:peTtm ?pe .
  FILTER (?roe >= 15 && ?pe <= 20 && ?profit > 0)
  FILTER NOT EXISTS { ?company ash:isST true }
}
ORDER BY DESC(?roe)

# --- CQ ---
# CQ02: Which companies have high financial risk?
PREFIX ash: <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#>
SELECT ?company ?companyName ?debtRatio ?interestCoverage WHERE {
  ?company a ash:ListedCompany ;
           ash:companyName ?companyName ;
           ash:hasFinancialReport ?report .
  ?report ash:debtRatio ?debtRatio ;
          ash:interestCoverage ?interestCoverage .
  FILTER (?debtRatio >= 70 && ?interestCoverage < 2)
}

# --- CQ ---
# CQ03: What is the recommendation, target, stop-loss and risk level for
#      each current decision?
PREFIX ash: <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?decisionId ?companyName ?action ?targetPrice ?stopLoss ?riskLevel ?confidence WHERE {
  ?decision a ash:InvestmentDecision ;
            ash:decisionId ?decisionId ;
            ash:aboutCompany ?company ;
            ash:hasRecommendation ?recommendation ;
            ash:hasRiskAssessment ?risk ;
            ash:confidence ?confidence .
  ?company ash:companyName ?companyName .
  ?recommendation ash:actionCode ?action .
  ?risk ash:hasRiskLevel ?level .
  ?level rdfs:label ?riskLevel .
  OPTIONAL { ?decision ash:targetPrice ?targetPrice }
  OPTIONAL { ?decision ash:stopLoss ?stopLoss }
}
ORDER BY DESC(?confidence)

# --- CQ ---
# CQ04: Which evidence, rationale and policy support a decision?
PREFIX ash: <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?decisionId ?rationale ?evidenceLabel ?policyTitle WHERE {
  ?decision a ash:InvestmentDecision ;
            ash:decisionId ?decisionId ;
            ash:hasRationale ?rationaleNode ;
            ash:basedOn ?evidence ;
            ash:governedBy ?policy .
  ?rationaleNode ash:rationaleText ?rationale .
  ?evidence rdfs:label ?evidenceLabel .
  ?policy dcterms:title ?policyTitle .
  FILTER (LANG(?policyTitle) = "zh")
}

# --- CQ ---
# CQ05: Which positions breach the 10% single-name concentration limit?
PREFIX ash: <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#>
SELECT ?position ?securityName ?weight WHERE {
  ?portfolio a ash:Portfolio ;
             ash:holdsPosition ?position .
  ?position ash:positionIn ?security ;
            ash:positionWeight ?weight .
  ?security ash:securityName ?securityName .
  FILTER (?weight > 0.10)
}

# --- CQ ---
# CQ06: Which inputs, outputs and preconditions does the decision service
#      expose?
PREFIX ash: <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#>
PREFIX service: <http://www.daml.org/services/owl-s/1.2/Service.owl#>
PREFIX profile: <http://www.daml.org/services/owl-s/1.2/Profile.owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?serviceName ?inputLabel ?outputLabel ?precondition WHERE {
  ?service a service:Service ;
           service:presents ?profile .
  ?profile profile:serviceName ?serviceName ;
           profile:hasInput ?input ;
           profile:hasOutput ?output ;
           profile:hasPrecondition ?preconditionNode .
  ?input rdfs:label ?inputLabel .
  ?output rdfs:label ?outputLabel .
  ?preconditionNode <http://www.daml.org/services/owl-s/1.2/generic/Expression.owl#expressionBody> ?precondition .
  FILTER (LANG(?inputLabel) = "zh")
  FILTER (LANG(?outputLabel) = "zh")
}

# --- CQ ---
# CQ07: Which ODRL prohibitions apply to a decision report?
PREFIX ash: <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
SELECT ?policyTitle ?action ?targetLabel WHERE {
  ?policy a ash:DecisionPolicy ;
          dcterms:title ?policyTitle ;
          odrl:prohibition ?prohibition .
  ?prohibition odrl:action ?action ;
               odrl:target ?target .
  ?target <http://www.w3.org/2000/01/rdf-schema#label> ?targetLabel .
  FILTER (LANG(?policyTitle) = "zh")
}

# --- CQ ---
# CQ08: What are the child concepts of each industry top concept?
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?parentLabel ?childLabel ?notation WHERE {
  ?scheme a skos:ConceptScheme ;
          skos:prefLabel ?schemeLabel .
  ?concept skos:inScheme ?scheme ;
           skos:prefLabel ?childLabel ;
           skos:broader ?parent .
  ?parent skos:prefLabel ?parentLabel .
  OPTIONAL { ?concept skos:notation ?notation }
  FILTER (LANG(?schemeLabel) = "zh")
  FILTER (LANG(?childLabel) = "zh")
  FILTER (LANG(?parentLabel) = "zh")
}
ORDER BY ?parentLabel ?childLabel

# --- CQ ---
# CQ09: Which active SWRL rules are owned by which team?
PREFIX ash: <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#>
PREFIX swrl: <http://www.w3.org/2003/11/swrl#>
SELECT ?ruleId ?ruleLabel ?severity ?owner ?ruleIf ?ruleThen WHERE {
  ?rule a swrl:Imp ;
        ash:ruleId ?ruleId ;
        ash:severity ?severity ;
        ash:ruleOwner ?owner ;
        ash:ruleStatus "active" .
  OPTIONAL { ?rule <http://www.w3.org/2000/01/rdf-schema#label> ?ruleLabel }
  OPTIONAL { ?rule ash:ruleIf ?ruleIf }
  OPTIONAL { ?rule ash:ruleThen ?ruleThen }
}
ORDER BY ?ruleId

# --- CQ ---
# CQ10: Which example decisions lack a risk assessment? This is an integrity
#       query, not a rule inference: OWL's open-world semantics cannot infer
#       absence.
PREFIX ash: <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#>
SELECT ?decision ?decisionId WHERE {
  ?decision a ash:InvestmentDecision ;
            ash:decisionId ?decisionId .
  FILTER NOT EXISTS { ?decision ash:hasRiskAssessment ?risk }
}

# --- CQ ---
# CQ11: What are the current cash, buying power, equity and position state?
PREFIX ash: <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#>
SELECT ?accountCode ?cashBalance ?buyingPower ?totalEquity ?asOf WHERE {
  ?account a ash:SecuritiesAccount ;
           ash:accountCode ?accountCode ;
           ash:hasAccountState ?state .
  ?state ash:cashBalance ?cashBalance ;
         ash:buyingPower ?buyingPower ;
         ash:totalEquity ?totalEquity ;
         ash:dataAsOf ?asOf .
}

# --- CQ ---
# CQ12: How much risk budget is used, and what are the per-trade and
#       single-name limits?
PREFIX ash: <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#>
SELECT ?portfolio ?utilization ?remaining ?riskPerTrade ?maxSingleNameWeight WHERE {
  ?portfolio a ash:Portfolio ;
             ash:hasRiskBudget ?budget .
  ?budget a ash:RiskBudget ;
          ash:riskBudgetUtilization ?utilization ;
          ash:riskBudgetRemaining ?remaining ;
          ash:riskPerTrade ?riskPerTrade ;
          ash:maxSingleNameWeight ?maxSingleNameWeight .
}

# --- CQ ---
# CQ13: Given entry, stop and risk budget, what quantity and weight should
#       the plan use?
PREFIX ash: <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#>
SELECT ?plan ?entryPrice ?stopPrice ?quantity ?weight ?riskAmount ?projectedWeight WHERE {
  ?plan a ash:EntryPlan ;
        ash:hasEntryPrice ?entry ;
        ash:hasStopPrice ?stop ;
        ash:hasPositionSizing ?sizing .
  ?entry ash:priceLevelValue ?entryPrice .
  ?stop ash:priceLevelValue ?stopPrice .
  ?sizing ash:sizingQuantity ?quantity ;
          ash:sizingWeight ?weight ;
          ash:riskAmount ?riskAmount ;
          ash:projectedWeight ?projectedWeight .
}

# --- CQ ---
# CQ14: Which buy plans are blocked because projected weight exceeds the
#       single-name limit?
PREFIX ash: <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#>
SELECT ?plan ?planStatus ?projectedWeight ?maxSingleNameWeight WHERE {
  ?plan a ash:EntryPlan ;
        ash:planStatus ?planStatus ;
        ash:hasPositionSizing ?sizing ;
        ash:planForPortfolio ?portfolio .
  ?sizing ash:projectedWeight ?projectedWeight .
  ?portfolio ash:hasRiskBudget ?budget .
  ?budget ash:maxSingleNameWeight ?maxSingleNameWeight .
  FILTER (?projectedWeight > ?maxSingleNameWeight)
}

# --- CQ ---
# CQ15: Which sell plans fit the available quantity, and what are the stop
#       and target prices?
PREFIX ash: <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#>
SELECT ?plan ?availableQuantity ?plannedQuantity ?stopPrice ?targetPrice WHERE {
  ?plan a ash:ExitPlan ;
        ash:exitPlanForPosition ?position ;
        ash:plannedQuantity ?plannedQuantity .
  ?position ash:hasPositionState ?state .
  ?state ash:availableQuantity ?availableQuantity .
  OPTIONAL { ?plan ash:hasStopPrice ?stopNode . ?stopNode ash:priceLevelValue ?stopPrice }
  OPTIONAL { ?plan ash:hasTargetPrice ?targetNode . ?targetNode ash:priceLevelValue ?targetPrice }
  FILTER (?plannedQuantity <= ?availableQuantity)
}

# --- CQ ---
# CQ16: How are trade plan, order intent, order, trade and execution quality
#       linked?
PREFIX ash: <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#>
SELECT ?plan ?intent ?order ?trade ?slippageBps WHERE {
  ?plan a ash:TradePlan ;
        ash:hasOrderIntent ?intent .
  ?intent ash:intentRealizedBy ?order .
  ?trade ash:generatedFromOrder ?order ;
         ash:hasExecutionQuality ?quality .
  ?quality ash:slippageBps ?slippageBps .
}

# --- CQ ---
# CQ17: What was the outcome of a decision: return, PnL, holding period and
#       excursions?
PREFIX ash: <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#>
SELECT ?decision ?realizedReturn ?realizedPnl ?holdingDays ?maxAdverseExcursion ?maxFavorableExcursion ?outcomeStatus WHERE {
  ?decision a ash:InvestmentDecision ;
            ash:hasOutcome ?outcome .
  ?outcome ash:realizedReturn ?realizedReturn ;
           ash:realizedPnlAmount ?realizedPnl ;
           ash:holdingPeriodDays ?holdingDays ;
           ash:maxAdverseExcursion ?maxAdverseExcursion ;
           ash:maxFavorableExcursion ?maxFavorableExcursion ;
           ash:outcomeStatus ?outcomeStatus .
}

# --- CQ ---
# CQ18: Which recurring review findings triggered a rule revision?
PREFIX ash: <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#>
SELECT ?finding ?severity ?occurrenceCount ?revision ?rule ?revisionStatus WHERE {
  ?review a ash:PostTradeReview ;
          ash:hasReviewFinding ?finding ;
          ash:resultsInRevision ?revision .
  ?finding ash:findingSeverity ?severity ;
           ash:findingOccurrenceCount ?occurrenceCount .
  ?revision ash:revisionOfRule ?rule ;
            ash:revisionStatus ?revisionStatus .
  FILTER (?occurrenceCount >= 2)
}

# --- CQ ---
# CQ19: What are the ordered stages of the decision lifecycle service?
PREFIX ash: <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX service: <http://www.daml.org/services/owl-s/1.2/Service.owl#>
PREFIX process: <http://www.daml.org/services/owl-s/1.2/Process.owl#>
SELECT ?service ?stepLabel WHERE {
  ?service a service:Service ;
           service:describedBy ?model .
  ?model process:composedOf ?sequence .
  ?sequence process:components ?list .
  ?list rdf:rest*/rdf:first ?perform .
  ?perform process:process ?step .
  ?step rdfs:label ?stepLabel .
  FILTER (LANG(?stepLabel) = "zh")
}

# --- CQ ---
# CQ20: Which entities carry a risk-budget, buying-power or execution breach?
PREFIX ash: <https://beiluo.github.io/dsh-superagent-demo/ontology/a-share#>
SELECT ?entity ?type WHERE {
  {
    ?entity a ash:RiskBudgetExceeded .
    BIND ("RiskBudgetExceeded" AS ?type)
  } UNION {
    ?entity a ash:EntryBlocked .
    BIND ("EntryBlocked" AS ?type)
  } UNION {
    ?entity a ash:BuyingPowerInsufficient .
    BIND ("BuyingPowerInsufficient" AS ?type)
  } UNION {
    ?entity a ash:ExecutionSlippageBreach .
    BIND ("ExecutionSlippageBreach" AS ?type)
  }
}
